      "settings": {
        "subheading": "",
        "title": "",
        "liquid": "<style>\n.what-is-brisa{padding:0 20px;position:relative}\n.what-is-brisa__inner{position:relative}\n.what-is-brisa__copy{\n  position:relative;\n  padding-right:120px;\n  background-image:url('https://cdn.shopify.com/s/files/1/0939/5752/1780/files/cyan-tran.png?v=1772367343');\n  background-size:auto 100%;\n  background-repeat:no-repeat;\n  background-position:right top;\n}\n.what-is-brisa__heading{margin:0 0 1rem}\n.what-is-brisa__text{margin:0;max-width:42rem;line-height:1.55}\n.what-is-brisa__features{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:1.5rem 2rem;\n  max-width:36rem;\n  margin-top:2rem;\n}\n.what-is-brisa__feature{display:flex;align-items:center;gap:.85rem}\n.what-is-brisa__icon{width:56px;height:56px;flex-shrink:0}\n.what-is-brisa__icon img{display:block;width:100%;height:100%;object-fit:contain}\n.what-is-brisa__label{margin:0;font-weight:700;line-height:1.25}\n@media (max-width:749px){\n  .what-is-brisa{padding:0 16px}\n  .what-is-brisa__copy{\n    padding-right:88px;\n    background-position:right top;\n    background-size:auto 100%;\n  }\n  .what-is-brisa__text{\n    max-width:none;\n    font-size:.95rem;\n    line-height:1.5;\n  }\n  .what-is-brisa__features{\n    grid-template-columns:1fr 1fr;\n    gap:1rem .75rem;\n    max-width:none;\n    margin-top:1.25rem;\n  }\n  .what-is-brisa__feature{gap:.55rem;align-items:flex-start}\n  .what-is-brisa__icon{width:40px;height:40px}\n  .what-is-brisa__label{font-size:.82rem;line-height:1.2}\n}\n@media (max-width:389px){\n  .what-is-brisa__copy{padding-right:72px}\n  .what-is-brisa__icon{width:36px;height:36px}\n  .what-is-brisa__label{font-size:.78rem}\n}\n</style>\n<div class=\"what-is-brisa\">\n  <div class=\"what-is-brisa__inner\">\n    <div class=\"what-is-brisa__copy\">\n      <h3 class=\"heading h2 what-is-brisa__heading\">WHAT IS BRISA?</h3>\n      <p class=\"what-is-brisa__text\">Brisa is a reusable sensory habit device - built to help people move away from smoking or vaping without losing the part you actually like, Hand-to-mouth, familiar draw, real flavour. Air and aroma only. Make the switch. No smoke. No vapour. No nicotine.</p>\n    </div>\n    <div class=\"what-is-brisa__features\">\n      <div class=\"what-is-brisa__feature\">\n        <span class=\"what-is-brisa__icon\"><img src=\"https://cdn.shopify.com/s/files/1/0939/5752/1780/files/hand-to-mouth.png\" alt=\"\" width=\"56\" height=\"56\" loading=\"lazy\"></span>\n        <p class=\"what-is-brisa__label\">Hand-to-mouth<br>draw</p>\n      </div>\n      <div class=\"what-is-brisa__feature\">\n        <span class=\"what-is-brisa__icon\"><img src=\"https://cdn.shopify.com/s/files/1/0939/5752/1780/files/real-throat.png\" alt=\"\" width=\"56\" height=\"56\" loading=\"lazy\"></span>\n        <p class=\"what-is-brisa__label\">Real throat hit</p>\n      </div>\n      <div class=\"what-is-brisa__feature\">\n        <span class=\"what-is-brisa__icon\"><img src=\"https://cdn.shopify.com/s/files/1/0939/5752/1780/files/bold-familiar-flavour.png\" alt=\"\" width=\"56\" height=\"56\" loading=\"lazy\"></span>\n        <p class=\"what-is-brisa__label\">Bold familiar<br>Aroma/flavour</p>\n      </div>\n      <div class=\"what-is-brisa__feature\">\n        <span class=\"what-is-brisa__icon\"><img src=\"https://cdn.shopify.com/s/files/1/0939/5752/1780/files/no-nicotine_0a7af6ed-56f4-4ca6-b69c-8aaa0c76d8ac.png\" alt=\"\" width=\"56\" height=\"56\" loading=\"lazy\"></span>\n        <p class=\"what-is-brisa__label\">No Nicotine, No Vapour,<br>No Smoke</p>\n      </div>\n    </div>\n  </div>\n</div>",
        "background_type": "full_width",
        "add_vertical_spacing": true,
        "background": "rgba(0,0,0,0)",
        "text_color": "rgba(0,0,0,0)"
      }
