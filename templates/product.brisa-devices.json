    "device_questions_PFtKdK": {
      "type": "device-questions",
      "blocks": {
        "question_hw4pbt": {
          "type": "question",
          "settings": {
            "question": "How does Brisa work?",
            "answer": "<p>Brisa uses aroma cores and a tactile ritual to replace the hand-to-mouth habit of vaping. You inhale clean air through a familiar motion, tricking your brain without the nicotine.</p>"
          }
        },
        "question_MA3EtX": {
          "type": "question",
          "settings": {
            "question": "Is there nicotine in Brisa?",
            "answer": "<p>No nicotine. No vapour. No combustion. Just food-grade flavour cores and the ritual your hands already know.</p>"
          }
        },
        "question_BWYAAp": {
          "type": "question",
          "settings": {
            "question": "How long does each core last?",
            "answer": "<p>Each core lasts 2.5 to 4 days depending on how often you reach for it and the aroma profile. The Starter Kit (9 cores) covers 3 to 5 weeks of ritual. The Mates Pack covers 3 to 5 weeks per person - 18 cores total, split across both devices.</p>"
          }
        },
        "question_YAKgfd": {
          "type": "question",
          "settings": {
            "question": "What if it doesn't work?",
            "answer": "<p>Every device is covered by the 30-Day Success Guarantee. If Brisa doesn't work in 30 days, we'll send you 3 weeks of cores FREE and book a 1-on-1 call. We don't stop until you've kicked the habit.</p>"
          }
        },
        "question_xtD9Vi": {
          "type": "question",
          "settings": {
            "question": "Can the Mates Pack ship to two addresses?",
            "answer": "<p>Yes. At checkout you'll enter two separate shipping addresses. Both devices are delivered independently.</p>"
          }
        },
        "question_m8ApTb": {
          "type": "question",
          "settings": {
            "question": "Is Brisa available outside Australia?",
            "answer": "<p>Currently we ship Australia-wide only, with free standard shipping on every order.</p>"
          }
        }
      },
