r::-webkit-scrollbar {\n  display: none;\n}\n.product-item {\n  min-width: 200px;\n  flex-shrink: 0;\n  text-align: center;\n}\n.product-item img {\n  width: 100%;\n  border-radius: 8px;\n  margin-bottom: 10px;\n}\n.product-item h3 {\n  font-size: 14px;\n  margin: 5px 0;\n}\n.product-item .price {\n  font-weight: bold;\n  color: #333;\n}\n.arrow {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  background: rgba(0,0,0,0.5);\n  color: white;\n  border: none;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  cursor: pointer;\n  font-size: 20px;\n  z-index: 10;\n}\n.arrow:hover {\n  background: rgba(0,0,0,0.8);\n}\n.arrow-left { left: 10px; }\n.arrow-right { right: 10px; }\n<\/style>\n\n<div class=\"product-carousel\">\n  <button class=\"arrow arrow-left\" onclick=\"scrollCarousel(-1)\">‹<\/button>\n  <div class=\"carousel-container\" id=\"carousel\">\n    {% assign cores_collection = collections['cores'] %}\n    {% for product in cores_collection.products %}\n      <div class=\"product-item\">\n        <a href=\"{{ product.url }}\">\n          <img src=\"{{ product.featured_image | img_url: '300x300' }}\" alt=\"{{ product.title }}\">\n          <h3>{{ product.title }}<\/h3>\n          <p class=\"price\">{{ product.price | money }}<\/p>\n        <\/a>\n      <\/div>\n    {% endfor %}\n  <\/div>\n  <button class=\"arrow arrow-right\" onclick=\"scrollCarousel(1)\">›<\/button>\n<\/div>\n\n<script>\nfunction scrollCarousel(direction) {\n  const carousel = document.getElementById('carousel');\n  const scrollAmount = 220;\n  carousel.scrollLeft += direction * scrollAmount;\n}\n<\/script>","background_type":"full_width","add_vertical_spacing":true,"background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)"}}},"order":["collection-banner","main","slideshow_FwwizV","custom_liquid_faBL88"]}