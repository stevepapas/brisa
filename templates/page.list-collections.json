e_4 | img_url: '150x150' }}\" alt=\"Sprout 4\">\n                <\/div>\n              {% endif %}\n            <\/div>\n\n            {% if product.metafields.custom.carousel_product_image %}\n              <img class=\"product-main-image\" src=\"{{ product.metafields.custom.carousel_product_image | img_url: '500x500' }}\" alt=\"{{ product.title }}\">\n            {% else %}\n              <img class=\"product-main-image\" src=\"{{ product.featured_image | img_url: '500x500' }}\" alt=\"{{ product.title }}\">\n            {% endif %}\n          <\/div>\n\n          <div class=\"product-info\">\n            <h3 class=\"product-title\">{{ product.title }}<\/h3>\n            <p class=\"product-price\">{{ product.price | money }}<\/p>\n          <\/div>\n      <\/a>  <\/div>\n      {% endfor %}\n    <\/div>\n\n    <button class=\"carousel-arrow carousel-arrow-right\" aria-label=\"Next\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n        <polyline points=\"9 18 15 12 9 6\"><\/polyline>\n      <\/svg>\n    <\/button>\n  <\/div>\n<\/div>","background_type":"full_width","add_vertical_spacing":true,"background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)"}},"custom_liquid_W4mPVT":{"type":"custom-liquid","name":"Cores","settings":{"subheading":"","title":"","liquid":"{% assign collection = collections['cores'] %}\n<div class=\"product-carousel-section\">\n{% assign featured_image = 'brisa-cores.png' | file_url %}\n<img class=\"image_heading\" src=\"{{ featured_image }}\" alt=\"Featured Products\" style=\"max-width: 100%; height: auto; display: block;\" \/>\n<div class=\"cores-product-page\">\n  <div class=\"carousel-container\">\n<h3 class=\"tex\" style=\"margin: 0px auto; padding-top: 30px; text-align: center\">CHOOSE FROM {{ collection.products_count }} FLAVOURS<\/h3>\n    <button class=\"carousel-arrow carousel-arrow-left\"  aria-label=\"Previous\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n        <pol