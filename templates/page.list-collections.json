        "liquid": "<div class=\"product-carousel-section\">\n{% assign featured_image = 'the-brisa.png' | file_url %}\n<img class=\"image_heading\" src=\"{{ featured_image }}\" alt=\"Featured Products\" style=\"max-width: 100%; height: auto; display: block;\" />\n{% assign collection = collections['brisas'] %}\n\n  <div class=\"carousel-container brisas\">\n<h3 class=\"tex\" style=\"margin: 0px auto; padding-top: 30px; text-align: center\">CHOOSE FROM {{ collection.products_count }} COLOURS</h3>\n    <button class=\"carousel-arrow carousel-arrow-left\"  aria-label=\"Previous\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n        <polyline points=\"15 18 9 12 15 6\"></polyline>\n      </svg>\n    </button>\n\n    <div class=\"product-carousel\" id=\"productCarousel\">\n      \n      {% for product in collection.products limit: 8 %}\n      <a href=\"{{ product.url }}\" class=\"product-card product-{{ product.handle }}\">\n          <div class=\"product-image-wrapper no-padding\">\n            <div class=\"fruit-elements\">\n              {% if product.metafields.custom.sprout_image_1 %}\n                <div class=\"fruit-element\">\n                  <img src=\"{{ product.metafields.custom.sprout_image_1 | img_url: '150x150' }}\" alt=\"Sprout 1\">\n                </div>\n              {% endif %}\n              \n              {% if product.metafields.custom.sprout_image_2 %}\n                <div class=\"fruit-element\">\n                  <img src=\"{{ product.metafields.custom.sprout_image_2 | img_url: '150x150' }}\" alt=\"Sprout 2\">\n                </div>\n              {% endif %}\n              \n              {% if product.metafields.custom.sprout_image_3 %}\n                <div class=\"fruit-element\">\n                  <img src=\"{{ product.metafields.custom.sprout_image_3 | img_url: '150x150' }}\" alt=\"Sprout 3\">\n                </div>\n              {% endif %}\n              \n              {% if product.metafields.custom.sprout_image_4 %}\n                <div class=\"fruit-element\">\n                  <img src=\"{{ product.metafields.custom.sprout_image_4 | img_url: '150x150' }}\" alt=\"Sprout 4\">\n                </div>\n              {% endif %}\n            </div>\n\n            {% if product.metafields.custom.carousel_product_image %}\n              <img class=\"product-main-image\" src=\"{{ product.metafields.custom.carousel_product_image | img_url: '500x500' }}\" alt=\"{{ product.title }}\">\n            {% else %}\n              <img class=\"product-main-image\" src=\"{{ product.featured_image | img_url: '500x500' }}\" alt=\"{{ product.title }}\">\n            {% endif %}\n          </div>\n\n          <div class=\"product-info\">\n            <h3 class=\"product-title\">{{ product.title }}</h3>\n            <p class=\"product-price\">{{ product.price | money }}</p>\n          </div>\n      </a>  \n      {% endfor %}\n    </div>\n\n    <button class=\"carousel-arrow carousel-arrow-right\" aria-label=\"Next\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n        <polyline points=\"9 18 15 12 9 6\"></polyline>\n      </svg>\n    </button>\n  </div>\n</div>",
