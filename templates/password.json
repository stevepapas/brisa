    "custom_liquid_JHFYBz": {
      "type": "custom-liquid",
      "custom_css": [
        "h2 {margin-bottom: 0px; font-size: 20px; text-transform: uppercase; line-height: 1.2;}",
        "h3 {margin-top: 0px; margin-bottom: 0px; text-transform: uppercase; line-height: 1; font-size: 12px;}"
      ],
      "name": "Select Better Core",
      "settings": {
        "subheading": "",
        "title": "",
        "liquid": "{% assign collection = collections['cores'] %}\n<div>\n<h2 class=\"bold tex text-center\">Select your Better Core</h2>\n<h3 class=\"tex text-center\">One Time Purchase or Subscription</h3>\n\n<div class=\"carousel-container brisas flavours\">\n    <button class=\"carousel-arrow carousel-arrow-left\"  aria-label=\"Previous\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n        <polyline points=\"15 18 9 12 15 6\"></polyline>\n      </svg>\n    </button>\n\n    <div class=\"product-carousel\" id=\"productCarousel\">\n      {% assign collection = collections['cores'] %}\n      {% for product in collection.products limit: 8 %}\n        <div class=\"product-card product-{{ product.handle }}\" style=\"background-size: cover; background-image: url({{ product.metafields.custom.carousel_background_gradient | img_url: '1000x1000' }});\">\n\n<a href=\"{{ product.url }}\">\n<div class=\"product-flavour\" style=\"text-align: center; color: white;width: 100%; top: 9px; position: absolute;\">{{product.metafields.custom.flavour}}</div>          \n<div class=\"product-image-wrapper\">\n            <div class=\"fruit-elements\">\n              {% if product.metafields.custom.sprout_image_1 %}\n                <div class=\"fruit-element\">\n                  <img src=\"{{ product.metafields.custom.sprout_image_1 | img_url: '150x150' }}\" alt=\"Sprout 1\">\n                </div>\n              {% endif %}\n              \n              {% if product.metafields.custom.sprout_image_2 %}\n                <div class=\"fruit-element\">\n                  <img src=\"{{ product.metafields.custom.sprout_image_2 | img_url: '150x150' }}\" alt=\"Sprout 2\">\n                </div>\n              {% endif %}\n              \n              {% if product.metafields.custom.sprout_image_3 %}\n                <div class=\"fruit-element\">\n                  <img src=\"{{ product.metafields.custom.sprout_image_3 | img_url: '150x150' }}\" alt=\"Sprout 3\">\n                </div>\n              {% endif %}\n              \n              {% if product.metafields.custom.sprout_image_4 %}\n                <div class=\"fruit-element\">\n                  <img src=\"{{ product.metafields.custom.sprout_image_4 | img_url: '150x150' }}\" alt=\"Sprout 4\">\n                </div>\n              {% endif %}\n            </div>\n\n            {% if product.metafields.custom.carousel_product_image %}\n              <img class=\"product-main-image\" src=\"{{ product.metafields.custom.carousel_product_image | img_url: '500x500' }}\" alt=\"{{ product.title }}\">\n            {% else %}\n              <img class=\"product-main-image\" src=\"{{ product.featured_image | img_url: '500x500' }}\" alt=\"{{ product.title }}\">\n            {% endif %}\n          </div>\n\n          <div class=\"product-info\">\n            <h3 class=\"product-title\">{{ product.title }}</h3>\n            <p class=\"product-price\">{{ product.price | money }}</p>\n          </div></a>\n        </div>\n      {% endfor %}\n    </div>\n\n    <button class=\"carousel-arrow carousel-arrow-right\" aria-label=\"Next\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n        <polyline points=\"9 18 15 12 9 6\"></polyline>\n      </svg>\n    </button>\n  </div>",
        "background_type": "full_width",
