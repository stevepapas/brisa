    "brisa_inside_cores": {
      "type": "brisa-inside-cores",
      "blocks": {
        "card_flavours": {
          "type": "card",
          "settings": {
            "image_asset": "brisa-inside-core-1.png",
            "heading": "The flavours you actually chase 🍒",
            "description": "Most alternatives leave you with a horrible aftertaste, or flavours nobody actually wants: cinnamon, liquorice, vanilla. We went the other way… the better way. Flavours you know and love, starting with fan favourites Cherry Pomegranate and Mixed Berry. And we're constantly developing new ones to make every draw better than the last."
          }
        },
        "card_formula": {
          "type": "card",
          "settings": {
            "image_asset": "brisa-inside-core-2.png",
            "heading": "The Brisa edge 🤫",
            "description": "Every great brand has a recipe nobody else gets. This is ours. Almost a year of R&D went into one blend of food-grade aroma and cooling compounds, and it stays locked away. It's why Brisa flavours hit bold from the first draw and last roughly 2–3 days per core. We put everything into the core, because it's the part that makes or breaks every draw."
          }
        },
        "card_hit": {
          "type": "card",
          "settings": {
            "image_asset": "brisa-inside-core-3.png",
            "heading": "The hit isn't an accident 🌀",
            "description": "It's different to smoke or vapour, obviously. Where we put our focus is the detail of the throat feel. Our aroma compound blends are built heavily around a throat sensation and cooling, refined through extensive development to give you the experience you're reaching for. Our R&D is extensive and runs nearly 24/7, and our commitment is to keep improving the formula so every core feels as familiar as we can make it. Zero nicotine. Zero smoke. Zero vapour."
          }
        },
        "card_food_grade": {
          "type": "card",
          "settings": {
            "image_asset": "brisa-inside-core-4.png",
            "heading": "What's actually in a Brisa core? 🔍",
            "description": "People always ask, so here it is, in plain terms. Every Brisa core is built from three things: a food-grade fibre core, food-grade aroma compounds, and our cooling effect layer. The core material is independently lab tested. Nothing is burned, heated or charged, and there's no nicotine, no tobacco, no e-liquid, no battery, no smoke and no vapour. We take what goes into the core seriously. The exact blend stays ours, but we're always happy to answer questions about what's in it. Message us and a real person replies."
          }
        }
      },
      "block_order": [
        "card_flavours",
        "card_formula",
        "card_hit",
        "card_food_grade"
      ],
