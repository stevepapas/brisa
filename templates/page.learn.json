    "learn_faq": {
      "type": "learn-faq",
      "blocks": {
        "faq_safe": {
          "type": "question",
          "settings": {
            "question": "Is Brisa safe?",
            "answer": "<p>Brisa is a non-consumption product. There is no smoke, no vapour, no nicotine, no heating, no battery, and no e-liquid.</p><p>It works through air pressure and aroma only. You breathe air through the aromatic core to create the sensory draw, without burning, vaporising, or consuming anything.</p>"
          }
        },
        "faq_habit": {
          "type": "question",
          "settings": {
            "question": "Will it actually help me drop the habit?",
            "answer": "<p>Brisa is designed for the moment, especially when you are trying to move away from smoking or vaping and the urge hits.</p><p>Instead of going back to nicotine, you use Brisa as the replacement action. It mimics the old habit with a familiar weight, size, look, aroma, hand-to-mouth feel, and draw pressure — but without smoke, vapour, or nicotine.</p>"
          }
        },
        "faq_cores": {
          "type": "question",
          "settings": {
            "question": "How long do the cores last?",
            "answer": "<p>Each core lasts 2.5 to 4 days depending on how often you reach for it and the aroma profile. The Starter Kit covers 3 to 5 weeks of ritual.</p>"
          }
        },
        "faq_flavours": {
          "type": "question",
          "settings": {
            "question": "What flavours do you have?",
            "answer": "<p>Brisa cores come in familiar aroma profiles including Mint, and other food-grade aromatic options designed to feel natural and recognisable.</p>"
          }
        },
        "faq_guarantee": {
          "type": "question",
          "settings": {
            "question": "What's in the 30-day success guarantee?",
            "answer": "<p>If you need extra support within your first 30 days, we will book a 1-on-1 call, talk through your current routine, and help build a better strategy.</p><p>We will also send you 3 packs of Better Cores for free to help kick-start the new strategy, valued at $45.</p>"
          }
        }
      },
