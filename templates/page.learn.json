    "learn_faq": {
      "type": "learn-faq",
      "blocks": {
        "faq_satisfy": {
          "type": "question",
          "settings": {
            "question": "Be honest... will it actually satisfy me?",
            "answer": "<p>Brisa is built for the moment the urge hits \u2014 familiar weight, size, hand-to-mouth feel, draw pressure, and aroma \u2014 without nicotine, smoke, or vapour. It replaces the ritual action, not with another nicotine product.</p>"
          }
        },
        "faq_vape": {
          "type": "question",
          "settings": {
            "question": "Isn't it just a vape without the nicotine?",
            "answer": "<p>No. There is no heating, no battery, no e-liquid, and no vapour. You draw air through a food-grade aroma core. Same ritual cues \u2014 completely different mechanism.</p>"
          }
        },
        "faq_pens": {
          "type": "question",
          "settings": {
            "question": "Isn't it like those wooden pens that just blow air?",
            "answer": "<p>Those miss what makes the ritual land. Brisa is built around weight, size, look, calibrated airflow, throat sensation, and aroma profiles people actually recognise \u2014 not just empty air through a stick.</p>"
          }
        },
        "faq_gums": {
          "type": "question",
          "settings": {
            "question": "I've tried gums and patches, how is this different?",
            "answer": "<p>Gums and patches address nicotine chemically. Brisa targets the hand-to-mouth ritual itself \u2014 the reach, the draw, the sensory pause \u2014 so you have something to do in the moment without going back to nicotine.</p>"
          }
        },
        "faq_inhale": {
          "type": "question",
          "settings": {
            "question": "Is it actually safe to inhale? What am I breathing in?",
            "answer": "<p>Brisa is a non-consumption product. There is no smoke, no vapour, no nicotine, no heating, no battery, and no e-liquid. You breathe air through a PET fibre core with food-grade aroma compounds \u2014 no burning and no vaporising.</p>"
          }
        },
        "faq_cost": {
          "type": "question",
          "settings": {
            "question": "Won't the cores run out and cost me forever?",
            "answer": "<p>Each core lasts about 2.5 to 4 days depending on use and aroma. The Starter Kit covers roughly 3 to 5 weeks of ritual. Compared with ongoing vape spend, cores are a fraction of the monthly bill.</p>"
          }
        },
        "faq_work": {
          "type": "question",
          "settings": {
            "question": "Can I use it at work and around people?",
            "answer": "<p>Yes. There is no smoke, no vapour, and no lingering smell like cigarettes or disposables. It is designed for everyday routines \u2014 work, pubs, worksites \u2014 without the social friction of vaping.</p>"
          }
        },
        "faq_gimmick": {
          "type": "question",
          "settings": {
            "question": "Is this just a gimmick \u2014 will it really work?",
            "answer": "<p>Brisa is designed for the urge moment: same motion, different story. If it is not landing in your first 30 days, claim the Success Guarantee \u2014 we send a Brisa Strategy Guide with the exact tweak to try, plus 6 free cores (2 packs) the same week.</p>"
          }
        }
      },
