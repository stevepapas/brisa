# Brisa store (.myshopify.com host, not the public domain)
SHOP=whsuhd-8u.myshopify.com

# Dev Dashboard → Brisa Admin → Settings
CLIENT_ID=
CLIENT_SECRET=

# Optional: primary stock location for Better Box core decrements
# LOCATION_ID=gid://shopify/Location/…

# Optional overrides
# BETTER_BOX_HANDLE=monthly-better-box
# CORES_HANDLE=brisa-cores
# CHERRY_QTY=1
# SHOPIFY_API_VERSION=2025-01

# Brisa Admin scopes needed for Better Box / Variety inventory CLI:
#   write_products, read_orders, write_inventory, read_inventory, read_locations
