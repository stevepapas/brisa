<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.page_background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box {
    color: {{ section.settings.text_color }};
    text-align: center;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__ribbon-wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .black-ribbon-blue-box__panel {
      padding: 0;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__panel-inner {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 80px 44px 80px;
    }
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__ribbon {
    padding: 22px 28px;
    color: {{ section.settings.ribbon_text_color }};
    background: {{ section.settings.ribbon_background }};
    font-size: {{ section.settings.ribbon_size }}px;
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__panel {
    padding: 80px 44px 80px;
    background: {{ section.settings.box_background }};
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__heading {
    max-width: 860px;
    margin: 0 auto 12px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 1.28;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__subheading {
    margin: 0 auto;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: 900;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__subheading strong,
  #shopify-section-{{ section.id }} .black-ribbon-blue-box__subheading a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 12px auto 32px;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__stars {
    display: inline-flex;
    gap: 8px;
    color: {{ section.settings.star_color }};
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__star {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__star svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__rating-text {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.rating_size }}px;
    font-weight: 900;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__badge {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 6px 28px;
    color: {{ section.settings.badge_text_color }};
    background: {{ section.settings.badge_background }};
    border-radius: {{ section.settings.badge_radius }}px;
    font-size: {{ section.settings.badge_size }}px;
    font-weight: 900;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 820px;
    min-height: 92px;
    margin: 0 auto 24px;
    padding: 20px 34px;
    color: {{ section.settings.button_text_color }} !important;
    background: {{ section.settings.button_background }};
    border-radius: 50%;
    font-size: {{ section.settings.button_size }}px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.04em;
    text-decoration: none !important;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .black-ribbon-blue-box__benefits {
    margin: 0;
    color: {{ section.settings.benefits_color }};
    font-size: {{ section.settings.benefits_size }}px;
    font-weight: 900;
    line-height: 1.25;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__ribbon-wrap {
      padding: 0;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__ribbon {
      padding: 16px 18px;
      font-size: {{ section.settings.ribbon_size | times: 0.7 | round }}px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__panel {
      padding: 50px 22px 52px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__heading {
      font-size: {{ section.settings.heading_size | times: 0.62 | round }}px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__subheading {
      font-size: {{ section.settings.subheading_size | times: 0.7 | round }}px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__rating {
      gap: 8px;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__star {
      width: {{ section.settings.star_size | times: 0.72 | round }}px;
      height: {{ section.settings.star_size | times: 0.72 | round }}px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__rating-text {
      font-size: {{ section.settings.rating_size | times: 0.78 | round }}px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__badge {
      padding-inline: 18px;
      font-size: {{ section.settings.badge_size | times: 0.82 | round }}px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__button {
      min-height: 70px;
      margin-bottom: 20px;
      font-size: {{ section.settings.button_size | times: 0.7 | round }}px;
    }

    #shopify-section-{{ section.id }} .black-ribbon-blue-box__benefits {
      font-size: {{ section.settings.benefits_size | times: 0.72 | round }}px;
    }
  }
</style>

{% liquid
  assign ribbon_text = section.settings.ribbon_text | strip
%}

<section class="black-ribbon-blue-box" {{ section.shopify_attributes }}>
  <div class="black-ribbon-blue-box__ribbon-wrap">
    {% if ribbon_text != blank %}
      <div class="black-ribbon-blue-box__ribbon">{{ ribbon_text | escape }}</div>
    {% endif %}
  </div>

  <div class="black-ribbon-blue-box__panel">
    <div class="black-ribbon-blue-box__panel-inner">
    {% if section.settings.heading != blank %}
      <h2 class="black-ribbon-blue-box__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="black-ribbon-blue-box__subheading">{{ section.settings.subheading }}</div>
    {% endif %}

    {% if section.settings.show_rating %}
      <div class="black-ribbon-blue-box__rating" aria-label="{{ section.settings.rating_label | escape }}">
        <span class="black-ribbon-blue-box__stars" aria-hidden="true">
          {% for star in (1..5) %}
            <span class="black-ribbon-blue-box__star">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="m12 1.9 3.1 6.2 6.9 1-5 4.9 1.2 6.9-6.2-3.2-6.2 3.2L7 14 2 9.1l6.9-1L12 1.9Z" />
              </svg>
            </span>
          {% endfor %}
        </span>

        {% if section.settings.rating_text != blank %}
          <span class="black-ribbon-blue-box__rating-text">{{ section.settings.rating_text | escape }}</span>
        {% endif %}

        {% if section.settings.badge_text != blank %}
          <span class="black-ribbon-blue-box__badge">{{ section.settings.badge_text | escape }}</span>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a class="black-ribbon-blue-box__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_text | escape }}
      </a>
    {% endif %}

    {% if section.settings.benefits != blank %}
      <p class="black-ribbon-blue-box__benefits">{{ section.settings.benefits | escape }}</p>
    {% endif %}
    </div>
  </div>
</section>

