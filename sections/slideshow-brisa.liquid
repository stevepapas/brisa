{%- capture active_kit_set -%}{%- render 'brisa-active-kit-set', product: product, section: section -%}{%- endcapture -%}
{%- assign active_kit_set = active_kit_set | strip | default: 'all' -%}

{%- if request.design_mode and section.settings.editor_preview_kit != 'auto' and section.settings.editor_preview_kit != blank -%}
  {%- assign active_kit_set = section.settings.editor_preview_kit -%}
{%- endif -%}

{%- liquid
  assign visible_blocks_count = 0
  assign first_visible_block = blank

  for block in section.blocks
    assign block_kit_set = block.settings.kit_set | default: 'both'
    assign block_matches = false

    if active_kit_set == 'all' or block_kit_set == 'both' or block_kit_set == active_kit_set
      assign block_matches = true
    endif

    if block_matches
      assign visible_blocks_count = visible_blocks_count | plus: 1
      if first_visible_block == blank
        assign first_visible_block = block
      endif
    endif
  endfor

  assign progress_block = first_visible_block | default: section.blocks.first
  assign frame_height_percent = section.settings.frame_height_percent | default: 100

  assign slideshow_product_gallery = false
  if template.name == 'product'
    if template.suffix == 'brisa-devices' or template.suffix == 'brisa-devices-variations' or template.suffix == 'brisa-cores' or template.suffix == 'brisa-cores-variations'
      assign slideshow_product_gallery = true
    endif
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --progress-bar-color: {{ progress_block.settings.text_color.red }}, {{ progress_block.settings.text_color.green }}, {{ progress_block.settings.text_color.blue }};
    --section-autoplay-duration: {% if section.settings.autoplay %}{{ section.settings.cycle_speed }}s{% else %}0s{% endif %};
    --section-animation-play-state: paused;
    --slideshow-brisa-thumb-size: {{ section.settings.thumbnail_size }}px;
    /* Cap radius so small mobile thumbs stay rounded squares (not near-circles). */
    --slideshow-brisa-thumb-radius: min(
      {{ section.settings.thumbnail_radius | default: 15 }}px,
      calc(var(--slideshow-brisa-thumb-size) * 0.25)
    );
    --slideshow-brisa-frame-ratio: 100 / {{ frame_height_percent }};
    background-color: {{ section.settings.background }}; /* Allows to set a placeholder color while loading */
  }

  {%- for block in section.blocks -%}
    {%- assign text_position = block.settings.text_position | split: '_' | first -%}
    {%- assign image_focal = block.settings.image_focal_point | default: 'center_center' | replace: '_', ' ' -%}

    #block-{{ section.id }}-{{ block.id }} .slideshow__image-wrapper .slideshow__image,
    #block-{{ section.id }}-{{ block.id }} .slideshow__image-wrapper .slideshow__image--placeholder {
      object-position: {{ image_focal }};
    }

    {%- case text_position -%}
      {%- when 'top' -%}
        {%- assign section_items_alignment = 'flex-start' -%}
      {%- when 'middle' -%}
        {%- assign section_items_alignment = 'center' -%}
      {%- when 'bottom' -%}
        {%- assign section_items_alignment = 'flex-end' -%}
    {%- endcase -%}

    #block-{{ section.id }}-{{ block.id }} {
      --heading-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --text-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --primary-button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};
      --primary-button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};

      --section-blocks-alignment: {{ section_items_alignment }};
      --section-blocks-overlay-color: {{ block.settings.overlay_color.red }}, {{ block.settings.overlay_color.green }}, {{ block.settings.overlay_color.blue }};
      --section-blocks-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    }

    {%- if block.settings.show_image_overlay -%}
      #block-{{ section.id }}-{{ block.id }} .slideshow__image-wrapper::before {
        display: block !important;
        background: rgba({{ block.settings.overlay_color.red }}, {{ block.settings.overlay_color.green }}, {{ block.settings.overlay_color.blue }}, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) !important;
        pointer-events: none;
        z-index: 1;
      }
    {%- else -%}
      #block-{{ section.id }}-{{ block.id }} .slideshow__image-wrapper::before {
        display: none !important;
      }
    {%- endif -%}
  {%- endfor -%}

  #shopify-section-{{ section.id }} .slideshow-brisa__nav-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 14px 20px 18px;
    background: {{ section.settings.nav_background }};
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    min-height: 0;
    width: 100%;
    max-width: 100%;
    overflow: visible;
    visibility: visible;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} page-dots.slideshow-brisa__dots {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: static;
    inset: auto;
    min-height: 0;
    pointer-events: auto;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__dots {
    display: flex;
    flex: 0 1 auto;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.thumbnail_gap }}px;
    width: max-content;
    max-width: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: none;
    scrollbar-width: none;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__dots::-webkit-scrollbar {
    display: none;
  }

  {%- if slideshow_product_gallery -%}
    #shopify-section-{{ section.id }} .slideshow-brisa {
      --slideshow-min-height: 0;
      display: flex;
      flex-direction: column;
      min-height: 0;
      height: auto;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide-list,
    #shopify-section-{{ section.id }} .slideshow-brisa__stage .slideshow__slide-list {
      position: relative;
      flex: 0 0 auto;
      width: 100%;
      aspect-ratio: var(--slideshow-brisa-frame-ratio, 1 / 1);
      min-height: 0 !important;
      max-height: none !important;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-height: 100% !important;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide-inner {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-height: 100% !important;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide-inner::before {
      display: none;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__image-wrapper,
    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__image {
      width: 100%;
      height: 100%;
    }

  #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__image {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide[id$="-image_device6"] .slideshow__image {
    object-fit: contain;
    background: #b7e0f4;
  }
  {%- else -%}
    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide-list {
      position: relative;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .slideshow__slide-inner::before {
      display: none;
    }

    #shopify-section-{{ section.id }} .slideshow__image {
      object-fit: cover;
      object-position: center;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide[hidden] {
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide:not([hidden]) {
    z-index: 1;
  }

  /* Rounded squares — never circles (no 50% / clip-path circle). */
  #shopify-section-{{ section.id }} .slideshow-brisa__thumb {
    position: relative;
    display: block;
    flex: 0 0 var(--slideshow-brisa-thumb-size);
    flex-shrink: 0;
    scroll-snap-align: center;
    width: var(--slideshow-brisa-thumb-size) !important;
    min-width: var(--slideshow-brisa-thumb-size) !important;
    max-width: var(--slideshow-brisa-thumb-size) !important;
    height: var(--slideshow-brisa-thumb-size) !important;
    min-height: var(--slideshow-brisa-thumb-size) !important;
    max-height: var(--slideshow-brisa-thumb-size) !important;
    aspect-ratio: 1 / 1 !important;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 2px solid #e0e0e0;
    border-radius: var(--slideshow-brisa-thumb-radius) !important;
    background-color: #ececec;
    cursor: pointer;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
    line-height: 0;
    clip-path: none !important;
    -webkit-clip-path: none !important;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__thumb[aria-current="true"] {
    border-color: {{ section.settings.thumbnail_active_border }};
    box-shadow: 0 0 0 1px {{ section.settings.thumbnail_active_border }};
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__thumb img,
  #shopify-section-{{ section.id }} .slideshow-brisa__thumb-image {
    display: block;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover;
    object-position: center;
    border-radius: var(--slideshow-brisa-thumb-radius) !important;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__thumb-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: #d0d0d0;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #008bdc;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.28));
    cursor: pointer;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__video-play:hover {
    transform: translate(-50%, -50%) scale(1.07);
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.34));
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__video-play:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__video-play svg {
    display: block;
    width: 76px;
    height: 76px;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__inline-video {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .slideshow__slide.is-playing-video .slideshow__image-wrapper,
  #shopify-section-{{ section.id }} .slideshow__slide.is-playing-video .slideshow-brisa__video-play {
    visibility: hidden;
  }

  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} .slideshow-brisa__video-play,
    #shopify-section-{{ section.id }} .slideshow-brisa__video-play svg {
      width: 64px;
      height: 64px;
    }
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__arrow {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: {{ section.settings.arrow_background }};
    color: {{ section.settings.arrow_color }};
    cursor: pointer;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__arrow svg {
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .slideshow-brisa__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  {%- if section.settings.desktop_layout == 'square' -%}
    #shopify-section-{{ section.id }} {
      --slideshow-brisa-desktop-size: {{ section.settings.desktop_max_width }}px;
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop slide-show.slideshow-brisa,
      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__slide-list {
        min-height: 0 !important;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop slide-show.slideshow-brisa {
        --slideshow-min-height: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        height: auto;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__slide-list {
        position: relative;
        flex: 0 0 auto;
        width: min(var(--slideshow-brisa-desktop-size, 520px), 100%) !important;
        max-width: 100%;
        margin-inline: auto;
        aspect-ratio: var(--slideshow-brisa-frame-ratio, 1 / 1);
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        min-height: 100% !important;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__slide-inner {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        min-height: 100% !important;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__slide-inner::before {
        display: none;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__image-wrapper,
      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__image {
        width: 100%;
        height: 100%;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__image {
        object-fit: {{ section.settings.desktop_image_fit }};
        object-position: center;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow-brisa__nav-bar {
        width: 100%;
        max-width: min(calc(var(--slideshow-brisa-desktop-size, 520px) + (2 * var(--slideshow-brisa-peek-size, 84px)) + (2 * var(--slideshow-brisa-peek-gap, 12px))), 100%);
        margin-inline: auto;
      }
    }
  {%- endif -%}

  {%- if slideshow_product_gallery -%}
    @media screen and (max-width: 999px) {
      #shopify-section-{{ section.id }} {
        overflow-x: clip;
        max-width: 100%;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa__stage .slideshow__slide-list {
        width: calc(100% - (2 * var(--slideshow-brisa-peek-size)) - (2 * var(--slideshow-brisa-peek-gap))) !important;
        max-width: calc(100% - (2 * var(--slideshow-brisa-peek-size)) - (2 * var(--slideshow-brisa-peek-gap)));
        aspect-ratio: var(--slideshow-brisa-frame-ratio, 1 / 1);
      }

      #shopify-section-{{ section.id }} .slideshow__image {
        object-fit: cover;
        object-position: center;
      }
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .slideshow__slide-inner .content-box {
      margin-inline-start: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      {%- if slideshow_product_gallery and visible_blocks_count > 0 -%}
        --slideshow-brisa-thumb-size: min(
          {{ section.settings.thumbnail_size | times: 0.78 | round }}px,
          calc((100vw - 124px - {{ section.settings.thumbnail_gap | times: visible_blocks_count | minus: 1 }}px) / {{ visible_blocks_count }})
        );
      {%- else -%}
        --slideshow-brisa-thumb-size: {{ section.settings.thumbnail_size | times: 0.78 | round }}px;
      {%- endif -%}
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__nav-bar {
      gap: 10px;
      padding: 12px 14px 14px;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__arrow {
      width: 38px;
      height: 38px;
    }
  }

  {%- if slideshow_product_gallery -%}
    /* Canva-style adjacent-slide peeks (product gallery only — not homepage hero) */
    #shopify-section-{{ section.id }} .slideshow-brisa__stage {
      --slideshow-brisa-peek-size: 18px;
      --slideshow-brisa-peek-gap: 8px;
      --slideshow-brisa-peek-opacity: 1;
      --slideshow-brisa-slide-radius: 18px;
      display: flex;
      align-items: stretch;
      gap: var(--slideshow-brisa-peek-gap);
      width: 100%;
      max-width: 100%;
      overflow: hidden;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__stage .slideshow__slide-list {
      flex: 1 1 auto;
      min-width: 0;
      width: calc(100% - (2 * var(--slideshow-brisa-peek-size)) - (2 * var(--slideshow-brisa-peek-gap))) !important;
      max-width: calc(100% - (2 * var(--slideshow-brisa-peek-size)) - (2 * var(--slideshow-brisa-peek-gap)));
      border-radius: var(--slideshow-brisa-slide-radius);
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__peek {
      flex: 0 0 var(--slideshow-brisa-peek-size);
      width: var(--slideshow-brisa-peek-size);
      min-width: var(--slideshow-brisa-peek-size);
      position: relative;
      overflow: hidden;
      opacity: var(--slideshow-brisa-peek-opacity);
      background: #0b3a66;
      cursor: pointer;
      align-self: stretch;
      padding: 0;
      border: 0;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__peek--prev {
      border-radius: 0 var(--slideshow-brisa-slide-radius) var(--slideshow-brisa-slide-radius) 0;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__peek--next {
      border-radius: var(--slideshow-brisa-slide-radius) 0 0 var(--slideshow-brisa-slide-radius);
    }

    /* Empty peek slots stay in the flex row (white gutter) so the main slide never shifts. */
    #shopify-section-{{ section.id }} .slideshow-brisa__peek.is-empty,
    #shopify-section-{{ section.id }} .slideshow-brisa__peek[hidden] {
      display: block !important;
      visibility: visible;
      pointer-events: none;
      cursor: default;
      opacity: 1;
      background: #fff;
      border-radius: 0;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__peek.is-empty .slideshow-brisa__peek-image,
    #shopify-section-{{ section.id }} .slideshow-brisa__peek[hidden] .slideshow-brisa__peek-image {
      visibility: hidden;
      opacity: 0;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__peek-image {
      display: block;
      width: 220%;
      max-width: none;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__peek--prev .slideshow-brisa__peek-image {
      object-position: right center;
      margin-inline-start: auto;
      margin-inline-end: 0;
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__peek--next .slideshow-brisa__peek-image {
      object-position: left center;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .slideshow-brisa__stage {
        --slideshow-brisa-peek-size: 28px;
      }
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .slideshow-brisa__stage {
        --slideshow-brisa-peek-size: 84px;
        --slideshow-brisa-peek-gap: 12px;
        --slideshow-brisa-peek-opacity: 0.1;
        --slideshow-brisa-slide-radius: 20px;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow-brisa__stage {
        width: min(calc(var(--slideshow-brisa-desktop-size, 520px) + (2 * var(--slideshow-brisa-peek-size)) + (2 * var(--slideshow-brisa-peek-gap))), 100%);
        margin-inline: auto;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow-brisa__stage .slideshow__slide-list {
        width: min(var(--slideshow-brisa-desktop-size, 520px), calc(100% - (2 * var(--slideshow-brisa-peek-size)) - (2 * var(--slideshow-brisa-peek-gap)))) !important;
        max-width: min(var(--slideshow-brisa-desktop-size, 520px), calc(100% - (2 * var(--slideshow-brisa-peek-size)) - (2 * var(--slideshow-brisa-peek-gap))));
        margin-inline: 0;
      }
    }

    /* Native gallery track at every breakpoint. The complete current slide
       travels out while the next complete slide enters on the same track. */
    #shopify-section-{{ section.id }} .slideshow-brisa__stage .slideshow__slide-list {
      display: flex;
      gap: 4px;
      overflow-x: auto;
      overflow-y: hidden;
      box-sizing: border-box;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      touch-action: pan-y;
      cursor: grab;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__stage .slideshow__slide-list.is-dragging {
      scroll-behavior: auto;
      scroll-snap-type: none;
      cursor: grabbing;
      user-select: none;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa__stage .slideshow__slide-list::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide,
    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide[hidden],
    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide:not([hidden]) {
      position: relative !important;
      inset: auto !important;
      display: block !important;
      flex: 0 0 calc(100% - 4px);
      width: calc(100% - 4px);
      height: 100%;
      min-height: 100% !important;
      overflow: hidden;
      border-radius: var(--slideshow-brisa-slide-radius);
      clip-path: none !important;
      visibility: visible !important;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      z-index: auto;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide {
      opacity: 0.1;
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .slideshow-brisa__stage {
        display: block;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa__peek,
      #shopify-section-{{ section.id }} .slideshow-brisa__peek.is-empty,
      #shopify-section-{{ section.id }} .slideshow-brisa__peek[hidden] {
        display: none !important;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow-brisa__stage .slideshow__slide-list {
        width: 100% !important;
        max-width: 100%;
        height: var(--slideshow-brisa-desktop-size, 520px);
        aspect-ratio: auto;
        padding-inline: calc(var(--slideshow-brisa-peek-size) + var(--slideshow-brisa-peek-gap));
        border-radius: 0;
        scroll-padding-inline: calc(var(--slideshow-brisa-peek-size) + var(--slideshow-brisa-peek-gap));
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__slide,
      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__slide[hidden],
      #shopify-section-{{ section.id }} .slideshow-brisa-section--square-desktop .slideshow__slide:not([hidden]) {
        flex: 0 0 var(--slideshow-brisa-desktop-size, 520px) !important;
        width: var(--slideshow-brisa-desktop-size, 520px) !important;
        height: var(--slideshow-brisa-desktop-size, 520px);
        min-height: var(--slideshow-brisa-desktop-size, 520px) !important;
        aspect-ratio: 1 / 1;
      }
    }

    @media screen and (max-width: 999px) {
      #shopify-section-{{ section.id }} .slideshow-brisa__stage {
        display: block;
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa__peek {
        display: none !important;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa__stage .slideshow__slide-list {
        width: 100% !important;
        max-width: 100%;
        padding-inline: 15px;
        border-radius: 0;
        scroll-padding-inline: 15px;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa .slideshow__slide {
        opacity: 1 !important;
      }
    }
  {%- else -%}
    /* Homepage hero: centred, same width as What is Brisa panel (800px on desktop) */
    #shopify-section-{{ section.id }} .slideshow-brisa-section--hero .slideshow-brisa__stage {
      display: block;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding-inline: var(--container-gutter);
      box-sizing: border-box;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .slideshow-brisa-section--hero .slideshow__slide-list {
      width: 100% !important;
      max-width: 800px;
      margin-inline: auto;
      overflow: hidden;
      border-radius: 18px;
    }

    @media screen and (min-width: 800px) {
      #shopify-section-{{ section.id }} .slideshow-brisa-section--hero .slideshow-brisa__stage {
        padding-inline: 0;
      }

      #shopify-section-{{ section.id }} .slideshow-brisa-section--hero .slideshow__slide-list {
        width: min(800px, 100%) !important;
        border-radius: 0;
      }
    }
  {%- endif -%}
</style>

<section
  class="section section--flush{% unless slideshow_product_gallery %} slideshow-brisa-section--hero{% endunless %}{% if section.settings.desktop_layout == 'square' %} slideshow-brisa-section--square-desktop{% endif %}"
  data-brisa-native-gallery="{{ slideshow_product_gallery }}"
  data-active-kit-set="{{ active_kit_set }}"
  data-starter-handle-prefix="{{ section.settings.starter_handle_prefix | default: 'brisa-device-' | escape }}"
  data-starter-handle="{{ section.settings.starter_handle | escape }}"
  data-mates-handle="{{ section.settings.mates_handle | escape }}"
>
  <slide-show {% if section.settings.show_initial_transition %}reveal-on-scroll{% endif %} {% if section.settings.autoplay %}auto-play{% endif %} transition-type="{{ section.settings.transition_type | escape }}" class="slideshow slideshow-brisa slideshow--{{ section.settings.section_height }}">
    <div class="slideshow-brisa__stage">
    {%- if slideshow_product_gallery and visible_blocks_count > 1 -%}
      <button type="button" class="slideshow-brisa__peek slideshow-brisa__peek--prev" data-slideshow-brisa-peek-prev aria-label="{{ 'general.accessibility.previous' | t }}">
        <img class="slideshow-brisa__peek-image" data-slideshow-brisa-peek-prev-image alt="" width="200" height="400" decoding="async">
      </button>
    {%- endif -%}
    <div class="slideshow__slide-list">
      {%- assign visible_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_kit_set = block.settings.kit_set | default: 'both'
          assign block_matches = false

          if active_kit_set == 'all' or block_kit_set == 'both' or block_kit_set == active_kit_set
            assign block_matches = true
          endif
        -%}

        {%- unless block_matches -%}
          {%- continue -%}
        {%- endunless -%}

        {%- assign visible_index = visible_index | plus: 1 -%}
        {%- assign is_first_visible = false -%}
        {%- if visible_index == 1 -%}
          {%- assign is_first_visible = true -%}
        {%- endif -%}
        {%- comment -%}
        ------------------------------------------------------------------------------------------------------------------
        IMAGE PART
        ------------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- liquid
          assign image = block.settings.image
          assign image_asset = block.settings.image_asset | strip
          assign image_aspect_ratio = image.aspect_ratio | default: 1
          assign video_src = blank
          assign video_type = 'iframe'

          if block.settings.video != blank
            for video_source in block.settings.video.sources
              if video_source.format == 'mp4'
                assign video_src = video_source.url
                break
              endif
            endfor

            if video_src == blank
              assign video_src = block.settings.video.sources.first.url
            endif

            assign video_type = 'html5'
          elsif block.settings.video_url != blank
            assign video_src = block.settings.video_url
          elsif block.settings.video_asset != blank
            assign video_src = block.settings.video_asset | asset_url
            assign video_type = 'html5'
          endif
        -%}

        {%- if visible_index > 2 -%}
          {%- assign loading_attribute_value = 'lazy' -%}
        {%- else -%}
          {%- assign loading_attribute_value = 'eager' -%}
        {%- endif -%}

        {%- liquid
          if section.settings.desktop_layout == 'square'
            assign slide_image_sizes = '(min-width: 1000px) 520px, 100vw'
          elsif slideshow_product_gallery
            assign slide_image_sizes = '100vw'
          else
            assign slide_image_sizes = '(min-width: 800px) 800px, 100vw'
          endif
        -%}

        {%- capture slide_content -%}
          <div class="slideshow__image-wrapper{% if block.settings.show_image_overlay %} slideshow__image-wrapper--has-overlay{% endif %}" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or is_first_visible == false %}reveal-visibility{% endif %}>
            {%- if image != blank -%}
              {{- image | image_url: width: 3000 | image_tag: loading: loading_attribute_value, draggable: false, class: 'slideshow__image', sizes: slide_image_sizes, widths: '400,600,800,1000,1200,1600,2000,2400,3000' -}}
            {%- elsif image_asset != blank -%}
              <img
                class="slideshow__image"
                src="{{ image_asset | asset_url }}"
                alt=""
                loading="{{ loading_attribute_value }}"
                draggable="false"
                sizes="{{ slide_image_sizes }}"
                width="1000"
                height="1000"
              >
            {%- else -%}
              {% capture image_name %}lifestyle-{% cycle '1', '2' %}{%- endcapture -%}
              {{- image_name | placeholder_svg_tag: 'slideshow__image slideshow__image--placeholder' -}}
            {%- endif -%}
          </div>

          {%- if video_src != blank -%}
            <button
              type="button"
              class="slideshow-brisa__video-play"
              data-brisa-video-src="{{ video_src | escape }}"
              data-brisa-video-type="{{ video_type }}"
              data-brisa-video-aspect="{{ block.settings.video_aspect | default: 'landscape' }}"
              aria-label="{{ block.settings.video_label | default: 'Play video' | escape }}"
            >
              {%- render 'icon' with 'play', width: 76, height: 76 -%}
            </button>
          {%- endif -%}

          {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          CONTENT PART
          ----------------------------------------------------------------------------------------------------------------
          {%- endcomment -%}

          {%- liquid
            assign slide_subheading = block.settings.subheading | strip_html | strip
            assign slide_title = block.settings.title | strip_html | strip
            assign slide_content = block.settings.content | strip_html | strip
          -%}

          {%- capture section_content -%}
            {%- if slide_subheading != blank -%}
              <h2 class="heading heading--small">
                <split-lines {% if section.settings.transition_type != 'fade' and section.settings.show_initial_transition or is_first_visible == false %}reveal{% endif %}>{{ block.settings.subheading | escape }}</split-lines>
              </h2>
            {%- endif -%}

            {%- if slide_title != blank -%}
              <h3 class="heading heading--large">
                <split-lines {% if section.settings.transition_type != 'fade' and section.settings.show_initial_transition or is_first_visible == false %}reveal{% endif %}>{{ block.settings.title }}</split-lines>
              </h3>
            {%- endif -%}

            {%- if slide_content != blank -%}
              <p class="content">
                <split-lines {% if section.settings.transition_type != 'fade' and section.settings.show_initial_transition or is_first_visible == false %}reveal{% endif %}>{{ block.settings.content }}</split-lines>
              </p>
            {%- endif -%}

            {%- capture buttons -%}
              {%- if block.settings.button_1_text != blank -%}
                <a href="{{ block.settings.button_1_link }}" class="button button--primary">{{ block.settings.button_1_text | escape }}</a>
              {%- endif -%}

              {%- if block.settings.button_2_text != blank -%}
                <a href="{{ block.settings.button_2_link }}" class="button button--primary">{{ block.settings.button_2_text | escape }}</a>
              {%- endif -%}
            {%- endcapture -%}

            {%- if block.settings.button_1_text != blank and block.settings.button_2_text != blank -%}
              <div class="button-group" {% if section.settings.transition_type != 'fade' and section.settings.show_initial_transition or is_first_visible == false %}reveal{% endif %}>
                <div class="button-group__wrapper">
                  {{- buttons -}}
                </div>
              </div>
            {%- elsif buttons != blank -%}
              <div class="button-wrapper" {% if section.settings.transition_type != 'fade' and section.settings.show_initial_transition or is_first_visible == false %}reveal{% endif %}>
                {{- buttons -}}
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- if section_content != blank -%}
            <div class="container">
              {%- assign text_alignment = block.settings.text_position | split: '_' | first -%}
              {%- assign text_position = block.settings.text_position | split: '_' | last -%}

              <div class="slideshow__text-wrapper slideshow__text-wrapper--{{ text_alignment }} vertical-breather">
                <div class="content-box content-box--medium content-box--text-{{ text_position }} content-box--{{ text_position }} text-container">
                  {{- section_content -}}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {%- comment -%}If only the button 1 link is filled, then we make the whole slide clickable{%- endcomment -%}

        {%- capture slide_attributes -%}
          {{ block.shopify_attributes }}
          id="block-{{ section.id }}-{{ block.id }}"
          class="slideshow__slide {% if section.settings.transition_type == 'sweep' %}slideshow__slide--sweep{% endif %}"
          data-kit-set="{{ block_kit_set }}"
          {% unless is_first_visible %}hidden{% endunless %}
          {% if section.settings.section_height == 'auto' %}
            style="--image-aspect-ratio: {{ image_aspect_ratio }}; --mobile-image-aspect-ratio: {{ image_aspect_ratio }};"
          {% endif %}
        {%- endcapture -%}

        <slide-show-item {% if section.settings.transition_type != 'reveal' and section.settings.show_initial_transition or is_first_visible == false %}reveal-visibility{% endif %} {{ slide_attributes }}>
          {%- if block.settings.button_1_link != blank and block.settings.button_1_text == blank and block.settings.button_2_text == blank -%}
            <a class="slideshow__slide-inner" href="{{ block.settings.button_1_link }}">
              {{- slide_content -}}
            </a>
          {%- else -%}
            <div class="slideshow__slide-inner">
              {{- slide_content -}}
            </div>
          {%- endif -%}
        </slide-show-item>
      {%- endfor -%}
    </div>
    {%- if slideshow_product_gallery and visible_blocks_count > 1 -%}
      <button type="button" class="slideshow-brisa__peek slideshow-brisa__peek--next" data-slideshow-brisa-peek-next aria-label="{{ 'general.accessibility.next' | t }}">
        <img class="slideshow-brisa__peek-image" data-slideshow-brisa-peek-next-image alt="" width="200" height="400" decoding="async">
      </button>
    {%- endif -%}
    </div>
  </slide-show>

  {%- if visible_blocks_count > 1 -%}
    <div class="slideshow-brisa__nav-bar">
      <button type="button" class="slideshow-brisa__arrow slideshow-brisa__arrow--prev prev-next-button" is="prev-button" aria-label="{{ 'general.accessibility.previous' | t }}">
        {%- render 'icon' with 'nav-arrow-left', direction_aware: true -%}
      </button>

      <page-dots class="slideshow-brisa__dots" role="tablist">
        {%- assign dot_index = -1 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_kit_set = block.settings.kit_set | default: 'both'
            assign block_matches = false

            if active_kit_set == 'all' or block_kit_set == 'both' or block_kit_set == active_kit_set
              assign block_matches = true
            endif
          -%}

          {%- unless block_matches -%}
            {%- continue -%}
          {%- endunless -%}

          {%- assign dot_index = dot_index | plus: 1 -%}

          {%- assign thumb_image = block.settings.thumbnail_image -%}
          {%- if thumb_image == blank -%}
            {%- assign thumb_image = block.settings.image -%}
          {%- endif -%}
          {%- assign thumb_asset = block.settings.image_asset | strip -%}

          <button
            type="button"
            role="tab"
            class="slideshow-brisa__thumb"
            data-kit-set="{{ block_kit_set }}"
            data-slide-index="{{ dot_index }}"
            aria-controls="block-{{ section.id }}-{{ block.id }}"
            {% if dot_index == 0 %}aria-current="true" aria-selected="true"{% else %}aria-selected="false"{% endif %}
          >
            {%- if thumb_image != blank -%}
              <img
                class="slideshow-brisa__thumb-image"
                src="{{ thumb_image | image_url: width: 160, height: 160, crop: 'center' }}"
                srcset="{{ thumb_image | image_url: width: 80, height: 80, crop: 'center' }} 80w, {{ thumb_image | image_url: width: 120, height: 120, crop: 'center' }} 120w, {{ thumb_image | image_url: width: 160, height: 160, crop: 'center' }} 160w"
                sizes="{{ section.settings.thumbnail_size }}px"
                width="160"
                height="160"
                alt=""
                loading="{% if dot_index < 4 %}eager{% else %}lazy{% endif %}"
              >
            {%- elsif thumb_asset != blank -%}
              <img
                class="slideshow-brisa__thumb-image"
                src="{{ thumb_asset | asset_url }}"
                width="160"
                height="160"
                alt=""
                loading="{% if dot_index < 4 %}eager{% else %}lazy{% endif %}"
              >
            {%- else -%}
              <span class="slideshow-brisa__thumb-placeholder" aria-hidden="true"></span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'general.accessibility.go_to_slide' | t: num: dot_index | plus: 1 }}</span>
          </button>
        {%- endfor -%}
      </page-dots>

      <button type="button" class="slideshow-brisa__arrow slideshow-brisa__arrow--next prev-next-button" is="next-button" aria-label="{{ 'general.accessibility.next' | t }}">
        {%- render 'icon' with 'nav-arrow-right', direction_aware: true -%}
      </button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Slideshow Brisa",
  "class": "shopify-section--slideshow-brisa",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Kit sets"
    },
    {
      "type": "paragraph",
      "content": "Match the Product kit picker: assign each slide to Starter Kit, Mates Pack, or Both. Slides tagged Both always show."
    },
    {
      "type": "product",
      "id": "starter_product",
      "label": "Starter Kit product"
    },
    {
      "type": "text",
      "id": "starter_handle",
      "label": "Starter Kit handle (fallback)",
      "default": "brisa-device-black",
      "info": "Used if no product is selected above. Prefix rule below also matches colour variants."
    },
    {
      "type": "text",
      "id": "starter_handle_prefix",
      "label": "Starter kit handle prefix",
      "default": "brisa-device-",
      "info": "Any product handle starting with this prefix shows Starter Kit slides (e.g. brisa-device-black, brisa-device-cyan, brisa-device-rose)."
    },
    {
      "type": "product",
      "id": "mates_product",
      "label": "Mates Pack product"
    },
    {
      "type": "text",
      "id": "mates_handle",
      "label": "Mates Pack handle (fallback)",
      "default": "brisa-mates-pack-ocean-starter-kit"
    },
    {
      "type": "select",
      "id": "editor_preview_kit",
      "label": "Theme editor preview",
      "info": "Preview which kit slides show while editing. Auto uses the current product.",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto (from product)" },
        { "value": "starter", "label": "Starter Kit" },
        { "value": "mates", "label": "Mates Pack" },
        { "value": "all", "label": "Show all slides" }
      ]
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop image layout",
      "default": "default",
      "options": [
        { "value": "default", "label": "Full width (theme default)" },
        { "value": "square", "label": "Square, centered (product pages)" }
      ]
    },
    {
      "type": "range",
      "id": "desktop_max_width",
      "min": 360,
      "max": 720,
      "step": 20,
      "unit": "px",
      "label": "Desktop max width",
      "default": 520,
      "visible_if": "{{ section.settings.desktop_layout == 'square' }}"
    },
    {
      "type": "select",
      "id": "desktop_image_fit",
      "label": "Desktop image fit",
      "default": "cover",
      "options": [
        { "value": "contain", "label": "Show full image (no crop)" },
        { "value": "cover", "label": "Fill frame (may crop)" }
      ],
      "visible_if": "{{ section.settings.desktop_layout == 'square' }}"
    },
    {
      "type": "range",
      "id": "frame_height_percent",
      "min": 80,
      "max": 140,
      "step": 1,
      "unit": "%",
      "label": "Frame height",
      "default": 100,
      "info": "100% is square. Below 100 is wider-than-tall (e.g. 93 ≈ 1024×955). Above 100 makes the frame taller.",
      "visible_if": "{{ section.settings.desktop_layout == 'square' }}"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        {
          "value": "auto",
          "label": "Original image ratio"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "fit",
          "label": "Fit screen height"
        }
      ],
      "info": "Choose \"Original image ratio\" to not cut images. [Learn more](https://help.shopify.com/en/manual/online-store/images/theme-images#best-practices-for-slideshows-and-full-width-images)",
      "default": "auto"
    },
    {
      "type": "select",
      "id": "transition_type",
      "label": "Transition type",
      "options": [
        {
          "value": "sweep",
          "label": "Sweep"
        },
        {
          "value": "reveal",
          "label": "Reveal"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "sweep"
    },
    {
      "type": "checkbox",
      "id": "show_initial_transition",
      "label": "Show initial transition",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate between slides",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "sec",
      "label": "Change slides every",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "info": "Used while slideshow image is loading",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "color",
      "id": "nav_background",
      "label": "Navigation bar background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "thumbnail_gap",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Thumbnail gap",
      "default": 8
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "min": 48,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Thumbnail size",
      "default": 64
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Thumbnail corner radius",
      "default": 15
    },
    {
      "type": "color",
      "id": "thumbnail_active_border",
      "label": "Active thumbnail border",
      "default": "#008bdc"
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "Arrow background",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "select",
          "id": "kit_set",
          "label": "Kit set",
          "default": "both",
          "info": "Which kit this slide belongs to. Use Both for slides shared by Starter Kit and Mates Pack.",
          "options": [
            { "value": "both", "label": "Both" },
            { "value": "starter", "label": "Starter Kit" },
            { "value": "mates", "label": "Mates Pack" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
