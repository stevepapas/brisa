{% liquid
  assign section_uid = section.id | replace: '-', '' | downcase

  assign starter_product = section.settings.starter_product
  assign mates_product = section.settings.mates_product

  if starter_product == blank
    assign starter_product = all_products[section.settings.starter_handle]
  endif

  if mates_product == blank
    assign mates_product = all_products[section.settings.mates_handle]
  endif

  assign is_starter_active = false
  assign is_mates_active = false

  if product != blank
    if starter_product != blank and product.id == starter_product.id
      assign is_starter_active = true
    elsif mates_product != blank and product.id == mates_product.id
      assign is_mates_active = true
    elsif starter_product != blank and product.handle == starter_product.handle
      assign is_starter_active = true
    elsif mates_product != blank and product.handle == mates_product.handle
      assign is_mates_active = true
    endif
  endif

  if is_starter_active == false and is_mates_active == false and request.page_type == 'product'
    if starter_product != blank and product.handle == section.settings.starter_handle
      assign is_starter_active = true
    elsif mates_product != blank and product.handle == section.settings.mates_handle
      assign is_mates_active = true
    endif
  endif

  if is_mates_active
    assign kit_heading_suffix = section.settings.mates_kit_heading
  else
    assign kit_heading_suffix = section.settings.starter_kit_heading
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .product-kit-picker-{{ section_uid }} {
    color: {{ section.settings.text_color }};
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__hero {
    margin-bottom: {{ section.settings.hero_spacing }}px;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__hero-heading {
    margin: 0 0 {{ section.settings.hero_heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.hero_heading_size }}px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ section.settings.highlight_gap }}px {{ section.settings.highlight_column_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__highlight {
    display: grid;
    grid-template-columns: {{ section.settings.highlight_icon_size }}px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    font-size: {{ section.settings.highlight_text_size }}px;
    font-weight: 700;
    line-height: 1.25;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.highlight_icon_size }}px;
    height: {{ section.settings.highlight_icon_size }}px;
    color: {{ section.settings.highlight_icon_color }};
    background: {{ section.settings.highlight_icon_background }};
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__highlight-icon svg {
    display: block;
    width: {{ section.settings.highlight_icon_svg_size }}%;
    height: {{ section.settings.highlight_icon_svg_size }}%;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__highlight-icon img {
    display: block;
    width: {{ section.settings.highlight_icon_svg_size }}%;
    height: {{ section.settings.highlight_icon_svg_size }}%;
    object-fit: contain;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__highlight-icon--custom {
    background: transparent;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__highlight-icon--custom img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
    align-items: stretch;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 22px 20px 24px;
    color: inherit;
    text-decoration: none;
    background: {{ section.settings.card_background }};
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__card:hover {
    box-shadow: 0 8px 24px rgba(0, 139, 220, 0.12);
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__card.is-active {
    background: {{ section.settings.active_background }};
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__card:focus-visible {
    outline: 3px solid {{ section.settings.border_color }};
    outline-offset: 3px;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__banner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    max-width: 100%;
    margin: 0 0 14px;
    padding: 7px 16px;
    color: {{ section.settings.banner_text_color }};
    background: {{ section.settings.banner_background }};
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__title-wrap {
    min-width: 0;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__title {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: 900;
    line-height: 1.1;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__subtitle {
    margin: 6px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.3;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__header-price {
    flex: 0 0 auto;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.header_price_size }}px;
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    flex: 1 1 auto;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__feature {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    font-size: {{ section.settings.feature_size }}px;
    line-height: 1.35;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__check {
    display: inline-flex;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: {{ section.settings.check_color }};
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__check svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__note {
    margin: 16px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.note_size }}px;
    line-height: 1.35;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__footer {
    margin-top: 22px;
    text-align: center;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__price {
    display: block;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.price_size }}px;
    font-weight: 900;
    line-height: 1;
  }

  .product-kit-picker-{{ section_uid }} .product-kit-picker__compare {
    display: block;
    margin-top: 6px;
    color: {{ section.settings.compare_color }};
    font-size: {{ section.settings.compare_size }}px;
    line-height: 1.2;
    text-decoration: line-through;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    .product-kit-picker-{{ section_uid }} .product-kit-picker__hero-heading {
      font-size: {{ section.settings.mobile_hero_heading_size }}px;
    }

    .product-kit-picker-{{ section_uid }} .product-kit-picker__highlight {
      font-size: {{ section.settings.mobile_highlight_text_size }}px;
    }

    .product-kit-picker-{{ section_uid }} .product-kit-picker__title {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    .product-kit-picker-{{ section_uid }} .product-kit-picker__price {
      font-size: {{ section.settings.mobile_price_size }}px;
    }
  }
</style>

<section class="product-kit-picker product-kit-picker-{{ section_uid }}" {{ section.shopify_attributes }}>
  <div class="product-kit-picker__inner">
    {% if section.settings.show_hero %}
      <div class="product-kit-picker__hero">
        <h2 class="product-kit-picker__hero-heading">
          {{ section.settings.brand_prefix | escape }} {{ kit_heading_suffix | escape }}
        </h2>

        <ul class="product-kit-picker__highlights">
          {% for i in (1..4) %}
            {% liquid
              case i
                when 1
                  assign highlight_icon = section.settings.highlight_icon_1
                  assign highlight_label = section.settings.highlight_label_1
                  assign highlight_fallback = 'ritual'
                when 2
                  assign highlight_icon = section.settings.highlight_icon_2
                  assign highlight_label = section.settings.highlight_label_2
                  assign highlight_fallback = 'sparkles'
                when 3
                  assign highlight_icon = section.settings.highlight_icon_3
                  assign highlight_label = section.settings.highlight_label_3
                  assign highlight_fallback = 'no_smoke'
                else
                  assign highlight_icon = section.settings.highlight_icon_4
                  assign highlight_label = section.settings.highlight_label_4
                  assign highlight_fallback = 'no_nicotine'
              endcase
            %}

            {% if highlight_label != blank %}
              <li class="product-kit-picker__highlight">
                <span class="product-kit-picker__highlight-icon{% if highlight_icon != blank %} product-kit-picker__highlight-icon--custom{% endif %}" aria-hidden="true">
                  {% if highlight_icon != blank %}
                    {{ highlight_icon | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', alt: '' }}
                  {% else %}
                    {% case highlight_fallback %}
                      {% when 'sparkles' %}
                        <svg viewBox="0 0 48 48" fill="none" focusable="false">
                          <path d="M16 7 18.7 14.3 26 17 18.7 19.7 16 27 13.3 19.7 6 17 13.3 14.3 16 7Z" fill="currentColor"/>
                          <path d="M32 18 34.6 25.4 42 28 34.6 30.6 32 38 29.4 30.6 22 28 29.4 25.4 32 18Z" fill="currentColor"/>
                          <path d="M17 30 18.6 34.4 23 36 18.6 37.6 17 42 15.4 37.6 11 36 15.4 34.4 17 30Z" fill="currentColor"/>
                        </svg>
                      {% when 'no_smoke' %}
                        <svg viewBox="0 0 48 48" fill="none" focusable="false">
                          <path d="M10 30c4-8 10-12 18-12 4 0 7 1 10 4" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/>
                          <path d="M8 34h28" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/>
                          <path d="m11 37 26-26" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
                        </svg>
                      {% when 'no_nicotine' %}
                        <svg viewBox="0 0 48 48" fill="none" focusable="false">
                          <circle cx="16" cy="16" r="4" stroke="currentColor" stroke-width="2.8"/>
                          <circle cx="32" cy="16" r="4" stroke="currentColor" stroke-width="2.8"/>
                          <circle cx="24" cy="32" r="4" stroke="currentColor" stroke-width="2.8"/>
                          <path d="M19 19l10 10M29 19 19 29" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/>
                          <path d="m10 38 28-28" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
                        </svg>
                      {% else %}
                        <svg viewBox="0 0 48 48" fill="none" focusable="false">
                          <path d="M34 14a12 12 0 1 0-12 12" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/>
                          <path d="M34 14 22 26M34 14v8h-8" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    {% endcase %}
                  {% endif %}
                </span>
                <span>{{ highlight_label | escape }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <div class="product-kit-picker__grid">
      {% if starter_product != blank %}
        <a
          href="{{ starter_product.url }}"
          class="product-kit-picker__card product-kit-picker__card--starter{% if is_starter_active %} is-active{% endif %}"
          {% if is_starter_active %}aria-current="page"{% endif %}
        >
          <div class="product-kit-picker__header">
            <div class="product-kit-picker__title-wrap">
              <h3 class="product-kit-picker__title">{{ section.settings.starter_title | escape }}</h3>
              {% if section.settings.starter_subtitle != blank %}
                <p class="product-kit-picker__subtitle">{{ section.settings.starter_subtitle | escape }}</p>
              {% endif %}
            </div>

            {% if section.settings.starter_header_price != blank %}
              <span class="product-kit-picker__header-price">{{ section.settings.starter_header_price | escape }}</span>
            {% endif %}
          </div>

          <ul class="product-kit-picker__features">
            {% for block in section.blocks %}
              {% if block.type == 'feature' and block.settings.card == 'starter' and block.settings.text != blank %}
                <li class="product-kit-picker__feature" {{ block.shopify_attributes }}>
                  <span class="product-kit-picker__check" aria-hidden="true">
                    <svg viewBox="0 0 20 20" focusable="false"><path fill="currentColor" d="M7.6 14.2 3.8 10.4l1.4-1.4 2.4 2.4 6.2-6.2 1.4 1.4z"/></svg>
                  </span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          <div class="product-kit-picker__footer">
            <span class="product-kit-picker__price">{{ section.settings.starter_price | escape }}</span>
            {% if section.settings.starter_compare_price != blank %}
              <span class="product-kit-picker__compare">{{ section.settings.starter_compare_price | escape }}</span>
            {% endif %}
          </div>
        </a>
      {% endif %}

      {% if mates_product != blank %}
        <a
          href="{{ mates_product.url }}"
          class="product-kit-picker__card product-kit-picker__card--mates{% if is_mates_active %} is-active{% endif %}"
          {% if is_mates_active %}aria-current="page"{% endif %}
        >
          {% if section.settings.mates_banner != blank %}
            <span class="product-kit-picker__banner">{{ section.settings.mates_banner | escape }}</span>
          {% endif %}

          <div class="product-kit-picker__header">
            <div class="product-kit-picker__title-wrap">
              <div class="product-kit-picker__title-row">
                <h3 class="product-kit-picker__title">{{ section.settings.mates_title | escape }}</h3>
                {% if section.settings.mates_icon != blank %}
                  <span class="product-kit-picker__icon" aria-hidden="true">
                    {{ section.settings.mates_icon | image_url: width: 68 | image_tag: loading: 'lazy', widths: '34,68' }}
                  </span>
                {% endif %}
              </div>
            </div>
          </div>

          <ul class="product-kit-picker__features">
            {% for block in section.blocks %}
              {% if block.type == 'feature' and block.settings.card == 'mates' and block.settings.text != blank %}
                <li class="product-kit-picker__feature" {{ block.shopify_attributes }}>
                  <span class="product-kit-picker__check" aria-hidden="true">
                    <svg viewBox="0 0 20 20" focusable="false"><path fill="currentColor" d="M7.6 14.2 3.8 10.4l1.4-1.4 2.4 2.4 6.2-6.2 1.4 1.4z"/></svg>
                  </span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          {% if section.settings.mates_note != blank %}
            <p class="product-kit-picker__note">{{ section.settings.mates_note | escape }}</p>
          {% endif %}

          <div class="product-kit-picker__footer">
            <span class="product-kit-picker__price">{{ section.settings.mates_price | escape }}</span>
            {% if section.settings.mates_compare_price != blank %}
              <span class="product-kit-picker__compare">{{ section.settings.mates_compare_price | escape }}</span>
            {% endif %}
          </div>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product kit picker",
  "class": "shopify-section--brisa-product-kit-picker",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "starter_product",
      "label": "Starter Kit product"
    },
    {
      "type": "text",
      "id": "starter_handle",
      "label": "Starter Kit handle (fallback)",
      "default": "starter-kit"
    },
    {
      "type": "product",
      "id": "mates_product",
      "label": "Mates Pack product"
    },
    {
      "type": "text",
      "id": "mates_handle",
      "label": "Mates Pack handle (fallback)",
      "default": "mates-pack"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show hero",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_prefix",
      "label": "Brand prefix",
      "default": "BRISA™"
    },
    {
      "type": "text",
      "id": "starter_kit_heading",
      "label": "Starter Kit heading",
      "default": "STARTER KIT"
    },
    {
      "type": "text",
      "id": "mates_kit_heading",
      "label": "Mates Kit heading",
      "default": "MATES KIT"
    },
    {
      "type": "header",
      "content": "Hero icons"
    },
    {
      "type": "image_picker",
      "id": "highlight_icon_1",
      "label": "Icon 1 image"
    },
    {
      "type": "text",
      "id": "highlight_label_1",
      "label": "Icon 1 label",
      "default": "Satisfies the ritual"
    },
    {
      "type": "image_picker",
      "id": "highlight_icon_2",
      "label": "Icon 2 image"
    },
    {
      "type": "text",
      "id": "highlight_label_2",
      "label": "Icon 2 label",
      "default": "Throat sensation"
    },
    {
      "type": "image_picker",
      "id": "highlight_icon_3",
      "label": "Icon 3 image"
    },
    {
      "type": "text",
      "id": "highlight_label_3",
      "label": "Icon 3 label",
      "default": "No smoke No vapour"
    },
    {
      "type": "image_picker",
      "id": "highlight_icon_4",
      "label": "Icon 4 image"
    },
    {
      "type": "text",
      "id": "highlight_label_4",
      "label": "Icon 4 label",
      "default": "No Nicotine"
    },
    {
      "type": "header",
      "content": "Starter Kit card"
    },
    {
      "type": "text",
      "id": "starter_title",
      "label": "Title",
      "default": "Starter Kit"
    },
    {
      "type": "text",
      "id": "starter_subtitle",
      "label": "Subtitle",
      "default": "For your first switch"
    },
    {
      "type": "text",
      "id": "starter_header_price",
      "label": "Header price",
      "default": "$130"
    },
    {
      "type": "text",
      "id": "starter_price",
      "label": "Footer price",
      "default": "$130"
    },
    {
      "type": "text",
      "id": "starter_compare_price",
      "label": "Compare at price",
      "default": "$145"
    },
    {
      "type": "header",
      "content": "Mates Pack card"
    },
    {
      "type": "text",
      "id": "mates_banner",
      "label": "Banner",
      "default": "Best value. Save $40"
    },
    {
      "type": "text",
      "id": "mates_title",
      "label": "Title",
      "default": "Mates Pack"
    },
    {
      "type": "image_picker",
      "id": "mates_icon",
      "label": "Title icon"
    },
    {
      "type": "text",
      "id": "mates_note",
      "label": "Description",
      "default": "Tackle it with a mate or loved one who also needs to quit."
    },
    {
      "type": "text",
      "id": "mates_price",
      "label": "Footer price",
      "default": "$220"
    },
    {
      "type": "text",
      "id": "mates_compare_price",
      "label": "Compare at price",
      "default": "$260"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 700,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "hero_heading_size",
      "label": "Hero heading size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_hero_heading_size",
      "label": "Mobile hero heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "hero_spacing",
      "label": "Space below hero",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "hero_heading_spacing",
      "label": "Space below hero heading",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "highlight_gap",
      "label": "Highlight row gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "highlight_column_gap",
      "label": "Highlight column gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
