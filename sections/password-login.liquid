{%- if section.settings.background != settings.background and section.settings.background != 'rgba(0,0,0,0)' -%}
  {%- assign blends_with_background = false -%}
{%- else -%}
  {%- assign blends_with_background = true -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.card_background == 'rgba(0,0,0,0)' -%}
      {%- assign card_background = settings.background -%}
    {%- else -%}
      {%- assign card_background = section.settings.card_background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.button_background == 'rgba(0,0,0,0)' -%}
      {%- assign button_background = settings.primary_button_background -%}
    {%- else -%}
      {%- assign button_background = section.settings.button_background -%}
    {%- endif -%}

    {%- if section.settings.button_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign button_text_color = settings.primary_button_text_color -%}
    {%- else -%}
      {%- assign button_text_color = section.settings.button_text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
    --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};
    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --password-login-card-background: {{ card_background.red }}, {{ card_background.green }}, {{ card_background.blue }};
  }

  #shopify-section-{{ section.id }} .password-login {
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .password-login__card {
    background: rgb(var(--password-login-card-background));
    border-radius: {{ section.settings.card_border_radius }}px;
    margin-inline-start: auto;
    margin-inline-end: auto;
    max-width: 460px;
    padding: 32px 24px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .password-login__form {
    margin-block-start: 24px;
  }

  #shopify-section-{{ section.id }} .password-login__admin-link {
    margin-block-start: 16px;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .password-login__card {
      padding: 40px;
    }
  }
</style>

{%- assign form_id = 'storefront-password-' | append: section.id -%}
{%- assign password_input_id = 'password-login-' | append: section.id | append: '-password' -%}
{%- assign error_id = form_id | append: '-error' -%}

<section class="section {% unless blends_with_background %}section--flush{% endunless %}">
  <div class="section__color-wrapper">
    <div class="container">
      <div class="password-login {% unless blends_with_background %}vertical-breather{% endunless %}">
        <div class="password-login__card text-container">
          {%- if section.settings.icon != 'none' -%}
            {%- render 'icon' with section.settings.icon, width: 28, height: 28 -%}
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="heading h2">{{ section.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            {{- section.settings.content -}}
          {%- endif -%}

          {%- form 'storefront_password', id: form_id, name: 'password', class: 'password-login__form form' -%}
            {%- if form.errors -%}
              <div id="{{ error_id }}" class="form__banner banner banner--error">
                <span class="banner__ribbon">{% render 'icon' with 'form-error' %}</span>
                <p class="banner__content">{{ form.errors.messages['form'] }}</p>
              </div>

              <script>
                window.addEventListener('DOMContentLoaded', () => {
                  const section = document.getElementById('shopify-section-{{ section.id }}');
                  const passwordInput = document.getElementById('{{ password_input_id }}');

                  section?.scrollIntoView({ block: 'center' });
                  passwordInput?.focus();
                });
              </script>
            {%- endif -%}

            <div class="input">
              <input
                type="password"
                id="{{ password_input_id }}"
                name="password"
                class="input__field input__field--text"
                autocomplete="current-password"
                required="required"
                {% if form.errors %}aria-describedby="{{ error_id }}"{% endif %}
              >
              <label for="{{ password_input_id }}" class="input__label">{{ section.settings.input_label | escape }}</label>
            </div>

            <button is="loader-button" type="submit" class="form__submit form__submit--closer button button--primary button--full">
              {{- section.settings.button_text | escape -}}
            </button>
          {%- endform -%}

          {%- if section.settings.show_admin_link -%}
            <p class="password-login__admin-link text--small text--subdued">
              {{ 'password.general.store_owner' | t }}
              <a href="/admin" class="link">{{ 'password.general.login' | t }}</a>
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password login",
  "class": "shopify-section--password-login",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lock",
          "label": "Lock"
        }
      ],
      "default": "lock"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Enter password"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>Enter the store password to continue.</p>"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Password field label",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Enter store"
    },
    {
      "type": "checkbox",
      "id": "show_admin_link",
      "label": "Show store owner login link",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "Password login"
    }
  ]
}
{% endschema %}
