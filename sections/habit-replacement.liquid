<style>
  @font-face {
    font-family: 'TeX Gyre Bonum';
    font-style: italic;
    font-weight: 700;
    font-display: swap;
    src: url({{ 'texgyrebonum-bolditalic.woff' | asset_url }}) format('woff');
  }

  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  } 

  #shopify-section-{{ section.id }} .habit-replacement {
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .habit-replacement__top,
  #shopify-section-{{ section.id }} .habit-replacement__bottom {
    padding: 42px 48px 54px;
  }

  #shopify-section-{{ section.id }} .habit-replacement__top {
    background: {{ section.settings.top_panel_background }};
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .habit-replacement__bottom {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    background: {{ section.settings.bottom_panel_background }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .habit-replacement__top {
      padding: 0;
    }

    #shopify-section-{{ section.id }} .habit-replacement__top-inner {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 42px 48px 54px;
    }
  }

  #shopify-section-{{ section.id }} .habit-replacement__eyebrow {
    display: table;
    margin: 0 auto 24px;
    padding: 8px 16px;
    color: {{ section.settings.eyebrow_color }};
    background: {{ section.settings.eyebrow_background }};
    border-radius: 999px;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .habit-replacement__heading {
    margin: 0 auto 30px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .habit-replacement__reasons {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  #shopify-section-{{ section.id }} .habit-replacement__reason {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .habit-replacement__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: {{ section.settings.number_color }};
    background: {{ section.settings.number_background }};
    border-radius: 50%;
    font-size: 26px;
    font-weight: 900;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .habit-replacement__reason-title {
    margin: 0 0 3px;
    color: {{ section.settings.heading_color }};
    font-size: 18px;
    font-weight: 900;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .habit-replacement__reason-text {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 17px;
    line-height: 1.24;
  }

  #shopify-section-{{ section.id }} .habit-replacement__bottom {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .habit-replacement__bottom > .habit-replacement__eyebrow {
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .habit-replacement__bottom-heading {
    margin: 0 auto 20px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.bottom_heading_size }}px;
    font-weight: 900;
    line-height: 1.15;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .habit-replacement__bottom-heading-main {
    display: block;
    color: #111111;
    font-family: inherit;
    font-style: normal;
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .habit-replacement__bottom-heading-accent {
    display: block;
    margin-top: 0.12em;
    color: {{ section.settings.eyebrow_color | default: '#2c579b' }};
    font-family: 'TeX Gyre Bonum', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .habit-replacement__video {
    position: relative;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto 14px;
    overflow: hidden;
    background: #d8f6ff;
    border-radius: 24px;
  }

  #shopify-section-{{ section.id }} .habit-replacement__video-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  #shopify-section-{{ section.id }} .habit-replacement__video-caption {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto 22px;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .habit-replacement__video-caption p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .habit-replacement__video-caption strong {
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .habit-replacement__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    padding: 0;
    background: rgba(255, 255, 255, 0.92);
    border: 3px solid {{ section.settings.number_background }};
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .habit-replacement__play span {
    width: 0;
    height: 0;
    margin-left: 5px;
    border-top: 15px solid transparent;
    border-bottom: 15px solid transparent;
    border-left: 22px solid {{ section.settings.eyebrow_color }};
  }

  #shopify-section-{{ section.id }} .habit-replacement__steps {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .habit-replacement__step {
    display: grid;
    grid-template-columns: 44px 6px minmax(0, 1fr);
    gap: 0 17px;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .habit-replacement__step:not(:last-child) {
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid {{ section.settings.step_divider_color }};
  }

  #shopify-section-{{ section.id }} .habit-replacement__step-index {
    align-self: start;
    color: {{ section.settings.step_number_color }};
    font-size: 28px;
    font-weight: 900;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .habit-replacement__step-line {
    display: block;
    align-self: stretch;
    width: 6px;
    min-height: 34px;
    background: {{ section.settings.eyebrow_background }};
    border-radius: 3px;
  }

  #shopify-section-{{ section.id }} .habit-replacement__step-title {
    display: block;
    margin-bottom: 3px;
    color: {{ section.settings.heading_color }};
    font-size: 14px;
    font-weight: 900;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .habit-replacement__step-text {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .habit-replacement__cta {
    max-width: {{ section.settings.max_width }}px;
    margin: 26px auto 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .habit-replacement__cta-card {
    margin: 0 0 22px;
    padding: 22px 24px;
    color: #111111;
    background: {{ section.settings.cta_card_background | default: '#eef3fd' }};
    border: 2px solid {{ section.settings.cta_card_border | default: '#5b83c8' }};
    border-radius: 20px;
  }

  #shopify-section-{{ section.id }} .habit-replacement__cta-title {
    margin: 0 0 8px;
    color: #111111;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .habit-replacement__cta-text {
    margin: 0;
    color: #111111;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .habit-replacement__cta-text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .habit-replacement__cta-text strong,
  #shopify-section-{{ section.id }} .habit-replacement__cta-text a {
    color: {{ section.settings.number_background | default: '#1198dc' }};
    font-weight: 800;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .habit-replacement__cta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 56px;
    padding: 14px 24px;
    box-sizing: border-box;
    color: #ffffff;
    background: {{ section.settings.cta_button_background | default: '#38b6ff' }};
    border: 0;
    border-radius: 999px;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.1;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .habit-replacement__cta-trust {
    margin: 12px 0 0;
    color: #111111;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .habit-replacement__top,
    #shopify-section-{{ section.id }} .habit-replacement__bottom {
      padding: 32px 28px 42px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__heading {
      font-size: {{ section.settings.heading_size | times: 0.86 | round }}px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__bottom-heading {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__reason-text {
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__video {
      border-radius: 20px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__video-caption {
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__step {
      grid-template-columns: 23px 6px minmax(0, 1fr);
      gap: 0 8px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__step-index {
      font-size: 19px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__step-title {
      margin-bottom: 0;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__step-text {
      font-size: 12px;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .habit-replacement__cta {
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__cta-card {
      padding: 9px 8px;
      border-radius: 18px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__cta-title {
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__cta-text {
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__cta-button {
      min-height: 52px;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .habit-replacement__cta-trust {
      font-size: 12px;
    }
  }
</style>

<section class="habit-replacement" {{ section.shopify_attributes }}>
  {%- liquid
    assign has_reasons = false
    for block in section.blocks
      if block.type == 'reason'
        assign has_reasons = true
        break
      endif
    endfor
  -%}

  {% if section.settings.eyebrow != blank or section.settings.heading != blank or has_reasons %}
  <div class="habit-replacement__top">
    <div class="habit-replacement__top-inner">
    {% if section.settings.eyebrow != blank %}
      <div class="habit-replacement__eyebrow">{{ section.settings.eyebrow | escape }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="habit-replacement__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {% endif %}

    {% if has_reasons %}
    <div class="habit-replacement__reasons">
      {% assign reason_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'reason' %}
          {% assign reason_index = reason_index | plus: 1 %}
          <div class="habit-replacement__reason" {{ block.shopify_attributes }}>
            <span class="habit-replacement__number">{{ reason_index }}</span>
            <div>
              {% if block.settings.title != blank %}
                <h3 class="habit-replacement__reason-title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="habit-replacement__reason-text">{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
    </div>
  </div>
  {% endif %}

  <div class="habit-replacement__bottom">
    {% if section.settings.bottom_eyebrow != blank %}
      <div class="habit-replacement__eyebrow">{{ section.settings.bottom_eyebrow | escape }}</div>
    {% endif %}

    {% if section.settings.bottom_heading != blank %}
      {%- liquid
        assign bottom_heading_html = section.settings.bottom_heading | strip | newline_to_br
        assign bottom_heading_lines = bottom_heading_html | split: '<br />'
        if bottom_heading_lines.size == 1
          assign bottom_heading_lines = bottom_heading_html | split: '<br>'
        endif
      -%}
      <h2 class="habit-replacement__bottom-heading">
        {% if bottom_heading_lines.size > 1 %}
          <span class="habit-replacement__bottom-heading-main">{{ bottom_heading_lines.first | strip_html | strip | escape }}</span>
          <span class="habit-replacement__bottom-heading-accent">{{ bottom_heading_lines.last | strip_html | strip | escape }}</span>
        {% else %}
          {{ section.settings.bottom_heading | escape | newline_to_br }}
        {% endif %}
      </h2>
    {% endif %}

    <div class="habit-replacement__video">
      {% if section.settings.video_image != blank %}
        {%- liquid
          assign video_image_alt = section.settings.video_image.alt | default: 'How Brisa works'
          assign video_image_width = section.settings.video_image.width | at_most: 900
          assign video_image_sizes = '(max-width: 749px) calc(100vw - 56px), ' | append: section.settings.max_width | append: 'px'
        -%}
        {%- capture video_image_markup -%}
          {{- section.settings.video_image
            | image_url: width: video_image_width
            | image_tag:
              class: 'habit-replacement__video-image',
              alt: video_image_alt,
              loading: 'lazy',
              sizes: video_image_sizes,
              widths: '280,360,480,640,800,900',
              width: section.settings.video_image.width,
              height: section.settings.video_image.height
          -}}
        {%- endcapture -%}
        {{- video_image_markup
          | replace: '&amp;width=', '&amp;quality=70&amp;width='
          | replace: '?width=', '?quality=70&amp;width='
        -}}
      {% endif %}

      {% liquid
        assign video_src = ''
        assign video_type = ''

        if section.settings.video != blank
          assign local_video_source = section.settings.video.sources | where: 'format', 'mp4' | first
          if local_video_source == blank
            assign local_video_source = section.settings.video.sources | first
          endif
          assign video_src = local_video_source.url
          assign video_type = 'html5'
        elsif section.settings.video_url.type == 'youtube'
          assign video_src = 'https://www.youtube.com/embed/' | append: section.settings.video_url.id | append: '?autoplay=1&rel=0&modestbranding=1'
          assign video_type = 'iframe'
        elsif section.settings.video_url.type == 'vimeo'
          assign video_src = 'https://player.vimeo.com/video/' | append: section.settings.video_url.id | append: '?autoplay=1&title=0&byline=0&portrait=0'
          assign video_type = 'iframe'
        endif
      %}

      {% if video_src != blank %}
        <button
          type="button"
          class="habit-replacement__play"
          data-brisa-video-src="{{ video_src | escape }}"
          data-brisa-video-type="{{ video_type }}"
          aria-label="Play video"
        >
          <span aria-hidden="true"></span>
        </button>
      {% endif %}
    </div>

    {% if section.settings.video_caption != blank %}
      <div class="habit-replacement__video-caption rte">{{ section.settings.video_caption }}</div>
    {% endif %}

    <div class="habit-replacement__steps">
      {% assign step_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          {% assign step_index = step_index | plus: 1 %}
          <div class="habit-replacement__step" {{ block.shopify_attributes }}>
            <span class="habit-replacement__step-index">{{ step_index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="habit-replacement__step-line" aria-hidden="true"></span>
            <p class="habit-replacement__step-text">
              {% if block.settings.title != blank %}
                <strong class="habit-replacement__step-title">{{ block.settings.title | escape }}</strong>
              {% endif %}
              {{ block.settings.text | escape }}
            </p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.cta_title != blank or section.settings.cta_text != blank or section.settings.cta_button_text != blank %}
      <div class="habit-replacement__cta">
        {% if section.settings.cta_title != blank or section.settings.cta_text != blank %}
          <div class="habit-replacement__cta-card">
            {% if section.settings.cta_title != blank %}
              <p class="habit-replacement__cta-title">{{ section.settings.cta_title | escape }}</p>
            {% endif %}
            {% if section.settings.cta_text != blank %}
              <div class="habit-replacement__cta-text rte">{{ section.settings.cta_text }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.cta_button_text != blank %}
          <a
            class="habit-replacement__cta-button"
            href="{{ section.settings.cta_button_link | default: '/products/brisa-starter-kit' }}"
            aria-label="{{ section.settings.cta_button_text | escape }} from How Brisa works"
          >
            {{ section.settings.cta_button_text | escape }}
          </a>
        {% endif %}

        {% if section.settings.cta_trust != blank %}
          <p class="habit-replacement__cta-trust">{{ section.settings.cta_trust | escape }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Habit replacement",
  "class": "shopify-section--habit-replacement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Top badge",
      "default": "HABIT - REPLACEMENT DESIGN"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Top heading",
      "default": "DRUG-FREE\nRITUAL-LOCKED\nHABIT REPLACED"
    },
    {
      "type": "text",
      "id": "bottom_eyebrow",
      "label": "Bottom badge",
      "default": "HOW IT WORKS"
    },
    {
      "type": "textarea",
      "id": "bottom_heading",
      "label": "Bottom heading",
      "default": "FOUR STEPS.\nREPLACE THE MOMENT"
    },
    {
      "type": "image_picker",
      "id": "video_image",
      "label": "Cloud image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Local video",
      "info": "Replaces the external video if both are set."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "External video",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "richtext",
      "id": "video_caption",
      "label": "Video caption",
      "default": "<p>watch <strong>Kaiden, our Co - founder</strong>, show you how he uses the brisa,</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "top_panel_background",
      "label": "Top panel background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "bottom_panel_background",
      "label": "Bottom panel background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "eyebrow_background",
      "label": "Badge background",
      "default": "#75cfff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Badge text",
      "default": "#2c579b"
    },
    {
      "type": "color",
      "id": "number_background",
      "label": "Number background",
      "default": "#1198dc"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "step_number_color",
      "label": "Step number",
      "default": "#1b4a87"
    },
    {
      "type": "color",
      "id": "step_divider_color",
      "label": "Step divider",
      "default": "#a8d4f2"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Badge size",
