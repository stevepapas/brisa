<style>
  #shopify-section-{{ section.id }} {
    --learn-blue: #038bdd;
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .learn-details {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .learn-details__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--learn-features-gap, 24px);
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .learn-details__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .learn-details__icon-wrap {
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .learn-details__title {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 900;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .learn-details__text {
    margin: 0;
    font-size: 13px;
    line-height: 1.35;
    color: #444444;
  }

  #shopify-section-{{ section.id }} .learn-details__core {
    margin-bottom: 40px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .learn-details__core-label {
    margin: 0 0 10px;
    color: var(--learn-blue);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .learn-details__core-subhead {
    margin: 0 0 28px;
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 900;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .learn-details__story {
    margin-bottom: 20px;
    padding: 22px 20px;
    text-align: left;
    background: #e8f6fc;
    border-radius: 14px;
  }

  #shopify-section-{{ section.id }} .learn-details__story-heading {
    margin: 0 0 10px;
    color: #111111;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .learn-details__story-text {
    margin: 0;
    color: #333333;
    font-size: 15px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .learn-details__testimonials-inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .learn-details__badge {
    display: inline-block;
    margin: 0 0 16px;
    padding: 8px 16px;
    color: #2c579b;
    background: #bee3f9;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .learn-details__social-heading {
    margin: 0 0 24px;
    font-size: clamp(24px, 5vw, 32px);
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }
</style>

<section class="learn-details" {{ section.shopify_attributes }}>
  {%- if section.blocks.size > 0 -%}
    <div class="learn-details__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'detail' -%}
          <div class="learn-details__item" {{ block.shopify_attributes }}>
            {% render 'learn-feature-icon', title: block.settings.title %}
            <div>
              {%- if block.settings.title != blank -%}
                <p class="learn-details__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="learn-details__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.core_label != blank or section.settings.core_subhead != blank or section.settings.flavour_heading != blank or section.settings.formula_heading != blank -%}
    <div class="learn-details__core">
      {%- if section.settings.core_label != blank -%}
        <p class="learn-details__core-label">{{ section.settings.core_label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.core_subhead != blank -%}
        <h3 class="learn-details__core-subhead">{{ section.settings.core_subhead | escape }}</h3>
      {%- endif -%}

      {%- if section.settings.flavour_heading != blank or section.settings.flavour_text != blank -%}
        <div class="learn-details__story">
          {%- if section.settings.flavour_heading != blank -%}
            <p class="learn-details__story-heading">{{ section.settings.flavour_heading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.flavour_text != blank -%}
            <p class="learn-details__story-text">{{ section.settings.flavour_text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.formula_heading != blank or section.settings.formula_text != blank -%}
        <div class="learn-details__story">
          {%- if section.settings.formula_heading != blank -%}
            <p class="learn-details__story-heading">{{ section.settings.formula_heading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.formula_text != blank -%}
            <p class="learn-details__story-text">{{ section.settings.formula_text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="learn-details__testimonials">
    <div class="learn-details__testimonials-inner">
    {%- if section.settings.badge != blank -%}
      <p class="learn-details__badge">{{ section.settings.badge | escape }}</p>
    {%- endif -%}

    {%- if section.settings.social_heading != blank -%}
      <h2 class="learn-details__social-heading">{{ section.settings.social_heading | escape | newline_to_br }}</h2>
    {%- endif -%}

    {% render 'brisa-product-testimonials-slider',
      section: section,
      show_heading: false,
      desktop_page_size: 1,
      mobile_page_size: 1
    %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Learn product details",
  "class": "shopify-section--learn-product-details",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Inside the Brisa core"
    },
    {
      "type": "text",
      "id": "core_label",
      "label": "Core section label",
      "default": "Inside the Brisa core"
    },
    {
      "type": "text",
      "id": "core_subhead",
      "label": "Core section subhead",
      "default": "The part everyone tries to copy... and no one's cracked."
    },
    {
      "type": "text",
      "id": "flavour_heading",
      "label": "Flavour heading",
      "default": "The flavours you actually chase 🍒"
    },
    {
      "type": "textarea",
      "id": "flavour_text",
      "label": "Flavour text",
      "default": "We create the ones people genuinely miss, starting with Cherry Pomegranate, a world first no one in our category has cracked. And we're building more, matched to the profiles you already know."
    },
    {
      "type": "text",
      "id": "formula_heading",
      "label": "Formula heading",
      "default": "A formula we'll never share 🤫"
    },
    {
      "type": "textarea",
      "id": "formula_text",
      "label": "Formula text",
      "default": "Almost a year of R&D in the making, our exact combination of food-grade aroma and cooling compounds is ours alone — there is none alike, locked away. Creating the best all-around experience for our customers: a rush of flavour/aroma, a real throat sensation, and longevity in every core."
    },
    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Testimonial badge",
      "default": "REAL RESULTS"
    },
    {
      "type": "textarea",
      "id": "social_heading",
      "label": "Social proof heading",
      "default": "FROM THE PEOPLE WHO'VE\nALREADY MADE THE SWITCH."
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Reviews disclaimer",
      "default": "Customer experiences vary. Brisa is not a medical device or smoking cessation product."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show review arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show review dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable review autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Review autoplay speed",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 5000
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Throat sensation"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Built for a cool, familiar draw and sensory feel."
        }
      ]
    },
    {
      "type": "video_review",
      "name": "Video review",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Person thumbnail"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Local video",
          "info": "Replaces the external video if both are set."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "External video",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessibility label",
          "default": "customer video review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Learn product details"
    }
  ]
}
{% endschema %}
