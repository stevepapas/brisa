{% liquid
  assign section_uid = section.id | replace: '-', '' | downcase
  assign buy_product = section.settings.product | default: product
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .brisa-buy-zone-{{ section_uid }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    color: {{ section.settings.text_color }};
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-buy-zone__value-line {
    margin: 0 0 {{ section.settings.value_spacing }}px;
    font-size: {{ section.settings.value_size }}px;
    font-weight: 800;
    line-height: 1.35;
    text-align: center;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__heading {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 900;
    line-height: 1.2;
    text-transform: uppercase;
    text-align: left;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__heading-values {
    font-weight: 800;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(140px, 42%);
    gap: 16px;
    align-items: center;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    justify-content: flex-start;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__swatch {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__swatch-dot {
    display: block;
    width: {{ section.settings.swatch_size }}px;
    height: {{ section.settings.swatch_size }}px;
    border: 2px solid transparent;
    border-radius: 50%;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__swatch.is-active .brisa-colour-picker__swatch-dot {
    border-color: {{ section.settings.swatch_active_border }};
    box-shadow: 0 0 0 2px {{ section.settings.swatch_active_ring }};
    transform: scale(1.08);
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__swatch-label {
    font-size: 12px;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__image {
    display: block;
    width: 100%;
    max-width: 220px;
    height: auto;
    object-fit: contain;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__image-placeholder {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1;
    background: #e8f5fc;
    border-radius: 12px;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-buy-zone__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: {{ section.settings.rating_spacing }}px;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-buy-zone__stars {
    display: inline-flex;
    gap: 3px;
    color: {{ section.settings.star_color }};
  }

  .brisa-buy-zone-{{ section_uid }} .brisa-buy-zone__star svg {
    display: block;
    width: 22px;
    height: 22px;
  }

  @media screen and (max-width: 749px) {
    .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__row {
      grid-template-columns: 1fr;
    }

    .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__media {
      order: -1;
      min-height: 100px;
    }

    .brisa-buy-zone-{{ section_uid }} .brisa-colour-picker__image {
      max-width: 180px;
      margin: 0 auto;
    }
  }
</style>

<section class="brisa-buy-zone brisa-buy-zone-{{ section_uid }}" data-brisa-buy-zone {{ section.shopify_attributes }}>
  <div class="brisa-buy-zone__inner">
    {%- if section.settings.value_line != blank -%}
      <p class="brisa-buy-zone__value-line">{{ section.settings.value_line | escape }}</p>
    {%- endif -%}

    {%- if buy_product != blank -%}
      {%- render 'brisa-variant-colour-picker', product: buy_product, section: section -%}
    {%- endif -%}

    {%- if section.settings.show_rating -%}
      <div class="brisa-buy-zone__rating">
        <span class="brisa-buy-zone__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <span class="brisa-buy-zone__star">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
              </svg>
            </span>
          {%- endfor -%}
        </span>
        <span>{{ section.settings.rating_text | escape }}</span>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const zone = document.currentScript.previousElementSibling;
    if (!zone || !zone.matches('[data-brisa-buy-zone]')) return;

    const picker = zone.querySelector('[data-brisa-colour-picker]');
    if (!picker) return;

    const imageEl = picker.querySelector('[data-brisa-colour-image]');
    const imagesScript = picker.querySelector('[data-brisa-variant-images]');
    let variantImages = {};

    try {
      variantImages = JSON.parse(imagesScript?.textContent || '{}');
    } catch (error) {
      variantImages = {};
    }

    function getVariantPicker() {
      return document.querySelector('variant-picker[form-id]');
    }

    function getVariantPickerForm(pickerEl) {
      const formId = pickerEl?.getAttribute('form-id');
      if (!formId) return null;
      return document.getElementById(formId);
    }

    function selectThemeVariant(variantId, optionPosition, optionValueId) {
      const variantPicker = getVariantPicker();
      const form = getVariantPickerForm(variantPicker);
      if (!form || !variantPicker) return;

      const targetInput = form.querySelector(
        `input[data-option-position="${optionPosition}"][value="${optionValueId}"]`
      );

      if (targetInput) {
        if (targetInput.type === 'radio') {
          targetInput.checked = true;
        }
        targetInput.dispatchEvent(new Event('change', { bubbles: true }));
        return;
      }

      const hiddenVariantInput = form.querySelector('input[name="id"]');
      if (hiddenVariantInput) {
        hiddenVariantInput.value = variantId;
        hiddenVariantInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    function updateDeviceImage(variantId) {
      if (!imageEl) return;
      const payload = variantImages[String(variantId)];
      if (!payload?.src) return;
      imageEl.src = payload.src;
      if (payload.width) imageEl.width = payload.width;
      if (payload.height) imageEl.height = payload.height;
    }

    function setActiveSwatch(button) {
      picker.querySelectorAll('[data-brisa-colour-swatch]').forEach((item) => {
        const isActive = item === button;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    picker.querySelectorAll('[data-brisa-colour-swatch]').forEach((button) => {
      button.addEventListener('click', () => {
        const variantId = button.dataset.variantId;
        const optionPosition = button.dataset.optionPosition;
        const optionValueId = button.dataset.optionValueId;
        if (!variantId) return;

        setActiveSwatch(button);
        selectThemeVariant(variantId, optionPosition, optionValueId);
        updateDeviceImage(variantId);
      });
    });

    document.addEventListener('variant:changed', (event) => {
      const variant = event.detail?.variant;
      if (!variant?.id) return;

      const matchingSwatch = picker.querySelector(
        `[data-brisa-colour-swatch][data-variant-id="${variant.id}"]`
      );
      if (matchingSwatch) setActiveSwatch(matchingSwatch);
      updateDeviceImage(variant.id);
      updateAddToCartLabel(variant);
    });

    function updateAddToCartLabel(variant) {
      const button = document.querySelector('[data-product-add-to-cart-button]');
      if (!button || !variant) return;

      const prefix = button.dataset.brisaCtaPrefix || 'ADD STARTER KIT';
      const price = variant.price ? Shopify.formatMoney(variant.price) : '';
      const label = price ? `${prefix} — ${price} →` : prefix;
      const labelTarget = button.querySelector('[data-button-content]') || button;

      if (labelTarget === button) {
        button.textContent = label;
      } else {
        labelTarget.textContent = label;
      }
    }

    const initialVariantPicker = getVariantPicker();
    const initialScript = initialVariantPicker?.querySelector('script[data-variant]');
    if (initialScript) {
      try {
        const initialVariant = JSON.parse(initialScript.textContent);
        updateAddToCartLabel(initialVariant);
      } catch (error) {
        /* ignore */
      }
    }

    const addButton = document.querySelector('[data-product-add-to-cart-button]');
    if (addButton && !addButton.dataset.brisaCtaPrefix) {
      addButton.dataset.brisaCtaPrefix = 'ADD STARTER KIT';
    }
  })();
</script>

{% schema %}
{
  "name": "Brisa buy zone",
  "class": "shopify-section--brisa-product-buy-zone",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the current product page product."
    },
    {
      "type": "text",
      "id": "option_name",
      "label": "Colour option name",
      "default": "Color"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show colour heading row",
      "default": true
    },
    {
      "type": "header",
      "content": "Variant image"
    },
    {
      "type": "text",
      "id": "image_metafield_namespace",
      "label": "Image metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "image_metafield_key",
      "label": "Image metafield key",
      "default": "slider_image",
      "info": "Variant metafield for the device image beside swatches."
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "swatch_active_border",
      "label": "Active swatch border",
      "default": "#008bdc"
    },
    {
      "type": "color",
      "id": "swatch_active_ring",
      "label": "Active swatch ring",
      "default": "#add5fe"
    },
    {
      "type": "header",
      "content": "Value line"
    },
    {
      "type": "text",
      "id": "value_line",
      "label": "Text",
      "default": "$130 one-time. Or $300/month + vaping. Your call."
    },
    {
      "type": "range",
      "id": "value_size",
      "label": "Text size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "value_spacing",
      "label": "Space below value line",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating below colour row",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Rated 4.7 (163)"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#008bdc"
    },
    {
      "type": "range",
      "id": "rating_spacing",
      "label": "Space above rating",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 600,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Brisa buy zone",
      "category": "Brisa"
    }
  ]
}
{% endschema %}
