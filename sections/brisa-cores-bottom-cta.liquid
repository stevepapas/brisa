{{ 'brisa-kit-purchase.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .bkp-bottom__caption {
    margin: 10px 0 18px;
    color: #8a8a8a;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .bkp-bottom__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 16px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .bkp-bottom__trust-item {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 0 0 calc(33.333% - 12px);
    max-width: 180px;
    box-sizing: border-box;
    color: #111;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.25;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .bkp-bottom__trust-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: #008bdc;
  }

  #shopify-section-{{ section.id }} .bkp-bottom__trust-icon img,
  #shopify-section-{{ section.id }} .bkp-bottom__trust-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 549px) {
    #shopify-section-{{ section.id }} .bkp-bottom__trust {
      gap: 14px 8px;
    }

    #shopify-section-{{ section.id }} .bkp-bottom__trust-item {
      flex-basis: calc(33.333% - 8px);
      font-size: 11px;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .bkp-bottom__trust-icon {
      width: 20px;
      height: 20px;
    }
  }
</style>

<section class="bkp-bottom" data-brisa-cores-bottom-cta {{ section.shopify_attributes }}>
  <div class="bkp-bottom__inner">
    <button type="button" class="bkp__atc" data-brisa-cores-bottom-atc>
      <span>{{ section.settings.button_label | default: 'ADD TO CART >' | escape }}</span>
    </button>

    {% if section.settings.atc_caption != blank %}
      <p class="bkp-bottom__caption">{{ section.settings.atc_caption | escape }}</p>
    {% endif %}

    {% if section.settings.show_trust %}
      <ul class="bkp-bottom__trust" aria-label="Store benefits">
        {% for i in (1..5) %}
          {% liquid
            case i
              when 1
                assign t_label = section.settings.trust_1
                assign t_icon = section.settings.trust_icon_1
                assign t_asset = section.settings.trust_icon_asset_1 | default: 'brisa-trust-ship.svg'
              when 2
                assign t_label = section.settings.trust_2
                assign t_icon = section.settings.trust_icon_2
                assign t_asset = section.settings.trust_icon_asset_2 | default: 'brisa-trust-lock.svg'
              when 3
                assign t_label = section.settings.trust_3
                assign t_icon = section.settings.trust_icon_3
                assign t_asset = section.settings.trust_icon_asset_3 | default: 'brisa-trust-star.svg'
              when 4
                assign t_label = section.settings.trust_4
                assign t_icon = section.settings.trust_icon_4
                assign t_asset = section.settings.trust_icon_asset_4 | default: 'brisa-trust-globe.svg'
              else
                assign t_label = section.settings.trust_5
                assign t_icon = section.settings.trust_icon_5
                assign t_asset = section.settings.trust_icon_asset_5 | default: 'brisa-trust-sparkles.svg'
            endcase
          %}
          {% if t_label != blank %}
            <li class="bkp-bottom__trust-item">
              <span class="bkp-bottom__trust-icon" aria-hidden="true">
                {% if t_icon != blank %}
                  {{ t_icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
                {% elsif t_asset != blank %}
                  <img src="{{ t_asset | asset_url }}" alt="" width="28" height="28" loading="lazy">
                {% endif %}
              </span>
              <span>{{ t_label | escape | newline_to_br }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    const btn = root.querySelector('[data-brisa-cores-bottom-atc]');
    if (!btn || btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';

    const findProductAtc = () =>
      document.querySelector(
        '.shopify-section--brisa-cores-picker .product-form__add-button, .shopify-section--brisa-cores-picker [name="add"], .shopify-section--brisa-cores-picker button[type="submit"]'
      );

    const syncDisabled = () => {
      const source = findProductAtc();
      if (!source) return;
      btn.disabled = Boolean(source.disabled);
    };

    btn.addEventListener('click', (event) => {
      event.preventDefault();
      const source = findProductAtc();
      if (!source) return;
      source.scrollIntoView({ behavior: 'smooth', block: 'center' });
      window.setTimeout(() => {
        source.click();
      }, 350);
    });

    syncDisabled();
    document.addEventListener('DOMContentLoaded', syncDisabled);
    window.addEventListener('load', syncDisabled);
    const picker = document.querySelector('.shopify-section--brisa-cores-picker');
    if (picker) {
      const observer = new MutationObserver(syncDisabled);
      observer.observe(picker, { subtree: true, childList: true, attributes: true, attributeFilter: ['disabled'] });
    }
  })();
</script>

