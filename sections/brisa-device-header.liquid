{% liquid
  assign section_id = section.id | replace: '-', '' | downcase
  assign star_color = section.settings.accent_color | default: '#1687d9'
  assign icon_background = '#38adf5'
  assign badge_background = '#35adff'
  assign badge_text_color = '#1379dd'
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .brisa-device-header-{{ section_id }} {
    color: {{ section.settings.text_color }};
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__inner {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__content {
    max-width: 760px;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__intro {
    margin: 0 0 18px;
    color: {{ section.settings.text_color }};
    font-size: 21px;
    font-weight: 400;
    line-height: 1.38;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__stars {
    display: inline-flex;
    gap: 6px;
    color: {{ star_color }};
    line-height: 1;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__star {
    display: block;
    width: 36px;
    height: 36px;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__star svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__rating-text {
    color: {{ section.settings.heading_color }};
    font-size: 25px;
    font-weight: 800;
    line-height: 1.15;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__badge {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 4px 22px;
    color: {{ badge_text_color }};
    background: {{ badge_background }};
    border-radius: 6px;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.1;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: 0.015em;
    text-transform: uppercase;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 72px;
    row-gap: 22px;
    margin-top: 32px;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__feature {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    min-width: 72px;
    min-height: 72px;
    color: #ffffff;
    background: {{ icon_background }};
    border-radius: 50%;
    overflow: hidden;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__icon svg {
    display: block;
    width: 78%;
    height: 78%;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__icon-image {
    display: block;
    width: 58%;
    height: 58%;
    object-fit: contain;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__feature-title {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: 28px;
    font-weight: 900;
    line-height: 1.15;
  }

  .brisa-device-header-{{ section_id }} .brisa-device-header__feature-text {
    margin: 2px 0 0;
    color: {{ section.settings.text_color }};
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: 24px;
      padding-bottom: 24px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__intro {
      font-size: 19px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__heading {
      font-size: {{ section.settings.heading_size | times: 0.72 | round }}px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__stars {
      gap: 4px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__star {
      width: 30px;
      height: 30px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__rating-text {
      font-size: 22px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__badge {
      padding-inline: 14px;
      font-size: 16px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__features {
      column-gap: 18px;
      row-gap: 20px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__feature {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 10px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__icon {
      width: 64px;
      height: 64px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__feature-title {
      font-size: 24px;
    }

    .brisa-device-header-{{ section_id }} .brisa-device-header__feature-text {
      font-size: 17px;
    }
  }

  @media screen and (max-width: 520px) {
    .brisa-device-header-{{ section_id }} .brisa-device-header__features {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="brisa-device-header brisa-device-header-{{ section_id }}" {{ section.shopify_attributes }}>
  <div class="brisa-device-header__inner">
    <div class="brisa-device-header__content">
      {% if section.settings.intro != blank %}
        <p class="brisa-device-header__intro">{{ section.settings.intro | escape }}</p>
      {% endif %}

      {% if section.settings.show_rating %}
        <div class="brisa-device-header__rating" aria-label="{{ section.settings.rating_label | escape }}">
          <span class="brisa-device-header__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <span class="brisa-device-header__star">
                <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
                  <path d="m12 1.9 3.1 6.2 6.9 1-5 4.9 1.2 6.9-6.2-3.2-6.2 3.2L7 14 2 9.1l6.9-1L12 1.9Z"/>
                </svg>
              </span>
            {% endfor %}
          </span>

          {% if section.settings.rating_text != blank %}
            <span class="brisa-device-header__rating-text">{{ section.settings.rating_text | escape }}</span>
          {% endif %}

          {% if section.settings.badge_text != blank %}
            <span class="brisa-device-header__badge">{{ section.settings.badge_text | escape }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% liquid
        assign feature_count = section.blocks.size
        if feature_count == 0
          assign feature_count = 4
        endif
      %}

      {% if section.settings.heading != blank %}
        <h2 class="brisa-device-header__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <div class="brisa-device-header__features">
        {% for i in (1..feature_count) %}
          {% liquid
            assign feature_icon = 'leaf'
            assign feature_title = ''
            assign feature_text = ''
            assign feature_icon_image = blank

            if section.blocks.size > 0
              assign block = section.blocks[forloop.index0]
              assign feature_icon = block.settings.icon
              assign feature_title = block.settings.title
              assign feature_text = block.settings.text
              assign feature_icon_image = block.settings.icon_image
            else
              case forloop.index
                when 1
                  assign feature_icon = 'leaf'
                  assign feature_title = 'Food-Grade Cores'
                  assign feature_text = 'Natural aroma compounds only'
                when 2
                  assign feature_icon = 'no_nicotine'
                  assign feature_title = 'No Nicotine'
                when 3
                  assign feature_icon = 'slot'
                  assign feature_title = 'Slot-in Install'
                when 4
                  assign feature_icon = 'sparkles'
                  assign feature_title = 'Multiple aroma profiles'
              endcase
            endif
          %}

          <div class="brisa-device-header__feature"{% if section.blocks.size > 0 %} {{ block.shopify_attributes }}{% endif %}>
            <div class="brisa-device-header__icon" aria-hidden="true">
              {% if feature_icon_image != blank %}
                <img
                  class="brisa-device-header__icon-image"
                  src="{{ feature_icon_image | image_url: width: 120 }}"
                  alt=""
                  loading="lazy"
                  width="120"
                  height="120"
                >
              {% else %}
                {% case feature_icon %}
                  {% when 'leaf' %}
                    <svg viewBox="0 0 48 48" fill="none" focusable="false">
                      <path d="M40 7C21.5 8.5 10.5 17.5 9 35.5C18.5 37 30.5 31 35.5 21.5" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9.5 36C15.5 25.5 23.5 19.5 35.5 16" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
                    </svg>
                  {% when 'slot' %}
                    <svg viewBox="0 0 48 48" fill="none" focusable="false">
                      <path d="M24 7 41 40H7L24 7Z" stroke="currentColor" stroke-width="3.4" stroke-linejoin="round"/>
                      <path d="M24 15 34 36 24 30 14 36 24 15Z" fill="currentColor"/>
                    </svg>
                  {% when 'no_nicotine' %}
                    <svg viewBox="0 0 48 48" fill="none" focusable="false">
                      <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="3.6"/>
                      <path d="m12 36 24-24" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
                      <path d="M16 26h17.5c2 0 3.5-1.5 3.5-3.5S35.5 19 33.5 19H30" stroke="currentColor" stroke-width="2.7" stroke-linecap="round"/>
                      <path d="M19 19h6M20 19l-3 7" stroke="currentColor" stroke-width="2.7" stroke-linecap="round"/>
                    </svg>
                  {% when 'sparkles' %}
                    <svg viewBox="0 0 48 48" fill="none" focusable="false">
                      <path d="M16 7 18.7 14.3 26 17 18.7 19.7 16 27 13.3 19.7 6 17 13.3 14.3 16 7Z" fill="currentColor"/>
                      <path d="M32 18 34.6 25.4 42 28 34.6 30.6 32 38 29.4 30.6 22 28 29.4 25.4 32 18Z" fill="currentColor"/>
                      <path d="M17 30 18.6 34.4 23 36 18.6 37.6 17 42 15.4 37.6 11 36 15.4 34.4 17 30Z" fill="currentColor"/>
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 48 48" fill="none" focusable="false">
                      <circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="3.5"/>
                      <path d="m16 24 5 5 11-12" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>

            <div class="brisa-device-header__feature-copy">
              {% if feature_title != blank %}
                <h3 class="brisa-device-header__feature-title">{{ feature_title | escape }}</h3>
              {% endif %}

              {% if feature_text != blank %}
                <p class="brisa-device-header__feature-text">{{ feature_text | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brisa device header",
  "class": "shopify-section--brisa-device-header",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "intro",
      "label": "Intro text",
      "default": "Food-grade aroma cores for your Better Unit. Made to slot in, deliver the draw, and keep the moment yours."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Rated 4.7 (163)"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating accessibility label",
      "default": "Rated 4.7 out of 5 by 163 customers"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Happy customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better cores"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#1687d9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 88,
      "step": 2,
      "unit": "px",
      "default": 54
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon",
          "info": "Optional. Replaces the built-in icon if set."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "slot",
              "label": "Slot-in"
            },
            {
              "value": "no_nicotine",
              "label": "No nicotine"
            },
            {
              "value": "sparkles",
              "label": "Sparkles"
            },
            {
              "value": "check",
              "label": "Check"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Food-Grade Cores"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brisa device header",
      "category": "Brisa",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "leaf",
            "title": "Food-Grade Cores",
            "text": "Natural aroma compounds only"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "no_nicotine",
            "title": "No Nicotine"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "slot",
            "title": "Slot-in Install"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "sparkles",
            "title": "Multiple aroma profiles"
          }
        }
      ]
    }
  ]
}
{% endschema %}
