{% render 'brisa-product-testimonials-slider', section: section, show_heading: true %}

{% schema %}
{
  "name": "Brisa product reviews",
  "class": "shopify-section--brisa-testimonials-product-page",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Aussies. Real Reviews."
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Customer experiences vary. Brisa is not a medical device or smoking cessation product."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Legacy testimonial",
      "settings": [
        {
          "type": "paragraph",
          "content": "Legacy blocks are kept only so older page data can save. Reviews displayed by this section come from the testimonial metaobject setting above."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    },
    {
      "type": "video_review",
      "name": "Video review",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Person thumbnail"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Local video",
          "info": "Replaces the external video if both are set."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "External video",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessibility label",
          "default": "customer video review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brisa product reviews",
      "category": "Brisa"
    }
  ]
}
{% endschema %}
