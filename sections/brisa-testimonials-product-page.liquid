{% liquid
  assign section_id = section.id | replace: '-', '' | downcase
  assign testimonial_blocks = section.blocks | where: 'type', 'testimonial'
  assign total_testimonials = testimonial_blocks | size
  assign total_slides = total_testimonials | plus: 1 | divided_by: 2
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .brisa-product-testimonials-{{ section_id }} {
    position: relative;
    display: block;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__viewport {
    position: relative;
    max-width: {{ section.settings.cards_width }}px;
    margin: 0 auto;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__track {
    display: flex;
    transition: transform 450ms ease;
    will-change: transform;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__slide {
    flex: 0 0 100%;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_gap }}px;
    padding: 0 34px;
    box-sizing: border-box;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__card {
    display: grid;
    grid-template-columns: {{ section.settings.avatar_size }}px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    min-height: {{ section.settings.card_min_height }}px;
    padding: {{ section.settings.card_padding }}px;
    background: {{ section.settings.card_background }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    color: {{ section.settings.avatar_text_color }};
    background: {{ section.settings.avatar_background }};
    border-radius: 50%;
    font-size: {{ section.settings.avatar_text_size }}px;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__author {
    margin: 0;
    color: {{ section.settings.author_color }};
    font-size: {{ section.settings.author_size }}px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__stars {
    display: flex;
    gap: 4px;
    margin-top: 4px;
    color: {{ section.settings.star_color }};
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__star {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__star svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__star--empty {
    color: {{ section.settings.star_empty_color }};
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__quote {
    margin: 22px 0 0;
    color: {{ section.settings.quote_color }};
    font-size: {{ section.settings.quote_size }}px;
    line-height: 1.28;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.arrow_button_size }}px;
    height: {{ section.settings.arrow_button_size }}px;
    padding: 0;
    color: {{ section.settings.arrow_color }};
    background: {{ section.settings.arrow_background }};
    border: {{ section.settings.arrow_border_width }}px solid {{ section.settings.arrow_color }};
    border-radius: 50%;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__nav[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__nav--prev {
    left: 0;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__nav--next {
    right: 0;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__nav svg {
    display: block;
    width: {{ section.settings.arrow_icon_size }}px;
    height: {{ section.settings.arrow_icon_size }}px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    background: {{ section.settings.dot_color }};
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__dot[aria-current='true'] {
    background: {{ section.settings.dot_active_color }};
  }

  .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__disclaimer {
    max-width: {{ section.settings.disclaimer_width }}px;
    margin: {{ section.settings.disclaimer_spacing }}px auto 0;
    color: {{ section.settings.disclaimer_color }};
    font-size: {{ section.settings.disclaimer_size }}px;
    line-height: 1.35;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__heading {
      font-size: {{ section.settings.heading_size | times: 0.78 | round }}px;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__slide {
      padding: 0 26px;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__card {
      grid-template-columns: {{ section.settings.mobile_avatar_size }}px minmax(0, 1fr);
      gap: 14px;
      padding: {{ section.settings.mobile_card_padding }}px;
      min-height: auto;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__avatar {
      width: {{ section.settings.mobile_avatar_size }}px;
      height: {{ section.settings.mobile_avatar_size }}px;
      font-size: {{ section.settings.avatar_text_size | times: 0.82 | round }}px;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__author {
      font-size: {{ section.settings.author_size | times: 0.86 | round }}px;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__quote {
      grid-column: 1 / -1;
      margin-top: 8px;
      font-size: {{ section.settings.quote_size | times: 0.9 | round }}px;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__nav {
      width: {{ section.settings.arrow_button_size | times: 0.82 | round }}px;
      height: {{ section.settings.arrow_button_size | times: 0.82 | round }}px;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__nav svg {
      width: {{ section.settings.arrow_icon_size | times: 0.82 | round }}px;
      height: {{ section.settings.arrow_icon_size | times: 0.82 | round }}px;
    }

    .brisa-product-testimonials-{{ section_id }} .brisa-product-testimonials__disclaimer {
      font-size: {{ section.settings.disclaimer_size | times: 0.88 | round }}px;
    }
  }
{% endstyle %}

<brisa-product-testimonials-{{ section_id }}
  class="brisa-product-testimonials brisa-product-testimonials-{{ section_id }}"
  data-total-slides="{{ total_slides }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  {{ section.shopify_attributes }}
>
  {% if section.settings.heading != blank %}
    <h2 class="brisa-product-testimonials__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="brisa-product-testimonials__viewport">
    <div class="brisa-product-testimonials__track">
      {% for testimonial in testimonial_blocks %}
        {% liquid
          assign slide_modulo = forloop.index0 | modulo: 2
          assign author_initial = testimonial.settings.author | strip | slice: 0, 1
          if testimonial.settings.initial != blank
            assign author_initial = testimonial.settings.initial | strip | slice: 0, 1
          endif
        %}

        {% if slide_modulo == 0 %}
          <div class="brisa-product-testimonials__slide">
        {% endif %}

          <article class="brisa-product-testimonials__card" {{ testimonial.shopify_attributes }}>
            <div class="brisa-product-testimonials__avatar" aria-hidden="true">{{ author_initial | escape }}</div>

            <div class="brisa-product-testimonials__copy">
              {% if testimonial.settings.author != blank %}
                <h3 class="brisa-product-testimonials__author">{{ testimonial.settings.author | escape }}</h3>
              {% endif %}

              <div class="brisa-product-testimonials__stars" aria-label="{{ testimonial.settings.rating }} out of 5 stars">
                {% for star in (1..5) %}
                  <span class="brisa-product-testimonials__star {% if star > testimonial.settings.rating %}brisa-product-testimonials__star--empty{% endif %}" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="m12 1.9 3.1 6.2 6.9 1-5 4.9 1.2 6.9-6.2-3.2-6.2 3.2L7 14 2 9.1l6.9-1L12 1.9Z" />
                    </svg>
                  </span>
                {% endfor %}
              </div>

              {% if testimonial.settings.quote != blank %}
                <p class="brisa-product-testimonials__quote">"{{ testimonial.settings.quote | escape }}"</p>
              {% endif %}
            </div>
          </article>

        {% if slide_modulo == 1 or forloop.last %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if total_testimonials > 1 and section.settings.show_arrows %}
      <button class="brisa-product-testimonials__nav brisa-product-testimonials__nav--prev" type="button" aria-label="Previous testimonial">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="m15 5-7 7 7 7" />
        </svg>
      </button>

      <button class="brisa-product-testimonials__nav brisa-product-testimonials__nav--next" type="button" aria-label="Next testimonial">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="m9 5 7 7-7 7" />
        </svg>
      </button>
    {% endif %}
  </div>

  {% if total_slides > 1 and section.settings.show_dots %}
    <div class="brisa-product-testimonials__dots">
      {% for slide in (1..total_slides) %}
        <button
          class="brisa-product-testimonials__dot"
          type="button"
          aria-label="Go to testimonial group {{ forloop.index }}"
          {% if forloop.first %}aria-current="true"{% endif %}
          data-index="{{ forloop.index0 }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.disclaimer != blank %}
    <p class="brisa-product-testimonials__disclaimer">{{ section.settings.disclaimer | escape }}</p>
  {% endif %}
</brisa-product-testimonials-{{ section_id }}>

<script>
  (function() {
    class BrisaProductTestimonials{{ section_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
        this.touchStartX = 0;
        this.touchEndX = 0;
      }

      connectedCallback() {
        this.totalSlides = parseInt(this.dataset.totalSlides, 10) || 0;
        this.track = this.querySelector('.brisa-product-testimonials__track');
        this.prevButton = this.querySelector('.brisa-product-testimonials__nav--prev');
        this.nextButton = this.querySelector('.brisa-product-testimonials__nav--next');
        this.dots = this.querySelectorAll('.brisa-product-testimonials__dot');
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed, 10) || 5000;

        if (!this.track || this.totalSlides <= 1) return;

        this.setupEventListeners();
        this.updateCarousel();

        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNext());
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            this.goToSlide(parseInt(dot.dataset.index, 10));
          });
        });

        this.addEventListener('mouseenter', () => this.pauseAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) this.startAutoplay();
        });

        this.track.addEventListener('touchstart', (event) => {
          this.touchStartX = event.changedTouches[0].screenX;
        }, { passive: true });

        this.track.addEventListener('touchend', (event) => {
          this.touchEndX = event.changedTouches[0].screenX;
          this.handleSwipe();
        }, { passive: true });
      }

      handleSwipe() {
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) < 50) return;
        diff > 0 ? this.goToNext() : this.goToPrev();
      }

      goToPrev() {
        this.goToSlide((this.currentIndex - 1 + this.totalSlides) % this.totalSlides);
      }

      goToNext() {
        this.goToSlide((this.currentIndex + 1) % this.totalSlides);
      }

      goToSlide(index) {
        if (Number.isNaN(index)) return;
        this.currentIndex = index;
        this.updateCarousel();
        this.resetAutoplay();
      }

      updateCarousel() {
        this.track.style.transform = `translateX(${-this.currentIndex * 100}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });
      }

      startAutoplay() {
        this.pauseAutoplay();
        this.autoplayInterval = setInterval(() => this.goToNext(), this.autoplaySpeed);
      }

      pauseAutoplay() {
        if (!this.autoplayInterval) return;
        clearInterval(this.autoplayInterval);
        this.autoplayInterval = null;
      }

      resetAutoplay() {
        if (!this.autoplay) return;
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.pauseAutoplay();
      }
    }

    if (!customElements.get('brisa-product-testimonials-{{ section_id }}')) {
      customElements.define('brisa-product-testimonials-{{ section_id }}', BrisaProductTestimonials{{ section_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Brisa testimonials product page",
  "class": "shopify-section--brisa-testimonials-product-page",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Aussies. Real Reviews."
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Customer experiences vary. Brisa is not a medical device or smoking cessation product."
    },
