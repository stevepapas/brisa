{% liquid
  assign ai_gen_id = section.id | replace: '-', '' | downcase
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .brisa-comparison-{{ ai_gen_id }} {
    color: {{ section.settings.text_color }};
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__header {
    max-width: 760px;
    margin: 0 auto 28px;
    text-align: center;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__subheading {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 18px 4px;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__table {
    position: relative;
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(112px, 1.05fr) repeat(3, minmax(105px, 1fr));
    min-width: 620px;
    max-width: 900px;
    margin: 0 auto;
    isolation: isolate;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__cell {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    border-top: {{ section.settings.line_width }}px solid {{ section.settings.line_color }};
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__cell--label {
    justify-content: flex-start;
    text-align: left;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__cell--heading {
    min-height: 58px;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-top: 0;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__cell--brisa {
    position: relative;
    z-index: 1;
    color: {{ section.settings.brisa_text_color }};
    background: {{ section.settings.brisa_color }};
    border-top-color: transparent;
    box-shadow: 0 0 0 1px {{ section.settings.brisa_color }};
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__cell--brisa-heading {
    min-height: 76px;
    border-radius: {{ section.settings.brisa_radius }}px {{ section.settings.brisa_radius }}px 0 0;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__cell--brisa-last {
    border-radius: 0 0 {{ section.settings.brisa_radius }}px {{ section.settings.brisa_radius }}px;
    min-height: 72px;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__logo {
    display: block;
    max-width: 86px;
    max-height: 42px;
    object-fit: contain;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__logo-text {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4px 8px 2px;
    color: #111111;
    background: #ffffff;
    border-radius: 4px;
    font-family: Georgia, serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.08em;
    text-transform: uppercase;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__logo-text small {
    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__value--icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    border-radius: 50%;
    color: {{ section.settings.icon_color }};
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__cell--brisa .brisa-comparison__value--icon {
    color: {{ section.settings.brisa_icon_color }};
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__value--icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__footnote {
    max-width: 760px;
    margin: 18px auto 0;
    text-align: center;
    font-size: 13px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__heading {
      font-size: {{ section.settings.heading_size | times: 0.74 | round }}px;
    }

    .brisa-comparison-{{ ai_gen_id }} .brisa-comparison__scroll {
      margin: 0 -20px;
      padding-inline: 20px;
    }
  }
</style>

<section class="brisa-comparison brisa-comparison-{{ ai_gen_id }}" {{ section.shopify_attributes }}>
  <div class="brisa-comparison__container">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="brisa-comparison__header">
        {% if section.settings.heading != blank %}
          <h2 class="brisa-comparison__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="brisa-comparison__subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="brisa-comparison__scroll">
      <div class="brisa-comparison__table" role="table" aria-label="{{ section.settings.table_label | escape }}">
        <div class="brisa-comparison__cell brisa-comparison__cell--heading" role="columnheader"></div>

        <div class="brisa-comparison__cell brisa-comparison__cell--heading brisa-comparison__cell--brisa brisa-comparison__cell--brisa-heading" role="columnheader">
          {% if section.settings.brisa_logo != blank %}
            <img
              src="{{ section.settings.brisa_logo | image_url: width: 180 }}"
              alt="{{ section.settings.brisa_heading | escape }}"
              class="brisa-comparison__logo"
              loading="lazy"
              width="{{ section.settings.brisa_logo.width }}"
              height="{{ section.settings.brisa_logo.height }}"
            >
          {% else %}
            <span class="brisa-comparison__logo-text">Brisa <small>Better</small></span>
          {% endif %}
        </div>

        <div class="brisa-comparison__cell brisa-comparison__cell--heading" role="columnheader">{{ section.settings.column_2_heading | escape }}</div>
        <div class="brisa-comparison__cell brisa-comparison__cell--heading" role="columnheader">{{ section.settings.column_3_heading | escape }}</div>
        <div class="brisa-comparison__cell brisa-comparison__cell--heading" role="columnheader">{{ section.settings.column_4_heading | escape }}</div>

        {% for block in section.blocks %}
          {% liquid
            assign is_last_row = false
            if forloop.last
              assign is_last_row = true
            endif
          %}

          <div class="brisa-comparison__cell brisa-comparison__cell--label" role="rowheader" {{ block.shopify_attributes }}>
            {{ block.settings.label | escape }}
          </div>

          <div class="brisa-comparison__cell brisa-comparison__cell--brisa {% if is_last_row %}brisa-comparison__cell--brisa-last{% endif %}" role="cell">
            {% case block.settings.brisa_value_type %}
              {% when 'check' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="Yes">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M10.5 20.5 17 27 30.5 13.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {% when 'cross' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="No">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12.5 12.5 27.5 27.5M27.5 12.5 12.5 27.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
                </span>
              {% when 'text' %}
                <span class="brisa-comparison__value">{{ block.settings.brisa_text | escape }}</span>
            {% endcase %}
          </div>

          <div class="brisa-comparison__cell" role="cell">
            {% case block.settings.column_2_value_type %}
              {% when 'check' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="Yes">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M10.5 20.5 17 27 30.5 13.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {% when 'cross' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="No">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12.5 12.5 27.5 27.5M27.5 12.5 12.5 27.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
                </span>
              {% when 'text' %}
                <span class="brisa-comparison__value">{{ block.settings.column_2_text | escape }}</span>
            {% endcase %}
          </div>

          <div class="brisa-comparison__cell" role="cell">
            {% case block.settings.column_3_value_type %}
              {% when 'check' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="Yes">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M10.5 20.5 17 27 30.5 13.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {% when 'cross' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="No">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12.5 12.5 27.5 27.5M27.5 12.5 12.5 27.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
                </span>
              {% when 'text' %}
                <span class="brisa-comparison__value">{{ block.settings.column_3_text | escape }}</span>
            {% endcase %}
          </div>

          <div class="brisa-comparison__cell" role="cell">
            {% case block.settings.column_4_value_type %}
              {% when 'check' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="Yes">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M10.5 20.5 17 27 30.5 13.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {% when 'cross' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="No">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12.5 12.5 27.5 27.5M27.5 12.5 12.5 27.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
                </span>
              {% when 'text' %}
                <span class="brisa-comparison__value">{{ block.settings.column_4_text | escape }}</span>
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.footnote != blank %}
      <div class="brisa-comparison__footnote rte">{{ section.settings.footnote }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Brisa comparison table",
  "class": "shopify-section--brisa-comparison-table",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brisa vs alternatives"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "table_label",
      "label": "Accessibility label",
      "default": "Brisa comparison table"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "image_picker",
      "id": "brisa_logo",
      "label": "Brisa logo"
    },
    {
      "type": "text",
      "id": "brisa_heading",
      "label": "Brisa column heading",
      "default": "Brisa Better"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Column 2 heading",
      "default": "Vaping"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Column 3 heading",
      "default": "Smoking"
    },
    {
      "type": "text",
      "id": "column_4_heading",
      "label": "Column 4 heading",
      "default": "Nicorette"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Row lines",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "line_width",
      "label": "Row line width",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "brisa_color",
      "label": "Brisa column background",
      "default": "#0798dc"
    },
    {
      "type": "color",
      "id": "brisa_text_color",
      "label": "Brisa column text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Competitor icons",
      "default": "#2350a4"
    },
    {
      "type": "color",
      "id": "brisa_icon_color",
      "label": "Brisa icons",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "brisa_radius",
      "label": "Brisa column corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Nicotine"
        },
        {
          "type": "header",
          "content": "Brisa"
        },
        {
          "type": "select",
          "id": "brisa_value_type",
          "label": "Value type",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" },
            { "value": "blank", "label": "Blank" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "brisa_text",
          "label": "Text value"
        },
        {
          "type": "header",
          "content": "Column 2"
        },
        {
          "type": "select",
          "id": "column_2_value_type",
          "label": "Value type",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" },
            { "value": "blank", "label": "Blank" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "column_2_text",
          "label": "Text value"
        },
        {
          "type": "header",
          "content": "Column 3"
        },
        {
          "type": "select",
          "id": "column_3_value_type",
          "label": "Value type",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" },
            { "value": "blank", "label": "Blank" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "column_3_text",
          "label": "Text value"
        },
        {
          "type": "header",
          "content": "Column 4"
        },
        {
          "type": "select",
          "id": "column_4_value_type",
          "label": "Value type",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" },
            { "value": "blank", "label": "Blank" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "column_4_text",
          "label": "Text value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brisa comparison table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Monthly cost",
            "brisa_value_type": "text",
            "brisa_text": "$45",
            "column_2_value_type": "text",
            "column_2_text": "$300+",
            "column_3_value_type": "text",
            "column_3_text": "$400+",
            "column_4_value_type": "text",
            "column_4_text": "$100+"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Nicotine",
            "brisa_value_type": "cross",
            "column_2_value_type": "check",
            "column_3_value_type": "check",
            "column_4_value_type": "check"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Chemicals",
            "brisa_value_type": "cross",
            "column_2_value_type": "check",
            "column_3_value_type": "check",
            "column_4_value_type": "check"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Ritual kept",
            "brisa_value_type": "check",
            "column_2_value_type": "check",
            "column_3_value_type": "check",
            "column_4_value_type": "cross"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Habit broken",
            "brisa_value_type": "check",
            "column_2_value_type": "cross",
            "column_3_value_type": "cross",
            "column_4_value_type": "cross"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Sensory satisfaction",
            "brisa_value_type": "check",
            "column_2_value_type": "check",
            "column_3_value_type": "check",
            "column_4_value_type": "cross"
          }
        }
      ]
    }
  ]
}
{% endschema %}
