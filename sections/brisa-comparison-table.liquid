<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    --brisa-comparison-text-color: {{ section.settings.text_color }};
    --brisa-comparison-max-width: {{ section.settings.max_width }}px;
    --brisa-comparison-heading-color: {{ section.settings.heading_color }};
    --brisa-comparison-heading-size: {{ section.settings.heading_size }}px;
    --brisa-comparison-line-width: 2px;
    --brisa-comparison-line-color: #333333;
    --brisa-comparison-brisa-text-color: {{ section.settings.brisa_text_color }};
    --brisa-comparison-brisa-color: {{ section.settings.brisa_color }};
    --brisa-comparison-brisa-radius: {{ section.settings.brisa_radius }}px;
    --brisa-comparison-icon-size: {{ section.settings.icon_size }}px;
    --brisa-comparison-icon-color: {{ section.settings.icon_color }};
    --brisa-comparison-brisa-icon-color: {{ section.settings.brisa_icon_color }};
    --brisa-comparison-label-size: {{ section.settings.label_size }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }
  }
</style>

{%- liquid
  assign check_svg = '<svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="currentColor"/><path d="M11.5 20.5 17.2 26.2 28.8 13.8" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  assign check_brisa_svg = '<svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="#fff"/><path d="M11.5 20.5 17.2 26.2 28.8 13.8" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  assign empty_svg = '<svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>'
-%}

<section class="brisa-comparison" {{ section.shopify_attributes }}>
  <div class="brisa-comparison__container">
    <div class="brisa-comparison__header">
      <h2 class="brisa-comparison__heading">
        {% if section.settings.heading != blank %}
          {{ section.settings.heading | escape }}
        {% else %}
          <img
            class="brisa-comparison__heading-logo"
            src="https://cdn.shopify.com/s/files/1/0939/5752/1780/files/brisa-better.png?v=1772423446"
            alt="{{ section.settings.heading_brand | default: 'Brisa Better' | escape }}"
            width="600"
            height="270"
            loading="lazy"
          >
          <span class="brisa-comparison__vs">{{ section.settings.heading_vs | default: 'VS' | escape }}</span>
          <span class="brisa-comparison__rest">{{ section.settings.heading_rest | default: 'THE REST.' | escape }}</span>
        {% endif %}
      </h2>

      {% if section.settings.subheading != blank %}
        <div class="brisa-comparison__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}
    </div>

    <div class="brisa-comparison__scroll">
      <div class="brisa-comparison__table" role="table" aria-label="{{ section.settings.table_label | escape }}">
        <div class="brisa-comparison__cell brisa-comparison__cell--heading" role="columnheader"></div>

        <div class="brisa-comparison__cell brisa-comparison__cell--heading brisa-comparison__cell--brisa brisa-comparison__cell--brisa-heading" role="columnheader">
          {% if section.settings.brisa_logo != blank %}
            <img
              src="{{ section.settings.brisa_logo | image_url: width: 240 }}"
              alt="{{ section.settings.brisa_heading | default: 'Brisa Better' | escape }}"
              class="brisa-comparison__logo"
              loading="lazy"
              width="{{ section.settings.brisa_logo.width }}"
              height="{{ section.settings.brisa_logo.height }}"
            >
          {% else %}
            <img
              src="https://cdn.shopify.com/s/files/1/0939/5752/1780/files/brisa-better.png?v=1772423446"
              alt="{{ section.settings.brisa_heading | default: 'Brisa Better' | escape }}"
              class="brisa-comparison__logo"
              loading="lazy"
              width="600"
              height="270"
            >
          {% endif %}
        </div>

        <div class="brisa-comparison__cell brisa-comparison__cell--heading" role="columnheader">{{ section.settings.column_2_heading | escape }}</div>
        <div class="brisa-comparison__cell brisa-comparison__cell--heading" role="columnheader">{{ section.settings.column_3_heading | escape }}</div>
        <div class="brisa-comparison__cell brisa-comparison__cell--heading" role="columnheader">{{ section.settings.column_4_heading | escape }}</div>

        {% for block in section.blocks %}
          {% liquid
            assign is_last_row = false
            if forloop.last
              assign is_last_row = true
            endif
            assign row_icon = blank
            if block.settings.icon != blank
              assign row_icon = block.settings.icon | image_url: width: 96
            elsif block.settings.icon_asset != blank
              assign row_icon = block.settings.icon_asset | asset_url
            endif
          %}

          <div class="brisa-comparison__cell brisa-comparison__cell--label" role="rowheader" {{ block.shopify_attributes }}>
            {% if row_icon != blank %}
              <span class="brisa-comparison__row-icon" aria-hidden="true">
                <img src="{{ row_icon }}" alt="" loading="lazy" width="40" height="40">
              </span>
            {% endif %}
            <span class="brisa-comparison__row-label">{{ block.settings.label | escape }}</span>
          </div>

          {%- capture brisa_value -%}
            {% case block.settings.brisa_value_type %}
              {% when 'check' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon brisa-comparison__value--check" aria-label="Yes">{{ check_brisa_svg | raw }}</span>
              {% when 'empty' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon brisa-comparison__value--empty" aria-label="No">{{ empty_svg | raw }}</span>
              {% when 'cross' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="No">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12.5 12.5 27.5 27.5M27.5 12.5 12.5 27.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
                </span>
              {% when 'cost' %}
                <div class="brisa-comparison__cost brisa-comparison__cost--brisa">
                  {% if block.settings.brisa_text != blank %}
                    <span class="brisa-comparison__cost-level">{{ block.settings.brisa_text | escape }}</span>
                  {% endif %}
                  {% if block.settings.brisa_subtext != blank %}
                    <span class="brisa-comparison__cost-pill">{{ block.settings.brisa_subtext | escape }}</span>
                  {% endif %}
                </div>
              {% when 'text' %}
                <span class="brisa-comparison__value">{{ block.settings.brisa_text | escape }}</span>
            {% endcase %}
          {%- endcapture -%}

          {%- capture col2_value -%}
            {% case block.settings.column_2_value_type %}
              {% when 'check' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon brisa-comparison__value--check" aria-label="Yes">{{ check_svg | raw }}</span>
              {% when 'empty' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon brisa-comparison__value--empty" aria-label="No">{{ empty_svg | raw }}</span>
              {% when 'cross' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="No">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12.5 12.5 27.5 27.5M27.5 12.5 12.5 27.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
                </span>
              {% when 'cost' %}
                <div class="brisa-comparison__cost">
                  {% if block.settings.column_2_text != blank %}
                    <span class="brisa-comparison__cost-level">{{ block.settings.column_2_text | escape }}</span>
                  {% endif %}
                  {% if block.settings.column_2_subtext != blank %}
                    <span class="brisa-comparison__cost-pill">{{ block.settings.column_2_subtext | escape }}</span>
                  {% endif %}
                </div>
              {% when 'text' %}
                <span class="brisa-comparison__value">{{ block.settings.column_2_text | escape }}</span>
            {% endcase %}
          {%- endcapture -%}

          {%- capture col3_value -%}
            {% case block.settings.column_3_value_type %}
              {% when 'check' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon brisa-comparison__value--check" aria-label="Yes">{{ check_svg | raw }}</span>
              {% when 'empty' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon brisa-comparison__value--empty" aria-label="No">{{ empty_svg | raw }}</span>
              {% when 'cross' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="No">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12.5 12.5 27.5 27.5M27.5 12.5 12.5 27.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
                </span>
              {% when 'cost' %}
                <div class="brisa-comparison__cost">
                  {% if block.settings.column_3_text != blank %}
                    <span class="brisa-comparison__cost-level">{{ block.settings.column_3_text | escape }}</span>
                  {% endif %}
                  {% if block.settings.column_3_subtext != blank %}
                    <span class="brisa-comparison__cost-pill">{{ block.settings.column_3_subtext | escape }}</span>
                  {% endif %}
                </div>
              {% when 'text' %}
                <span class="brisa-comparison__value">{{ block.settings.column_3_text | escape }}</span>
            {% endcase %}
          {%- endcapture -%}

          {%- capture col4_value -%}
            {% case block.settings.column_4_value_type %}
              {% when 'check' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon brisa-comparison__value--check" aria-label="Yes">{{ check_svg | raw }}</span>
              {% when 'empty' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon brisa-comparison__value--empty" aria-label="No">{{ empty_svg | raw }}</span>
              {% when 'cross' %}
                <span class="brisa-comparison__value brisa-comparison__value--icon" aria-label="No">
                  <svg viewBox="0 0 40 40" focusable="false" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12.5 12.5 27.5 27.5M27.5 12.5 12.5 27.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg>
                </span>
              {% when 'cost' %}
                <div class="brisa-comparison__cost">
                  {% if block.settings.column_4_text != blank %}
                    <span class="brisa-comparison__cost-level">{{ block.settings.column_4_text | escape }}</span>
                  {% endif %}
                  {% if block.settings.column_4_subtext != blank %}
                    <span class="brisa-comparison__cost-pill">{{ block.settings.column_4_subtext | escape }}</span>
                  {% endif %}
                </div>
              {% when 'text' %}
                <span class="brisa-comparison__value">{{ block.settings.column_4_text | escape }}</span>
            {% endcase %}
          {%- endcapture -%}

          <div class="brisa-comparison__cell brisa-comparison__cell--brisa {% if is_last_row %}brisa-comparison__cell--brisa-last{% endif %}" role="cell">
            {{ brisa_value }}
          </div>
          <div class="brisa-comparison__cell" role="cell">{{ col2_value }}</div>
          <div class="brisa-comparison__cell" role="cell">{{ col3_value }}</div>
          <div class="brisa-comparison__cell" role="cell">{{ col4_value }}</div>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.footnote != blank %}
      <div class="brisa-comparison__footnote rte">{{ section.settings.footnote }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Brisa comparison table",
  "class": "shopify-section--brisa-comparison-table",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Custom heading (overrides styled title)",
      "info": "Leave blank to use Brand / VS / Rest fields below."
    },
    {
      "type": "text",
      "id": "heading_brand",
      "label": "Heading brand",
      "default": "BRISA"
    },
    {
      "type": "text",
      "id": "heading_vs",
      "label": "Heading VS",
      "default": "VS"
    },
    {
      "type": "text",
      "id": "heading_rest",
      "label": "Heading rest",
      "default": "THE REST."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Everything you love about the habit. None of what it costs you.</p>"
    },
    {
      "type": "text",
      "id": "table_label",
      "label": "Accessibility label",
      "default": "Brisa comparison table"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "image_picker",
      "id": "brisa_logo",
      "label": "Brisa logo"
    },
    {
      "type": "text",
      "id": "brisa_heading",
      "label": "Brisa column heading",
      "default": "Brisa Better"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Column 2 heading",
      "default": "Vaping"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Column 3 heading",
      "default": "Smoking"
    },
    {
      "type": "text",
      "id": "column_4_heading",
      "label": "Column 4 heading",
      "default": "Gums/Patches"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Row lines",
      "default": "#d9d9d9"
    },
    {
      "type": "range",
      "id": "line_width",
      "label": "Row line width",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "brisa_color",
      "label": "Brisa column background",
      "default": "#4eb8ef"
    },
    {
      "type": "color",
      "id": "brisa_text_color",
      "label": "Brisa column text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Competitor icons",
      "default": "#4eb8ef"
    },
    {
      "type": "color",
      "id": "brisa_icon_color",
      "label": "Brisa check accent",
      "default": "#4eb8ef"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Check icon size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Row label size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "brisa_radius",
      "label": "Brisa column corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 640,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 920
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Hand to mouth ritual"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Row icon"
        },
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Theme asset filename",
          "info": "Optional fallback, e.g. brisa-compare-hand.png"
        },
        {
          "type": "header",
          "content": "Brisa"
        },
        {
          "type": "select",
          "id": "brisa_value_type",
          "label": "Value type",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "empty", "label": "Empty circle" },
            { "value": "cross", "label": "Cross" },
            { "value": "cost", "label": "Cost (level + pill)" },
            { "value": "text", "label": "Text" },
            { "value": "blank", "label": "Blank" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "brisa_text",
          "label": "Text / cost level",
          "info": "For cost rows: Low / High"
        },
        {
          "type": "text",
          "id": "brisa_subtext",
          "label": "Cost pill",
          "info": "e.g. $45 / month*"
        },
        {
          "type": "header",
          "content": "Column 2"
        },
        {
          "type": "select",
          "id": "column_2_value_type",
          "label": "Value type",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "empty", "label": "Empty circle" },
            { "value": "cross", "label": "Cross" },
            { "value": "cost", "label": "Cost (level + pill)" },
            { "value": "text", "label": "Text" },
            { "value": "blank", "label": "Blank" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "column_2_text",
          "label": "Text / cost level"
        },
        {
          "type": "text",
          "id": "column_2_subtext",
          "label": "Cost pill"
        },
        {
          "type": "header",
          "content": "Column 3"
        },
        {
          "type": "select",
          "id": "column_3_value_type",
          "label": "Value type",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "empty", "label": "Empty circle" },
            { "value": "cross", "label": "Cross" },
            { "value": "cost", "label": "Cost (level + pill)" },
            { "value": "text", "label": "Text" },
            { "value": "blank", "label": "Blank" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "column_3_text",
          "label": "Text / cost level"
        },
        {
          "type": "text",
          "id": "column_3_subtext",
          "label": "Cost pill"
        },
        {
          "type": "header",
          "content": "Column 4"
        },
        {
          "type": "select",
          "id": "column_4_value_type",
          "label": "Value type",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "empty", "label": "Empty circle" },
            { "value": "cross", "label": "Cross" },
            { "value": "cost", "label": "Cost (level + pill)" },
            { "value": "text", "label": "Text" },
            { "value": "blank", "label": "Blank" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "column_4_text",
          "label": "Text / cost level"
        },
        {
          "type": "text",
          "id": "column_4_subtext",
          "label": "Cost pill"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brisa comparison table"
    }
  ]
}
{% endschema %}
