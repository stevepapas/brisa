    .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__swatch {
      width: 100%;
      height: 100%;
    }

    .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__new-badge {
