    .brisa-cores-picker-{{ section_uid }} .bcp-pack__cores {
      font-size: 13px;
    }

    .brisa-cores-picker-{{ section_uid }} .bcp-pack__flag,
    .brisa-cores-picker-{{ section_uid }} .bcp-pack__save {
      font-size: 8px;
      padding: 3px 5px;
    }
  }
</style>

<section
  class="brisa-cores-picker brisa-cores-picker-{{ section_uid }}"
  data-purchase-mode="onetime"
  {{ section.shopify_attributes }}
>
  {% if section.settings.show_sticky_add_to_cart and product.available %}
    {%- render 'product-sticky-form', product: product, product_form_id: product_form_id -%}
  {% endif %}

  <div class="brisa-cores-picker__inner">
    {%- capture aroma_slot -%}
      <p class="brisa-cores-picker__aroma" data-brisa-cores-aroma-label>
        {{ section.settings.aroma_prefix | escape }} {{ selected_flavour | upcase | escape }}
      </p>
      <p
        class="brisa-cores-picker__aroma-desc"
        data-brisa-cores-aroma-desc
        data-onetime-desc="{{ section.settings.aroma_description | escape }}"
        data-addon-desc="{{ section.settings.addon_aroma_description | default: section.settings.addon_subtitle | escape }}"
      >
        {{ section.settings.aroma_description | escape }}
      </p>
    {%- endcapture -%}

    {% render 'brisa-cores-gallery',
      product: product,
      section: section,
      color_swatch_config: color_swatch_config,
      aroma_slot: aroma_slot
    %}

    <div class="brisa-cores-picker__purchase">
      {% if section.settings.pack_heading != blank %}
        <h2 class="brisa-cores-picker__pack-heading">{{ section.settings.pack_heading | escape }}</h2>
      {% endif %}

      {% if section.settings.pack_subheading != blank %}
        <p class="brisa-cores-picker__pack-subheading">{{ section.settings.pack_subheading | escape }}</p>
      {% endif %}

      {% render 'brisa-cores-pack-cards', section: section %}

      {% if section.settings.value_line != blank %}
        <p class="brisa-cores-picker__value-line">{{ section.settings.value_line }}</p>
      {% endif %}

      {% render 'brisa-cores-better-box', section: section %}

      <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
        {%- render 'product-form', product: product, product_form_id: product_form_id, update_url: true -%}
      </product-rerender>

      {% if section.settings.atc_caption != blank %}
        <p class="brisa-cores-picker__atc-caption">{{ section.settings.atc_caption | escape }}</p>
      {% endif %}

      {% if section.settings.show_trust_row %}
        {% render 'brisa-trust-row',
          trust_1: section.settings.trust_shipping,
          trust_2: section.settings.trust_checkout,
          trust_3: section.settings.trust_social,
          trust_4: section.settings.trust_4,
          trust_5: section.settings.trust_5,
          trust_icon_1: section.settings.trust_icon_shipping,
          trust_icon_2: section.settings.trust_icon_checkout,
          trust_icon_3: section.settings.trust_icon_social,
          trust_icon_4: section.settings.trust_icon_4,
          trust_icon_5: section.settings.trust_icon_5,
          trust_asset_3: 'brisa-trust-star.svg'
        %}
      {% endif %}

      {% if section.settings.show_guarantee %}
        <div class="brisa-product-area-info__guarantee">
          <strong>{{ section.settings.guarantee_heading | escape }}</strong>
          <span>{{ section.settings.guarantee_text | escape }}</span>
        </div>
      {% endif %}

      {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
      {% if accordion_blocks.size > 0 %}
        <div class="bcp-accordions">
          {% for block in accordion_blocks %}
            <details class="bcp-accordion" {{ block.shopify_attributes }}>
              <summary class="bcp-accordion__summary">
                <span class="bcp-accordion__icon" aria-hidden="true">
                  {% if block.settings.icon != blank %}
                    {{ block.settings.icon | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32,48,64', alt: '' }}
                  {% else %}
                    {%- case block.settings.icon_style -%}
                      {%- when 'ingredients' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 12h8M8 15h5"/></svg>
                      {%- when 'subscription' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12a8 8 0 0 1 13.5-5.8M20 12a8 8 0 0 1-13.5 5.8"/><path d="M17 3v4h4M7 21v-4H3"/></svg>
                      {%- when 'shipping' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
                      {%- when 'special' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6h.01M4 12h.01M4 18h.01"/></svg>
                    {%- endcase -%}
                  {% endif %}
                </span>
                <span class="bcp-accordion__title">{{ block.settings.title | escape }}</span>
                <span class="bcp-accordion__toggle" aria-hidden="true"></span>
              </summary>
              <div class="bcp-accordion__body rte">{{ block.settings.content }}</div>
            </details>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    const root = sectionEl.querySelector('.brisa-cores-picker');
    const gallery = sectionEl.querySelector('[data-brisa-cores-gallery]');
    if (!gallery || !root) return;

    const track = gallery.querySelector('[data-brisa-cores-track]');
    const cards = Array.from(gallery.querySelectorAll('[data-brisa-cores-card]'));
    const navItems = Array.from(gallery.querySelectorAll('[data-product-slider-nav]'));
    const captions = Array.from(gallery.querySelectorAll('[data-brisa-cores-caption]'));
    const aromaLabel = sectionEl.querySelector('[data-brisa-cores-aroma-label]');
    const aromaDesc = sectionEl.querySelector('[data-brisa-cores-aroma-desc]');
    const aromaPrefix = {{ section.settings.aroma_prefix | json }};
    const addonCaption = {{ section.settings.addon_gallery_caption | default: 'Monthly better box - NEW!' | json }};
    const purchase = sectionEl.querySelector('[data-brisa-cores-purchase]');
    const modeInputs = Array.from(sectionEl.querySelectorAll('[data-brisa-cores-mode]'));
    const modeOptions = Array.from(sectionEl.querySelectorAll('[data-brisa-cores-mode-option]'));
    const packButtons = Array.from(sectionEl.querySelectorAll('[data-brisa-cores-pack]'));
    let currentIndex = 0;
    let purchaseMode = 'onetime';

    function ensureQuantityInput(form) {
      if (!form) return null;
      let input = form.querySelector('input[name="quantity"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'quantity';
        input.value = '6';
        form.appendChild(input);
      }
      return input;
    }

    function getForm() {
      return sectionEl.querySelector('form[id="{{ product_form_id }}"]') || document.getElementById('{{ product_form_id }}');
    }

    function setPackQuantity(qty) {
      const form = getForm();
      const input = ensureQuantityInput(form);
      if (input) {
        input.value = String(qty);
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    function selectPack(button) {
      if (!button) return;
      packButtons.forEach((btn) => {
        const on = btn === button;
        btn.classList.toggle('is-selected', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      setPackQuantity(parseInt(button.dataset.packQty || '1', 10));
    }

    function syncVariantPicker(index) {
      const card = cards[index];
      if (!card) return;

      const variantId = String(card.dataset.variantId || '');
      const slideLabel = (card.dataset.slideLabel || '').trim().toLowerCase();
      const form = getForm();
      if (form && variantId) {
        const idInput = form.querySelector('input[name="id"]');
        if (idInput && idInput.value !== variantId) {
          idInput.value = variantId;
          idInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      const variantPicker = sectionEl.querySelector('variant-picker');
      if (!variantPicker) return;

      const radios = variantPicker.querySelectorAll('.color-swatch__radio, .block-swatch__radio');
      radios.forEach((radio) => {
        const radioVariantId = radio.dataset.variantId || radio.value || '';
        const label = radio.labels && radio.labels[0] ? radio.labels[0].textContent.trim().toLowerCase() : '';
        const match = (variantId && String(radioVariantId) === variantId) ||
          (slideLabel && label === slideLabel);
        if (match && !radio.checked) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    }

    function updateGallery(index) {
      if (!track || cards.length === 0) return;

      currentIndex = (index + cards.length) % cards.length;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      navItems.forEach((item, itemIndex) => {
        const isActive = itemIndex === currentIndex;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-checked', isActive ? 'true' : 'false');
        if (isActive) {
          item.setAttribute('aria-current', 'true');
        } else {
          item.removeAttribute('aria-current');
        }
      });

      captions.forEach((caption, captionIndex) => {
        if (purchaseMode === 'addon') {
          caption.classList.toggle('is-active', captionIndex === 0);
          if (captionIndex === 0) caption.textContent = addonCaption;
        } else {
          caption.classList.toggle('is-active', captionIndex === currentIndex);
        }
      });

      const card = cards[currentIndex];
      if (!card) return;

      if (aromaLabel && purchaseMode !== 'addon') {
        const label = card.dataset.slideLabel || '';
        aromaLabel.textContent = `${aromaPrefix} ${label.toUpperCase()}`.trim();
      }

      if (purchaseMode !== 'addon') syncVariantPicker(currentIndex);
    }

    function setPurchaseMode(mode) {
      const available = purchase?.dataset.addonAvailable !== 'false';
      if (mode === 'addon' && !available) mode = 'onetime';
      purchaseMode = mode;
      root.dataset.purchaseMode = mode;

      modeOptions.forEach((option) => {
        option.classList.toggle('is-selected', option.dataset.mode === mode);
      });
      modeInputs.forEach((input) => {
        input.checked = input.value === mode;
      });

      if (aromaDesc) {
        const next = mode === 'addon'
          ? (aromaDesc.dataset.addonDesc || '')
          : (aromaDesc.dataset.onetimeDesc || '');
        if (next) aromaDesc.textContent = next;
      }

      if (aromaLabel && mode === 'addon') {
        aromaLabel.textContent = {{ section.settings.addon_aroma_label | default: 'AROMA PROFILE — MONTHLY BETTER BOX' | json }};
      } else {
        updateGallery(currentIndex);
      }

      if (mode === 'addon') {
        captions.forEach((caption, captionIndex) => {
          caption.classList.toggle('is-active', captionIndex === 0);
          if (captionIndex === 0) caption.textContent = addonCaption;
        });
      } else {
        updateGallery(currentIndex);
      }
    }

    async function addAddonToCart() {
      const variantId = purchase?.dataset.addonVariantId;
      const sellingPlanId = purchase?.dataset.addonSellingPlanId;
      if (!variantId || !sellingPlanId) {
        throw new Error('Monthly Better Box is unavailable.');
      }

      const res = await fetch(window.themeVariables?.routes?.cartAddUrl || '/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          items: [
            {
              id: String(variantId),
              quantity: 1,
              selling_plan: String(sellingPlanId),
              properties: {
                _bundle: 'brisa-cores-addon',
              },
            },
          ],
          sections: ['mini-cart'],
        }),
      });

      const payload = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(payload.description || payload.message || 'Could not add Monthly Better Box.');
      }

      const cartRes = await fetch(`${window.themeVariables?.routes?.cartUrl || '/cart'}.js`);
      const cartContent = await cartRes.json();
      cartContent.sections = payload.sections;
      document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart: cartContent } }));
      document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
        bubbles: true,
        detail: {
          cart: cartContent,
          openMiniCart: window.themeVariables?.settings?.cartType === 'drawer',
        },
      }));
      document.documentElement.dispatchEvent(new CustomEvent('cart-notification:show', {
        bubbles: true,
        cancelable: true,
        detail: { status: 'success', error: '' },
      }));
    }

    packButtons.forEach((button) => {
      button.addEventListener('click', () => selectPack(button));
    });

    modeInputs.forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) setPurchaseMode(input.value);
      });
    });

    modeOptions.forEach((option) => {
      option.addEventListener('click', (event) => {
        if (option.classList.contains('is-sold-out')) {
          event.preventDefault();
          return;
        }
      });
    });

    sectionEl.addEventListener('submit', async (event) => {
      if (purchaseMode !== 'addon') return;
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (form.id !== '{{ product_form_id }}') return;
      event.preventDefault();
      event.stopImmediatePropagation();

      const submitButtons = Array.from(form.querySelectorAll('[type="submit"]'));
      submitButtons.forEach((btn) => {
        btn.setAttribute('disabled', 'disabled');
        btn.setAttribute('aria-busy', 'true');
      });

      try {
        await addAddonToCart();
      } catch (err) {
        document.documentElement.dispatchEvent(new CustomEvent('cart-notification:show', {
          bubbles: true,
          cancelable: true,
          detail: { status: 'error', error: err.message || 'Add to cart failed' },
        }));
      } finally {
        submitButtons.forEach((btn) => {
          btn.removeAttribute('disabled');
          btn.removeAttribute('aria-busy');
        });
      }
    }, true);

    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        if (item.dataset.available === 'false' || item.classList.contains('is-sold-out')) return;
        if (purchaseMode === 'addon') setPurchaseMode('onetime');
        updateGallery(parseInt(item.dataset.index, 10));
      });
    });

    document.addEventListener('variant:change', (event) => {
      if (!event.detail || !event.detail.variant) return;
      const variantId = String(event.detail.variant.id);
      const cardIndex = cards.findIndex((card) => card.dataset.variantId === variantId);
      if (cardIndex >= 0 && cardIndex !== currentIndex) {
        updateGallery(cardIndex);
      }
    });

    const popularName = {{ section.settings.popular_variant_name | downcase | json }};
    let startIndex = 0;
    if (popularName) {
      const popularIndex = cards.findIndex((card) => (card.dataset.slideLabel || '').trim().toLowerCase() === popularName);
      if (popularIndex >= 0) startIndex = popularIndex;
    }
    updateGallery(startIndex);

    const defaultPack = packButtons.find((btn) => btn.classList.contains('is-selected')) || packButtons[1] || packButtons[0];
    selectPack(defaultPack);
    setPurchaseMode('onetime');
  })();
</script>

{% schema %}
