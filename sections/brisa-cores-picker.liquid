{% liquid
  assign section_uid = section.id | replace: '-', '' | downcase
  assign color_swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />'
  assign selected_variant = product.selected_or_first_available_variant
  assign selected_flavour = selected_variant.metafields.custom.flavour.value | default: selected_variant.metafields.custom.flavour | default: selected_variant.title
%}

{%- capture product_form_id -%}product-form-cores-{{ product.id }}-{{ section.id }}{%- endcapture -%}
{%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if buy_buttons_block -%}
      {%- if buy_buttons_block.settings.atc_button_background == 'rgba(0,0,0,0)' -%}
        {%- assign primary_button_background = settings.primary_button_background -%}
      {%- else -%}
        {%- assign primary_button_background = buy_buttons_block.settings.atc_button_background -%}
      {%- endif -%}

      {%- if buy_buttons_block.settings.atc_button_text_color == 'rgba(0,0,0,0)' -%}
        {%- assign primary_button_text_color = settings.primary_button_text_color -%}
      {%- else -%}
        {%- assign primary_button_text_color = buy_buttons_block.settings.atc_button_text_color -%}
      {%- endif -%}

      --primary-button-background: {{ primary_button_background.red }}, {{ primary_button_background.green }}, {{ primary_button_background.blue }};
      --primary-button-text-color: {{ primary_button_text_color.red }}, {{ primary_button_text_color.green }}, {{ primary_button_text_color.blue }};
    {%- endif -%}
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .brisa-cores-picker-{{ section_uid }} {
    color: {{ section.settings.text_color }};
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__aroma {
    margin: 0 0 8px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.aroma_label_size }}px;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__aroma-desc {
    margin: 0 0 {{ section.settings.gallery_spacing }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.aroma_text_size }}px;
    font-weight: 400;
    line-height: 1.35;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ section.settings.nav_gap }}px;
    margin-bottom: {{ section.settings.swatch_spacing }}px;
  }

  /* Circular thumbs ARE the flavour swatches (sole selector; form swatches hidden). */
  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__nav {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0;
    color: {{ section.settings.text_color }};
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__nav.is-sold-out {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__swatch {
    display: block;
    width: {{ section.settings.swatch_size }}px;
    height: {{ section.settings.swatch_size }}px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    border: 2px solid transparent;
    border-radius: 50%;
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__nav.is-active .product-slider__swatch {
    border-color: {{ section.settings.active_nav_color }};
    transform: scale(1.08);
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__swatch-label {
    display: block;
    max-width: {{ section.settings.swatch_label_width }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.swatch_text_size }}px;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__viewport {
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.card_background }};
    {% if section.settings.slide_background_image != blank %}
      background-image: url({{ section.settings.slide_background_image | image_url: width: 1600 }});
    {% endif %}
    background-position: center;
    background-size: cover;
    border-radius: 0 !important;
    -webkit-mask-image: none !important;
    mask-image: none !important;
    clip-path: none !important;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__image,
  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__image-wrapper {
    border-radius: 0 !important;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__aroma-slot {
    margin: 0 0 12px;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__caption {
    border-radius: 0;
  }

  /* Purchase mode: one-time + Monthly Better Box */
  .brisa-cores-picker-{{ section_uid }} .bcp-purchase {
    display: grid;
    gap: 12px;
    margin: 16px 0 18px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__option {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    gap: 10px 12px;
    align-items: start;
    margin: 0;
    padding: 14px 14px 16px;
    border: 2px solid #d8d8d8;
    border-radius: 14px;
    background: #fff;
    cursor: pointer;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__option--addon {
    grid-template-columns: 22px minmax(0, 1fr);
    background: #e8f6ff;
    border-color: #23aee8;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__option.is-selected {
    border-color: #23aee8;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__option.is-sold-out {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__radio-ui {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    border: 2px solid #23aee8;
    border-radius: 50%;
    box-sizing: border-box;
    background: #fff;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__option.is-selected .bcp-purchase__radio-ui {
    box-shadow: inset 0 0 0 5px #23aee8;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__option-title {
    display: inline-block;
    color: #111;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.2;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__option-price {
    color: #111;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon {
    display: grid;
    gap: 10px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__save {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    background: #e11d48;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__save--sold-out {
    background: #666;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-thumb {
    width: 110px;
    height: 110px;
    object-fit: contain;
    border-radius: 0 !important;
    flex-shrink: 0;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-subtitle,
  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-meta,
  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-contents {
    margin: 0;
    color: #6b6b6b;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.35;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-price {
    color: #111;
    font-size: 28px;
    font-weight: 900;
    line-height: 1;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-compare {
    color: #8a8a8a;
    font-size: 16px;
    font-weight: 700;
    text-decoration: line-through;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__bonus {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: #e7f8ea;
    border-radius: 12px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__bonus-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    padding: 5px 10px;
    border-radius: 999px;
    background: #22c55e;
    color: #fff;
    font-size: 11px;
    font-weight: 900;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__bonus-text {
    flex: 1;
    margin: 0;
    color: #166534;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__bonus-media {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 0 !important;
    flex-shrink: 0;
    margin-left: auto;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__breakdown {
    display: grid;
    gap: 8px;
    padding: 12px;
    background: #fff;
    border: 1px solid #23aee8;
    border-radius: 12px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__breakdown-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    color: #111;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.3;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__breakdown-row--free {
    color: #166534;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__breakdown-row--free strong {
    color: #166534;
    font-weight: 800;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__breakdown-row s {
    color: #8a8a8a;
    font-weight: 600;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__breakdown-row--total {
    padding-top: 8px;
    border-top: 1px solid #e5e5e5;
    color: #6b6b6b;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__breakdown-row--pay {
    font-size: 16px;
    font-weight: 800;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-purchase__addon-footer {
    margin: 0;
    color: #111;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }}[data-purchase-mode="addon"] .product-form__variants {
    opacity: 0.45;
    pointer-events: none;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordions {
    margin: 22px 0 0;
    border-top: 1px solid #e6e6e6;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion {
    border-bottom: 1px solid #e6e6e6;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__summary {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) 18px;
    align-items: center;
    gap: 12px;
    padding: 14px 2px;
    list-style: none;
    cursor: pointer;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__icon {
    width: 22px;
    height: 22px;
    color: #666;
    border-radius: 0 !important;
    overflow: visible;
    -webkit-mask-image: none !important;
    mask-image: none !important;
    clip-path: none !important;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__icon img,
  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Override global img { border-radius: 10px } which circles small 22px icons */
    border-radius: 0 !important;
    overflow: visible;
    -webkit-mask-image: none !important;
    mask-image: none !important;
    clip-path: none !important;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__title {
    color: #111;
    font-size: 14px;
    font-weight: 700;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__toggle {
    position: relative;
    width: 14px;
    height: 14px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__toggle::before,
  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__toggle::after {
    content: '';
    position: absolute;
    background: #111;
    inset: 50% auto auto 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__toggle::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion[open] .bcp-accordion__toggle::after {
    opacity: 0;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__body {
    padding: 0 2px 14px 38px;
    color: #444;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__body > *:first-child {
    margin-top: 0;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-accordion__body > *:last-child {
    margin-bottom: 0;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__track {
    display: flex;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__card {
    flex: 0 0 100%;
    min-width: 100%;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__image-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.card_height }}px;
    padding: {{ section.settings.image_padding }}px 20px;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__image {
    display: block;
    width: auto;
    max-width: {{ section.settings.image_width }}%;
    max-height: {{ section.settings.image_max_height }}px;
    object-fit: contain;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__caption {
    display: none;
    margin: 12px 0 0;
    color: {{ section.settings.popular_color }};
    font-size: {{ section.settings.popular_size }}px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__caption.is-active {
    display: block;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__purchase {
    margin-top: {{ section.settings.purchase_spacing }}px;
    padding-top: {{ section.settings.purchase_border_padding }}px;
    border-top: 1px solid {{ section.settings.purchase_border_color }};
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__pack-heading {
    margin: 0 0 6px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.pack_heading_size }}px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: left;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__pack-subheading {
    margin: 0 0 18px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.pack_subheading_size }}px;
    font-weight: 400;
    line-height: 1.35;
    text-align: left;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__value-line {
    margin: 14px 0 0;
    color: {{ section.settings.muted_color }};
    font-size: {{ section.settings.value_line_size }}px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    text-align: center;
    text-transform: none;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__atc-caption {
    margin: 12px 0 0;
    color: {{ section.settings.muted_color }};
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__swatch-wrap {
    position: relative;
    display: inline-flex;
    width: {{ section.settings.swatch_size }}px;
    height: {{ section.settings.swatch_size }}px;
    border-radius: 50%;
    overflow: hidden;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__swatch-wrap .product-slider__swatch {
    width: 100%;
    height: 100%;
  }

  /* NEW pill sits inside the circle: white bg, blue text */
  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__new-badge {
    position: absolute;
    top: 6px;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
    padding: 2px 5px;
    border-radius: 999px;
    background: #fff;
    color: #008bdc;
    font-size: 8px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-packs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    align-items: stretch;
    margin: 0 0 8px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-height: 148px;
    margin: 0;
    padding: 18px 8px 12px;
    border: 2px solid #d8d8d8;
    border-radius: 14px;
    background: #fff;
    color: #111;
    cursor: pointer;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack.is-selected {
    border-color: #23aee8;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack--value.is-selected {
    border-color: #e11d48;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__flag {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 3px 8px;
    border-radius: 999px;
    background: #23aee8;
    color: #fff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__flag--value {
    background: #e11d48;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__cores {
    font-size: 15px;
    font-weight: 800;
    line-height: 1.15;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__meta {
    color: #666;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.2;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__price-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__price {
    font-size: 22px;
    font-weight: 900;
    line-height: 1.1;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__compare {
    color: #8a8a8a;
    font-size: 13px;
    font-weight: 600;
    text-decoration: line-through;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__unit {
    color: #666;
    font-size: 11px;
    font-weight: 400;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__save {
    margin-top: auto;
    padding: 4px 8px;
    border-radius: 999px;
    background: #23aee8;
    color: #fff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .brisa-cores-picker-{{ section_uid }} .bcp-pack__save--value {
    background: #e11d48;
  }

  .brisa-cores-picker-{{ section_uid }}[data-purchase-mode="addon"] .bcp-packs {
    opacity: 0.45;
    pointer-events: none;
  }

  .brisa-cores-picker-{{ section_uid }} .product-form__quantity,
  .brisa-cores-picker-{{ section_uid }} .product-form__option-info {
    display: none !important;
  }

  /* Hide duplicate form swatches — gallery circular thumbs are the only selector. */
  .brisa-cores-picker-{{ section_uid }} .product-form__variants,
  .brisa-cores-picker-{{ section_uid }} .product-form__option-selector,
  .brisa-cores-picker-{{ section_uid }} variant-picker,
  .brisa-cores-picker-{{ section_uid }} .color-swatch-list,
  .brisa-cores-picker-{{ section_uid }} .block-swatch-list {
    display: none !important;
  }

  .brisa-cores-picker-{{ section_uid }} .product-form__text {
    display: none !important;
  }

  .brisa-cores-picker-{{ section_uid }}[data-purchase-mode="addon"] .shopify-payment-button,
  .brisa-cores-picker-{{ section_uid }}[data-purchase-mode="addon"] shopify-accelerated-checkout {
    display: none !important;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-product-area-info__guarantee {
