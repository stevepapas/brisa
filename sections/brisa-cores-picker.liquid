{% liquid
  assign section_uid = section.id | replace: '-', '' | downcase
  assign color_swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />'
  assign selected_variant = product.selected_or_first_available_variant
  assign selected_flavour = selected_variant.metafields.custom.flavour.value | default: selected_variant.metafields.custom.flavour | default: selected_variant.title
%}

{%- capture product_form_id -%}product-form-cores-{{ product.id }}-{{ section.id }}{%- endcapture -%}
{%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if buy_buttons_block -%}
      {%- if buy_buttons_block.settings.atc_button_background == 'rgba(0,0,0,0)' -%}
        {%- assign primary_button_background = settings.primary_button_background -%}
      {%- else -%}
        {%- assign primary_button_background = buy_buttons_block.settings.atc_button_background -%}
      {%- endif -%}

      {%- if buy_buttons_block.settings.atc_button_text_color == 'rgba(0,0,0,0)' -%}
        {%- assign primary_button_text_color = settings.primary_button_text_color -%}
      {%- else -%}
        {%- assign primary_button_text_color = buy_buttons_block.settings.atc_button_text_color -%}
      {%- endif -%}

      --primary-button-background: {{ primary_button_background.red }}, {{ primary_button_background.green }}, {{ primary_button_background.blue }};
      --primary-button-text-color: {{ primary_button_text_color.red }}, {{ primary_button_text_color.green }}, {{ primary_button_text_color.blue }};
    {%- endif -%}
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .brisa-cores-picker-{{ section_uid }} {
    color: {{ section.settings.text_color }};
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__aroma {
    margin: 0 0 8px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.aroma_label_size }}px;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__aroma-desc {
    margin: 0 0 {{ section.settings.gallery_spacing }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.aroma_text_size }}px;
    font-weight: 400;
    line-height: 1.35;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ section.settings.nav_gap }}px;
    margin-bottom: {{ section.settings.swatch_spacing }}px;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__nav {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0;
    color: {{ section.settings.text_color }};
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__swatch {
    display: block;
    width: {{ section.settings.swatch_size }}px;
    height: {{ section.settings.swatch_size }}px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    border: 2px solid transparent;
    border-radius: 50%;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__nav.is-active .product-slider__swatch {
    border-color: {{ section.settings.active_nav_color }};
    transform: scale(1.08);
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__swatch-label {
    display: block;
    max-width: {{ section.settings.swatch_label_width }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.swatch_text_size }}px;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__viewport {
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.card_background }};
    {% if section.settings.slide_background_image != blank %}
      background-image: url({{ section.settings.slide_background_image | image_url: width: 1600 }});
    {% endif %}
    background-position: center;
    background-size: cover;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__track {
    display: flex;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__card {
    flex: 0 0 100%;
    min-width: 100%;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__image-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.card_height }}px;
    padding: {{ section.settings.image_padding }}px 20px;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__image {
    display: block;
    width: auto;
    max-width: {{ section.settings.image_width }}%;
    max-height: {{ section.settings.image_max_height }}px;
    object-fit: contain;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__caption {
    display: none;
    margin: 12px 0 0;
    color: {{ section.settings.popular_color }};
    font-size: {{ section.settings.popular_size }}px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__caption.is-active {
    display: block;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__purchase {
    margin-top: {{ section.settings.purchase_spacing }}px;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__pack-heading {
    margin: 0 0 6px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.pack_heading_size }}px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__pack-subheading {
    margin: 0 0 18px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.pack_subheading_size }}px;
    font-weight: 400;
    line-height: 1.35;
    text-align: center;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-cores-picker__value-line {
    margin: 14px 0 0;
    color: {{ section.settings.muted_color }};
    font-size: {{ section.settings.value_line_size }}px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }

  .brisa-cores-picker-{{ section_uid }} .brisa-product-area-info__guarantee {
    margin-top: 20px;
  }

  .brisa-cores-picker-{{ section_uid }} .product-form__option-selector[data-selector-type="swatch"] {
    display: none !important;
  }

  .brisa-cores-picker-{{ section_uid }} .product-form__description,
  .brisa-cores-picker-{{ section_uid }} .product-form__text .rte > p:first-child strong:empty {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__image-wrapper {
      min-height: {{ section.settings.mobile_card_height }}px;
    }

    .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__image {
      max-height: {{ section.settings.mobile_image_max_height }}px;
    }

    .brisa-cores-picker-{{ section_uid }} .brisa-cores-gallery__swatches .product-slider__swatch {
      width: {{ section.settings.swatch_size | times: 0.86 | round }}px;
      height: {{ section.settings.swatch_size | times: 0.86 | round }}px;
    }
  }
</style>

<section class="brisa-cores-picker brisa-cores-picker-{{ section_uid }}" {{ section.shopify_attributes }}>
  {% if section.settings.show_sticky_add_to_cart and product.available %}
    {%- render 'product-sticky-form', product: product, product_form_id: product_form_id -%}
  {% endif %}

  <div class="brisa-cores-picker__inner">
    <p class="brisa-cores-picker__aroma" data-brisa-cores-aroma-label>
      {{ section.settings.aroma_prefix | escape }} {{ selected_flavour | upcase | escape }}
    </p>

    {% if section.settings.aroma_description != blank %}
      <p class="brisa-cores-picker__aroma-desc">{{ section.settings.aroma_description | escape }}</p>
    {% endif %}

    {% render 'brisa-cores-gallery',
      product: product,
      section: section,
      color_swatch_config: color_swatch_config
    %}

    <div class="brisa-cores-picker__purchase">
      {% if section.settings.pack_heading != blank %}
        <h2 class="brisa-cores-picker__pack-heading">{{ section.settings.pack_heading | escape }}</h2>
      {% endif %}

      {% if section.settings.pack_subheading != blank %}
        <p class="brisa-cores-picker__pack-subheading">{{ section.settings.pack_subheading | escape }}</p>
      {% endif %}

      <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
        {%- render 'product-form', product: product, product_form_id: product_form_id, update_url: true -%}
      </product-rerender>

      {% if section.settings.show_guarantee %}
        <div class="brisa-product-area-info__guarantee">
          <strong>{{ section.settings.guarantee_heading | escape }}</strong>
          <span>{{ section.settings.guarantee_text | escape }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const gallery = section.querySelector('[data-brisa-cores-gallery]');
    if (!gallery) return;

    const track = gallery.querySelector('[data-brisa-cores-track]');
    const cards = Array.from(gallery.querySelectorAll('[data-brisa-cores-card]'));
    const navItems = Array.from(gallery.querySelectorAll('[data-product-slider-nav]'));
    const captions = Array.from(gallery.querySelectorAll('[data-brisa-cores-caption]'));
    const aromaLabel = section.querySelector('[data-brisa-cores-aroma-label]');
    const aromaPrefix = {{ section.settings.aroma_prefix | json }};
    let currentIndex = 0;

    function syncVariantPicker(index) {
      const card = cards[index];
      if (!card) return;

      const slideLabel = (card.dataset.slideLabel || '').trim().toLowerCase();
      const variantPicker = section.querySelector('variant-picker');
      if (!variantPicker || !slideLabel) return;

      const radios = variantPicker.querySelectorAll('.color-swatch__radio, .block-swatch__radio');
      radios.forEach((radio) => {
        const label = radio.labels && radio.labels[0] ? radio.labels[0].textContent.trim().toLowerCase() : '';
        if (label === slideLabel && !radio.checked) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    }

    function updateGallery(index) {
      if (!track || cards.length === 0) return;

      currentIndex = (index + cards.length) % cards.length;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      navItems.forEach((item, itemIndex) => {
        const isActive = itemIndex === currentIndex;
        item.classList.toggle('is-active', isActive);
        if (isActive) {
          item.setAttribute('aria-current', 'true');
        } else {
          item.removeAttribute('aria-current');
        }
      });

      captions.forEach((caption, captionIndex) => {
        caption.classList.toggle('is-active', captionIndex === currentIndex);
      });

      const card = cards[currentIndex];
      if (!card) return;

      if (aromaLabel) {
        const label = card.dataset.slideLabel || '';
        aromaLabel.textContent = `${aromaPrefix} ${label.toUpperCase()}`.trim();
      }

      syncVariantPicker(currentIndex);
    }

    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        updateGallery(parseInt(item.dataset.index, 10));
      });
    });

    document.addEventListener('variant:change', (event) => {
      if (!event.detail || !event.detail.variant) return;
      const variantId = String(event.detail.variant.id);
      const cardIndex = cards.findIndex((card) => card.dataset.variantId === variantId);
      if (cardIndex >= 0 && cardIndex !== currentIndex) {
        updateGallery(cardIndex);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Brisa cores picker",
  "class": "shopify-section--brisa-cores-picker",
  "settings": [
    {
      "type": "header",
      "content": "Aroma"
    },
    {
      "type": "text",
      "id": "aroma_prefix",
      "label": "Aroma label prefix",
      "default": "Aroma —"
    },
    {
      "type": "textarea",
      "id": "aroma_description",
      "label": "Aroma description",
      "default": "Mint Ice is the daily. Watermelon and Black Currant rotate in for variety."
    },
    {
      "type": "text",
      "id": "option_name",
      "label": "Color option name",
      "default": "Color"
    },
    {
      "type": "checkbox",
      "id": "use_swatch_nav",
      "label": "Use colour swatches",
      "default": true
    },
    {
      "type": "select",
      "id": "swatch_color_source",
      "label": "Swatch color source",
      "options": [
        {
          "value": "carousel_swatch_colour",
          "label": "carousel_swatch_colour metafield"
        },
        {
          "value": "product_option",
          "label": "Product option swatch"
        }
      ],
      "default": "carousel_swatch_colour"
    },
    {
      "type": "select",
      "id": "swatch_label_source",
      "label": "Swatch label source",
      "options": [
        {
          "value": "product_option",
