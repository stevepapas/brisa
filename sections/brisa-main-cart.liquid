      "default": "4 payments of [amount] with Afterpay"
    },
    {
      "type": "image_picker",
      "id": "afterpay_logo",
      "label": "Afterpay logo"
    },
    {
      "type": "header",
      "content": "Guarantee & trust"
    },
    {
      "type": "checkbox",
      "id": "show_guarantee",
      "label": "Show guarantee",
      "default": true
    },
    {
      "type": "text",
      "id": "guarantee_heading",
      "label": "Guarantee heading",
      "default": "30-DAY SUCCESS GUARANTEE"
    },
    {
      "type": "textarea",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "If Brisa doesn't work for you in 30-days, we'll send you 3 weeks of cores FREE and book a 1-on-1 call to make sure it does. We don't stop until you've kicked the habit."
    },
