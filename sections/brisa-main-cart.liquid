      "id": "trust_reviews",
      "label": "Trust — reviews",
      "default": "⭐ 4.7/5 (163 reviews)"
    },
    {
      "type": "text",
      "id": "trust_social",
      "label": "Trust — social proof",
      "default": "🇦🇺 1,000+ Aussies on Brisa"
    },
    {
      "type": "text",
      "id": "trust_checkout",
      "label": "Trust — checkout",
      "default": "🔒 Secure Checkout"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show urgency banner",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency text",
      "default": "⚡️ WE SOLD OUT FAST LAST TIME - GET IN QUICK AND ORDER NOW"
    },
    {
      "type": "text",
      "id": "checkout_button_text",
      "label": "Checkout button text",
      "default": "SECURE CHECKOUT - [total] >"
    },
    {
      "type": "checkbox",
      "id": "show_payment_methods",
      "label": "Show payment methods",
      "default": true
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "Empty cart button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty cart title",
      "default": "Your Cart"
    }
  ]
}
{% endschema %}
