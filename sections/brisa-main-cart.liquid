{% liquid
  assign section_uid = section.id | replace: '-', '' | downcase
  assign kit_handles_setting = section.settings.kit_trigger_handles
  if kit_handles_setting == blank
    assign kit_handles_setting = section.settings.gift_trigger_handles
  endif
  if kit_handles_setting == blank
    assign kit_handles_setting = 'brisa-starter-kit,starter-kit,the-commitment-kit,commitment-kit,brisa-mates-pack,mates-pack'
  endif
  assign kit_trigger_handles = kit_handles_setting | downcase | split: ','
  assign has_kit_product = false
  assign show_gift_bonus = false

  for line_item in cart.items
    assign item_handle = line_item.product.handle | downcase
    assign line_kit_key = line_item.properties['_kit_key'] | downcase
    if line_kit_key == 'try' or line_kit_key == 'commitment' or line_kit_key == 'mates'
      assign has_kit_product = true
      assign show_gift_bonus = true
      break
    endif
    for trigger_handle in kit_trigger_handles
      assign trigger = trigger_handle | strip
      if trigger != blank and item_handle contains trigger
        assign has_kit_product = true
        assign show_gift_bonus = true
        break
      endif
    endfor
    if has_kit_product
      break
    endif
  endfor

  assign shipping_threshold = section.settings.shipping_threshold | default: 90 | times: 1.0
  if shipping_threshold <= 0
    assign shipping_threshold = 90
  endif
  assign threshold_cents = shipping_threshold | times: 100.0

  assign shipping_is_free = false
  if has_kit_product or cart.total_price >= threshold_cents
    assign shipping_is_free = true
  endif

  assign progress_value = 0
  assign progress_show_gift = false
  if has_kit_product
    assign progress_value = 1
    assign progress_show_gift = true
  else
    assign progress_value = cart.total_price | times: 1.0 | divided_by: threshold_cents | at_most: 1
  endif

  assign installment_amount = cart.total_price | divided_by: 4
%}

{% capture cart_total_money %}{{ cart.total_price | money }}{% endcapture %}
{% capture installment_money %}{{ installment_amount | money }}{% endcapture %}

<section class="brisa-cart brisa-cart-{{ section_uid }}" data-section-id="{{ section.id }}">
  <div class="brisa-cart__inner">
    {%- if cart.item_count == 0 -%}
      <div class="brisa-cart__empty">
        <h1 class="brisa-cart__title">{{ section.settings.empty_title | default: 'Your Cart' }}</h1>
        <p class="brisa-cart__empty-text">{{ 'cart.general.empty' | t }}</p>
        <a href="{{ section.settings.empty_button_link }}" class="brisa-cart__checkout-button">{{ 'cart.general.start_shopping' | t }}</a>
      </div>
    {%- else -%}
      <header class="brisa-cart__header">
        <h1 class="brisa-cart__title">{{ section.settings.title | replace: '[count]', cart.item_count }}</h1>

        {%- if section.settings.show_shipping_message -%}
          {%- render 'brisa-cart-progress',
            has_kit_product: has_kit_product,
            shipping_is_free: shipping_is_free,
            progress_value: progress_value,
            show_gift_marker: progress_show_gift,
            free_shipping_message: section.settings.free_shipping_message,
            threshold_met_message: section.settings.threshold_met_message,
            cores_shipping_message: section.settings.cores_shipping_message
          -%}
        {%- endif -%}
      </header>

      <form action="{{ routes.cart_url }}" method="post" novalidate class="brisa-cart__form" id="brisa-cart-form">
        <input type="hidden" name="checkout">

        {%- liquid
          assign cores_pool_qty = 0
          for pool_item in cart.items
            if pool_item.product.handle == 'brisa-cores' and pool_item.selling_plan_allocation == blank
              if pool_item.properties['_kit_key'] == blank and pool_item.properties['_device_1_variant_id'] == blank and pool_item.properties['_brisa_component'] == blank
                assign cores_pool_qty = cores_pool_qty | plus: pool_item.quantity
              endif
            endif
          endfor
        -%}

        <div class="brisa-cart__items">
          {%- for line_item in cart.items -%}
            {% liquid
              assign max_quantity = ''
              assign variant = line_item.variant

              if variant.inventory_management != blank and variant.inventory_policy == 'deny'
                assign current_quantity_for_variant = cart | item_count_for_variant: variant.id
                assign max_quantity = variant.inventory_quantity | minus: current_quantity_for_variant | plus: line_item.quantity
              endif

              if variant.quantity_rule.max != nil
                assign max_quantity = max_quantity | default: 999999 | at_most: variant.quantity_rule.max
              endif

              assign line_kit_key = line_item.properties['_kit_key'] | downcase
              assign line_subtitle = line_item.properties['_kit_description']
              assign line_image_url = line_item.properties['_kit_image_url']

              if line_subtitle == blank
                case line_kit_key
                  when 'commitment'
                    assign line_subtitle = 'Give it a real go - 2 months of ritual · 1 reusable Brisa device · 18 cores - about 8 weeks (9 Mint - 9 Cherry pomegranate) · Free cores + cleaning kit & Bag'
                  when 'mates'
                    assign line_subtitle = 'For you and someone else · 2 reusable Brisa device · 18 cores - roughly a month each (3 Mint - 6 Cherry pomegranate each) · Free cores + cleaning kit’s & Bag'
                  when 'try'
                    assign line_subtitle = '1 reusable Brisa device · 9 cores - roughly a month worth (3 Mint - 6 Cherry pomegranate) · Free cores + cleaning kit & Bag'
                endcase
              endif

              if line_image_url == blank
                case line_kit_key
                  when 'commitment'
                    assign line_image_url = 'brisa-kit-commitment-canva.png' | asset_url
                  when 'mates'
                    assign line_image_url = 'brisa-kit-mates-canva.png' | asset_url
                  when 'try'
                    assign line_image_url = 'brisa-kit-try-canva.png' | asset_url
                endcase
              endif
              if line_subtitle == blank
                assign line_subtitle = line_item.product.metafields.custom.cart_subtitle.value
              endif
              if line_subtitle == blank
                assign line_subtitle = section.settings.default_line_subtitle
              endif

              assign display_title = line_item.product.title
              unless line_item.product.has_only_default_variant
                assign display_title = display_title | append: ' · ' | append: line_item.variant.title
              endunless

              assign is_cores_onetime = false
              if line_item.product.handle == 'brisa-cores' and line_item.selling_plan_allocation == blank
                if line_item.properties['_kit_key'] == blank and line_item.properties['_device_1_variant_id'] == blank and line_item.properties['_brisa_component'] == blank
                  assign is_cores_onetime = true
                endif
              endif
            %}

            <article class="brisa-cart__item{% if is_cores_onetime %} brisa-cart__item--cores{% endif %}">
              {%- if line_image_url != blank or line_item.image != blank -%}
                <div class="brisa-cart__item-media">
                  <a href="{{ line_item.url }}" class="brisa-cart__item-image" tabindex="-1" aria-hidden="true">
                    {%- if line_image_url != blank -%}
                      <img src="{{ line_image_url }}" width="200" height="200" loading="lazy" alt="{{ line_item.product.title | escape }}">
                    {%- else -%}
                      {{- line_item.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,140,200', sizes: '100px', alt: line_item.product.title -}}
                    {%- endif -%}
                  </a>
                  {%- unless is_cores_onetime -%}
                    {%- if line_item.variant.compare_at_price > line_item.variant.price or line_item.original_line_price > line_item.final_line_price -%}
                      {%- if section.settings.item_badge_text != blank -%}
                        <span class="brisa-cart__item-badge">{{ section.settings.item_badge_text }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endunless -%}
                </div>
              {%- endif -%}

              <div class="brisa-cart__item-body">
                {%- if is_cores_onetime -%}
                  {%- render 'brisa-cart-cores-line', line_item: line_item, part: 'title', layout: 'main', cores_pool_qty: cores_pool_qty -%}
                  {%- render 'brisa-cart-cores-line', line_item: line_item, part: 'pack_copy', layout: 'main', cores_pool_qty: cores_pool_qty -%}
                {%- else -%}
                  <a href="{{ line_item.url }}" class="brisa-cart__item-title">{{ display_title }}</a>

                  <ul class="brisa-cart__item-details list--unstyled">
                    {%- assign cart_bullets = line_item.product.metafields.custom.cart_bullets.value -%}
                    {%- if cart_bullets != blank -%}
                      {%- for bullet in cart_bullets -%}
                        {%- if bullet != blank -%}
                          <li>{{ bullet }}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- else -%}
                      {%- if line_subtitle != blank -%}
                        <li>{{ line_subtitle }}</li>
                      {%- endif -%}
                      {%- if line_item.item_components != blank and line_item.item_components.size > 0 -%}
                        {%- for component in line_item.item_components -%}
                          {%- unless component.properties['_brisa_component'] == 'pack' -%}
                            {%- assign component_role = component.properties['Role'] -%}
                            {%- assign component_colour = component.properties['Colour'] -%}
                            <li>
                              {%- if component_role != blank -%}
                                {{ component_role }}{% if component_colour != blank %} — {{ component_colour }}{% endif %}
                              {%- elsif component_colour != blank -%}
                                {{ component_colour }}
                              {%- else -%}
                                {{ component.title }}
                              {%- endif -%}
                            </li>
                          {%- endunless -%}
                        {%- endfor -%}
                      {%- else -%}
                        {%- if line_item.properties['Your colour'] != blank -%}
                          <li>
                            Device Colour —
                            {%- assign _colour = line_item.properties['Your colour'] | strip -%}
                            {%- assign _colour_key = _colour | downcase | strip -%}
                            {%- if _colour_key == 'black' -%}
                              <span class="brisa-cart-colour-property__value" style="color: #1a1a1a !important;">{{ _colour }}</span>
                            {%- elsif _colour_key == 'ocean' or _colour_key == 'blue' -%}
                              <span class="brisa-cart-colour-property__value" style="color: #1A7A8A !important;">{{ _colour }}</span>
                            {%- elsif _colour_key == 'rose' -%}
                              <span class="brisa-cart-colour-property__value" style="color: #C97878 !important;">{{ _colour }}</span>
                            {%- else -%}
                              {{ _colour }}
                            {%- endif -%}
                          </li>
                        {%- endif -%}
                        {%- assign mates_colour_value = line_item.properties["Mate's colour"] -%}
                        {%- if mates_colour_value == blank -%}
                          {%- for _prop in line_item.properties -%}
                            {%- assign _pk = _prop.first | downcase | replace: '’', "'" | replace: '‘', "'" -%}
                            {%- if _pk == "mate's colour" -%}
                              {%- assign mates_colour_value = _prop.last -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                        {%- if mates_colour_value != blank -%}
                          <li>
                            Mate's colour —
                            {%- assign _colour = mates_colour_value | strip -%}
                            {%- assign _colour_key = _colour | downcase | strip -%}
                            {%- if _colour_key == 'black' -%}
                              <span class="brisa-cart-colour-property__value" style="color: #1a1a1a !important;">{{ _colour }}</span>
                            {%- elsif _colour_key == 'ocean' or _colour_key == 'blue' -%}
                              <span class="brisa-cart-colour-property__value" style="color: #1A7A8A !important;">{{ _colour }}</span>
                            {%- elsif _colour_key == 'rose' -%}
                              <span class="brisa-cart-colour-property__value" style="color: #C97878 !important;">{{ _colour }}</span>
                            {%- else -%}
                              {{ _colour }}
                            {%- endif -%}
                          </li>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endif -%}
                  </ul>
                {%- endif -%}

                {%- if is_cores_onetime -%}
                  {%- render 'brisa-cart-cores-line', line_item: line_item, part: 'quantity', layout: 'main', line_index: forloop.index, max_quantity: max_quantity, cores_pool_qty: cores_pool_qty -%}
                {%- else -%}
                  <line-item-quantity class="brisa-cart__quantity">
                    <div class="quantity-selector quantity-selector--small brisa-cart__quantity-selector">
                      <a href="{{ routes.cart_change_url }}?quantity={{ line_item.quantity | minus: line_item.variant.quantity_rule.increment | at_least: line_item.variant.quantity_rule.min }}&line={{ forloop.index }}" class="quantity-selector__button" aria-label="{{ 'cart.general.decrease_quantity' | t | escape }}" data-no-instant>{% render 'icon' with 'minus' %}</a>
                      <input is="input-number" class="quantity-selector__input text--xsmall" value="{{ line_item.quantity }}" name="updates[]" data-line="{{ forloop.index }}" {% if max_quantity != '' %}max="{{ max_quantity }}"{% endif %} aria-label="{{ 'cart.general.change_quantity' | t | escape }}">
                      {%- if max_quantity == blank or line_item.quantity < max_quantity -%}
                        {% assign increment = line_item.quantity | plus: line_item.variant.quantity_rule.increment %}
                        {%- if line_item.variant.quantity_rule.max != nil -%}
                          {%- assign increment = increment | at_most: line_item.variant.quantity_rule.max -%}
                        {%- endif -%}
                        <a href="{{ routes.cart_change_url }}?quantity={{ increment }}&line={{ forloop.index }}" class="quantity-selector__button" aria-label="{{ 'cart.general.increase_quantity' | t | escape }}" data-no-instant>{% render 'icon' with 'plus' %}</a>
                      {%- else -%}
                        <span class="quantity-selector__button" aria-hidden="true">{% render 'icon' with 'plus' %}</span>
                      {%- endif -%}
                    </div>
                  </line-item-quantity>
                {%- endif -%}
              </div>

              <div class="brisa-cart__item-side">
                {%- if is_cores_onetime -%}
                  {%- render 'brisa-cart-cores-line', line_item: line_item, part: 'price', layout: 'main', cores_pool_qty: cores_pool_qty -%}
                {%- else -%}
                  <div class="brisa-cart__item-pricing">
                    {%- if line_item.variant.compare_at_price > line_item.variant.price -%}
                      <span class="brisa-cart__price brisa-cart__price--compare">{{ line_item.variant.compare_at_price | times: line_item.quantity | money }}</span>
                    {%- elsif line_item.original_line_price > line_item.final_line_price -%}
                      <span class="brisa-cart__price brisa-cart__price--compare">{{ line_item.original_line_price | money }}</span>
                    {%- endif -%}
                    <span class="brisa-cart__price brisa-cart__price--current">
                      {%- if line_item.final_line_price == 0 -%}
                        {{ 'cart.general.free' | t }}
                      {%- else -%}
                        {{ line_item.final_line_price | money }}
                      {%- endif -%}
                    </span>
                  </div>
                {%- endif -%}

                <a href="{{ line_item.url_to_remove }}" class="brisa-cart__remove" aria-label="{{ 'cart.general.remove' | t | escape }}" data-no-instant>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 7h16"/>
                    <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                    <path d="M7 7v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V7"/>
                    <path d="M10 11v6M14 11v6"/>
                  </svg>
                </a>
              </div>

              {%- if is_cores_onetime -%}
                {%- render 'brisa-cart-cores-line', line_item: line_item, part: 'discount', layout: 'main', cores_pool_qty: cores_pool_qty -%}
              {%- elsif line_item.line_level_discount_allocations != blank -%}
                <ul class="brisa-cart__item-discounts list--unstyled" role="list">
                  {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                    <li class="brisa-cart__item-discount">{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </article>
          {%- endfor -%}

          {%- if show_gift_bonus and section.settings.show_gift_bonus -%}
            {%- render 'brisa-cart-gift',
              gift_product: section.settings.gift_product,
              gift_image: section.settings.gift_image,
              gift_image_url: section.settings.gift_image_url,
              gift_title: section.settings.gift_title,
              gift_subtitle: section.settings.gift_subtitle,
              gift_detail: section.settings.gift_detail,
              gift_value: section.settings.gift_value,
              gift_price_label: section.settings.gift_price_label
            -%}
          {%- endif -%}
        </div>

        {%- if section.settings.show_recommendations -%}
          <product-recommendations section-id="{{ section.id }}" intent="related" product-id="{{ cart.items.first.product_id }}" recommendations-count="6" class="brisa-cart__recommendations" hidden>
            {%- assign acceptable_recommendations_count = 0 -%}
            {%- for product in recommendations.products -%}
              {%- assign matching_product = cart.items | where: 'product_id', product.id | first -%}
              {%- if matching_product == blank -%}
                {%- assign acceptable_recommendations_count = acceptable_recommendations_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if recommendations.performed and acceptable_recommendations_count > 0 -%}
              <div class="brisa-cart__recommendations-inner">
                <p class="brisa-cart__recommendations-heading">{{ section.settings.recommendations_title }}</p>
                {%- assign shown_products_count = 0 -%}
                {%- for product in recommendations.products -%}
                  {%- if shown_products_count >= 1 -%}
                    {%- break -%}
                  {%- endif -%}
                  {%- assign matching_product = cart.items | where: 'product_id', product.id -%}
                  {%- if matching_product.size == 0 -%}
                    {%- assign shown_products_count = shown_products_count | plus: 1 -%}
                    <div class="brisa-cart__recommendation">
                      <a href="{{ product.url }}" class="brisa-cart__recommendation-image" tabindex="-1" aria-hidden="true">
                        {%- if product.featured_media -%}
                          {{- product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', sizes: '60px', alt: product.title -}}
                        {%- endif -%}
                      </a>
                      <div class="brisa-cart__recommendation-info">
                        <a href="{{ product.url }}" class="brisa-cart__recommendation-title">{{ product.title }}</a>
                        <p class="brisa-cart__recommendation-price">
                          {%- if product.price_varies -%}
                            From {{ product.price_min | money }}
                          {%- else -%}
                            {{ product.price | money }}
                          {%- endif -%}
                        </p>
                        <button type="button" is="toggle-button" loader aria-controls="brisa-cart-quick-buy-{{ section.id }}-{{ product.id }}" aria-expanded="false" class="brisa-cart__recommendation-quick-view hidden-phone">{{ section.settings.quick_view_label }}</button>
                        <button type="button" is="toggle-button" loader aria-controls="brisa-cart-quick-buy-popover-{{ section.id }}-{{ product.id }}" aria-expanded="false" class="brisa-cart__recommendation-quick-view hidden-tablet-and-up">{{ section.settings.quick_view_label }}</button>
                        <quick-buy-drawer id="brisa-cart-quick-buy-{{ section.id }}-{{ product.id }}" href="{{ product.url }}" class="drawer drawer--large drawer--quick-buy hidden-phone"></quick-buy-drawer>
                        <quick-buy-popover id="brisa-cart-quick-buy-popover-{{ section.id }}-{{ product.id }}" href="{{ product.url }}" class="popover popover--quick-buy hidden-tablet-and-up"></quick-buy-popover>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </product-recommendations>
        {%- endif -%}

        <div class="brisa-cart__checkout-panel">
          <div class="brisa-cart__summary">
            {%- if cart.cart_level_discount_applications != blank -%}
              {%- for discount_application in cart.cart_level_discount_applications -%}
                <div class="brisa-cart__summary-row brisa-cart__summary-row--discount">
                  <span>{{ discount_application.title }}</span>
                  <span>-{{ discount_application.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}

            <div class="brisa-cart__summary-row brisa-cart__summary-row--subtotal">
              <div class="brisa-cart__summary-copy">
                <span class="brisa-cart__summary-label">{{ section.settings.subtotal_label }}</span>
                {%- if shipping_is_free or section.settings.always_show_free_shipping -%}
                  <span class="brisa-cart__summary-note">{{ section.settings.free_shipping_note | default: 'Free shipping' }}</span>
                {%- elsif section.settings.calculated_shipping_label != blank -%}
                  <span class="brisa-cart__summary-note">{{ section.settings.calculated_shipping_label }}</span>
                {%- endif -%}
              </div>
              <span class="brisa-cart__summary-price">{{ cart.total_price | money }}</span>
            </div>
          </div>

          <div class="brisa-cart__footer">
            <button type="submit" class="brisa-cart__checkout-button" name="checkout">
              <span class="brisa-cart__checkout-lock" aria-hidden="true">{% render 'icon' with 'lock' %}</span>
              <span>{{ section.settings.checkout_button_text | replace: '[total]', cart_total_money }}</span>
            </button>

            {%- if section.settings.show_payment_methods and shop.enabled_payment_types.size > 0 -%}
              <div class="brisa-cart__payment-methods">
                <div class="payment-methods-list payment-methods-list--center">
                  {% for type in shop.enabled_payment_types %}
                    {{ type | payment_type_svg_tag }}
                  {% endfor %}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brisa cart",
  "class": "shopify-section--brisa-main-cart",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your Cart ([count])"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_message",
      "label": "Show shipping progress",
      "default": true
    },
    {
      "type": "richtext",
      "id": "free_shipping_message",
      "label": "Free shipping message (starter & mates pack)",
      "default": "<p>You've been approved for <strong>FREE SHIPPING</strong> &amp; a <strong>FREE GIFT</strong></p>"
    },
    {
      "type": "text",
      "id": "cores_shipping_message",
      "label": "Shipping message (cores only)",
      "default": "Spend $90 to receive FREE SHIPPING"
    },
    {
      "type": "text",
      "id": "threshold_met_message",
      "label": "Threshold met message (no kit)",
      "default": "You've received FREE SHIPPING"
    },
    {
      "type": "number",
      "id": "shipping_threshold",
      "label": "Free shipping threshold ($)",
      "default": 90,
      "info": "Used for cores progress bar fill. Kit products always unlock free shipping + gift."
    },
    {
      "type": "text",
      "id": "shipping_progress_message",
      "label": "Shipping message (cores only, legacy)",
      "default": "Spend $90 to receive FREE SHIPPING"
    },
    {
      "type": "checkbox",
      "id": "always_show_free_shipping",
      "label": "Always show free shipping (legacy, leave off)",
      "default": false
    },
    {
      "type": "text",
      "id": "default_line_subtitle",
      "label": "Default line item subtitle",
      "default": "9 cores · 3 to 5 weeks of ritual",
      "info": "Used when product metafield custom.cart_subtitle is empty. Prefer custom.cart_bullets list metafield for multi-line details."
    },
    {
      "type": "text",
      "id": "item_badge_text",
      "label": "Discount badge on image",
      "default": "Save 10% OFF & Free Shipping",
      "info": "Shown on discounted line items. Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Recommendations"
    },
    {
      "type": "checkbox",
      "id": "show_recommendations",
      "label": "Show recommendations",
      "default": true
    },
    {
      "type": "text",
      "id": "recommendations_title",
