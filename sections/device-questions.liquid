      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Outer background",
      "default": "#008bdc"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "FAQ background",
      "default": "#008bdc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Be honest... will it actually satisfy me?"
        },
        {
          "type": "richtext",
