<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .device-questions {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .device-questions__box {
    padding: {{ section.settings.box_padding_vertical }}px {{ section.settings.box_padding_horizontal }}px;
    color: {{ section.settings.text_color }};
    background: {{ section.settings.panel_background }};
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
  }

  #shopify-section-{{ section.id }} .device-questions__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .device-questions__list {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .device-questions__item {
    padding: {{ section.settings.item_padding_vertical }}px 0;
    border-top: {{ section.settings.divider_width }}px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .device-questions__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__item:last-child {
    padding-bottom: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__question {
    margin: 0 0 10px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.question_size }}px;
    font-weight: 900;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .device-questions__answer {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.answer_size }}px;
    font-weight: 400;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .device-questions__answer p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__answer p + p {
    margin-top: 10px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .device-questions__heading {
      font-size: {{ section.settings.heading_size | times: 0.82 | round }}px;
    }

    #shopify-section-{{ section.id }} .device-questions__question {
      font-size: {{ section.settings.question_size | times: 0.92 | round }}px;
    }

    #shopify-section-{{ section.id }} .device-questions__answer {
      font-size: {{ section.settings.answer_size | times: 0.95 | round }}px;
    }

    #shopify-section-{{ section.id }} .device-questions__box {
      padding: {{ section.settings.box_padding_vertical | times: 0.75 | round }}px {{ section.settings.box_padding_horizontal | times: 0.75 | round }}px;
    }
  }
</style>

<section class="device-questions" {{ section.shopify_attributes }}>
  <div class="device-questions__box">
    {% if section.settings.heading != blank %}
      <h2 class="device-questions__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="device-questions__list" itemscope itemtype="https://schema.org/FAQPage">
        {% for block in section.blocks %}
          {% if block.type == 'question' %}
            <div class="device-questions__item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" {{ block.shopify_attributes }}>
              {% if block.settings.question != blank %}
                <h3 class="device-questions__question" itemprop="name">{{ block.settings.question | escape }}</h3>
              {% endif %}

              {% if block.settings.answer != blank %}
                <div class="device-questions__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                  <div itemprop="text">{{ block.settings.answer }}</div>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Device questions",
  "class": "shopify-section--device-questions",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
