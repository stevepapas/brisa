      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "question_size",
      "label": "Question size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "answer_size",
      "label": "Answer size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Box background",
      "default": "#d9efff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2c4e8a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Box border",
      "default": "#7eb8e0"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#7eb8e0"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does Brisa work?"
        },
        {
          "type": "richtext",
          "id": "answer",
