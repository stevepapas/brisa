<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: 0;
  }

  #shopify-section-{{ section.id }} .device-questions {
    width: 100%;
    color: {{ section.settings.text_color }};
    background: {{ section.settings.panel_background }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.box_padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .device-questions__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .device-questions__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .device-questions__list {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_padding_vertical }}px;
  }

  #shopify-section-{{ section.id }} .device-questions__item {
    border: 0;
    margin: 0;
    padding: 0;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .device-questions__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18px;
    align-items: center;
    gap: 16px;
    list-style: none;
    cursor: pointer;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.question_size }}px;
    font-weight: 500;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .device-questions__summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .device-questions__toggle {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__toggle::before,
  #shopify-section-{{ section.id }} .device-questions__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: {{ section.settings.text_color }};
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .device-questions__toggle::before {
    width: 14px;
    height: 2px;
  }

  #shopify-section-{{ section.id }} .device-questions__toggle::after {
    width: 2px;
    height: 14px;
    transition: opacity 0.15s ease;
  }

  #shopify-section-{{ section.id }} .device-questions__item[open] .device-questions__toggle::after {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__answer {
    padding: 12px 32px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.answer_size }}px;
    font-weight: 400;
    line-height: 1.45;
    opacity: 0.92;
  }

  #shopify-section-{{ section.id }} .device-questions__answer p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__answer p + p {
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .device-questions__answer img {
    border-radius: 0 !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .device-questions {
      padding: {{ section.settings.padding_top | times: 0.8 | round }}px 20px {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }

    #shopify-section-{{ section.id }} .device-questions__heading {
      font-size: {{ section.settings.heading_size | times: 0.72 | round }}px;
    }

    #shopify-section-{{ section.id }} .device-questions__summary {
      font-size: {{ section.settings.question_size | times: 0.95 | round }}px;
      gap: 12px;
    }
  }
</style>

<section class="device-questions" {{ section.shopify_attributes }}>
  <div class="device-questions__inner">
    {% if section.settings.heading != blank %}
      <h2 class="device-questions__heading">{{ section.settings.heading | newline_to_br }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="device-questions__list" itemscope itemtype="https://schema.org/FAQPage">
        {% for block in section.blocks %}
          {% if block.type == 'question' and block.settings.question != blank %}
            <details
              class="device-questions__item"
              itemscope
              itemprop="mainEntity"
              itemtype="https://schema.org/Question"
              {{ block.shopify_attributes }}
            >
              <summary class="device-questions__summary">
                <span itemprop="name">{{ block.settings.question | escape }}</span>
                <span class="device-questions__toggle" aria-hidden="true"></span>
              </summary>

              {% if block.settings.answer != blank %}
                <div
                  class="device-questions__answer"
                  itemscope
                  itemprop="acceptedAnswer"
                  itemtype="https://schema.org/Answer"
                >
                  <div itemprop="text">{{ block.settings.answer }}</div>
                </div>
              {% endif %}
            </details>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Device questions",
  "class": "shopify-section--device-questions",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions Answered"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 480,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "box_padding_horizontal",
      "label": "Side padding",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 8,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "item_padding_vertical",
      "label": "Space between questions",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "question_size",
      "label": "Question size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "answer_size",
      "label": "Answer size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Outer background",
      "default": "#008bdc"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "FAQ background",
      "default": "#008bdc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Be honest... will it actually satisfy me?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Brisa is built for the hand-to-mouth ritual — same weight, draw, and sensory cues — without nicotine, vapour, or smoke.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Device questions",
      "category": "Brisa",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Be honest... will it actually satisfy me?",
            "answer": "<p>Brisa is built for the hand-to-mouth ritual — same weight, draw, and sensory cues — without nicotine, vapour, or smoke.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Isn't it just a vape without the nicotine?",
            "answer": "<p>No. There's no vapour, no coil, and no chemicals. It's a sensory habit device that keeps the ritual, not a nicotine product.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Isn't it like those wooden pens that just blow air?",
            "answer": "<p>No. Brisa uses precision-formulated aroma cores and tuned airflow so the draw and throat feel land like the habit you know.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "I've tried gums and patches, how is this different?",
            "answer": "<p>Gums and patches skip the ritual. Brisa keeps the hand-to-mouth moment your body reaches for — so the switch feels familiar, not empty.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
