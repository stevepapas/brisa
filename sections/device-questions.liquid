<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .device-questions {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__box {
    padding: {{ section.settings.box_padding_vertical }}px {{ section.settings.box_padding_horizontal }}px;
    color: {{ section.settings.text_color }};
    background: {{ section.settings.panel_background }};
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
  }

  #shopify-section-{{ section.id }} .device-questions__box-inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .device-questions__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .device-questions__list {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .device-questions__item {
    padding: {{ section.settings.item_padding_vertical }}px 0;
    border-top: {{ section.settings.divider_width }}px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .device-questions__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__item:last-child {
    padding-bottom: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__question {
    margin: 0 0 10px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.question_size }}px;
    font-weight: 900;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .device-questions__answer {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.answer_size }}px;
    font-weight: 400;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .device-questions__answer p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .device-questions__answer p + p {
    margin-top: 10px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .device-questions__heading {
      font-size: {{ section.settings.heading_size | times: 0.82 | round }}px;
    }

    #shopify-section-{{ section.id }} .device-questions__question {
      font-size: {{ section.settings.question_size | times: 0.92 | round }}px;
    }

    #shopify-section-{{ section.id }} .device-questions__answer {
      font-size: {{ section.settings.answer_size | times: 0.95 | round }}px;
    }

    #shopify-section-{{ section.id }} .device-questions__box {
      padding: {{ section.settings.box_padding_vertical | times: 0.75 | round }}px {{ section.settings.box_padding_horizontal | times: 0.75 | round }}px;
    }
  }
</style>

<section class="device-questions" {{ section.shopify_attributes }}>
  <div class="device-questions__box">
    <div class="device-questions__box-inner">
      {% if section.settings.heading != blank %}
        <h2 class="device-questions__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="device-questions__list" itemscope itemtype="https://schema.org/FAQPage">
          {% for block in section.blocks %}
            {% if block.type == 'question' %}
              <div class="device-questions__item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" {{ block.shopify_attributes }}>
                {% if block.settings.question != blank %}
                  <h3 class="device-questions__question" itemprop="name">{{ block.settings.question | escape }}</h3>
                {% endif %}

                {% if block.settings.answer != blank %}
                  <div class="device-questions__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                    <div itemprop="text">{{ block.settings.answer }}</div>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .device-questions-cost {
    padding: 48px 40px 40px;
    background: #ffffff;
    text-align: left;
    max-width: 980px;
    margin: 0 auto;
  }
  .device-questions-cost__heading {
    margin: 0 0 8px;
    font-size: 36px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111111;
  }
  .device-questions-cost__sub {
    margin: 0;
    font-size: 36px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111111;
  }
  .device-questions-cost__brisa {
    display: block;
    margin-top: 12px;
    font-size: 28px;
    font-weight: 900;
    color: #008bdc;
    text-transform: uppercase;
  }
  .dq-final-cta {
    padding: 32px 40px 40px;
    background: #ffffff;
    max-width: 980px;
    margin: 0 auto;
  }
  .dq-final-cta__stars {
    font-size: 22px;
    color: #1a73e8;
    margin-bottom: 10px;
  }
  .dq-final-cta__stars span {
    font-size: 16px;
    font-weight: 800;
    color: #111111;
    vertical-align: middle;
  }
  .dq-final-cta__promo {
    font-size: 15px;
    font-weight: 700;
    color: #008bdc;
    margin: 0 0 18px;
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .dq-final-cta__promo-icon { flex-shrink: 0; }
  .dq-final-cta__btn {
    display: block;
    width: 100%;
    padding: 18px 24px;
    background: #2eb8f4;
    color: #ffffff;
    font-size: 18px;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-radius: 50%;
    box-sizing: border-box;
    margin-bottom: 14px;
  }
  .dq-final-cta__trust {
    font-size: 13px;
    color: #555555;
    text-align: center;
    margin: 0;
  }
  @media screen and (max-width: 749px) {
    .device-questions-cost__heading,
    .device-questions-cost__sub { font-size: 26px; }
    .device-questions-cost__brisa { font-size: 22px; }
  }
</style>

<div class="device-questions-cost">
  <p class="device-questions-cost__heading">YOUR VAPE/ CIGARETTES COSTS YOU</p>
  <p class="device-questions-cost__sub">$300-$400 THIS MONTH.</p>
  <span class="device-questions-cost__brisa">BRISA COSTS YOU $130 - ONCE</span>
</div>

<div class="dq-final-cta">
  <div class="dq-final-cta__stars">
    &#9733;&#9733;&#9733;&#9733;&#9733; <span>Rated 4.7 (163)</span>
  </div>
  <p class="dq-final-cta__promo">
    <span class="dq-final-cta__promo-icon">&#127873;</span>
    Order this week - FREE watermelon core pack (valued at $15) included
  </p>
  <a href="#" class="dq-final-cta__btn" onclick="event.preventDefault();var btn=document.querySelector('[name=add]');if(btn){btn.scrollIntoView({behavior:'smooth'});setTimeout(function(){btn.click();},600);}">
    ADD STARTER KIT &mdash; $130 &rarr;
  </a>
  <p class="dq-final-cta__trust">Free shipping &middot; 30-Day Success Guarantee &middot; Ships in 1&ndash;2 days</p>
</div>

