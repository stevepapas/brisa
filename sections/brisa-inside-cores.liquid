          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename",
          "info": "Fallback when no Theme Editor image is set, e.g. brisa-inside-core-1.png"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The flavours you actually chase 🍒"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We create the ones people genuinely miss, starting with Cherry Pomegranate, a world first no one in our category has cracked. And we're building more, matched to the profiles you already know."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inside the Brisa core",
      "category": "Brisa",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "image_asset": "brisa-inside-core-1.png",
            "heading": "The flavours you actually chase 🍒",
            "description": "We create the ones people genuinely miss, starting with Cherry Pomegranate, a world first no one in our category has cracked. And we're building more, matched to the profiles you already know."
          }
        },
        {
          "type": "card",
          "settings": {
            "image_asset": "brisa-inside-core-2.png",
            "heading": "A formula we'll never share 🤫",
            "description": "Almost a year of R&D in the making, our exact combination of food-grade aroma and cooling compounds is ours alone — there is none alike, locked away. Creating the best all-around experience: a rush of flavour and aroma, a real throat sensation, and longevity in every core."
          }
        },
        {
          "type": "card",
          "settings": {
            "image_asset": "brisa-inside-core-3.png",
            "heading": "The hit isn't an accident",
            "description": "That satisfying hit and rush at the back of your throat is engineered. Our secret layering delivers the sensation you know, with zero nicotine, zero smoke, zero vapour. The closest thing to the real feeling."
          }
        },
        {
