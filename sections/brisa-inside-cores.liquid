{% liquid
  assign section_id = section.id | replace: '-', '' | downcase
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .brisa-inside-cores-{{ section_id }} {
    --bic-ink: {{ section.settings.heading_color }};
    --bic-muted: {{ section.settings.subtitle_color }};
    --bic-text: {{ section.settings.text_color }};
    --bic-card: {{ section.settings.card_background }};
    --bic-dot-active: {{ section.settings.dot_active_color }};
    --bic-dot-inactive: {{ section.settings.dot_inactive_color }};
    --bic-shadow: {{ section.settings.card_shadow_color }};
    --bic-gap: min(14px, max(8px, {{ section.settings.card_gap }}px));
    --bic-peek: {{ section.settings.card_peek }}px;
    --bic-radius: {{ section.settings.card_radius }}px;
    --bic-image-radius: {{ section.settings.image_radius }}px;
    --bic-card-pad: max(18px, {{ section.settings.card_padding }}px);
    --bic-card-text-pad: 0;
    font-family: inherit;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__header {
    padding: 0 24px;
    text-align: center;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__heading {
    margin: 0;
    color: var(--bic-ink);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__subtitle {
    margin: 10px auto 0;
    max-width: 34em;
    color: var(--bic-muted);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 500;
    line-height: 1.4;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__carousel {
    /* Width tokens live on the carousel (unpadded) so card % / side padding
       do not circularly shrink against the track content box. */
    --bic-edge: 24px;
    --bic-card-max: {{ section.settings.card_max_width }}px;
    --bic-card-w: min(var(--bic-card-max), calc(100% - var(--bic-edge) - var(--bic-peek)));
    --bic-side: max(var(--bic-edge), calc((100% - var(--bic-card-w)) / 2));
    margin-top: {{ section.settings.carousel_spacing }}px;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__track {
    display: flex;
    gap: var(--bic-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 8px 0 12px;
    padding-inline: var(--bic-side);
    scroll-padding-inline: var(--bic-side);
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__track::-webkit-scrollbar {
    display: none;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__card {
    flex: 0 0 var(--bic-card-w);
    width: var(--bic-card-w);
    max-width: none;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    box-sizing: border-box;
    padding: var(--bic-card-pad);
    background: var(--bic-card);
    border-radius: var(--bic-radius);
    box-shadow:
      0 12px 32px rgba(0, 139, 220, 0.14),
      0 2px 10px rgba(0, 139, 220, 0.08);
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__media {
    display: block;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--bic-image-radius);
    background: transparent;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    mask-image: radial-gradient(white, black);
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__image {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 683;
    object-fit: cover;
    border: 0;
    outline: none;
    box-shadow: none;
    filter: none;
    border-radius: 0;
    background: transparent;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__image-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 683;
    border: 0;
    outline: none;
    box-shadow: none;
    filter: none;
    border-radius: 0;
    background: linear-gradient(160deg, #d7ebf8 0%, #c5dff0 100%);
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__card-heading {
    margin: 14px var(--bic-card-text-pad) 0;
    color: var(--bic-ink);
    font-size: {{ section.settings.card_heading_size }}px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__card-text {
    margin: 10px var(--bic-card-text-pad) 6px;
    color: var(--bic-text);
    font-size: {{ section.settings.card_text_size }}px;
    font-weight: 400;
    line-height: 1.4;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: {{ section.settings.dots_spacing }}px;
    padding: 0 24px;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__dot {
    appearance: none;
    width: 10px;
    height: 10px;
    padding: 0;
    border: 1.5px solid var(--bic-dot-inactive);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__dot.is-active {
    background: var(--bic-dot-active);
    border-color: var(--bic-dot-active);
    transform: scale(1.05);
  }

  .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__dot:focus-visible {
    outline: 2px solid var(--bic-dot-inactive);
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .brisa-inside-cores-{{ section_id }} {
      --bic-gap: max(36px, {{ section.settings.card_gap }}px);
    }

    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__carousel {
      --bic-edge: 40px;
      --bic-card-max: {{ section.settings.card_max_width | plus: 50 }}px;
    }

    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__card-heading {
      font-size: {{ section.settings.card_heading_size | plus: 2 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .brisa-inside-cores-{{ section_id }} {
      --bic-gap: 8px;
    }

    /* Left-anchored cards: fixed left inset, 15% wider than prior centered width,
       next card peeks on the right (width grows rightward only). */
    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__carousel {
      --bic-edge: 16px;
      --bic-peek: min(56px, {{ section.settings.card_peek }}px);
      --bic-card-base: calc(100% - var(--bic-edge) - var(--bic-peek));
      --bic-card-w: calc(var(--bic-card-base) * 1.15);
      /* Keep the old centered left edge; do not expand equally both ways. */
      --bic-side: max(var(--bic-edge), calc((var(--bic-edge) + var(--bic-peek)) / 2));
      --bic-side-end: max(var(--bic-edge), calc(100% - var(--bic-side) - var(--bic-card-w)));
    }

    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__track {
      padding-inline: var(--bic-side) var(--bic-side-end);
      scroll-padding-inline: var(--bic-side) 0;
    }

    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__card {
      scroll-snap-align: start;
      padding: calc(var(--bic-card-pad) / 2);
    }

    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__heading {
      font-size: {{ section.settings.heading_size | times: 0.82 | round }}px;
    }

    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__subtitle {
      font-size: {{ section.settings.subtitle_size | times: 0.92 | round }}px;
    }

    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__card-heading {
      font-size: 15px;
      margin-top: 12px;
      line-height: 1.05;
    }

    .brisa-inside-cores-{{ section_id }} .brisa-inside-cores__card-text {
      font-size: 10px;
      line-height: 1.1;
    }
  }
</style>

<section
  class="brisa-inside-cores brisa-inside-cores-{{ section_id }}"
  data-brisa-inside-cores
  {{ section.shopify_attributes }}
>
  <div class="brisa-inside-cores__inner">
    <div class="brisa-inside-cores__header">
      {% if section.settings.heading != blank %}
        <h2 class="brisa-inside-cores__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="brisa-inside-cores__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="brisa-inside-cores__carousel">
        <div class="brisa-inside-cores__track" data-bic-track tabindex="0" role="list" aria-label="{{ section.settings.heading | default: 'Inside the Brisa core' | escape }}">
          {% for block in section.blocks %}
            {% liquid
              assign card_image_url = blank
              assign card_image_alt = block.settings.heading | default: section.settings.heading | escape
              if block.settings.image != blank
                assign card_image_url = block.settings.image | image_url: width: 1200
              elsif block.settings.image_asset != blank
                assign card_image_url = block.settings.image_asset | asset_url
              endif
            %}
            <article class="brisa-inside-cores__card" role="listitem" {{ block.shopify_attributes }}>
              <div class="brisa-inside-cores__media">
                {% if card_image_url != blank %}
                  <img
                    class="brisa-inside-cores__image"
                    src="{{ card_image_url }}"
                    alt="{{ card_image_alt }}"
                    width="1200"
                    height="683"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {% if forloop.first %}fetchpriority="high"{% endif %}
                  >
                {% else %}
                  <span class="brisa-inside-cores__image-placeholder" aria-hidden="true"></span>
                {% endif %}
              </div>

              {% if block.settings.heading != blank %}
                <h3 class="brisa-inside-cores__card-heading">{{ block.settings.heading | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="brisa-inside-cores__card-text">{{ block.settings.description | escape | newline_to_br }}</div>
              {% endif %}
            </article>
          {% endfor %}
        </div>

        {% if section.blocks.size > 1 %}
          <div class="brisa-inside-cores__dots" data-bic-dots role="tablist" aria-label="Carousel pagination">
            {% for block in section.blocks %}
              <button
                type="button"
                class="brisa-inside-cores__dot{% if forloop.first %} is-active{% endif %}"
                data-bic-dot
                data-index="{{ forloop.index0 }}"
                aria-label="Go to card {{ forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              ></button>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var section = root.querySelector('[data-brisa-inside-cores]');
    if (!section || section.dataset.bicReady === '1') return;
    section.dataset.bicReady = '1';

    var track = section.querySelector('[data-bic-track]');
    var dots = Array.prototype.slice.call(section.querySelectorAll('[data-bic-dot]'));
    if (!track || !dots.length) return;

    var cards = Array.prototype.slice.call(track.querySelectorAll('.brisa-inside-cores__card'));
    var activeIndex = 0;
    var ticking = false;
    var mobileMq = window.matchMedia('(max-width: 749px)');

    function isStartAlign() {
      return mobileMq.matches;
    }

    function startPad() {
      var styles = window.getComputedStyle(track);
      var raw = styles.scrollPaddingInlineStart || styles.scrollPaddingLeft || styles.paddingInlineStart || styles.paddingLeft || '0';
      return parseFloat(raw) || 0;
    }

    function setActive(index) {
      if (index < 0 || index >= cards.length) return;
      activeIndex = index;
      dots.forEach(function (dot, i) {
        var on = i === index;
        dot.classList.toggle('is-active', on);
        if (on) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    function nearestIndex() {
      var trackRect = track.getBoundingClientRect();
      var target;
      if (isStartAlign()) {
        target = trackRect.left + startPad();
      } else {
        target = trackRect.left + trackRect.width / 2;
      }
      var best = 0;
      var bestDist = Infinity;
      cards.forEach(function (card, i) {
        var rect = card.getBoundingClientRect();
        var point = isStartAlign() ? rect.left : rect.left + rect.width / 2;
        var dist = Math.abs(point - target);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      return best;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        setActive(nearestIndex());
        ticking = false;
      });
    }

    function scrollToIndex(index, behavior) {
      var card = cards[index];
      if (!card) return;
      var trackRect = track.getBoundingClientRect();
      var cardRect = card.getBoundingClientRect();
      var delta;
      if (isStartAlign()) {
        // Align card start to the fixed left inset (not center midpoint).
        delta = cardRect.left - trackRect.left - startPad();
      } else {
        delta = cardRect.left - trackRect.left - (trackRect.width - cardRect.width) / 2;
      }
      if (Math.abs(delta) < 1) {
        setActive(index);
        return;
      }
      track.scrollBy({ left: delta, behavior: behavior || 'smooth' });
      setActive(index);
    }

    track.addEventListener('scroll', onScroll, { passive: true });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        scrollToIndex(Number(dot.getAttribute('data-index')) || 0);
      });
    });

    window.addEventListener('resize', function () {
      scrollToIndex(activeIndex, 'auto');
    }, { passive: true });

    // Re-align after layout/images so the first card sits on the start inset.
    var imgs = track.querySelectorAll('img');
    var pending = 0;
    function onReady() {
      scrollToIndex(activeIndex, 'auto');
    }
    imgs.forEach(function (img) {
      if (img.complete) return;
      pending += 1;
      img.addEventListener('load', function () {
        pending -= 1;
        if (pending <= 0) onReady();
      }, { once: true });
      img.addEventListener('error', function () {
        pending -= 1;
        if (pending <= 0) onReady();
      }, { once: true });
    });
    scrollToIndex(0, 'auto');
    requestAnimationFrame(function () {
      requestAnimationFrame(onReady);
    });
    if (pending === 0) {
      onReady();
    }
  })();
</script>

{% schema %}
{
  "name": "Inside the Brisa core",
  "tag": "section",
  "class": "shopify-section--brisa-inside-cores",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Inside the Brisa core"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The part everyone tries to copy... and no one's cracked."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width",
      "min": 640,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 980
    },
    {
      "type": "range",
      "id": "card_max_width",
      "label": "Card max width",
      "min": 260,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 420,
      "info": "Desktop cards render 50px wider than this value."
    },
    {
      "type": "range",
      "id": "card_peek",
      "label": "Next-card peek",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "image_radius",
