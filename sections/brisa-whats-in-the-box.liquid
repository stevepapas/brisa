{% liquid
  assign section_uid = section.id | replace: '-', '' | downcase
  assign main_image_alt = section.settings.image.alt | default: section.settings.heading | escape
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .brisa-whats-in-the-box-{{ section_uid }} {
    color: {{ section.settings.text_color }};
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__header {
    margin: 0 0 32px;
    text-align: center;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: 48px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__subheading {
    margin: 12px 0 0;
    font-size: 18px;
    line-height: 1.4;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__panel {
    padding: 48px 40px;
    background: {{ section.settings.panel_background }};
    border-radius: 24px;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__panel-heading {
    margin: 0;
    color: {{ section.settings.panel_heading_color }};
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 40px;
    font-weight: 400;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__panel-tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 10px 0 32px;
    color: {{ section.settings.panel_heading_color }};
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__stage {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 44%) 1fr;
    grid-template-rows: auto auto auto;
    gap: 20px 24px;
    align-items: center;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__image-wrap {
    grid-column: 2;
    grid-row: 1 / span 3;
    margin: 0 auto;
    width: 100%;
    max-width: 520px;
    min-height: 280px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: start;
    max-width: 280px;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: {{ section.settings.callout_icon_color }};
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout-title {
    margin: 0;
    color: {{ section.settings.panel_heading_color }};
    font-size: 14px;
    font-weight: 900;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout-text {
    margin: 4px 0 0;
    color: {{ section.settings.panel_heading_color }};
    font-size: 14px;
    line-height: 1.3;
  }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-top-right { grid-column: 3; grid-row: 1; justify-self: start; }
  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-middle-right { grid-column: 3; grid-row: 2; justify-self: start; }
  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-bottom-right { grid-column: 3; grid-row: 3; justify-self: start; }
  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-bottom-left { grid-column: 1; grid-row: 3; justify-self: end; }
  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-top-left { grid-column: 1; grid-row: 1; justify-self: end; }
  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-middle-left { grid-column: 1; grid-row: 2; justify-self: end; }

  .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__footer {
    margin: 28px 0 0;
    font-size: 16px;
    line-height: 1.4;
    text-align: center;
  }

  @media screen and (max-width: 999px) {
    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__stage {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__image-wrap {
      order: -1;
      max-width: 100%;
    }

    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout {
      max-width: none;
    }

    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-top-right,
    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-middle-right,
    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-bottom-right,
    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-bottom-left,
    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-top-left,
    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__callout--position-middle-left {
      justify-self: stretch;
    }
  }

  @media screen and (max-width: 749px) {
    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__heading {
      font-size: 38px;
    }

    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__panel {
      padding: 34px 28px;
    }

    .brisa-whats-in-the-box-{{ section_uid }} .brisa-whats-in-the-box__panel-heading {
      font-size: 32px;
    }
  }
</style>

<section class="brisa-whats-in-the-box brisa-whats-in-the-box-{{ section_uid }}" {{ section.shopify_attributes }}>
  <div class="brisa-whats-in-the-box__inner">
    {% if section.settings.heading != blank %}
      <header class="brisa-whats-in-the-box__header">
        <h2 class="brisa-whats-in-the-box__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="brisa-whats-in-the-box__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="brisa-whats-in-the-box__panel">
      {% if section.settings.panel_heading != blank %}
        <h3 class="brisa-whats-in-the-box__panel-heading">{{ section.settings.panel_heading | escape }}</h3>
      {% endif %}

      {% if section.settings.panel_tagline != blank %}
        <p class="brisa-whats-in-the-box__panel-tagline">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M20 7C10.5 8 5.5 12.5 5 20C11 21 16.5 17.5 18.5 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5.5 19.5C9 14 12.5 11.5 17.5 10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
          <span>{{ section.settings.panel_tagline | escape }}</span>
        </p>
      {% endif %}

      <div class="brisa-whats-in-the-box__stage">
        {% if section.settings.image != blank %}
          <div class="brisa-whats-in-the-box__image-wrap">
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                class: 'brisa-whats-in-the-box__image',
                widths: '600,800,1000,1200,1400',
                sizes: '(min-width: 1000px) 44vw, 100vw',
                alt: main_image_alt
            }}
          </div>
        {% endif %}

        {% for block in section.blocks %}
          <div
            class="brisa-whats-in-the-box__callout brisa-whats-in-the-box__callout--position-{{ block.settings.position }}"
            {{ block.shopify_attributes }}
          >
            <div class="brisa-whats-in-the-box__callout-icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'device' %}
                  <svg viewBox="0 0 48 48" fill="none" focusable="false">
                    <rect x="16" y="8" width="16" height="32" rx="8" stroke="currentColor" stroke-width="3.2"/>
                    <path d="M20 14h8M20 34h8" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/>
                  </svg>
                {% when 'leaf' %}
                  <svg viewBox="0 0 48 48" fill="none" focusable="false">
                    <path d="M40 7C21.5 8.5 10.5 17.5 9 35.5C18.5 37 30.5 31 35.5 21.5" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9.5 36C15.5 25.5 23.5 19.5 35.5 16" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
                  </svg>
                {% when 'bag' %}
                  <svg viewBox="0 0 48 48" fill="none" focusable="false">
                    <path d="M14 18h20l2 22H12l2-22Z" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round"/>
                    <path d="M18 18v-4a6 6 0 0 1 12 0v4" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 48 48" fill="none" focusable="false">
                    <path d="M24 6l2.5 8.5L35 17l-8.5 2.5L24 28l-2.5-8.5L13 17l8.5-2.5L24 6Z" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round"/>
                  </svg>
              {% endcase %}
            </div>

            <div>
              {% if block.settings.title != blank %}
                <h4 class="brisa-whats-in-the-box__callout-title">{{ block.settings.title | escape }}</h4>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="brisa-whats-in-the-box__callout-text">{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.footer_text != blank %}
      <p class="brisa-whats-in-the-box__footer">{{ section.settings.footer_text | escape }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Brisa whats in the box",
  "class": "shopify-section--brisa-whats-in-the-box",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHATS IN THE BOX"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to make the switch on day one."
    },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Panel heading",
      "default": "What comes with"
    },
    {
      "type": "text",
      "id": "panel_tagline",
      "label": "Panel tagline",
      "default": "Everything you need. Nothing you do not."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Everything in one box. Ships in 1-2 business days."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#d9efff"
    },
    {
      "type": "color",
      "id": "panel_heading_color",
      "label": "Panel text",
      "default": "#1a3d6b"
    },
    {
      "type": "color",
      "id": "callout_icon_color",
      "label": "Callout icon",
      "default": "#1a3d6b"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Callout",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position (desktop)",
          "default": "top-right",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "top-right", "label": "Top right" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "middle-right", "label": "Middle right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-right", "label": "Bottom right" }
          ]
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "device",
          "options": [
            { "value": "device", "label": "Device" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "bag", "label": "Bag" },
            { "value": "sparkle", "label": "Sparkle" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1 device"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Premium. Reusable. Built to last."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brisa whats in the box",
      "category": "Brisa",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "position": "top-right",
            "icon": "device",
            "title": "1 device",
            "text": "Premium. Reusable. Built to last."
          }
        },
        {
          "type": "item",
          "settings": {
            "position": "middle-right",
            "icon": "leaf",
            "title": "3 mint core packs (30 days worth)",
            "text": "Designed for a complete sensory experience."
          }
        },
        {
          "type": "item",
          "settings": {
            "position": "bottom-right",
            "icon": "bag",
            "title": "Carry bag",
            "text": "Protective. Portable. Made to go."
          }
        },
        {
          "type": "item",
          "settings": {
            "position": "bottom-left",
            "icon": "sparkle",
            "title": "Cleaning kit",
            "text": "Keep your device clean and performing at its best."
          }
        }
      ]
    }
  ]
}
{% endschema %}
