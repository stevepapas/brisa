{% liquid
  assign section_uid = section.id | replace: '-', '' | downcase
  assign main_image_alt = section.settings.image.alt | default: section.settings.heading | escape
  assign image_sizes = '(min-width: 1000px) ' | append: section.settings.image_max_width | append: 'px, 100vw'
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .whats-in-the-box-{{ section_uid }} {
    color: {{ section.settings.text_color }};
    text-align: center;
  }

  .whats-in-the-box-{{ section_uid }} .whats-in-the-box__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .whats-in-the-box-{{ section_uid }} .whats-in-the-box__header {
    margin: 0 0 {{ section.settings.header_spacing }}px;
  }

  .whats-in-the-box-{{ section_uid }} .whats-in-the-box__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .whats-in-the-box-{{ section_uid }} .whats-in-the-box__subheading {
    margin: 14px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: 400;
    line-height: 1.45;
  }

  .whats-in-the-box-{{ section_uid }} .whats-in-the-box__image-wrap {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.image_max_width }}px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: {{ section.settings.placeholder_background }};
  }

  .whats-in-the-box-{{ section_uid }} .whats-in-the-box__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }

  .whats-in-the-box-{{ section_uid }} .whats-in-the-box__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 100%;
    padding: 24px;
    color: {{ section.settings.placeholder_text_color }};
    font-size: {{ section.settings.placeholder_text_size }}px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
  }

  .whats-in-the-box-{{ section_uid }} .whats-in-the-box__footer {
    margin: {{ section.settings.footer_spacing }}px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.footer_size }}px;
    font-weight: 400;
    line-height: 1.45;
  }

  @media screen and (max-width: 749px) {
    .whats-in-the-box-{{ section_uid }} .whats-in-the-box__heading {
      font-size: {{ section.settings.heading_size | times: 0.78 | round }}px;
    }

    .whats-in-the-box-{{ section_uid }} .whats-in-the-box__subheading {
      font-size: {{ section.settings.subheading_size | times: 0.9 | round }}px;
    }
  }
</style>

<section class="whats-in-the-box whats-in-the-box-{{ section_uid }}" {{ section.shopify_attributes }}>
  <div class="whats-in-the-box__inner">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="whats-in-the-box__header">
        {% if section.settings.heading != blank %}
          <h2 class="whats-in-the-box__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="whats-in-the-box__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="whats-in-the-box__image-wrap">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            class: 'whats-in-the-box__image',
            widths: '600,800,1000,1200,1600',
            sizes: image_sizes,
            alt: main_image_alt
        }}
      {% elsif section.settings.placeholder_text != blank %}
        <div class="whats-in-the-box__placeholder">
          <span>{{ section.settings.placeholder_text | escape }}</span>
        </div>
      {% endif %}
    </div>

    {% if section.settings.footer_text != blank %}
      <p class="whats-in-the-box__footer">{{ section.settings.footer_text | escape }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Brisa whats in the box",
  "class": "shopify-section--brisa-whats-in-the-box",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHATS IN THE BOX"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to make the switch on day one."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Square image recommended (e.g. 1200 x 1200px)."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "info": "Shown when no image is uploaded.",
      "default": "Product image goes here"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Everything in one box. Ships in 1-2 business days."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Space below header",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "footer_spacing",
      "label": "Space above footer",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "footer_size",
      "label": "Footer size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "placeholder_text_size",
      "label": "Placeholder text size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "placeholder_background",
      "label": "Image placeholder background",
      "default": "#5b9fd4"
    },
    {
      "type": "color",
      "id": "placeholder_text_color",
      "label": "Placeholder text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Brisa whats in the box",
      "category": "Brisa"
    }
  ]
}
{% endschema %}
