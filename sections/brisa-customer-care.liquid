<style>
  #shopify-section-{{ section.id }} {
    --bcc-max-width: {{ section.settings.content_max_width }}px;
    --bcc-ribbon-bg: {{ section.settings.ribbon_background }};
    --bcc-ribbon-text: {{ section.settings.ribbon_text_color }};
    --bcc-hero-bg: {{ section.settings.hero_panel_background }};
    --bcc-hero-text: {{ section.settings.hero_panel_text_color }};
    --bcc-page-bg: {{ section.settings.page_background }};
    --bcc-panel-bg: {{ section.settings.claim_panel_background }};
    --bcc-button-bg: {{ section.settings.button_background }};
    --bcc-button-text: {{ section.settings.button_text_color }};
    --bcc-guarantee-border: {{ section.settings.guarantee_border_color }};
    --bcc-guarantee-bg: {{ section.settings.guarantee_background }};
    --bcc-card-bg: {{ section.settings.card_background }};
    --bcc-text: {{ section.settings.text_color }};
    --bcc-muted: {{ section.settings.muted_text_color }};
    --bcc-input-border: {{ section.settings.input_border_color }};
    --bcc-warning-bg: {{ section.settings.warning_background }};
    --bcc-care-panel-bg: {{ section.settings.care_panel_background }};
    --bcc-care-border: #008bdc;
    --bcc-care-icon-column: 56px;
    background: var(--bcc-page-bg);
  }

  #shopify-section-{{ section.id }} .brisa-customer-care {
    color: var(--bcc-text);
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__ribbon {
    display: block;
    width: 100%;
    padding: 16px 20px;
    color: #ffffff;
    background: #000000;
    border-radius: 0;
    font-size: 14px;
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__hero-panel {
    padding: 32px 20px 28px;
    color: var(--bcc-hero-text);
    background: #ffffff;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__hero-inner {
    max-width: var(--bcc-max-width);
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__badge {
    display: inline-block;
    margin: 0 0 20px;
    padding: 8px 14px;
    color: #2c579b;
    background: #bee3f9;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__hero-heading {
    margin: 0 0 16px;
    font-size: clamp(28px, 7vw, 36px);
    font-weight: 900;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__hero-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__form-panel {
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__inner {
    max-width: var(--bcc-max-width);
    margin: 0 auto;
    padding: 32px 20px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .brisa-customer-care__inner {
      padding-left: 0;
      padding-right: 0;
    }
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__section-heading {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 900;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__section-subtext {
    margin: 0 0 24px;
    color: var(--bcc-muted);
    font-size: 14px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__field {
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__label {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__input,
  #shopify-section-{{ section.id }} .brisa-customer-care__textarea {
    display: block;
    width: 100%;
    padding: 14px 16px;
    color: var(--bcc-text);
    background: #ffffff;
    border: 1px solid var(--bcc-input-border);
    border-radius: 10px;
    font: inherit;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__textarea {
    min-height: 120px;
    resize: vertical;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__input::placeholder,
  #shopify-section-{{ section.id }} .brisa-customer-care__textarea::placeholder {
    color: var(--bcc-muted);
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    margin-top: 8px;
    padding: 14px 20px;
    color: var(--bcc-button-text) !important;
    background: var(--bcc-button-bg);
    border: 0;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__privacy {
    margin: 12px 0 0;
    color: var(--bcc-muted);
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__guarantee {
    margin-top: 28px;
    padding: 20px;
    color: var(--bcc-text);
    background: var(--bcc-guarantee-bg);
    border: 2px solid var(--bcc-guarantee-border);
    border-radius: 14px;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__guarantee-heading {
    margin: 0 0 12px;
    color: var(--bcc-text);
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__guarantee-text {
    margin: 0;
    color: var(--bcc-text);
    font-size: 16px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__claim-panel {
    padding: 36px 20px 40px;
    background: var(--bcc-panel-bg);
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__claim-inner {
    max-width: var(--bcc-max-width);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__claim-heading {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__claim-intro {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__method-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 14px;
    padding: 16px;
    background: var(--bcc-card-bg);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__method-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #ffffff;
    background: #289adc;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__method-title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 900;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__method-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__steps {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__step-number {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: #ffffff;
    background: #289adc;
    border-radius: 50%;
    font-size: 14px;
    font-weight: 900;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__step-title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 900;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__step-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__quote {
    margin: 24px 0 0;
    font-size: 14px;
    font-style: italic;
    line-height: 1.4;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-section {
    background: var(--bcc-care-panel-bg);
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-ribbon-wrap {
    max-width: var(--bcc-max-width);
    margin: 0 auto;
    padding: 36px 20px 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-ribbon {
    display: inline-block;
    margin: 0;
    padding: 8px 14px;
    color: #2c579b;
    background: #bee3f9;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-hero {
    max-width: var(--bcc-max-width);
    margin: 0 auto;
    padding: 36px 20px 8px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-panel-wrap {
    max-width: var(--bcc-max-width);
    margin: 0 auto;
    padding: 0 20px 40px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .brisa-customer-care__care-panel-wrap {
      padding-left: 0;
      padding-right: 0;
    }
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-heading {
    margin: 0;
    font-size: clamp(26px, 6.5vw, 34px);
    font-weight: 900;
    line-height: 1.15;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-intro {
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 1.45;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-panel {
    margin-top: 16px;
    padding: 0;
    border: 0;
    border-radius: 0;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-icon-column {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: var(--bcc-care-icon-column);
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-frequency {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin: 0 0 16px;
    padding: 16px;
    font-size: 14px;
    line-height: 1.45;
    text-align: left;
    background: var(--bcc-warning-bg);
    border: 3px solid var(--bcc-care-border);
    border-radius: 10px;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-frequency-icon {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-frequency-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-inner {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-step {
    margin-bottom: 16px;
    overflow: hidden;
    background: #ffffff;
    border: 3px solid var(--bcc-care-border);
    border-radius: 10px;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-step:not(:last-child) {
    padding-bottom: 0;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-step-image-wrap {
    display: none;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-step-body {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-step-icon {
    display: block;
    width: var(--bcc-care-icon-column);
    height: var(--bcc-care-icon-column);
    object-fit: contain;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__warning {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 0;
    padding: 16px;
    background: var(--bcc-warning-bg);
    border: 3px solid var(--bcc-care-border);
    border-radius: 10px;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__warning-icon {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-step-title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 900;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__care-step-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__warning-heading {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 900;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__warning-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help-panel {
    width: 100%;
    background: #ffffff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help {
    max-width: var(--bcc-max-width);
    margin: 0 auto;
    padding: 36px 20px 24px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help-heading {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 900;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help-text {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help-policies {
    position: relative;
    left: 50%;
    width: 100vw;
    margin: 0;
    padding: 0;
    list-style: none;
    background: transparent;
    transform: translateX(-50%);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help-policies li {
    margin: 0;
    background: #f4f4f4;
    border-top: 2px solid #000000;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help-policies li:last-child {
    border-bottom: 2px solid #000000;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help-link {
    display: block;
    max-width: var(--bcc-max-width);
    margin: 0 auto;
    padding: 18px 20px;
    color: #000000;
    background: transparent;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .brisa-customer-care__help-link {
      padding-left: 0;
      padding-right: 0;
    }
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__help-link:hover {
    color: #000000;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .brisa-customer-care__form-banner {
    margin-bottom: 20px;
  }
</style>

<section class="brisa-customer-care" {{ section.shopify_attributes }}>
  <div class="brisa-customer-care__hero-panel">
    <div class="brisa-customer-care__hero-inner">
      {%- if section.settings.ribbon_contact != blank -%}
        <p class="brisa-customer-care__badge">{{ section.settings.ribbon_contact | escape }}</p>
      {%- endif -%}
      <h1 class="brisa-customer-care__hero-heading">{{ section.settings.hero_heading | escape }}</h1>
      {%- if section.settings.hero_text != blank -%}
        <p class="brisa-customer-care__hero-text">{{ section.settings.hero_text | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="brisa-customer-care__form-panel">
  <div class="brisa-customer-care__inner" id="brisa-contact-form">
    <h2 class="brisa-customer-care__section-heading">{{ section.settings.form_heading | escape }}</h2>
    {%- if section.settings.form_subtext != blank -%}
      <p class="brisa-customer-care__section-subtext">{{ section.settings.form_subtext | escape }}</p>
    {%- endif -%}

    {%- form 'contact', class: 'brisa-customer-care__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="banner banner--success form__banner brisa-customer-care__form-banner">
          <span class="banner__ribbon">{% render 'icon' with 'form-success' %}</span>
          <p class="banner__content">{{ section.settings.form_success_message | escape }}</p>
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="form__banner banner banner--error brisa-customer-care__form-banner">
          <span class="banner__ribbon">{% render 'icon' with 'form-error' %}</span>
          <div class="banner__content">{{ form.errors | default_errors }}</div>
        </div>
      {%- endif -%}

      <div class="brisa-customer-care__field">
        <label class="brisa-customer-care__label" for="brisa-contact-name-{{ section.id }}">{{ section.settings.label_name | escape }}</label>
        <input
          id="brisa-contact-name-{{ section.id }}"
          class="brisa-customer-care__input"
          type="text"
          name="contact[name]"
          placeholder="{{ section.settings.placeholder_name | escape }}"
          required
          {% if customer %}value="{{ customer.name }}"{% endif %}
        >
      </div>

      <div class="brisa-customer-care__field">
        <label class="brisa-customer-care__label" for="brisa-contact-email-{{ section.id }}">{{ section.settings.label_email | escape }}</label>
        <input
          id="brisa-contact-email-{{ section.id }}"
          class="brisa-customer-care__input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder_email | escape }}"
          required
          {% if customer %}value="{{ customer.email }}"{% endif %}
        >
      </div>

      <div class="brisa-customer-care__field">
        <label class="brisa-customer-care__label" for="brisa-contact-order-{{ section.id }}">{{ section.settings.label_order | escape }}</label>
        <input
          id="brisa-contact-order-{{ section.id }}"
          class="brisa-customer-care__input"
          type="text"
          name="contact[Order Number]"
          placeholder="{{ section.settings.placeholder_order | escape }}"
        >
      </div>

      <div class="brisa-customer-care__field">
        <label class="brisa-customer-care__label" for="brisa-contact-message-{{ section.id }}">{{ section.settings.label_message | escape }}</label>
        <textarea
          id="brisa-contact-message-{{ section.id }}"
          class="brisa-customer-care__textarea"
          name="contact[body]"
          placeholder="{{ section.settings.placeholder_message | escape }}"
          required
        ></textarea>
      </div>

      <button is="loader-button" type="submit" class="brisa-customer-care__submit">
        {{ section.settings.submit_label | escape }}
      </button>

      {%- if section.settings.privacy_text != blank -%}
        <p class="brisa-customer-care__privacy">{{ section.settings.privacy_text | escape }}</p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.guarantee_heading != blank or section.settings.guarantee_text != blank -%}
      <div class="brisa-customer-care__guarantee">
        {%- if section.settings.guarantee_heading != blank -%}
          <h2 class="brisa-customer-care__guarantee-heading">{{ section.settings.guarantee_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.guarantee_text != blank -%}
          <p class="brisa-customer-care__guarantee-text">{{ section.settings.guarantee_text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  </div>

  <div class="brisa-customer-care__claim-panel">
    <div class="brisa-customer-care__claim-inner">
      <h2 class="brisa-customer-care__claim-heading">{{ section.settings.claim_heading | escape }}</h2>
      {%- if section.settings.claim_intro != blank -%}
        <p class="brisa-customer-care__claim-intro">{{ section.settings.claim_intro | escape }}</p>
      {%- endif -%}

      {%- if section.settings.method_1_title != blank -%}
        <a class="brisa-customer-care__method-card" href="{{ section.settings.method_1_link | default: '#brisa-contact-form' }}">
          <span class="brisa-customer-care__method-icon" aria-hidden="true">
            {%- render 'icon' with 'picto-email', width: 24, height: 24 -%}
          </span>
          <span>
            <p class="brisa-customer-care__method-title">{{ section.settings.method_1_title | escape }}</p>
            {%- if section.settings.method_1_text != blank -%}
              <p class="brisa-customer-care__method-text">{{ section.settings.method_1_text | escape }}</p>
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}

      {%- if section.settings.method_2_title != blank -%}
        <a class="brisa-customer-care__method-card" href="{{ section.settings.method_2_link }}" target="_blank" rel="noopener">
          <span class="brisa-customer-care__method-icon" aria-hidden="true">
            {%- render 'icon' with 'instagram', width: 24, height: 24 -%}
          </span>
          <span>
            <p class="brisa-customer-care__method-title">{{ section.settings.method_2_title | escape }}</p>
            {%- if section.settings.method_2_text != blank -%}
              <p class="brisa-customer-care__method-text">{{ section.settings.method_2_text | escape }}</p>
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}

      {%- assign claim_steps = section.blocks | where: 'type', 'claim_step' -%}
      {%- if claim_steps.size > 0 -%}
        <ol class="brisa-customer-care__steps">
          {%- for block in claim_steps -%}
            <li class="brisa-customer-care__step" {{ block.shopify_attributes }}>
              <span class="brisa-customer-care__step-number">{{ forloop.index }}</span>
              <span>
                {%- if block.settings.title != blank -%}
                  <p class="brisa-customer-care__step-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="brisa-customer-care__step-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.claim_quote != blank -%}
        <p class="brisa-customer-care__quote">{{ section.settings.claim_quote | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="brisa-customer-care__care-section">
    <div class="brisa-customer-care__care-ribbon-wrap">
      <p class="brisa-customer-care__care-ribbon">{{ section.settings.ribbon_care | escape }}</p>
    </div>

    <div class="brisa-customer-care__care-hero">
      <h2 class="brisa-customer-care__care-heading">{{ section.settings.care_heading | escape }}</h2>
      {%- if section.settings.care_intro != blank -%}
        <p class="brisa-customer-care__care-intro">{{ section.settings.care_intro | escape }}</p>
      {%- endif -%}
    </div>

    <div class="brisa-customer-care__care-panel-wrap">
      <div class="brisa-customer-care__care-panel">
        {%- if section.settings.care_frequency != blank -%}
          {%- assign care_frequency_icon = section.settings.care_frequency_icon -%}
          {%- if care_frequency_icon == blank -%}
            {%- assign care_frequency_icon = 'aim.png' -%}
          {%- endif -%}
          <div class="brisa-customer-care__care-frequency">
            <span class="brisa-customer-care__care-icon-column brisa-customer-care__care-frequency-icon-wrap">
              <img
                class="brisa-customer-care__care-frequency-icon"
                src="{{ care_frequency_icon | file_url }}"
                alt=""
                width="28"
                height="28"
                loading="lazy"
              >
            </span>
            <p class="brisa-customer-care__care-frequency-text">{{ section.settings.care_frequency | escape }}</p>
          </div>
        {%- endif -%}

        <div class="brisa-customer-care__care-inner">
      {%- assign care_steps = section.blocks | where: 'type', 'care_step' -%}
      {%- for block in care_steps -%}
        {%- capture care_step_image -%}like-new_0{{ forloop.index }}.png{%- endcapture -%}
        <div class="brisa-customer-care__care-step" {{ block.shopify_attributes }}>
          <div class="brisa-customer-care__care-step-body">
            <span class="brisa-customer-care__care-icon-column brisa-customer-care__care-step-icon-wrap">
              <img
                class="brisa-customer-care__care-step-icon"
                src="{{ care_step_image | file_url }}"
                alt=""
                width="56"
                height="56"
                loading="lazy"
              >
            </span>
            <span>
              {%- if block.settings.title != blank -%}
                <p class="brisa-customer-care__care-step-title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="brisa-customer-care__care-step-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </span>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.settings.warning_heading != blank or section.settings.warning_text != blank -%}
        {%- assign warning_icon = section.settings.warning_icon -%}
        {%- if warning_icon == blank -%}
          {%- assign warning_icon = 'small-heads-up.png' -%}
        {%- endif -%}
        <div class="brisa-customer-care__warning">
          <span class="brisa-customer-care__care-icon-column brisa-customer-care__warning-icon-wrap">
            <img
              class="brisa-customer-care__warning-icon"
              src="{{ warning_icon | file_url }}"
              alt=""
              width="28"
              height="28"
              loading="lazy"
            >
          </span>
          <span>
            {%- if section.settings.warning_heading != blank -%}
              <p class="brisa-customer-care__warning-heading">{{ section.settings.warning_heading | escape }}</p>
            {%- endif -%}
            {%- if section.settings.warning_text != blank -%}
              <p class="brisa-customer-care__warning-text">{{ section.settings.warning_text | escape }}</p>
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <div class="brisa-customer-care__help-panel">
    <div class="brisa-customer-care__help">
      {%- if section.settings.help_heading != blank -%}
        <h2 class="brisa-customer-care__help-heading">{{ section.settings.help_heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.help_text != blank -%}
        <p class="brisa-customer-care__help-text">{{ section.settings.help_text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_policy_links -%}
      <ul class="brisa-customer-care__help-policies" role="list" aria-label="Policies">
        {%- if shop.refund_policy -%}
          <li>
            <a class="brisa-customer-care__help-link" href="{{ shop.refund_policy.url }}">{{ section.settings.refund_link_label | escape }}</a>
          </li>
        {%- endif -%}
        {%- if shop.terms_of_service -%}
          <li>
            <a class="brisa-customer-care__help-link" href="{{ shop.terms_of_service.url }}">{{ section.settings.terms_link_label | escape }}</a>
          </li>
        {%- endif -%}
        {%- if shop.shipping_policy -%}
          <li>
            <a class="brisa-customer-care__help-link" href="{{ shop.shipping_policy.url }}">{{ section.settings.shipping_link_label | escape }}</a>
          </li>
        {%- endif -%}
        {%- if shop.privacy_policy -%}
          <li>
            <a class="brisa-customer-care__help-link" href="{{ shop.privacy_policy.url }}">{{ section.settings.privacy_link_label | escape }}</a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>

