            {%- render 'icon' with 'picto-email', width: 24, height: 24 -%}
          </span>
          <span>
            <p class="brisa-customer-care__method-title">{{ section.settings.method_1_title | escape }}</p>
            {%- if section.settings.method_1_text != blank -%}
              <p class="brisa-customer-care__method-text">{{ section.settings.method_1_text | escape }}</p>
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}

      {%- if section.settings.method_2_title != blank -%}
        <a class="brisa-customer-care__method-card" href="{{ section.settings.method_2_link }}" target="_blank" rel="noopener">
