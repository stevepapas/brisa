              {%- if block.settings.title != blank -%}
                <p class="brisa-customer-care__care-step-title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="brisa-customer-care__care-step-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </span>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.settings.warning_heading != blank or section.settings.warning_text != blank -%}
        {%- assign warning_icon = section.settings.warning_icon -%}
        {%- if warning_icon == blank -%}
          {%- assign warning_icon = 'small-heads-up.png' -%}
        {%- endif -%}
        <div class="brisa-customer-care__warning">
          <span class="brisa-customer-care__care-icon-column brisa-customer-care__warning-icon-wrap">
            <img
              class="brisa-customer-care__warning-icon"
              src="{{ warning_icon | file_url }}"
              alt=""
              width="28"
              height="28"
              loading="lazy"
            >
          </span>
          <span>
            {%- if section.settings.warning_heading != blank -%}
              <p class="brisa-customer-care__warning-heading">{{ section.settings.warning_heading | escape }}</p>
            {%- endif -%}
            {%- if section.settings.warning_text != blank -%}
              <p class="brisa-customer-care__warning-text">{{ section.settings.warning_text | escape }}</p>
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <div class="brisa-customer-care__help-panel">
    <div class="brisa-customer-care__help">
      {%- if section.settings.help_heading != blank -%}
        <h2 class="brisa-customer-care__help-heading">{{ section.settings.help_heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.help_text != blank -%}
        <p class="brisa-customer-care__help-text">{{ section.settings.help_text | escape }}</p>
      {%- endif -%}
    </div>

  </div>
</section>

