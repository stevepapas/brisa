<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .blue-layout-2 {
    color: {{ section.settings.text_color }};
    background: {{ section.settings.panel_background }};
    border-top: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
  }

  #shopify-section-{{ section.id }} .blue-layout-2__stat {
    padding: 42px 20px 34px;
    text-align: center;
    border-bottom: {{ section.settings.divider_width }}px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .blue-layout-2__number {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.number_size }}px;
    font-weight: 900;
    line-height: 0.95;
  }

  #shopify-section-{{ section.id }} .blue-layout-2__stat-copy {
    margin: 14px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.stat_copy_size }}px;
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .blue-layout-2__content {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 34px 20px 58px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .blue-layout-2__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 34px;
    padding: 10px 16px;
    color: {{ section.settings.badge_text_color }};
    background: {{ section.settings.badge_background }};
    border-radius: 999px;
    font-size: {{ section.settings.badge_size }}px;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .blue-layout-2__heading {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .blue-layout-2__text {
    max-width: 480px;
    margin: 0 auto;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.25;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .blue-layout-2__number {
      font-size: {{ section.settings.number_size | times: 0.82 | round }}px;
    }

    #shopify-section-{{ section.id }} .blue-layout-2__heading {
      font-size: {{ section.settings.heading_size | times: 0.72 | round }}px;
    }

    #shopify-section-{{ section.id }} .blue-layout-2__text {
      font-size: {{ section.settings.body_size | times: 0.9 | round }}px;
    }
  }
</style>

<section class="blue-layout-2" {{ section.shopify_attributes }}>
  <div class="blue-layout-2__stat">
    {% if section.settings.number != blank %}
      <h2 class="blue-layout-2__number">{{ section.settings.number | escape }}</h2>
    {% endif %}

    {% if section.settings.stat_copy != blank %}
      <p class="blue-layout-2__stat-copy">{{ section.settings.stat_copy | escape }}</p>
    {% endif %}
  </div>

  <div class="blue-layout-2__content">
    {% if section.settings.badge != blank %}
      <div class="blue-layout-2__badge">{{ section.settings.badge | escape }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h3 class="blue-layout-2__heading">{{ section.settings.heading | escape | newline_to_br }}</h3>
    {% endif %}

    {% if section.settings.body != blank %}
      <p class="blue-layout-2__text">{{ section.settings.body | escape }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Blue layout 2",
  "class": "shopify-section--blue-layout-2",
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "1,000+"
    },
    {
      "type": "text",
      "id": "stat_copy",
      "label": "Stat copy",
      "default": "AUSSIES HAVE STARTED WITH BRISA"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "DESIGNED TO REBEL"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "FOR THE ONES WHO ARE DONE\nWITH THE HABIT"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Not another vape. Not another patch. Not another \"just use willpower\" lecture. Brisa was built for the moment your hand reaches before your brain catches up."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#1198dc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Outer border",
      "default": "#cdeeff"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Outer border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#b8e9ff"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#7ccfff"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#2c579b"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Number size",
      "min": 48,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "stat_copy_size",
      "label": "Stat copy size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Badge size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 52,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Blue layout 2",
      "category": "Brisa"
    }
  ]
}
{% endschema %}
