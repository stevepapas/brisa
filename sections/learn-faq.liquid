<style>
  #shopify-section-{{ section.id }} {
    --learn-blue: #038bdd;
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .learn-faq {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .learn-faq__badge {
    display: table;
    margin: 0 auto 16px;
    padding: 8px 16px;
    color: #2c579b;
    background: #bee3f9;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .learn-faq__heading {
    margin: 0 0 24px;
    font-size: clamp(28px, 6vw, 36px);
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .learn-faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .learn-faq__item {
    background: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 12px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .learn-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 16px 18px;
    color: #111111;
    background: transparent;
    border: 0;
    font-size: 15px;
    font-weight: 900;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .learn-faq__toggle {
    flex: 0 0 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: #ffffff;
    background: var(--learn-blue);
    border-radius: 50%;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .learn-faq__item[open] .learn-faq__toggle {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .learn-faq__answer {
    padding: 0 18px 16px;
    color: #444444;
    font-size: 15px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .learn-faq__answer p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .learn-faq__answer p + p {
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .learn-faq__footer {
    padding: 32px 20px;
    color: #ffffff;
    background: #111111;
    border-radius: 12px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .learn-faq__logo {
    margin: 0 0 12px;
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .learn-faq__logo-sub {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  #shopify-section-{{ section.id }} .learn-faq__copyright {
    margin: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>

<section class="learn-faq" id="learn-faq" {{ section.shopify_attributes }}>
  {%- if section.settings.badge != blank -%}
    <p class="learn-faq__badge">{{ section.settings.badge | escape }}</p>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <h2 class="learn-faq__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="learn-faq__list" itemscope itemtype="https://schema.org/FAQPage">
      {%- for block in section.blocks -%}
        <details class="learn-faq__item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" {{ block.shopify_attributes }}>
          <summary class="learn-faq__question">
            <span itemprop="name">{{ block.settings.question | escape }}</span>
            <span class="learn-faq__toggle" aria-hidden="true">+</span>
          </summary>
          <div class="learn-faq__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">{{ block.settings.answer }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_footer -%}
    <div class="learn-faq__footer">
      <p class="learn-faq__logo">
        BRISA
        <span class="learn-faq__logo-sub">BETTER</span>
      </p>
      {%- if section.settings.copyright != blank -%}
        <p class="learn-faq__copyright">{{ section.settings.copyright | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Learn FAQ",
  "class": "shopify-section--learn-faq",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "MOST POPULAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "QUICK QUESTIONS."
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Show footer strip",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "© BRISA BETTER PTY LTD · AUSTRALIA"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is Brisa safe?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Brisa is a non-consumption product. There is no smoke, no vapour, no nicotine, no heating, no battery, and no e-liquid.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Learn FAQ"
    }
  ]
}
{% endschema %}
