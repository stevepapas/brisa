{{ 'brisa-kit-purchase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'brisa-kit-purchase.js' | asset_url }}" defer></script>

{%- liquid
  assign try_product = section.settings.try_product
  assign commitment_product = section.settings.commitment_product
  assign mates_product = section.settings.mates_product
  assign addon_product = section.settings.addon_product

  if try_product == blank and section.settings.try_handle != blank
    assign try_product = all_products[section.settings.try_handle]
  endif
  if commitment_product == blank and section.settings.commitment_handle != blank
    assign commitment_product = all_products[section.settings.commitment_handle]
  endif
  if mates_product == blank and section.settings.mates_handle != blank
    assign mates_product = all_products[section.settings.mates_handle]
  endif
  if addon_product == blank and section.settings.addon_handle != blank
    assign addon_product = all_products[section.settings.addon_handle]
  endif

  assign active_key = 'commitment'
  if mates_product != blank and product.id == mates_product.id
    assign active_key = 'mates'
  elsif try_product != blank and product.id == try_product.id
    assign active_key = 'try'
  elsif commitment_product != blank and product.id == commitment_product.id
    assign active_key = 'commitment'
  elsif product.handle contains 'mates'
    assign active_key = 'mates'
  endif

  assign addon_variant = addon_product.selected_or_first_available_variant
  assign addon_price_cents = section.settings.addon_price_cents | default: 4400
  assign addon_selling_plan_id = blank
  if addon_variant != blank
    assign addon_price_cents = addon_variant.price
    for allocation in addon_variant.selling_plan_allocations
      assign addon_selling_plan_id = allocation.selling_plan.id
      assign addon_price_cents = allocation.price
      break
    endfor
  endif
  if addon_selling_plan_id == blank and addon_product != blank
    for group in addon_product.selling_plan_groups
      for plan in group.selling_plans
        assign addon_selling_plan_id = plan.id
        break
      endfor
      if addon_selling_plan_id != blank
        break
      endif
    endfor
  endif

  assign colour_blocks = section.blocks | where: 'type', 'colour'
-%}

<brisa-kit-purchase
  class="bkp"
  data-devices="1"
  data-addon-price-cents="{{ addon_price_cents }}"
  {% if addon_variant != blank %}data-addon-variant-id="{{ addon_variant.id }}"{% endif %}
  {% if addon_selling_plan_id != blank %}data-addon-selling-plan-id="{{ addon_selling_plan_id }}"{% endif %}
  {{ section.shopify_attributes }}
>
  <div class="bkp__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="bkp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <h2 class="bkp__title">
      {{ section.settings.title | default: 'BRISA™ STARTER KIT' | escape }}
    </h2>

    {% if section.settings.show_rating %}
      <div class="bkp__rating">
        <span class="bkp__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24" focusable="false"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {%- endfor -%}
        </span>
        {% if section.settings.rating_text != blank %}
          <span class="bkp__rating-text">{{ section.settings.rating_text | escape }}</span>
        {% endif %}
        {% if section.settings.rating_badge != blank %}
          <span class="bkp__rating-badge">{{ section.settings.rating_badge | escape }}</span>
        {% endif %}
      </div>
    {% endif %}

    <ul class="bkp__highlights">
      {% for i in (1..4) %}
        {% liquid
          case i
            when 1
              assign hi_icon = section.settings.highlight_icon_1
              assign hi_label = section.settings.highlight_label_1
            when 2
              assign hi_icon = section.settings.highlight_icon_2
              assign hi_label = section.settings.highlight_label_2
            when 3
              assign hi_icon = section.settings.highlight_icon_3
              assign hi_label = section.settings.highlight_label_3
            else
              assign hi_icon = section.settings.highlight_icon_4
              assign hi_label = section.settings.highlight_label_4
          endcase
        %}
        {% if hi_label != blank %}
          <li class="bkp__highlight">
            <span class="bkp__highlight-icon{% if hi_icon != blank %} bkp__highlight-icon--custom{% endif %}" aria-hidden="true">
              {% if hi_icon != blank %}
                {{ hi_icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48,96', alt: '' }}
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" focusable="false"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2"/></svg>
              {% endif %}
            </span>
            <span>{{ hi_label | escape }}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ul>

    <h3 class="bkp__choose-heading">{{ section.settings.choose_heading | default: 'Choose your kit' | escape }}</h3>
    {% if section.settings.choose_sub != blank %}
      <p class="bkp__choose-sub">{{ section.settings.choose_sub | escape }}</p>
    {% endif %}

    <div class="bkp__kits" role="radiogroup" aria-label="{{ section.settings.choose_heading | default: 'Choose your kit' | escape }}">
      {% assign kit_defs = 'try,commitment,mates' | split: ',' %}
      {% for key in kit_defs %}
        {% liquid
          assign kit_product = blank
          assign kit_title = ''
          assign kit_subtitle = ''
          assign kit_price = ''
          assign kit_compare = ''
          assign kit_save = ''
          assign kit_banner = ''
          assign kit_devices = 1
          assign kit_image = blank
          assign kit_image_asset = ''
          assign price_cents = 0
          assign variant_id = ''

          case key
            when 'try'
              assign kit_product = try_product
              assign kit_title = section.settings.try_title
              assign kit_subtitle = section.settings.try_subtitle
              assign kit_price = section.settings.try_price
              assign kit_compare = section.settings.try_compare
              assign kit_save = section.settings.try_save
              assign kit_banner = section.settings.try_banner
              assign kit_devices = 1
              assign kit_image = section.settings.try_image
              assign kit_image_asset = section.settings.try_image_asset | default: 'brisa-kit-try.jpg' | strip
              assign price_cents = section.settings.try_price_cents | default: 13000
            when 'commitment'
              assign kit_product = commitment_product
              assign kit_title = section.settings.commitment_title
              assign kit_subtitle = section.settings.commitment_subtitle
              assign kit_price = section.settings.commitment_price
              assign kit_compare = section.settings.commitment_compare
              assign kit_save = section.settings.commitment_save
              assign kit_banner = section.settings.commitment_banner
              assign kit_devices = 1
              assign kit_image = section.settings.commitment_image
              assign kit_image_asset = section.settings.commitment_image_asset | default: 'brisa-kit-commitment.jpg' | strip
              assign price_cents = section.settings.commitment_price_cents | default: 16500
            when 'mates'
              assign kit_product = mates_product
              assign kit_title = section.settings.mates_title
              assign kit_subtitle = section.settings.mates_subtitle
              assign kit_price = section.settings.mates_price
              assign kit_compare = section.settings.mates_compare
              assign kit_save = section.settings.mates_save
              assign kit_banner = section.settings.mates_banner
              assign kit_devices = 2
              assign kit_image = section.settings.mates_image
              assign kit_image_asset = section.settings.mates_image_asset | default: 'brisa-kit-mates.jpg' | strip
              assign price_cents = section.settings.mates_price_cents | default: 22000
          endcase

          if kit_product != blank
            assign kit_variant = kit_product.selected_or_first_available_variant
            assign variant_id = kit_variant.id
            assign price_cents = kit_variant.price
            if kit_image == blank
              assign kit_image = kit_product.featured_image
            endif
            if kit_price == blank
              assign kit_price = kit_variant.price | money_without_trailing_zeros
            endif
          endif

          assign is_selected = false
          if active_key == key
            assign is_selected = true
          endif
        %}

        <label
          class="bkp__kit{% if is_selected %} is-selected{% endif %}"
          data-bkp-kit
          data-kit-key="{{ key }}"
          data-devices="{{ kit_devices }}"
          data-variant-id="{{ variant_id }}"
          data-price-cents="{{ price_cents }}"
          data-title="{{ kit_title | escape }}"
        >
          <input type="radio" name="bkp-kit-{{ section.id }}" value="{{ key }}" {% if is_selected %}checked{% endif %}>
          {% if kit_banner != blank %}
            <span class="bkp__kit-banner">{{ kit_banner | escape }}</span>
          {% endif %}

          <div class="bkp__kit-main">
            <div class="bkp__kit-heading">
              <h4 class="bkp__kit-title">{{ kit_title | escape }}</h4>
              {% if kit_subtitle != blank %}
                <p class="bkp__kit-subtitle">{{ kit_subtitle | escape }}</p>
              {% endif %}
            </div>

            <div class="bkp__kit-pricing">
              {% if kit_price != blank %}
                <span class="bkp__kit-price">{{ kit_price | escape }}</span>
              {% endif %}
              {% if kit_compare != blank %}
                <span class="bkp__kit-compare">{{ kit_compare | escape }}</span>
              {% endif %}
              {% if kit_save != blank %}
                <span class="bkp__kit-save">{{ kit_save | escape }}</span>
              {% endif %}
            </div>

            <ul class="bkp__kit-features">
              {% for block in section.blocks %}
                {% if block.type == 'feature' and block.settings.kit == key and block.settings.text != blank %}
                  <li class="bkp__kit-feature{% if block.settings.bonus %} bkp__kit-feature--bonus{% endif %}" {{ block.shopify_attributes }}>
                    <span class="bkp__kit-check" aria-hidden="true"></span>
                    <span>{{ block.settings.text | escape }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>

          <div class="bkp__kit-side">
            <span class="bkp__kit-radio" aria-hidden="true"></span>
            {% if kit_image != blank %}
              {{ kit_image | image_url: width: 280 | image_tag: class: 'bkp__kit-thumb', loading: 'lazy', widths: '112,160,224,280', alt: kit_title }}
            {% elsif kit_image_asset != blank %}
              <img
                class="bkp__kit-thumb"
                src="{{ kit_image_asset | asset_url }}"
                alt="{{ kit_title | escape }}"
                width="140"
                height="140"
                loading="lazy"
                decoding="async"
              >
            {% endif %}
          </div>
        </label>
      {% endfor %}
    </div>

    {% if section.settings.gifts_heading != blank %}
      <p class="bkp__gifts-heading">{{ section.settings.gifts_heading | escape }}</p>
    {% endif %}
    <div class="bkp__gifts">
      {% for block in section.blocks %}
        {% if block.type == 'gift' %}
          <div class="bkp__gift" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 160 | image_tag: class: 'bkp__gift-media', loading: 'lazy', widths: '64,96,128,160', alt: block.settings.title }}
            {% else %}
              <span class="bkp__gift-media" aria-hidden="true"></span>
            {% endif %}
            <div class="bkp__gift-body">
              <div class="bkp__gift-title-row">
                {% if block.settings.title != blank %}
                  <h4 class="bkp__gift-title">{{ block.settings.title | escape }}</h4>
                {% endif %}
                {% if block.settings.tag != blank %}
                  <span class="bkp__gift-tag">{{ block.settings.tag | escape }}</span>
                {% endif %}
              </div>
              {% if block.settings.text != blank %}
                <p class="bkp__gift-text">{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_addon %}
      {%- liquid
        assign addon_image = section.settings.addon_image
        if addon_image == blank and addon_product != blank
          assign addon_image = addon_product.featured_image
        endif
        assign addon_image_asset = section.settings.addon_image_asset | strip
        assign addon_bonus_image = section.settings.addon_bonus_image
        assign addon_bonus_image_asset = section.settings.addon_bonus_image_asset | strip
      -%}
      <div class="bkp__addon" data-bkp-addon>
        <span class="bkp__addon-tab">{{ section.settings.addon_tab | default: 'ADD ON' | escape }}</span>

        <div class="bkp__addon-layout">
          <input
            class="bkp__addon-check"
            type="checkbox"
            data-bkp-addon-check
            id="bkp-addon-{{ section.id }}"
            {% unless addon_variant and addon_selling_plan_id %}disabled{% endunless %}
          >

          <div class="bkp__addon-main">
            <div class="bkp__addon-heading">
              <h4 class="bkp__addon-title">
                <label for="bkp-addon-{{ section.id }}">{{ section.settings.addon_title | default: 'Monthly Better Box' | escape }}</label>
              </h4>
              {% if section.settings.addon_save != blank %}
                <span class="bkp__addon-save">{{ section.settings.addon_save | escape }}</span>
              {% endif %}
            </div>

            {% if section.settings.addon_subtitle != blank %}
              <p class="bkp__addon-subtitle">{{ section.settings.addon_subtitle | escape }}</p>
            {% endif %}

            <div class="bkp__addon-body">
              <div class="bkp__addon-copy">
                <div class="bkp__addon-price-row">
                  <span class="bkp__addon-price">{{ section.settings.addon_price | default: '$44/mo' | escape }}</span>
                  {% if section.settings.addon_compare != blank %}
                    <span class="bkp__addon-compare">{{ section.settings.addon_compare | escape }}</span>
                  {% endif %}
                  {% if section.settings.addon_price_meta != blank %}
                    <span class="bkp__addon-price-meta">{{ section.settings.addon_price_meta | escape }}</span>
                  {% endif %}
                </div>
                {% if section.settings.addon_contents != blank %}
                  <p class="bkp__addon-contents">{{ section.settings.addon_contents | escape }}</p>
                {% endif %}
              </div>

              {% if addon_image != blank %}
                {{ addon_image | image_url: width: 280 | image_tag: class: 'bkp__addon-media', loading: 'lazy', widths: '120,180,240,280', alt: section.settings.addon_title }}
              {% elsif addon_image_asset != blank %}
                <img
                  class="bkp__addon-media"
                  src="{{ addon_image_asset | asset_url }}"
                  alt="{{ section.settings.addon_title | escape }}"
                  width="140"
                  height="140"
                  loading="lazy"
                  decoding="async"
                >
              {% endif %}
            </div>

            {% if section.settings.addon_bonus != blank or section.settings.addon_bonus_text != blank %}
              <div class="bkp__addon-bonus">
                <span class="bkp__addon-bonus-tag">{{ section.settings.addon_bonus_tag | default: 'FREE' | escape }}</span>
                <p class="bkp__addon-bonus-text">
                  {{ section.settings.addon_bonus_text | default: section.settings.addon_bonus | escape }}
                </p>
                {% if addon_bonus_image != blank %}
                  {{ addon_bonus_image | image_url: width: 96 | image_tag: class: 'bkp__addon-bonus-media', loading: 'lazy', widths: '48,72,96', alt: '' }}
                {% elsif addon_bonus_image_asset != blank %}
                  <img
                    class="bkp__addon-bonus-media"
                    src="{{ addon_bonus_image_asset | asset_url }}"
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  >
                {% endif %}
              </div>
            {% endif %}
          </div>

          <button type="button" class="bkp__addon-action" data-bkp-addon-toggle>
            {{ section.settings.addon_action | default: 'ADD' | escape }}
          </button>
        </div>

        {% if section.settings.addon_footer != blank %}
          <p class="bkp__addon-footer">{{ section.settings.addon_footer | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="bkp__colours bkp__colours--dual" data-bkp-colours>
      <div class="bkp__colour-group" data-role="yours">
        <p class="bkp__colour-label">{{ section.settings.colour_label_yours | default: 'Your colour' | escape }}</p>
        <div class="bkp__swatches" role="listbox" aria-label="{{ section.settings.colour_label_yours | default: 'Your colour' | escape }}">
          {% for block in colour_blocks %}
            {% liquid
              assign colour_product = block.settings.device_product
              assign colour_variant_id = ''
              if colour_product != blank
                assign colour_variant_id = colour_product.selected_or_first_available_variant.id
              endif
              assign swatch_style = block.settings.hex | default: '#cccccc'
              assign is_first = forloop.first
            %}
            <button
              type="button"
              class="bkp__swatch{% if is_first %} is-selected{% endif %}"
              style="background-color: {{ swatch_style }};"
              data-bkp-swatch
              data-role="yours"
              data-label="{{ block.settings.label | escape }}"
              data-variant-id="{{ colour_variant_id }}"
              aria-label="{{ block.settings.label | escape }}"
              {{ block.shopify_attributes }}
            ></button>
          {% endfor %}
        </div>
        <p class="bkp__swatch-name" data-bkp-colour-name="yours">
          {% if colour_blocks.size > 0 %}{{ colour_blocks.first.settings.label | escape }}{% endif %}
        </p>
      </div>

      <div class="bkp__colour-group" data-role="mates">
        <p class="bkp__colour-label">{{ section.settings.colour_label_mates | default: "Mate's colour" | escape }}</p>
        <div class="bkp__swatches" role="listbox" aria-label="{{ section.settings.colour_label_mates | default: "Mate's colour" | escape }}">
          {% for block in colour_blocks %}
            {% liquid
              assign colour_product = block.settings.device_product
              assign colour_variant_id = ''
              if colour_product != blank
                assign colour_variant_id = colour_product.selected_or_first_available_variant.id
              endif
              assign swatch_style = block.settings.hex | default: '#cccccc'
              assign is_first = forloop.first
            %}
            <button
              type="button"
              class="bkp__swatch{% if is_first %} is-selected{% endif %}"
              style="background-color: {{ swatch_style }};"
              data-bkp-swatch
              data-role="mates"
              data-label="{{ block.settings.label | escape }}"
              data-variant-id="{{ colour_variant_id }}"
              aria-label="{{ block.settings.label | escape }}"
            ></button>
          {% endfor %}
        </div>
        <p class="bkp__swatch-name" data-bkp-colour-name="mates">
          {% if colour_blocks.size > 0 %}{{ colour_blocks.first.settings.label | escape }}{% endif %}
        </p>
      </div>
    </div>

    <button type="button" class="bkp__atc" data-bkp-atc>
      <span data-bkp-atc-label>ADD TO CART</span>
    </button>
    <p class="bkp__error" data-bkp-error role="status" aria-live="polite"></p>

    {% if section.settings.show_trust %}
      <ul class="bkp__trust">
        {% for i in (1..6) %}
          {% liquid
            case i
              when 1
                assign t_label = section.settings.trust_1
                assign t_icon = section.settings.trust_icon_1
              when 2
                assign t_label = section.settings.trust_2
                assign t_icon = section.settings.trust_icon_2
              when 3
                assign t_label = section.settings.trust_3
                assign t_icon = section.settings.trust_icon_3
              when 4
                assign t_label = section.settings.trust_4
                assign t_icon = section.settings.trust_icon_4
              when 5
                assign t_label = section.settings.trust_5
                assign t_icon = section.settings.trust_icon_5
              else
                assign t_label = section.settings.trust_6
                assign t_icon = section.settings.trust_icon_6
            endcase
          %}
          {% if t_label != blank %}
            <li class="bkp__trust-item">
              <span class="bkp__trust-icon{% if t_icon != blank %} bkp__trust-icon--custom{% endif %}" aria-hidden="true">
                {% if t_icon != blank %}
                  {{ t_icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
                {% else %}
                  {% case i %}
                    {% when 1 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M3 7h13v10H3V7Zm13 3h3l2 3v4h-5V10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="18.5" r="1.5" fill="currentColor"/><circle cx="17" cy="18.5" r="1.5" fill="currentColor"/></svg>
                    {% when 2 %}
                      <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8"/></svg>
                    {% when 3 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M4 8h16v11H4V8Z" stroke="currentColor" stroke-width="1.8"/><path d="M4 8l8-4 8 4" stroke="currentColor" stroke-width="1.8"/></svg>
                    {% when 4 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M5 18c2-7 5-10 12-11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M7 20h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    {% when 5 %}
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 5.2L20 8.2l-4 4.1.9 5.7L12 15.6 7.1 18l.9-5.7-4-4.1 5.6-1L12 2z"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.8"/><path d="m8.5 12 2.2 2.2L15.5 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  {% endcase %}
                {% endif %}
              </span>
              <span>{{ t_label | escape }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
    {% if accordion_blocks.size > 0 %}
      <div class="bkp__accordions">
        {% for block in accordion_blocks %}
          {% if block.settings.title == blank %}{% continue %}{% endif %}
          <details class="bkp__accordion" {{ block.shopify_attributes }}>
            <summary class="bkp__accordion-summary">
              <span class="bkp__accordion-icon" aria-hidden="true">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 72 | image_tag: loading: 'lazy', widths: '24,48,72', alt: '' }}
                {% else %}
                  {% case block.settings.icon_style %}
                    {% when 'ingredients' %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M8 4h8l1 4H7l1-4Z" stroke="currentColor" stroke-width="1.8"/><path d="M7 8h10v11a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V8Z" stroke="currentColor" stroke-width="1.8"/><path d="M10 12h4M10 16h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    {% when 'subscription' %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M20 12a8 8 0 1 1-2.3-5.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M20 4v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% when 'shipping' %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M3 7h13v10H3V7Zm13 3h3l2 3v4h-5V10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="18.5" r="1.5" fill="currentColor"/><circle cx="17" cy="18.5" r="1.5" fill="currentColor"/><path d="M1 10h2M1 13h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 9h8M8 12h8M8 15h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  {% endcase %}
                {% endif %}
              </span>
              <span class="bkp__accordion-title">{{ block.settings.title | escape }}</span>
              <span class="bkp__accordion-toggle" aria-hidden="true"></span>
            </summary>
            {% if block.settings.content != blank %}
              <div class="bkp__accordion-body rte">{{ block.settings.content }}</div>
            {% endif %}
          </details>
        {% endfor %}
      </div>
    {% endif %}
