{% liquid
  assign section_uid = section.id | replace: '-', '' | downcase

  assign video_src = ''
  assign video_type = ''
  assign poster = section.settings.cover_image

  if poster == blank and section.settings.video != blank
    assign poster = section.settings.video.preview_image
  endif

  if section.settings.video != blank
    assign local_source = section.settings.video.sources | where: 'format', 'mp4' | first
    if local_source == blank
      assign local_source = section.settings.video.sources | first
    endif
    assign video_src = local_source.url
    assign video_type = 'html5'
  elsif section.settings.video_url.type == 'youtube'
    assign video_src = 'https://www.youtube.com/embed/' | append: section.settings.video_url.id | append: '?autoplay=1&rel=0&modestbranding=1'
    assign video_type = 'iframe'
  elsif section.settings.video_url.type == 'vimeo'
    assign video_src = 'https://player.vimeo.com/video/' | append: section.settings.video_url.id | append: '?autoplay=1&title=0&byline=0&portrait=0'
    assign video_type = 'iframe'
  elsif section.settings.video_mp4_url != blank
    assign video_src = section.settings.video_mp4_url
    assign video_type = 'html5'
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
  }

  .brisa-how-it-works-{{ section_uid }} {
    --bhiw-bg: {{ section.settings.background }};
    --bhiw-card: {{ section.settings.card_background }};
    --bhiw-ink: {{ section.settings.heading_color }};
    --bhiw-text: {{ section.settings.text_color }};
    --bhiw-badge: {{ section.settings.badge_background }};
    --bhiw-badge-text: {{ section.settings.badge_text_color }};
    --bhiw-radius: {{ section.settings.card_radius }}px;
    --bhiw-video-radius: {{ section.settings.video_radius }}px;
    --bhiw-max: {{ section.settings.max_width }}px;
    color: var(--bhiw-text);
    background: var(--bhiw-bg);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__inner {
    max-width: var(--bhiw-max);
    margin: 0 auto;
    box-sizing: border-box;
    padding: {{ section.settings.card_padding_y }}px {{ section.settings.card_padding_x }}px;
    background: var(--bhiw-card);
    border-radius: var(--bhiw-radius);
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: var(--bhiw-ink);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__video {
    margin: 0 0 {{ section.settings.video_spacing }}px;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: var(--bhiw-video-radius);
    background: #d6ebf8;
    cursor: default;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__media--playable {
    cursor: pointer;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__media:focus-visible {
    outline: 2px solid var(--bhiw-badge);
    outline-offset: 3px;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__poster,
  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__media .brisa-media-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(0, 139, 220, 0.92);
    box-shadow: 0 8px 24px rgba(0, 63, 123, 0.28);
    pointer-events: none;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__play span {
    display: block;
    width: 0;
    height: 0;
    margin-left: 4px;
    border-style: solid;
    border-width: 11px 0 11px 18px;
    border-color: transparent transparent transparent #ffffff;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__steps {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.step_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__step {
    display: grid;
    grid-template-columns: {{ section.settings.badge_size }}px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.badge_size }}px;
    height: {{ section.settings.badge_size }}px;
    margin-top: 1px;
    color: var(--bhiw-badge-text);
    background: var(--bhiw-badge);
    border-radius: 50%;
    font-size: {{ section.settings.badge_size | times: 0.42 | round }}px;
    font-weight: 800;
    line-height: 1;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__step-title {
    display: block;
    margin: 0 0 4px;
    color: var(--bhiw-ink);
    font-size: {{ section.settings.step_title_size }}px;
    font-weight: 800;
    line-height: 1.25;
  }

  .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__step-text {
    margin: 0;
    color: var(--bhiw-text);
    font-size: {{ section.settings.step_text_size }}px;
    font-weight: 400;
    line-height: 1.45;
  }

  @media screen and (max-width: 749px) {
    .brisa-how-it-works-{{ section_uid }} {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_horizontal }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__inner {
      padding: {{ section.settings.mobile_card_padding_y }}px {{ section.settings.mobile_card_padding_x }}px;
      border-radius: {{ section.settings.card_radius | times: 0.72 | round }}px;
    }

    .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__heading {
      font-size: {{ section.settings.heading_size | times: 0.78 | round }}px;
      margin-bottom: {{ section.settings.heading_spacing | times: 0.75 | round }}px;
    }

    .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__video {
      margin-bottom: {{ section.settings.video_spacing | times: 0.8 | round }}px;
    }

    .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__play {
      width: 56px;
      height: 56px;
    }

    .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__play span {
      border-width: 9px 0 9px 15px;
    }

    .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__step-title {
      font-size: {{ section.settings.step_title_size | times: 0.95 | round }}px;
    }

    .brisa-how-it-works-{{ section_uid }} .brisa-how-it-works__step-text {
      font-size: {{ section.settings.step_text_size | times: 0.95 | round }}px;
    }
  }
</style>

<section class="brisa-how-it-works brisa-how-it-works-{{ section_uid }}" {{ section.shopify_attributes }}>
  <div class="brisa-how-it-works__inner">
    {% if section.settings.heading != blank %}
      <h2 class="brisa-how-it-works__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="brisa-how-it-works__video">
      {% if video_src != blank %}
        <button
          type="button"
          class="brisa-how-it-works__media brisa-how-it-works__media--playable"
          data-brisa-video-src="{{ video_src | escape }}"
          data-brisa-video-type="{{ video_type }}"
          data-brisa-video-aspect="landscape"
          aria-label="{{ section.settings.video_label | escape }}"
        >
          {% if poster != blank %}
            <img
              src="{{ poster | image_url: width: 1600 }}"
              alt="{{ poster.alt | default: section.settings.heading | escape }}"
              class="brisa-how-it-works__poster"
              loading="lazy"
              width="{{ poster.width }}"
              height="{{ poster.height }}"
            >
          {% else %}
            {% render 'brisa-media-placeholder', type: 'landscape', label: 'VIDEO PLACE HOLDER' %}
          {% endif %}
          <span class="brisa-how-it-works__play" aria-hidden="true"><span></span></span>
        </button>
      {% else %}
        <div class="brisa-how-it-works__media" role="img" aria-label="{{ section.settings.heading | default: 'How it works' | escape }}">
          {% if poster != blank %}
            <img
              src="{{ poster | image_url: width: 1600 }}"
              alt="{{ poster.alt | default: section.settings.heading | escape }}"
              class="brisa-how-it-works__poster"
              loading="lazy"
              width="{{ poster.width }}"
              height="{{ poster.height }}"
            >
          {% else %}
            {% render 'brisa-media-placeholder', type: 'landscape', label: 'VIDEO PLACE HOLDER' %}
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <ol class="brisa-how-it-works__steps">
        {% for block in section.blocks %}
          {% liquid
            assign step_number = block.settings.number | strip
            if step_number == blank
              assign step_number = forloop.index
            endif
          %}
          <li class="brisa-how-it-works__step" {{ block.shopify_attributes }}>
            <span class="brisa-how-it-works__badge">{{ step_number | escape }}</span>
            <div class="brisa-how-it-works__step-body">
              {% if block.settings.title != blank %}
                <strong class="brisa-how-it-works__step-title">{{ block.settings.title | escape }}</strong>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="brisa-how-it-works__step-text">{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Brisa how it works",
  "tag": "section",
  "class": "shopify-section--brisa-how-it-works",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW IT WORKS"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video",
      "info": "Takes priority over external URL and MP4 URL."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube or Vimeo URL",
      "accept": ["youtube", "vimeo"]
