      "type": "range",
      "id": "swatch_label_width",
      "label": "Swatch label width",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop starter kit"
    },
    {
      "type": "url",
