{% liquid
  assign slider_product = section.settings.product
  assign section_key = section.id | replace: '-', '' | downcase
  assign color_swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />'
  assign slider_option = blank
  assign slider_item_count = 0

  if slider_product != blank
    assign option_name_setting = section.settings.option_name | strip | downcase

    for option in slider_product.options_with_values
      assign current_option_name = option.name | downcase

      if current_option_name == option_name_setting
        assign slider_option = option
        break
      endif
    endfor

    if slider_option == blank
      assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','

      for color_label in color_label_list
        if slider_product.options_by_name[color_label] != blank
          assign slider_option = slider_product.options_by_name[color_label]
          break
        endif
      endfor
    endif

    if slider_option != blank
      assign slider_item_count = slider_option.values.size
    else
      assign slider_item_count = slider_product.variants.size
    endif
  endif
%}

<style>
  .shopify_section_product_slider {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .shopify_section_product_slider .product-slider {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  .shopify_section_product_slider .product-slider__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .shopify_section_product_slider .product-slider__subheading {
    margin: 4px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.subheading_size }}px;
    line-height: 1.2;
  }

  .shopify_section_product_slider .product-slider__viewport {
    position: relative;
    margin-top: {{ section.settings.slider_spacing }}px;
    overflow: hidden;
    border-radius: {{ section.settings.slider_border_radius }}px;
  }

  .shopify_section_product_slider .product-slider__track {
    display: flex;
    border-radius: inherit;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .shopify_section_product_slider .product-slider__card {
    flex: 0 0 100%;
    min-width: 100%;
    overflow: hidden;
    background-color: {{ section.settings.card_background }};
    {% if section.settings.slide_background_image != blank %}
      background-image: url({{ section.settings.slide_background_image | image_url: width: 1600 }});
    {% endif %}
    background-position: center;
    background-size: cover;
    border-radius: {{ section.settings.slider_border_radius }}px;
  }

  .shopify_section_product_slider .product-slider__link {
    display: block;
    color: inherit;
    border-radius: inherit;
    overflow: hidden;
    text-decoration: none;
  }

  .shopify_section_product_slider .product-slider__image-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.card_height }}px;
    padding: {{ section.settings.image_padding }}px 20px;
    border-radius: inherit;
    overflow: visible;
  }

  .shopify_section_product_slider .product-slider__flavour {
    position: absolute;
    top: 10px;
    left: 0;
    z-index: 3;
    width: 100%;
    color: {{ section.settings.flavour_color }};
    font-size: {{ section.settings.flavour_size }}px;
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
  }

  .shopify_section_product_slider .product-slider__image {
    position: relative;
    z-index: 2;
    display: block;
    width: auto;
    max-width: {{ section.settings.image_width }}%;
    max-height: {{ section.settings.image_max_height }}px;
    object-fit: contain;
    border-radius: 0;
  }

  .shopify_section_product_slider .product-slider__sprouts {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .shopify_section_product_slider .product-slider__sprout {
    position: absolute;
    top: 50%;
    left: 50%;
    width: {{ section.settings.sprout_size }}px;
    height: {{ section.settings.sprout_size }}px;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .shopify_section_product_slider .product-slider__sprout img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .shopify_section_product_slider .product-slider__card:hover .product-slider__sprout:nth-child(1) {
    opacity: 1;
    transform: translate(-200%, -200%) rotate(-23deg) scale(1.3);
  }

  .shopify_section_product_slider .product-slider__card:hover .product-slider__sprout:nth-child(2) {
    opacity: 1;
    transform: translate(100%, -200%) rotate(47deg) scale(1.3);
  }

  .shopify_section_product_slider .product-slider__card:hover .product-slider__sprout:nth-child(3) {
    opacity: 1;
    transform: translate(-200%, 100%) rotate(18deg) scale(1.3);
  }

  .shopify_section_product_slider .product-slider__card:hover .product-slider__sprout:nth-child(4) {
    opacity: 1;
    transform: translate(100%, 100%) rotate(-35deg) scale(1.3);
  }

  .shopify_section_product_slider .product-slider__arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    padding: 0;
    color: {{ section.settings.arrow_color }};
    background: {{ section.settings.arrow_background }};
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .shopify_section_product_slider .product-slider__arrow--prev {
    left: 10px;
  }

  .shopify_section_product_slider .product-slider__arrow--next {
    right: 10px;
  }

  .shopify_section_product_slider .product-slider__arrow svg {
    display: block;
    width: 50%;
    height: 50%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
  }

  .shopify_section_product_slider .product-slider__active-title {
    display: none;
    margin: {{ section.settings.pagination_spacing }}px 0 10px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.product_name_size }}px;
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .shopify_section_product_slider .product-slider__active-title.is-active {
    display: block;
  }

  .shopify_section_product_slider .product-slider__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ section.settings.nav_gap }}px;
    margin-top: {{ section.settings.pagination_spacing }}px;
  }

  .shopify_section_product_slider .product-slider__nav {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0;
    color: {{ section.settings.text_color }};
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .shopify_section_product_slider .product-slider__dot {
    display: block;
    width: 12px;
    height: 12px;
    background: {{ section.settings.dot_color }};
    border-radius: 50%;
  }

  .shopify_section_product_slider .product-slider__swatch {
    display: block;
    width: {{ section.settings.swatch_size }}px;
    height: {{ section.settings.swatch_size }}px;
    background-color: {{ section.settings.dot_color }};
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    border: 2px solid transparent;
    border-radius: 50%;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .shopify_section_product_slider .product-slider__nav.is-active .product-slider__swatch,
  .shopify_section_product_slider .product-slider__nav.is-active .product-slider__dot {
    border-color: {{ section.settings.active_nav_color }};
    transform: scale(1.12);
  }

  .shopify_section_product_slider .product-slider__nav.is-active .product-slider__dot {
    background: {{ section.settings.active_nav_color }};
  }

  .shopify_section_product_slider .product-slider__swatch-label {
    display: block;
    max-width: {{ section.settings.swatch_label_width }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.swatch_text_size }}px;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .shopify_section_product_slider .product-slider__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: {{ section.settings.button_spacing }}px;
    padding: 14px 28px;
    color: {{ section.settings.button_text_color }} !important;
    background: {{ section.settings.button_background }};
    border-radius: 999px;
    font-size: {{ section.settings.button_size }}px;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    text-decoration: none !important;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .shopify_section_product_slider {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .shopify_section_product_slider .product-slider {
      padding: 0 14px;
    }

    .shopify_section_product_slider .product-slider__heading {
      font-size: {{ section.settings.heading_size | times: 0.78 | round }}px;
    }

    .shopify_section_product_slider .product-slider__image-wrapper {
      min-height: {{ section.settings.mobile_card_height }}px;
    }

    .shopify_section_product_slider .product-slider__image {
      max-height: {{ section.settings.mobile_image_max_height }}px;
    }

    .shopify_section_product_slider .product-slider__sprout {
      width: {{ section.settings.sprout_size | times: 0.72 | round }}px;
      height: {{ section.settings.sprout_size | times: 0.72 | round }}px;
    }

    .shopify_section_product_slider .product-slider__swatch {
      width: {{ section.settings.swatch_size | times: 0.86 | round }}px;
      height: {{ section.settings.swatch_size | times: 0.86 | round }}px;
    }
  }
</style>

<section class="product-slider product-slider-{{ section_key }}" data-product-slider>
  {% if section.settings.heading != blank or section.settings.subheading != blank %}
    <div class="product-slider__header">
      {% if section.settings.heading != blank %}
        <h2 class="product-slider__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="product-slider__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if slider_product != blank and slider_item_count > 0 %}
    <div class="product-slider__viewport" style="border-radius: {{ section.settings.slider_border_radius }}px;">
      <button class="product-slider__arrow product-slider__arrow--prev" type="button" aria-label="Previous variation" data-product-slider-prev>
        <svg viewBox="0 0 24 24" focusable="false">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="product-slider__track" data-product-slider-track>
        {% if slider_option != blank %}
          {% for option_value in slider_option.values limit: section.settings.variant_limit %}
            {% liquid
              assign variant = option_value.variant
              assign slide_label = option_value.name | default: variant.title
            %}

            {% if variant == blank %}
              {% continue %}
            {% endif %}

            {% render 'product-slider-slide',
              variant: variant,
              slide_label: slide_label,
              slider_product: slider_product,
              section: section,
              eager_load: forloop.first
            %}
          {% endfor %}
        {% else %}
          {% for variant in slider_product.variants limit: section.settings.variant_limit %}
            {% liquid
              assign slide_label = variant.metafields.custom.flavour.value | default: variant.metafields.custom.flavour | default: variant.title
            %}

            {% render 'product-slider-slide',
              variant: variant,
              slide_label: slide_label,
              slider_product: slider_product,
              section: section,
              eager_load: forloop.first
            %}
          {% endfor %}
        {% endif %}
      </div>

      <button class="product-slider__arrow product-slider__arrow--next" type="button" aria-label="Next variation" data-product-slider-next>
        <svg viewBox="0 0 24 24" focusable="false">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    {% if section.settings.show_product_name %}
      <div class="product-slider__titles" aria-live="polite">
        {% if slider_option != blank %}
          {% for option_value in slider_option.values limit: section.settings.variant_limit %}
            {% if option_value.variant == blank %}
              {% continue %}
            {% endif %}
            {% assign title_label = option_value.name %}
            <div class="product-slider__active-title {% if forloop.first %}is-active{% endif %}" data-product-slider-title>
              {{ title_label | escape }}
            </div>
          {% endfor %}
        {% else %}
          {% for variant in slider_product.variants limit: section.settings.variant_limit %}
            {% liquid
              assign title_label = variant.metafields.custom.flavour.value | default: variant.metafields.custom.flavour | default: variant.title
            %}
            <div class="product-slider__active-title {% if forloop.first %}is-active{% endif %}" data-product-slider-title>
              {{ title_label | escape }}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}

    <div class="product-slider__pagination" data-product-slider-pagination>
      {% if slider_option != blank %}
        {% for option_value in slider_option.values limit: section.settings.variant_limit %}
          {% render 'product-slider-nav',
            option_value: option_value,
            variant: option_value.variant,
            slider_product: slider_product,
            section: section,
            color_swatch_config: color_swatch_config,
            nav_index: forloop.index0,
            nav_first: forloop.first
          %}
        {% endfor %}
      {% else %}
        {% for variant in slider_product.variants limit: section.settings.variant_limit %}
          {% render 'product-slider-nav',
            option_value: blank,
            variant: variant,
            slider_product: slider_product,
            section: section,
            color_swatch_config: color_swatch_config,
            nav_index: forloop.index0,
            nav_first: forloop.first
          %}
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.button_text != blank %}
      <a class="product-slider__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_text | escape }}
      </a>
    {% endif %}
  {% else %}
    <p class="product-slider__subheading">Select a product to show its variations.</p>
  {% endif %}
</section>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-product-slider]')) return;

    const track = root.querySelector('[data-product-slider-track]');
    const cards = Array.from(root.querySelectorAll('[data-product-slider-card]'));
    const navItems = Array.from(root.querySelectorAll('[data-product-slider-nav]'));
    const titles = Array.from(root.querySelectorAll('[data-product-slider-title]'));
    const prev = root.querySelector('[data-product-slider-prev]');
    const next = root.querySelector('[data-product-slider-next]');
    let currentIndex = 0;

    function updateSlider(index) {
      if (!track || cards.length === 0) return;

      currentIndex = (index + cards.length) % cards.length;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      navItems.forEach((item, itemIndex) => {
        const isActive = itemIndex === currentIndex;
        item.classList.toggle('is-active', isActive);
        if (isActive) {
          item.setAttribute('aria-current', 'true');
        } else {
          item.removeAttribute('aria-current');
        }
      });

      titles.forEach((title, titleIndex) => {
        title.classList.toggle('is-active', titleIndex === currentIndex);
      });
    }

    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        updateSlider(parseInt(item.dataset.index, 10));
      });
    });

    if (prev) {
      prev.addEventListener('click', () => updateSlider(currentIndex - 1));
    }

    if (next) {
      next.addEventListener('click', () => updateSlider(currentIndex + 1));
    }
  })();
</script>

{% schema %}
{
  "name": "Product slider",
  "class": "shopify_section_product_slider",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "option_name",
      "label": "Product option name",
      "default": "Color",
      "info": "Matches the option linked to your colour metaobjects (e.g. Color). Swatch colours and labels are read from each option value."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose your Brisa"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Select your colour"
    },
    {
      "type": "range",
      "id": "variant_limit",
      "label": "Variations to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_product_name",
      "label": "Show variation name above pagination",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_slide_product_name",
      "label": "Show variation name in slide",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_swatch_nav",
      "label": "Use colour swatches as page navigation",
      "default": true
    },
    {
      "type": "header",
      "content": "Slide image"
    },
    {
      "type": "select",
      "id": "slide_image_source",
      "label": "Slide product image source",
      "options": [
        {
          "value": "variant_metafield",
          "label": "Variant metafield (e.g. Slider Image)"
        },
        {
          "value": "variant_image",
          "label": "Variant image"
        },
        {
          "value": "carousel_product_image",
          "label": "Legacy metafield: custom.carousel_product_image"
        }
      ],
      "default": "variant_metafield"
    },
    {
      "type": "text",
      "id": "slide_image_metafield_namespace",
      "label": "Variant image metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "slide_image_metafield_key",
      "label": "Variant image metafield key",
      "default": "slider_image",
      "info": "This should match the metafield definition key for “Slider Image”."
    },
    {
      "type": "select",
      "id": "swatch_color_source",
      "label": "Swatch colour source",
      "info": "Used only when colour swatches are enabled.",
      "options": [
        {
          "value": "product_option",
          "label": "Product option swatch (Color metaobject)"
        },
        {
          "value": "carousel_swatch_colour",
          "label": "Variant meta field: Carousel Swatch Colour"
        },
        {
          "value": "carousel_background_colour",
          "label": "Variant meta field: Carousel Background Colour"
        },
        {
          "value": "custom_metafield",
          "label": "Custom variant metafield"
        },
        {
          "value": "fallback",
          "label": "Fallback dot colour"
        }
      ],
      "default": "product_option"
    },
    {
      "type": "text",
      "id": "swatch_color_metafield_namespace",
      "label": "Custom swatch colour metafield namespace",
      "info": "Used when swatch colour source is set to custom variant metafield. Falls back to the product metafield if empty on the variant.",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "swatch_color_metafield_key",
      "label": "Custom swatch colour metafield key",
      "info": "Used when swatch colour source is set to custom variant metafield. Falls back to the product metafield if empty on the variant.",
      "default": "carousel_swatch_colour"
    },
    {
      "type": "select",
      "id": "swatch_label_source",
      "label": "Swatch navigation text",
      "info": "Used only when colour swatches are enabled.",
      "options": [
        {
          "value": "product_option",
          "label": "Product option label (Color metaobject)"
        },
        {
          "value": "carousel_swatch_colour",
          "label": "Variant meta field: Carousel Swatch Colour"
        },
        {
          "value": "flavour",
          "label": "Flavour metafield"
        },
        {
          "value": "variant_title",
          "label": "Variant title"
        },
        {
          "value": "product_title",
          "label": "Product title"
        },
        {
          "value": "vendor",
          "label": "Vendor"
        },
        {
          "value": "product_type",
          "label": "Product type"
        },
        {
          "value": "custom_metafield",
          "label": "Custom product metafield"
