    {%- if section.settings.heading != blank -%}
      <h2 class="brisa-judgeme__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- render block -%}
        </div>
      {%- endfor -%}
    {%- elsif review_product != blank -%}
      {%- liquid
        assign jdgm_revamp_data = review_product.metafields.judgeme.review_widget_data
        if jdgm_revamp_data.value != blank
          assign jdgm_revamp_json = jdgm_revamp_data.value
        elsif jdgm_revamp_data != blank
          assign jdgm_revamp_json = jdgm_revamp_data
        endif
      -%}
      <!--
        Judge.me revamp reads window.jdgm.data.reviewWidget[productId].
        Seed it from the metafield (or CDN fallback) before booting the Vue entry.
      -->
      <script>
        window.jdgm = window.jdgm || {};
        window.jdgm.data = window.jdgm.data || {};
        window.jdgm.data.reviewWidget = window.jdgm.data.reviewWidget || {};
        window.jdgm.data.reviewWidget[{{ review_product.id | json }}] =
          {% if jdgm_revamp_json != blank %}
            {{ jdgm_revamp_json | json }}
          {% else %}
            null
          {% endif %}
        ;
      </script>
      <div style="clear:both"></div>
      <div
        id="judgeme_product_reviews"
        class="jdgm-widget jdgm-review-widget"
        data-widget="review"
        data-entry-key="review-widget/main.js"
        data-product-title="{{ review_product.title | escape }}"
        data-product-handle="{{ review_product.handle | escape }}"
        data-product-id="{{ review_product.id }}"
        data-id="{{ review_product.id }}"
        data-auto-install="true"
        data-product-image-url="{{ jdgm_product_image_url | escape }}"
        data-image-url="{{ jdgm_product_image_url | escape }}"
      >
        {%- if review_product.metafields.judgeme.widget != blank -%}
          <div class="jdgm-legacy-widget-content" style="display:none">
            {{ review_product.metafields.judgeme.widget }}
          </div>
        {%- endif -%}
      </div>
      <script>
        (function () {
          var productId = {{ review_product.id | json }};
          var el = document.getElementById('judgeme_product_reviews');
          if (!el) return;

          function hasReviewPayload(data) {
            return !!(data && (data.number_of_reviews > 0 || (data.reviews && data.reviews.length) || (data.primary_language_reviews && data.primary_language_reviews.length)));
          }

          function bootRevamp() {
            var base = (window.jdgm && jdgm.CDN_BASE_URL) || '';
            if (!base) {
              setTimeout(bootRevamp, 50);
              return;
            }
            if (el.classList.contains('jdgm-widget-revamp')) return;
            el.setAttribute('data-entry-point', 'review_widget.js');
            el.setAttribute('data-entry-key', 'review-widget/main.js');
            var existing = document.querySelector('script[data-brisa-jdgm-revamp="1"]');
            if (existing) existing.remove();
            var script = document.createElement('script');
            script.type = 'module';
            script.src = base + 'review_widget.js?brisa=' + Date.now();
            script.setAttribute('data-brisa-jdgm-revamp', '1');
            document.head.appendChild(script);
          }

          function seedAndBoot(data) {
            window.jdgm = window.jdgm || {};
            window.jdgm.data = window.jdgm.data || {};
            window.jdgm.data.reviewWidget = window.jdgm.data.reviewWidget || {};
            if (data) window.jdgm.data.reviewWidget[productId] = data;
            bootRevamp();
          }

          var seeded = window.jdgm.data.reviewWidget[productId];
          if (hasReviewPayload(seeded)) {
            bootRevamp();
            return;
          }

          var shop = (window.Shopify && Shopify.shop) || window.location.hostname;
          var url =
            'https://cdn.judge.me/reviews/reviews_for_widget?url=' +
            encodeURIComponent(shop) +
            '&shop_domain=' +
            encodeURIComponent(shop) +
            '&product_id=' +
            encodeURIComponent(productId) +
            '&platform=shopify';

          fetch(url)
            .then(function (res) {
              if (!res.ok) throw new Error('Judge.me reviews fetch failed');
              return res.json();
            })
            .then(seedAndBoot)
            .catch(function () {
              seedAndBoot(seeded || {});
            });
        })();
      </script>
      <!-- End of Judge.me code -->
    {%- else -%}
      <p class="brisa-judgeme__fallback">
        Add the Judge.me Review Widget app block in the theme editor, or assign a product with Judge.me reviews.
      </p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    // Judge.me revamp (Vue) mounts into [data-entry-point] — do not restyle/reorder that DOM.
    function isRevampWidget() {
      return !!root.querySelector('.jdgm-widget-revamp, .jdgm-review-widget[data-entry-point]');
    }
    var PRODUCT_IMAGE_URL = {{ jdgm_product_image_url | json }};
    var CHEVRON = '<span class="brisa-jdgm-chevron" aria-hidden="true"><svg viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1.5L7 6.5L13 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>';
    var FILTER = '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.143 15a2.501 2.501 0 0 1 4.717 0h8.475v1.666H9.86a2.5 2.5 0 0 1-4.717 0H1.667V15h3.476Zm5-6.667a2.501 2.501 0 0 1 4.717 0h3.476V10h-3.476a2.5 2.5 0 0 1-4.717 0H1.667V8.333h8.476Zm-5-6.666a2.501 2.501 0 0 1 4.717 0h8.475V3.333H9.86a2.5 2.5 0 0 1-4.717 0H1.667V1.667h3.476Z"/></svg>';

    // Judge.me modal uses jQuery .data('image-url') from .jdgm-rev-widg — override
    // stale metafield cache with the current Shopify featured image.
    function syncProductImageAttrs() {
      if (!PRODUCT_IMAGE_URL) return;
      var nodes = root.querySelectorAll(
        '.jdgm-review-widget, .jdgm-rev-widg, .jm-review-widget, .jdgm-widget'
      );
      nodes.forEach(function (el) {
        if (el.getAttribute('data-image-url') !== PRODUCT_IMAGE_URL) {
          el.setAttribute('data-image-url', PRODUCT_IMAGE_URL);
        }
        if (el.getAttribute('data-product-image-url') !== PRODUCT_IMAGE_URL) {
          el.setAttribute('data-product-image-url', PRODUCT_IMAGE_URL);
        }
        if (window.jdgm && jdgm.$) {
          try {
            var $el = jdgm.$(el);
            if ($el.data('image-url') !== PRODUCT_IMAGE_URL) {
              $el.removeData('imageUrl').removeData('image-url');
              $el.attr('data-image-url', PRODUCT_IMAGE_URL);
              $el.data('image-url', PRODUCT_IMAGE_URL);
            }
          } catch (err) {
            /* Judge.me optional */
          }
        }
      });
      document
        .querySelectorAll(
          '.jdgm-write-review-modal__product-image img, .jdgm-write-review-modal__other-product-image img'
        )
        .forEach(function (img) {
          if (img.getAttribute('src') !== PRODUCT_IMAGE_URL) {
            img.setAttribute('src', PRODUCT_IMAGE_URL);
          }
        });
    }

    function formatAverage(text, fallback) {
      var match = String(text || '').match(/(\d+(?:\.\d+)?)/);
      if (!match) return fallback || '';
      var value = parseFloat(match[1]);
      if (isNaN(value)) return fallback || match[1];
      return (Math.round(value * 10) / 10).toFixed(1);
    }

    function formatAverageEl(widget) {
      var averageEl = root.querySelector('.jdgm-rev-widg__summary-average');
      if (!averageEl) return;
      var fromWidget = (widget && widget.getAttribute('data-average-rating'))
        || (root.querySelector('.jdgm-rev-widg') && root.querySelector('.jdgm-rev-widg').getAttribute('data-average-rating'));
      var next = formatAverage(averageEl.textContent, formatAverage(fromWidget, '5.0'));
      if (next && averageEl.textContent !== next) averageEl.textContent = next;
    }

    function reorderCards() {
      root.querySelectorAll('.jdgm-rev').forEach(function (rev) {
        var headerRow = rev.querySelector('.jdgm-rev__header');
        if (!headerRow) return;
        var profile = rev.querySelector('.jdgm-row-profile');
        var ratingRow = rev.querySelector('.jdgm-row-rating');
        // Keep author first, then rating/date block — only move when order is wrong.
        // Unconditional appendChild reorders on every pass and infinite-loops the MutationObserver.
        if (profile && headerRow.firstElementChild !== profile) {
          headerRow.insertBefore(profile, headerRow.firstElementChild);
        }
        if (ratingRow && profile && profile.nextElementSibling !== ratingRow) {
          headerRow.insertBefore(ratingRow, profile.nextSibling);
        } else if (ratingRow && !profile && headerRow.firstElementChild !== ratingRow) {
          headerRow.insertBefore(ratingRow, headerRow.firstElementChild);
        }
      });
    }

    function hydrateReviewImages() {
      root.querySelectorAll('.jdgm-rev__pic-link, .jdgm-gallery__thumbnail-link, .jdgm-rev__pics a, .jdgm-rev__pics img').forEach(function (el) {
        var img = el.tagName === 'IMG' ? el : el.querySelector('img');
        if (!img) return;

        var lazySrc = img.getAttribute('data-src') || img.getAttribute('data-original') || img.getAttribute('data-lazy-src');
        if (lazySrc && (!img.getAttribute('src') || img.getAttribute('src').indexOf('data:') === 0)) {
          img.setAttribute('src', lazySrc);
        }

        var markLoaded = function () {
          var link = img.closest('.jdgm-rev__pic-link, .jdgm-gallery__thumbnail-link');
          if (link) link.classList.remove('jdgm--loading');
          img.style.visibility = 'visible';
          img.style.opacity = '1';
        };

        if (img.complete && img.naturalWidth > 0) {
          markLoaded();
        } else {
          img.addEventListener('load', markLoaded, { once: true });
          img.addEventListener('error', function () {
            var link = img.closest('.jdgm-rev__pic-link');
            if (link) link.classList.remove('jdgm--loading');
          }, { once: true });
        }
      });

      // Stuck loading placeholders: clear after a short wait once src exists
      root.querySelectorAll('.jdgm-rev__pic-link.jdgm--loading').forEach(function (link) {
        var img = link.querySelector('img');
        if (img && img.getAttribute('src') && img.complete && img.naturalWidth > 0) {
          link.classList.remove('jdgm--loading');
        }
      });
    }

    function ensureJudgemeFormAssets() {
      if (!window.jdgm || typeof jdgm.loadScript !== 'function') return;
      var host = jdgm.CDN_HOST || 'https://cdnwidget.judge.me/';
      try {
        // Modal class must exist before form.js wires the write-review click path.
        jdgm.loadScript(host + 'widget/write_review_modal.js');
        jdgm.loadScript(host + 'widget/form.js');
        if (typeof jdgm.loadCSS === 'function' && typeof jdgm.widgetPath === 'function') {
          jdgm.loadCSS(jdgm.widgetPath('form.css'));
        }
      } catch (err) {
        /* Judge.me optional — never break the page */
      }
    }

    function disarmHashHref(link) {
      if (!link) return;
      var href = link.getAttribute('href');
      if (!href || href === '#' || href === '#/' || href === '#!') {
        link.setAttribute('href', 'javascript:void(0)');
      }
    }

    function isShown(el) {
      if (!el) return false;
      var style = window.getComputedStyle(el);
      if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) === 0) {
        return false;
      }
      var rect = el.getBoundingClientRect();
      return rect.width > 0 && rect.height > 0;
    }

    // Judge.me v3 inserts the inline form with: $(widget).find('.jdgm-row-stars').after(form)
    // Revamp/minimal headers omit that node — without it openForm only flips the button label.
    function ensureRowStars() {
      var header = root.querySelector('.jdgm-rev-widg__header');
      var summary = root.querySelector('.jdgm-rev-widg__summary');
      if (!header || !summary) return null;
      var existing = header.querySelector(':scope > .jdgm-row-stars') || root.querySelector('.jdgm-row-stars');
      if (existing) {
        if (!existing.contains(summary)) existing.appendChild(summary);
        return existing;
      }
      var row = document.createElement('div');
      row.className = 'jdgm-row-stars';
      summary.parentNode.insertBefore(row, summary);
      row.appendChild(summary);
      return row;
    }

    function getReviewWidgetEl() {
      return root.querySelector('.jdgm-review-widget') || root.querySelector('.jdgm-rev-widg, .jdgm-widget');
    }

    function ensureInlineReviewForm() {
      ensureRowStars();
      var existing = dedupeFormWrappers();
      if (existing) {
        relocateFormOutsideHeader(existing);
        return existing;
      }
      if (!window.jdgm || !jdgm.$) return null;

      var row = root.querySelector('.jdgm-row-stars');
      var header = root.querySelector('.jdgm-rev-widg__header');
      var html = null;
      try {
        if (jdgm.templates && typeof jdgm.templates.reviewForm === 'function') {
          html = jdgm.templates.reviewForm();
        }
      } catch (err) {
        html = null;
      }
      if (!html) return null;

      if (row) {
        jdgm.$(row).after(html);
      } else if (header) {
        jdgm.$(header).append(html);
      } else {
        return null;
      }
      var form = dedupeFormWrappers();
      relocateFormOutsideHeader(form);
      return form;
    }

    // Pull the form out of the header flex so it can't sit in a side column on mobile.
    function relocateFormOutsideHeader(form) {
      form = form || root.querySelector('.jdgm-form-wrapper');
      var header = root.querySelector('.jdgm-rev-widg__header');
      if (!form || !header || !header.contains(form)) return form;
      if (header.nextElementSibling === form) return form;
      header.insertAdjacentElement('afterend', form);
      return form;
    }

    function syncWritingState() {
      var form = relocateFormOutsideHeader();
      var open = false;
      if (form) {
        var style = form.getAttribute('style') || '';
        var hiddenAttr = form.hasAttribute('hidden');
        open = !hiddenAttr && style.indexOf('display: none') === -1 && style.indexOf('display:none') === -1;
        if (open && window.getComputedStyle(form).display === 'none') {
          open = false;
        }
        if (!open && isShown(form)) open = true;
      }
      root.classList.toggle('brisa-jdgm-writing', open);
      return open;
    }

    // Judge.me clones .jdgm-notification before EVERY .jdgm-form-wrapper — keep a single form.
    function dedupeFormWrappers() {
      var forms = Array.prototype.slice.call(root.querySelectorAll('.jdgm-form-wrapper'));
      if (!forms.length) return null;
      var keeper =
        forms.find(function (el) {
          return isShown(el);
        }) || forms[0];
      forms.forEach(function (el) {
        if (el !== keeper) el.remove();
      });
      // Also strip leftover horizontal rules Judge.me prefixes on some templates.
      root.querySelectorAll('.jdgm-rev-widg__header > .jdgm-rev__br, .jdgm-row-stars + .jdgm-rev__br').forEach(function (el) {
        el.remove();
      });
      relocateFormOutsideHeader(keeper);
      return keeper;
    }

    function normalizeSubmittedState() {
      var notes = Array.prototype.slice.call(root.querySelectorAll('.jdgm-notification'));
      if (!notes.length) return false;

      // Keep the outermost notice only (Judge.me clones one per form-wrapper).
      var topLevel = notes.filter(function (el) {
        return !el.parentElement || !el.parentElement.closest('.jdgm-notification');
      });
      topLevel.forEach(function (el, index) {
        if (index > 0) el.remove();
      });

      var keeper = root.querySelector('.jdgm-notification');
      if (!keeper) return false;

      // Flatten nested notice from settings HTML that already includes title + body.
      var nested = keeper.querySelector('.jdgm-notification');
      if (nested) {
        var outerTitle = keeper.querySelector(':scope > .jdgm-notification__inner > .jdgm-notification__title');
        if (outerTitle) outerTitle.remove();
      } else {
        var titles = keeper.querySelectorAll('.jdgm-notification__title');
        if (titles.length > 1) {
          titles[0].remove();
        }
      }

      root.querySelectorAll('.jdgm-form-wrapper').forEach(function (el) {
        el.style.setProperty('display', 'none', 'important');
        el.setAttribute('hidden', '');
      });
      return true;
    }

    function openInlineReviewForm() {
      if (!window.jdgm || typeof jdgm.openForm !== 'function' || !window.jdgm.$) return false;
      var form = ensureInlineReviewForm();
      if (!form) return false;
      var widgetEl = getReviewWidgetEl();
      if (!widgetEl) return false;
      try {
        jdgm.openForm(jdgm.$(widgetEl));
        relocateFormOutsideHeader(form);
        syncWritingState();
        return isShown(form) || form.style.display !== 'none';
      } catch (err) {
        return false;
      }
    }

    function tryOpenJudgemeModal() {
      var modal = document.querySelector('.jdgm-write-review-modal');
      if (!modal || !modal.querySelector('.jdgm-write-review-modal__container')) return false;
      if (isShown(modal)) return true;
      if (!window.jdgm || !jdgm.$) {
        modal.style.display = 'block';
        return isShown(modal);
      }
      try {
        jdgm.$(modal).stop(true, true).fadeIn(200);
        jdgm.$(modal).trigger('jdgm.modal.opened');
        return true;
      } catch (err) {
        modal.style.display = 'block';
        return isShown(modal);
      }
    }

    var didRebindWriteHandlers = false;

    function rebindJudgemeWriteHandlers() {
      if (didRebindWriteHandlers) return;
      if (!window.jdgm || !jdgm.$ || typeof jdgm._renderAndSetupReviewForm !== 'function') return;
      if (!jdgm._WriteReviewModal) return;
      var $widget = jdgm.$(root).find('.jdgm-review-widget').first();
      if (!$widget.length) $widget = jdgm.$(root).find('.jdgm-rev-widg').first();
      if (!$widget.length) return;

      // Orphan hidden modals block Judge.me re-setup (early return when modal selector matches).
      document.querySelectorAll('body > .jdgm-write-review-modal').forEach(function (el) {
        if (!isShown(el)) el.remove();
      });

      try {
        jdgm._renderAndSetupReviewForm($widget);
        didRebindWriteHandlers = true;
        dedupeFormWrappers();
      } catch (err) {
        /* Judge.me optional */
      }
    }

    function enhanceRevamp() {
      var header = root.querySelector('.jm-review-widget-minimal-header');
      var avgCluster = root.querySelector('.jm-average-rating-display .jm-cluster');
      if (!header || !avgCluster) return false;

      if (!avgCluster.querySelector('.brisa-jdgm-header-stars')) {
        var scoreEl = avgCluster.querySelector('.jm-text');
        var score = parseFloat((scoreEl && scoreEl.textContent) || '5') || 5;
        var filled = Math.max(0, Math.min(5, Math.round(score)));
        var stars = document.createElement('span');
        stars.className = 'brisa-jdgm-header-stars';
        stars.setAttribute('aria-hidden', 'true');
        var html = '';
        for (var i = 1; i <= 5; i++) {
          html +=
            '<span class="brisa-jdgm-header-star' +
            (i <= filled ? ' is-on' : '') +
            '">★</span>';
        }
        stars.innerHTML = html;
        avgCluster.insertBefore(stars, avgCluster.firstChild);

        if (scoreEl && !avgCluster.querySelector('.brisa-jdgm-chevron')) {
          scoreEl.insertAdjacentHTML('afterend', CHEVRON);
        }
      }

      if (!header.hasAttribute('data-brisa-revamp-filters')) {
        header.setAttribute('data-brisa-revamp-filters', '1');
        var filterBtn = header.querySelector(
          '.jm-custom-answer-filter, .jm-filters button, [data-testid="filters-button"], button[aria-label*="ilter" i]'
        );
        if (filterBtn) {
          filterBtn.addEventListener('click', function () {
            // Keep Judge.me’s own panel; also toggle our sort dropdown fallback.
            window.setTimeout(function () {
              header.classList.toggle('is-brisa-filters-open');
            }, 0);
          });
        }
      }

      return true;
    }

    function enhance() {
      // Revamp Vue widget owns its own header/form/cards — light header polish only.
      if (root.querySelector('.jdgm-widget-revamp')) {
        return enhanceRevamp();
      }

      var widget = root.querySelector('.jdgm-rev-widg, .jdgm-widget');
      if (!widget || !root.querySelector('.jdgm-rev-widg__summary')) return false;

      ensureRowStars();
      dedupeFormWrappers();
      relocateFormOutsideHeader();
      syncWritingState();
      normalizeSubmittedState();
      syncProductImageAttrs();

      var header = root.querySelector('.jdgm-rev-widg__header');
      var summary = root.querySelector('.jdgm-rev-widg__summary');
      var starsWrap = root.querySelector('.jdgm-rev-widg__summary-stars');
      var averageEl = root.querySelector('.jdgm-rev-widg__summary-average');
      var histogram = root.querySelector('.jdgm-histogram');
      var sortWrap = root.querySelector('.jdgm-rev-widg__sort-wrapper');

      formatAverageEl(widget);
      ensureJudgemeFormAssets();

      if (starsWrap && !starsWrap.closest('.brisa-jdgm-summary-trigger')) {
        var trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.className = 'brisa-jdgm-summary-trigger';
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-label', 'Show rating breakdown');
        starsWrap.parentNode.insertBefore(trigger, starsWrap);
        trigger.appendChild(starsWrap);
        if (averageEl) trigger.appendChild(averageEl);
        trigger.insertAdjacentHTML('beforeend', CHEVRON);

        trigger.addEventListener('click', function () {
          histogram = root.querySelector('.jdgm-histogram');
          if (!histogram) return;
          var open = histogram.classList.contains('jdgm-temp-hidden') || histogram.hasAttribute('hidden');
          if (open) {
            histogram.classList.remove('jdgm-temp-hidden');
            histogram.removeAttribute('hidden');
            trigger.setAttribute('aria-expanded', 'true');
          } else {
            histogram.classList.add('jdgm-temp-hidden');
            histogram.setAttribute('hidden', '');
            trigger.setAttribute('aria-expanded', 'false');
          }
        });
      } else if (averageEl && !root.querySelector('.brisa-jdgm-chevron')) {
        var existingTrigger = root.querySelector('.brisa-jdgm-summary-trigger');
        if (existingTrigger) existingTrigger.insertAdjacentHTML('beforeend', CHEVRON);
      }

      if (histogram && !histogram.hasAttribute('data-brisa-init')) {
        histogram.classList.add('jdgm-temp-hidden');
        histogram.setAttribute('hidden', '');
        histogram.setAttribute('data-brisa-init', '1');
      }

      if (header && !root.querySelector('.brisa-jdgm-filter')) {
        var filterBtn = document.createElement('button');
        filterBtn.type = 'button';
        filterBtn.className = 'brisa-jdgm-filter';
        filterBtn.setAttribute('aria-label', 'Sort and filter reviews');
        filterBtn.setAttribute('aria-expanded', 'false');
        filterBtn.innerHTML = FILTER;

        if (summary && summary.parentNode) {
          summary.parentNode.insertBefore(filterBtn, summary.nextSibling);
        } else if (header) {
          header.appendChild(filterBtn);
        }

        filterBtn.addEventListener('click', function () {
          var open = filterBtn.getAttribute('aria-expanded') === 'true';
          filterBtn.setAttribute('aria-expanded', open ? 'false' : 'true');
          sortWrap = root.querySelector('.jdgm-rev-widg__sort-wrapper');
          if (sortWrap && sortWrap.children.length) {
            sortWrap.classList.toggle('is-open', !open);
            var sortSelect = sortWrap.querySelector('select, .jdgm-sort-dropdown, button, [role="button"]');
            if (!open && sortSelect) sortSelect.focus();
          } else {
            var triggerBtn = root.querySelector('.brisa-jdgm-summary-trigger');
            if (triggerBtn) triggerBtn.click();
          }
        });
      }

      // Keep a single Write a review control. Judge.me (and re-setup) can leave 2+
      // .jdgm-write-rev-link nodes; our full-width CSS was revealing every copy.
      var writeLinks = Array.prototype.slice.call(root.querySelectorAll('.jdgm-write-rev-link'));
      if (writeLinks.length) {
        var keeper =
          writeLinks.find(function (el) {
            return el.parentElement === header;
          }) || writeLinks[0];
        writeLinks.forEach(function (el) {
          if (el === keeper) {
            el.classList.remove('brisa-jdgm-write-dup');
            el.style.setProperty('display', 'flex', 'important');
            el.removeAttribute('hidden');
            // Keep href="#" until click — Judge.me may read it; we preventDefault on click instead.
            if (header && el.parentElement !== header) {
              header.appendChild(el);
            }
          } else {
            el.classList.add('brisa-jdgm-write-dup');
            el.setAttribute('hidden', '');
            el.style.setProperty('display', 'none', 'important');
          }
        });
      }

      rebindJudgemeWriteHandlers();
      reorderCards();
      hydrateReviewImages();
      return true;
    }

    // Stop href="#" jump only. Let Judge.me run its own handler; recover if UI stays hidden.
    root.addEventListener(
      'click',
      function (event) {
        if (root.querySelector('.jdgm-widget-revamp')) return;
        var link = event.target.closest('a.jdgm-write-rev-link, a.jdgm-ask-question-btn');
        if (!link || !root.contains(link)) return;

        var href = link.getAttribute('href');
        if (!href || href === '#' || href === '#/' || href === '#!' || href.indexOf('javascript:') === 0) {
          event.preventDefault();
        }
        ensureJudgemeFormAssets();
        ensureRowStars();
        syncProductImageAttrs();

        window.setTimeout(function () {
          syncProductImageAttrs();
          relocateFormOutsideHeader();
          syncWritingState();
          if (isShown(document.querySelector('.jdgm-write-review-modal'))) return;
          if (isShown(root.querySelector('.jdgm-form-wrapper'))) {
            syncWritingState();
            return;
          }

          // Prefer Judge.me popup when its modal DOM is already mounted.
          if (tryOpenJudgemeModal()) {
            syncProductImageAttrs();
            return;
          }

          // Otherwise show the inline form (create insert target + form first so Cancel isn't empty).
          openInlineReviewForm();
          relocateFormOutsideHeader();
          syncWritingState();
        }, 350);
      },
      true
    );

    syncProductImageAttrs();
    enhance();

    var tries = 0;
    var timer = setInterval(function () {
      tries += 1;
      if (root.querySelector('.jdgm-widget-revamp')) {
        enhanceRevamp();
        if (tries > 20) clearInterval(timer);
        return;
      }
      enhance();
      formatAverageEl(root.querySelector('.jdgm-rev-widg, .jdgm-widget'));
      hydrateReviewImages();
      syncProductImageAttrs();
      if (tries > 40) clearInterval(timer);
    }, 250);

    document.addEventListener('jdgm.doneDoneSetup', function () {
      enhance();
      hydrateReviewImages();
      syncProductImageAttrs();
    });
    document.addEventListener('jdgm.doneLoadingReviews', function () {
      enhance();
      reorderCards();
      hydrateReviewImages();
      syncProductImageAttrs();
    });
    document.addEventListener('jdgm.doneSetupReviewForm', function () {
      ensureRowStars();
      syncProductImageAttrs();
    });

    if (window.MutationObserver) {
      var syncing = false;
      var observer = new MutationObserver(function () {
        if (syncing) return;
        syncing = true;
        try {
          if (root.querySelector('.jdgm-widget-revamp')) {
            enhanceRevamp();
            return;
          }
          dedupeFormWrappers();
          relocateFormOutsideHeader();
          syncWritingState();
          normalizeSubmittedState();
          formatAverageEl(root.querySelector('.jdgm-rev-widg, .jdgm-widget'));
          reorderCards();
          hydrateReviewImages();
          syncProductImageAttrs();
        } finally {
          syncing = false;
        }
      });
      observer.observe(root, { childList: true, subtree: true });
      // Modal mounts on body — patch thumb when Judge.me inserts/fills the write-review modal.
      var modalSyncTimer = null;
      var bodyObserver = new MutationObserver(function () {
        var img = document.querySelector('.jdgm-write-review-modal__product-image img');
        if (root.querySelector('.jdgm-notification')) {
          dedupeFormWrappers();
          normalizeSubmittedState();
        }
        if (!img || img.getAttribute('src') === PRODUCT_IMAGE_URL) return;
        if (modalSyncTimer) clearTimeout(modalSyncTimer);
        modalSyncTimer = setTimeout(syncProductImageAttrs, 50);
      });
      bodyObserver.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>

