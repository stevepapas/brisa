{{ 'brisa-home-hero-fix.css' | asset_url | stylesheet_tag }}
{% liquid
  assign accent = section.settings.accent_color | default: '#008bdc'
  assign button_bg = section.settings.button_background | default: '#35adff'
  assign hero_alt = section.settings.heading_line_1
  if section.settings.image != blank and section.settings.image.alt != blank
    assign hero_alt = section.settings.image.alt
  endif
%}

<style>
  @font-face {
    font-family: 'TeX Gyre Bonum';
    font-style: italic;
    font-weight: 700;
    font-display: swap;
    src: url({{ 'texgyrebonum-bolditalic.woff' | asset_url }}) format('woff');
  }

  #shopify-section-{{ section.id }} {
    --bhh-accent: {{ accent }};
    --bhh-button: {{ button_bg }};
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero {
    position: relative;
    isolation: isolate;
    min-height: {{ section.settings.hero_min_height }}px;
    color: #111111;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__image-wrap {
    width: 100%;
    height: 100%;
    background: #e8eef3;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.42) 28%,
      rgba(255, 255, 255, 0.12) 52%,
      rgba(255, 255, 255, 0.05) 100%
    );
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: {{ section.settings.hero_min_height }}px;
    padding: {{ section.settings.padding_top }}px 18px 28px;
    box-sizing: border-box;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__intro {
    max-width: 680px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 14px;
    padding: 8px 16px;
    color: #ffffff;
    background: var(--bhh-accent);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__title {
    margin: 0 0 12px;
    color: #111111;
    font-size: clamp(30px, 8vw, 48px);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__title-main {
    display: block;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__title-accent {
    display: block;
    color: var(--bhh-accent);
    font-family: 'TeX Gyre Bonum', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0;
    text-shadow: 0 0 18px rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__text {
    max-width: 520px;
    margin: 0 auto 8px;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__offer {
    max-width: 520px;
    margin: 0 auto 12px;
    color: #111111;
    font-size: 14px;
    font-style: italic;
    font-weight: 800;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--bhh-accent);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__star {
    display: block;
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__star svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating-text {
    color: #444444;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating-badge {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 5px 12px;
    color: #2c579b;
    background: #cfe9fb;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
    position: relative;
    z-index: 3;
    display: flex;
    gap: 10px;
    width: min(560px, 100%);
    margin: 34px auto 0;
    padding-top: 88px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta {
    position: relative;
    isolation: isolate;
    display: flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 12px;
    overflow: visible;
    color: #ffffff !important;
    background: transparent;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-align: center;
    text-decoration: none !important;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--bhh-button);
    border-radius: inherit;
    box-shadow: 0 10px 24px rgba(0, 100, 180, 0.22);
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-label {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    line-height: 0;
    bottom: calc(100% - 28px);
    width: 100%;
    max-width: 180px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--devices {
    left: 50%;
    transform: translateX(-50%) rotate(-15deg);
    transform-origin: center bottom;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores {
    left: 50%;
    right: auto;
    transform: translateX(-50%) rotate(15deg);
    transform-origin: center bottom;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 130px;
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.18));
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .brisa-home-hero,
    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      min-height: {{ section.settings.hero_min_height | plus: 80 }}px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      padding: {{ section.settings.padding_top | plus: 12 }}px 24px 40px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__eyebrow {
      margin-bottom: 16px;
      padding: 9px 20px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__title {
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__text,
    #shopify-section-{{ section.id }} .brisa-home-hero__offer {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__offer {
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__star {
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__rating-text {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__rating-badge {
      min-height: 28px;
      padding: 5px 14px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
      gap: 14px;
      width: min(620px, 100%);
      margin-top: 42px;
      padding-top: 110px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta {
      min-height: 60px;
      border-radius: 16px;
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art {
      max-width: 230px;
      bottom: calc(100% - 34px);
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art img {
      max-height: 160px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .brisa-home-hero,
    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      min-height: {{ section.settings.mobile_hero_min_height }}px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: 22px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
      margin-top: 28px;
      padding-top: 72px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta {
      min-height: 48px;
      padding: 12px 8px;
      font-size: 12px;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art {
      max-width: 120px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art img {
      max-height: 90px;
    }
  }
</style>

<section class="brisa-home-hero" {{ section.shopify_attributes }}>
  <div class="brisa-home-hero__media" aria-hidden="true">
    <div class="brisa-home-hero__image-wrap">
      {% if section.settings.image != blank %}
        {{ section.settings.image
          | image_url: width: 2000
          | image_tag:
            class: 'brisa-home-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600,900,1200,1600,2000',
            sizes: '100vw',
            alt: ''
        }}
      {% else %}
        <img
          class="brisa-home-hero__image"
          src="{{ 'brisa-home-hero.jpg' | asset_url }}"
          alt=""
          width="1651"
          height="1981"
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
    </div>
    <div class="brisa-home-hero__veil"></div>
  </div>

  <div class="brisa-home-hero__content">
    <div class="brisa-home-hero__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="brisa-home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
        <h1 class="brisa-home-hero__title">
          {% if section.settings.heading_line_1 != blank %}
            <span class="brisa-home-hero__title-main">{{ section.settings.heading_line_1 | escape }}</span>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="brisa-home-hero__title-accent">{{ section.settings.heading_line_2 | escape }}</span>
          {% endif %}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="brisa-home-hero__text">{{ section.settings.text | escape }}</p>
      {% endif %}

      {% if section.settings.offer != blank %}
        <p class="brisa-home-hero__offer">{{ section.settings.offer | escape }}</p>
      {% endif %}

      {% if section.settings.show_rating %}
        <div class="brisa-home-hero__rating" aria-label="{{ section.settings.rating_label | escape }}">
          <span class="brisa-home-hero__stars" aria-hidden="true">
            {% for star in (1..5) %}
              <span class="brisa-home-hero__star">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="m12 1.9 3.1 6.2 6.9 1-5 4.9 1.2 6.9-6.2-3.2-6.2 3.2L7 14 2 9.1l6.9-1L12 1.9Z" />
                </svg>
              </span>
            {% endfor %}
          </span>

          {% if section.settings.rating_text != blank %}
            <span class="brisa-home-hero__rating-text">{{ section.settings.rating_text | escape }}</span>
          {% endif %}

          {% if section.settings.rating_badge != blank %}
            <span class="brisa-home-hero__rating-badge">{{ section.settings.rating_badge | escape }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="brisa-home-hero__ctas">
      {% if section.settings.button_1_text != blank %}
        <a class="brisa-home-hero__cta brisa-home-hero__cta--devices" href="{{ section.settings.button_1_link | default: '/products/brisa-starter-kit' }}">
          {% if section.settings.devices_image != blank %}
            <span class="brisa-home-hero__cta-art brisa-home-hero__cta-art--devices" aria-hidden="true">
              {{ section.settings.devices_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700' }}
            </span>
          {% else %}
            <span class="brisa-home-hero__cta-art brisa-home-hero__cta-art--devices" aria-hidden="true">
              <img
                src="{{ section.settings.devices_image_url | default: 'https://cdn.shopify.com/s/files/1/0939/5752/1780/files/3-devices-trans.png?v=1784972994' }}"
                alt=""
                width="700"
                height="280"
                loading="lazy"
              >
            </span>
          {% endif %}
          <span class="brisa-home-hero__cta-label">{{ section.settings.button_1_text | escape }}</span>
        </a>
      {% endif %}

      {% if section.settings.button_2_text != blank %}
        <a class="brisa-home-hero__cta brisa-home-hero__cta--cores" href="{{ section.settings.button_2_link | default: '/products/brisa-cores' }}">
          {% if section.settings.cores_image != blank %}
            <span class="brisa-home-hero__cta-art brisa-home-hero__cta-art--cores" aria-hidden="true">
              {{ section.settings.cores_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700' }}
            </span>
          {% else %}
            <span class="brisa-home-hero__cta-art brisa-home-hero__cta-art--cores" aria-hidden="true">
              <img
                src="{{ section.settings.cores_image_url | default: 'https://cdn.shopify.com/s/files/1/0939/5752/1780/files/3-cores-trans.png?v=1784972994' }}"
                alt=""
                width="700"
                height="280"
                loading="lazy"
              >
            </span>
          {% endif %}
          <span class="brisa-home-hero__cta-label">{{ section.settings.button_2_text | escape }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brisa home hero v4",
  "tag": "section",
  "class": "shopify-section--brisa-home-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow badge",
      "default": "WORLD FIRST - AUSTRALIAN DESIGNED"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "KEEP THE RITUAL"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "DROP THE HABIT"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "A drug-free sensory habit device made to replace the hand-to-mouth routine of vaping and smoking."
    },
    {
      "type": "textarea",
      "id": "offer",
      "label": "Offer line",
      "default": "Up to $70 Aud in free gifts + savings, plus FREE SHIPPING on all kits."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Rated 4.7"
    },
    {
      "type": "text",
      "id": "rating_badge",
      "label": "Rating badge",
      "default": "Happy customers"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating accessibility label",
      "default": "Rated 4.7 out of 5 by happy customers"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Left button text",
      "default": "THE BRISA"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Left button link"
    },
    {
      "type": "image_picker",
      "id": "devices_image",
      "label": "Left button product art"
    },
    {
      "type": "text",
      "id": "devices_image_url",
      "label": "Left button product art URL",
      "default": "https://cdn.shopify.com/s/files/1/0939/5752/1780/files/3-devices-trans.png?v=1784972994"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Right button text",
      "default": "BRISA CORES"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Right button link"
    },
    {
      "type": "image_picker",
      "id": "cores_image",
      "label": "Right button product art"
    },
    {
      "type": "text",
      "id": "cores_image_url",
      "label": "Right button product art URL",
      "default": "https://cdn.shopify.com/s/files/1/0939/5752/1780/files/3-cores-trans.png?v=1784972994"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center 30%", "label": "Upper center" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center 30%"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#008bdc"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#35adff"
    },
    {
      "type": "range",
      "id": "hero_min_height",
      "label": "Desktop min height",
      "min": 520,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "mobile_hero_min_height",
      "label": "Mobile min height",
      "min": 560,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Brisa home hero v4",
      "category": "Brisa"
    }
  ]
}
{% endschema %}
