      "id": "rating_text",
      "label": "Rating text",
      "default": "Rated 4.7"
    },
    {
      "type": "text",
      "id": "rating_badge",
      "label": "Rating badge",
      "default": "Happy customers"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating accessibility label",
      "default": "Rated 4.7 out of 5 by happy customers"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Left button text",
      "default": "THE BRISA"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Left button link"
    },
    {
      "type": "image_picker",
