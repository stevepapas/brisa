{% liquid
  assign accent = section.settings.accent_color | default: '#008bdc'
  assign button_bg = section.settings.button_background | default: '#35adff'
  assign hero_alt = section.settings.heading_line_1
  if section.settings.image != blank and section.settings.image.alt != blank
    assign hero_alt = section.settings.image.alt
  endif
  assign text_in_image = section.settings.text_in_image
  assign devices_image_url = section.settings.devices_image_url | default: 'https://cdn.shopify.com/s/files/1/0939/5752/1780/files/3-devices-trans.png?v=1784972994'
  assign devices_image_query = '?'
  if devices_image_url contains '?'
    assign devices_image_query = '&'
  endif
  assign cores_image_url = section.settings.cores_image_url | default: 'https://cdn.shopify.com/s/files/1/0939/5752/1780/files/3-cores-trans.png?v=1784972994'
  assign cores_image_query = '?'
  if cores_image_url contains '?'
    assign cores_image_query = '&'
  endif
%}

{% if section.settings.image != blank %}
  <link
    rel="preload"
    as="image"
    href="{{ section.settings.image | image_url: width: 1200 }}"
    imagesrcset="
      {{ section.settings.image | image_url: width: 600 }} 600w,
      {{ section.settings.image | image_url: width: 900 }} 900w,
      {{ section.settings.image | image_url: width: 1200 }} 1200w,
      {{ section.settings.image | image_url: width: 1600 }} 1600w,
      {{ section.settings.image | image_url: width: 2000 }} 2000w
    "
    imagesizes="100vw"
    fetchpriority="high"
  >
{% else %}
  <link
    rel="preload"
    as="image"
    href="{{ 'brisa-home-hero.jpg' | asset_img_url: '819x' }}"
    imagesrcset="
      {{ 'brisa-home-hero.jpg' | asset_img_url: '400x' }} 400w,
      {{ 'brisa-home-hero.jpg' | asset_img_url: '600x' }} 600w,
      {{ 'brisa-home-hero.jpg' | asset_img_url: '819x' }} 819w
    "
    imagesizes="100vw"
    fetchpriority="high"
  >
{% endif %}

<style>
  @font-face {
    font-family: 'TeX Gyre Bonum';
    font-style: italic;
    font-weight: 700;
    font-display: swap;
    src: url({{ 'texgyrebonum-bolditalic.woff' | asset_url }}) format('woff');
  }

  #shopify-section-{{ section.id }} {
    --bhh-accent: {{ accent }};
    --bhh-button: {{ button_bg }};
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero {
    position: relative;
    isolation: isolate;
    min-height: {{ section.settings.hero_min_height }}px;
    color: #111111;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__image-wrap {
    width: 100%;
    height: 100%;
    background: #e8eef3;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    border-radius: 0;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.42) 28%,
      rgba(255, 255, 255, 0.12) 52%,
      rgba(255, 255, 255, 0.05) 100%
    );
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: {{ section.settings.hero_min_height }}px;
    padding: {{ section.settings.padding_top }}px 18px 28px;
    box-sizing: border-box;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__intro {
    max-width: 680px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 14px;
    padding: 8px 16px;
    color: #ffffff;
    background: var(--bhh-accent);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__title {
    margin: 0 0 12px;
    color: #111111;
    font-size: clamp(30px, 8vw, 48px);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__title-main {
    display: block;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__title-accent {
    display: block;
    color: var(--bhh-accent);
    font-family: 'TeX Gyre Bonum', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0;
    text-shadow: 0 0 18px rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__text {
    max-width: 520px;
    margin: 0 auto 8px;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__offer {
    max-width: 520px;
    margin: 0 auto 12px;
    color: #111111;
    font-size: 14px;
    font-style: italic;
    font-weight: 800;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating-link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating-link:hover .brisa-home-hero__rating-text,
  #shopify-section-{{ section.id }} .brisa-home-hero__rating-link:focus-visible .brisa-home-hero__rating-text {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--bhh-accent);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__star {
    display: block;
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__star svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating-text {
    color: #444444;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating-badge {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 5px 12px;
    color: #2c579b;
    background: #cfe9fb;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
    position: relative;
    z-index: 3;
    display: flex;
    gap: 10px;
    width: min(560px, 100%);
    margin: 34px auto 0;
    padding-top: 88px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta {
    position: relative;
    isolation: isolate;
    display: flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 12px;
    overflow: visible;
    color: #ffffff !important;
    background: transparent;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-align: center;
    text-decoration: none !important;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--bhh-button);
    border-radius: inherit;
    box-shadow: 0 10px 24px rgba(0, 100, 180, 0.22);
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-label {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    line-height: 0;
    bottom: calc(100% - 28px);
    width: 100%;
    max-width: 180px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--devices {
    left: -8%;
    right: auto;
    transform: rotate(-20deg);
    transform-origin: center bottom;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores {
    left: auto;
    right: -8%;
    width: 70%;
    max-width: 126px;
    transform: rotate(20deg);
    transform-origin: center bottom;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 130px;
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.18));
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores img {
    max-height: 91px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .brisa-home-hero,
    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      min-height: {{ section.settings.hero_min_height | plus: 80 }}px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      padding: {{ section.settings.padding_top | plus: 12 }}px 24px 40px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__eyebrow {
      margin-bottom: 16px;
      padding: 9px 20px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__title {
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__text,
    #shopify-section-{{ section.id }} .brisa-home-hero__offer {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__offer {
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__star {
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__rating-text {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__rating-badge {
      min-height: 28px;
      padding: 5px 14px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
      gap: 14px;
      width: min(620px, 100%);
      margin-top: 42px;
      padding-top: 110px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta {
      min-height: 60px;
      border-radius: 16px;
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art {
      max-width: 230px;
      bottom: calc(100% - 34px);
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores {
      max-width: 161px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art img {
      max-height: 160px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores img {
      max-height: 112px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .brisa-home-hero,
    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      min-height: {{ section.settings.mobile_hero_min_height }}px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: 22px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
      margin-top: 28px;
      padding-top: 72px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta {
      min-height: 48px;
      padding: 12px 8px;
      font-size: 12px;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art {
      max-width: 140px;
      bottom: calc(100% - 24px);
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--devices {
      left: -10%;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores {
      right: -10%;
      max-width: 98px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art img {
      max-height: 100px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores img {
      max-height: 70px;
    }
  }

  {% unless text_in_image %}
  #shopify-section-{{ section.id }} .brisa-home-hero__media {
    top: 50%;
  }
  {% endunless %}

  {% if text_in_image %}
  #shopify-section-{{ section.id }} .brisa-home-hero__veil {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 40%,
      rgba(255, 255, 255, 0) 70%
    );
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__intro {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__content {
    justify-content: flex-end;
  }

  /* CTA padding covers the baked rating — let clicks pass through empty space */
  #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta {
    pointer-events: auto;
  }

  /* Invisible hit target over baked-in stars/rating in the hero image */
  #shopify-section-{{ section.id }} .brisa-home-hero__rating-hotspot {
    position: absolute;
    z-index: 5;
    left: 50%;
    transform: translateX(-50%);
    width: 68%;
    max-width: 420px;
    height: 36px;
    border-radius: 999px;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating-hotspot:focus-visible {
    outline: 2px solid var(--bhh-accent);
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .brisa-home-hero__rating-hotspot {
      /* Image is height-cropped on tall mobile frames; y% tracks the asset */
      top: 31.5%;
      width: 78%;
      height: 34px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
      margin-top: 0 !important;
      padding-top: 172px !important;
      margin-bottom: 182px !important;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .brisa-home-hero__rating-hotspot {
      /* Width-driven cover crops the bottom; map image y≈32% into the frame */
      top: 40.2%;
      width: 62%;
      height: 38px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
      width: min(620px, 100%) !important;
      gap: 14px !important;
      margin-top: 0 !important;
      margin-bottom: 285px !important;
      padding-top: 317px !important;
    }
  }
  {% endif %}

  #shopify-section-{{ section.id }} .brisa-home-hero__eyebrow {
    margin: 0 0 5px;
    padding: 4px 16px;
    font-size: 10px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__title {
    margin-bottom: 3px;
    font-size: clamp(24px, 8vw, 48px);
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__text {
    margin: 0 auto 4px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__offer {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating {
    gap: 3px;
    flex-wrap: nowrap;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__stars {
    gap: 0;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__star {
    width: 13px;
    height: 13px;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__rating-badge {
    color: #254b99 !important;
    background: #38b6ff !important;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--devices {
    transform: rotate(-40deg) !important;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores {
    transform: rotate(30deg) !important;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--devices img {
    max-height: 48px !important;
  }

  #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores img {
    max-height: 36.4px !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .brisa-home-hero__text,
    #shopify-section-{{ section.id }} .brisa-home-hero__offer {
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art {
      bottom: calc(100% - 14px) !important;
    }

    {% unless text_in_image %}
    #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
      margin-top: -39px !important;
      padding-top: 72px !important;
      margin-bottom: 122px !important;
    }
    {% endunless %}
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .brisa-home-hero {
      width: min(712px, 100%);
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__content {
      width: min(712px, 100%);
      margin: 0 auto;
      padding: 28px 32px 32px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__intro,
    #shopify-section-{{ section.id }} .brisa-home-hero__text,
    #shopify-section-{{ section.id }} .brisa-home-hero__offer {
      max-width: 712px;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__text,
    #shopify-section-{{ section.id }} .brisa-home-hero__offer {
      font-size: 13px;
    }

    {% unless text_in_image %}
    #shopify-section-{{ section.id }} .brisa-home-hero__ctas {
      width: min(620px, 100%) !important;
      gap: 14px !important;
      margin-top: -24px !important;
      margin-bottom: 144px !important;
      padding-top: 84px !important;
    }
    {% endunless %}

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art {
      bottom: calc(100% - 18px) !important;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--devices img {
      max-height: 135px !important;
    }

    #shopify-section-{{ section.id }} .brisa-home-hero__cta-art--cores img {
      max-height: 94.5px !important;
    }
  }
</style>

<section class="brisa-home-hero" {{ section.shopify_attributes }}>
  <div class="brisa-home-hero__media" aria-hidden="true">
    <div class="brisa-home-hero__image-wrap">
      {% if section.settings.image != blank %}
        {{ section.settings.image
          | image_url: width: 2000
          | image_tag:
            class: 'brisa-home-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600,900,1200,1600,2000',
            sizes: '100vw',
            alt: ''
        }}
      {% else %}
        {% render 'brisa-responsive-asset-img',
          filename: 'brisa-home-hero.jpg',
          widths: '400,600,819',
          sizes: '100vw',
          alt: '',
          class: 'brisa-home-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          width: 819,
          height: 1024
        %}
      {% endif %}
    </div>
    <div class="brisa-home-hero__veil"></div>
  </div>

  <div class="brisa-home-hero__content">
    {% if text_in_image and section.settings.show_rating %}
      <a
        class="brisa-home-hero__rating-hotspot"
        href="#real_results"
        aria-label="{{ section.settings.rating_label | default: section.settings.rating_text | default: 'View customer reviews' | escape }}"
      ></a>
    {% endif %}

    <div class="brisa-home-hero__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="brisa-home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
        <h1 class="brisa-home-hero__title">
          {% if section.settings.heading_line_1 != blank %}
            <span class="brisa-home-hero__title-main">{{ section.settings.heading_line_1 | escape }}</span>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="brisa-home-hero__title-accent">{{ section.settings.heading_line_2 | escape }}</span>
          {% endif %}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="brisa-home-hero__text">{{ section.settings.text | escape }}</p>
      {% endif %}

      {% if section.settings.offer != blank %}
        <p class="brisa-home-hero__offer">{{ section.settings.offer | escape }}</p>
      {% endif %}

      {% if section.settings.show_rating %}
        <div class="brisa-home-hero__rating">
          {% if text_in_image %}
            <span class="brisa-home-hero__stars" aria-hidden="true">
              {% for star in (1..5) %}
                <span class="brisa-home-hero__star">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="m12 1.9 3.1 6.2 6.9 1-5 4.9 1.2 6.9-6.2-3.2-6.2 3.2L7 14 2 9.1l6.9-1L12 1.9Z" />
                  </svg>
                </span>
              {% endfor %}
            </span>
            {% if section.settings.rating_text != blank %}
              <span class="brisa-home-hero__rating-text">{{ section.settings.rating_text | escape }}</span>
            {% endif %}
          {% else %}
            <a
              href="#real_results"
              class="brisa-home-hero__rating-link"
              aria-label="{{ section.settings.rating_label | default: section.settings.rating_text | default: 'View customer reviews' | escape }}"
            >
              <span class="brisa-home-hero__stars" aria-hidden="true">
                {% for star in (1..5) %}
                  <span class="brisa-home-hero__star">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="m12 1.9 3.1 6.2 6.9 1-5 4.9 1.2 6.9-6.2-3.2-6.2 3.2L7 14 2 9.1l6.9-1L12 1.9Z" />
                    </svg>
                  </span>
                {% endfor %}
              </span>
              {% if section.settings.rating_text != blank %}
                <span class="brisa-home-hero__rating-text">{{ section.settings.rating_text | escape }}</span>
              {% endif %}
            </a>
          {% endif %}

          {% if section.settings.rating_badge != blank %}
            <span class="brisa-home-hero__rating-badge">{{ section.settings.rating_badge | escape }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="brisa-home-hero__ctas">
      {% if section.settings.button_1_text != blank %}
        <a class="brisa-home-hero__cta brisa-home-hero__cta--devices" href="{{ section.settings.button_1_link | default: '/products/brisa-starter-kit' }}">
          {% if section.settings.devices_image != blank %}
            <span class="brisa-home-hero__cta-art brisa-home-hero__cta-art--devices" aria-hidden="true">
              {%- capture devices_image_markup -%}
                {{ section.settings.devices_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '80,120,160,240,320,480', sizes: '(max-width: 749px) 80px, 230px' }}
              {%- endcapture -%}
              {{- devices_image_markup
                | replace: '&amp;width=', '&amp;quality=70&amp;width='
                | replace: '?width=', '?quality=70&amp;width='
              -}}
            </span>
          {% else %}
            <span class="brisa-home-hero__cta-art brisa-home-hero__cta-art--devices" aria-hidden="true">
              <img
                src="{{ devices_image_url }}{{ devices_image_query }}quality=70&width=160"
                srcset="
                  {{ devices_image_url }}{{ devices_image_query }}quality=70&width=80 80w,
                  {{ devices_image_url }}{{ devices_image_query }}quality=70&width=120 120w,
                  {{ devices_image_url }}{{ devices_image_query }}quality=70&width=160 160w,
                  {{ devices_image_url }}{{ devices_image_query }}quality=70&width=240 240w,
                  {{ devices_image_url }}{{ devices_image_query }}quality=70&width=320 320w,
                  {{ devices_image_url }}{{ devices_image_query }}quality=70&width=480 480w
                "
                sizes="(max-width: 749px) 80px, 230px"
                alt=""
                width="695"
                height="860"
                loading="lazy"
              >
            </span>
          {% endif %}
          <span class="brisa-home-hero__cta-label">{{ section.settings.button_1_text | escape }}</span>
        </a>
      {% endif %}

      {% if section.settings.button_2_text != blank %}
        <a class="brisa-home-hero__cta brisa-home-hero__cta--cores" href="{{ section.settings.button_2_link | default: '/products/brisa-cores' }}">
          {% if section.settings.cores_image != blank %}
            <span class="brisa-home-hero__cta-art brisa-home-hero__cta-art--cores" aria-hidden="true">
              {%- capture cores_image_markup -%}
                {{ section.settings.cores_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '80,120,160,240,320,480', sizes: '(max-width: 749px) 110px, 161px' }}
              {%- endcapture -%}
              {{- cores_image_markup
                | replace: '&amp;width=', '&amp;quality=70&amp;width='
                | replace: '?width=', '?quality=70&amp;width='
              -}}
            </span>
          {% else %}
            <span class="brisa-home-hero__cta-art brisa-home-hero__cta-art--cores" aria-hidden="true">
              <img
                src="{{ cores_image_url }}{{ cores_image_query }}quality=70&width=240"
                srcset="
                  {{ cores_image_url }}{{ cores_image_query }}quality=70&width=80 80w,
                  {{ cores_image_url }}{{ cores_image_query }}quality=70&width=120 120w,
                  {{ cores_image_url }}{{ cores_image_query }}quality=70&width=160 160w,
                  {{ cores_image_url }}{{ cores_image_query }}quality=70&width=240 240w,
                  {{ cores_image_url }}{{ cores_image_query }}quality=70&width=320 320w,
                  {{ cores_image_url }}{{ cores_image_query }}quality=70&width=480 480w
                "
                sizes="(max-width: 749px) 110px, 161px"
                alt=""
                width="868"
                height="539"
                loading="lazy"
              >
            </span>
          {% endif %}
          <span class="brisa-home-hero__cta-label">{{ section.settings.button_2_text | escape }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brisa home hero v4",
  "tag": "section",
  "class": "shopify-section--brisa-home-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow badge",
      "default": "WORLD FIRST - AUSTRALIAN DESIGNED"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
