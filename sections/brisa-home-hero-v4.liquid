    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Right button link"
    },
    {
      "type": "image_picker",
      "id": "cores_image",
      "label": "Right button product art"
    },
    {
      "type": "text",
      "id": "cores_image_url",
      "label": "Right button product art URL",
      "default": "https://cdn.shopify.com/s/files/1/0939/5752/1780/files/3-cores-trans.png?v=1784972994"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "checkbox",
      "id": "text_in_image",
      "label": "Hero image already includes copy",
