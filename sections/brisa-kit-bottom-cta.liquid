{{ 'brisa-kit-purchase.css' | asset_url | stylesheet_tag }}

<section class="bkp-bottom" data-bkp-bottom {{ section.shopify_attributes }}>
  <div class="bkp-bottom__inner">
    <button type="button" class="bkp__atc" data-bkp-sync-atc>
      <span data-bkp-sync-atc-label>ADD TO CART</span>
    </button>

    {%- if section.settings.show_trust -%}
      {%- liquid
        assign trust_count = 0
        if section.settings.show_trust_1 and section.settings.trust_1 != blank
          assign trust_count = trust_count | plus: 1
        endif
        if section.settings.show_trust_2 and section.settings.trust_2 != blank
          assign trust_count = trust_count | plus: 1
        endif
        if section.settings.show_trust_3 and section.settings.trust_3 != blank
          assign trust_count = trust_count | plus: 1
        endif
        if section.settings.show_trust_4 and section.settings.trust_4 != blank
          assign trust_count = trust_count | plus: 1
        endif
        if section.settings.show_trust_5 and section.settings.trust_5 != blank
          assign trust_count = trust_count | plus: 1
        endif
        if section.settings.show_trust_6 and section.settings.trust_6 != blank
          assign trust_count = trust_count | plus: 1
        endif
      -%}
      {%- if trust_count > 0 -%}
        <ul class="bkp__trust">
          {%- if section.settings.show_trust_1 and section.settings.trust_1 != blank -%}
            <li class="bkp__trust-item">
              <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
                {%- if section.settings.trust_icon_1 != blank -%}
                  {{ section.settings.trust_icon_1 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
                {%- else -%}
                  <img src="{{ section.settings.trust_icon_asset_1 | default: 'brisa-trust-ship.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
                {%- endif -%}
              </span>
              <span>{{ section.settings.trust_1 | escape }}</span>
            </li>
          {%- endif -%}

          {%- if section.settings.show_trust_2 and section.settings.trust_2 != blank -%}
            <li class="bkp__trust-item">
              <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
                {%- if section.settings.trust_icon_2 != blank -%}
                  {{ section.settings.trust_icon_2 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
                {%- else -%}
                  <img src="{{ section.settings.trust_icon_asset_2 | default: 'brisa-trust-lock.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
                {%- endif -%}
              </span>
              <span>{{ section.settings.trust_2 | escape }}</span>
            </li>
          {%- endif -%}

          {%- if section.settings.show_trust_3 and section.settings.trust_3 != blank -%}
            <li class="bkp__trust-item">
              <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
                {%- if section.settings.trust_icon_3 != blank -%}
                  {{ section.settings.trust_icon_3 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
                {%- else -%}
                  <img src="{{ section.settings.trust_icon_asset_3 | default: 'brisa-trust-box.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
                {%- endif -%}
              </span>
              <span>{{ section.settings.trust_3 | escape }}</span>
            </li>
          {%- endif -%}

          {%- if section.settings.show_trust_4 and section.settings.trust_4 != blank -%}
            <li class="bkp__trust-item">
              <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
                {%- if section.settings.trust_icon_4 != blank -%}
                  {{ section.settings.trust_icon_4 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
                {%- else -%}
                  <img src="{{ section.settings.trust_icon_asset_4 | default: 'brisa-trust-aussie.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
                {%- endif -%}
              </span>
              <span>{{ section.settings.trust_4 | escape }}</span>
            </li>
          {%- endif -%}

          {%- if section.settings.show_trust_5 and section.settings.trust_5 != blank -%}
            <li class="bkp__trust-item">
              <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
                {%- if section.settings.trust_icon_5 != blank -%}
                  {{ section.settings.trust_icon_5 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
                {%- else -%}
                  <img src="{{ section.settings.trust_icon_asset_5 | default: 'brisa-trust-star.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
                {%- endif -%}
              </span>
              <span>{{ section.settings.trust_5 | escape }}</span>
            </li>
          {%- endif -%}

          {%- if section.settings.show_trust_6 and section.settings.trust_6 != blank -%}
            <li class="bkp__trust-item">
              <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
                {%- if section.settings.trust_icon_6 != blank -%}
                  {{ section.settings.trust_icon_6 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
                {%- else -%}
                  <img src="{{ section.settings.trust_icon_asset_6 | default: 'brisa-trust-shield.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
                {%- endif -%}
              </span>
              <span>{{ section.settings.trust_6 | escape }}</span>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

