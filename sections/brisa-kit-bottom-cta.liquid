{{ 'brisa-kit-purchase.css' | asset_url | stylesheet_tag }}

<section class="bkp-bottom" data-bkp-bottom {{ section.shopify_attributes }}>
  <div class="bkp-bottom__inner">
    <button type="button" class="bkp__atc" data-bkp-sync-atc>
      <span data-bkp-sync-atc-label>ADD TO CART</span>
    </button>

    <ul class="bkp__trust">
      <li class="bkp__trust-item">
        <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
          <img src="{{ 'brisa-trust-ship.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
        </span>
        <span>Ships Next Day</span>
      </li>
      <li class="bkp__trust-item">
        <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
          <img src="{{ 'brisa-trust-lock.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
        </span>
        <span>Secure checkout</span>
      </li>
      <li class="bkp__trust-item">
        <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
          <img src="{{ 'brisa-trust-box.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
        </span>
        <span>FREE SHIPPING</span>
      </li>
      <li class="bkp__trust-item">
        <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
          <img src="{{ 'brisa-trust-aussie.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
        </span>
        <span>Australian Customer service</span>
      </li>
      <li class="bkp__trust-item">
        <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
          <img src="{{ 'brisa-trust-star.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
        </span>
        <span>4.7 (163)</span>
      </li>
      <li class="bkp__trust-item">
        <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
          <img src="{{ 'brisa-trust-shield.svg' | asset_url }}" alt="" width="28" height="28" loading="lazy">
        </span>
        <span>30 Day Guarantee</span>
      </li>
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brisa kit bottom CTA",
  "tag": "section",
  "class": "shopify-section--brisa-kit-bottom-cta",
  "settings": [],
  "presets": [{ "name": "Brisa kit bottom CTA" }]
}
{% endschema %}
