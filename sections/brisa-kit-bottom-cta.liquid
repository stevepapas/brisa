{{ 'brisa-kit-purchase.css' | asset_url | stylesheet_tag }}

<section
  class="bkp-bottom"
  data-bkp-bottom
  data-show-trust="{% if section.settings.show_trust %}true{% else %}false{% endif %}"
  data-show-trust-1="{% if section.settings.show_trust_1 %}true{% else %}false{% endif %}"
  data-show-trust-2="{% if section.settings.show_trust_2 %}true{% else %}false{% endif %}"
  data-show-trust-3="{% if section.settings.show_trust_3 %}true{% else %}false{% endif %}"
  data-show-trust-4="{% if section.settings.show_trust_4 %}true{% else %}false{% endif %}"
  data-show-trust-5="{% if section.settings.show_trust_5 %}true{% else %}false{% endif %}"
  data-show-trust-6="{% if section.settings.show_trust_6 %}true{% else %}false{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="bkp-bottom__inner">
    <button type="button" class="bkp__atc" data-bkp-sync-atc>
      <span data-bkp-sync-atc-label>ADD TO CART</span>
    </button>

    {%- comment -%}
      Trust labels/icons are cloned from Brisa kit purchase (single source of truth).
      This section only controls which items are shown.
    {%- endcomment -%}
    <div class="bkp-bottom__trust" data-bkp-mirror-trust></div>
  </div>
</section>

<script>
  (() => {
    const fillTrust = () => {
      document.querySelectorAll('[data-bkp-bottom]').forEach((section) => {
        const host = section.querySelector('[data-bkp-mirror-trust]');
        if (!host) return;

        if (section.dataset.showTrust !== 'true') {
          host.replaceChildren();
          return;
        }

        const source = document.querySelector(
          'brisa-kit-purchase [data-bkp-trust-source], brisa-kit-purchase .bkp__trust'
        );
        if (!source) return;

        const clone = source.cloneNode(true);
        clone.removeAttribute('data-bkp-trust-source');

        clone.querySelectorAll('[data-bkp-trust-index]').forEach((item) => {
          const index = item.getAttribute('data-bkp-trust-index');
          // data-show-trust-1 maps to dataset['showTrust-1'], not showTrust1
          if (section.getAttribute(`data-show-trust-${index}`) !== 'true') item.remove();
        });

        if (!clone.querySelector('[data-bkp-trust-index]')) {
          host.replaceChildren();
          return;
        }

        host.replaceChildren(clone);
      });
      return Boolean(document.querySelector('brisa-kit-purchase [data-bkp-trust-source], brisa-kit-purchase .bkp__trust'));
    };

    if (!fillTrust()) {
      document.addEventListener('DOMContentLoaded', fillTrust);
      window.addEventListener('load', fillTrust);
    }

    // Re-run after kit purchase custom element finishes setup.
    const kit = document.querySelector('brisa-kit-purchase');
    if (kit) {
      if (typeof kit.mirrorTrustIcons === 'function') {
        // Keep kit helper for any other mirrors; then apply our filters.
        kit.mirrorTrustIcons();
      }
      fillTrust();
    }
  })();
</script>

{% schema %}
{
  "name": "Brisa kit bottom CTA",
  "tag": "section",
  "class": "shopify-section--brisa-kit-bottom-cta",
  "settings": [
    {
      "type": "paragraph",
      "content": "Trust badge labels and icons come from Brisa kit purchase → Trust row. Use the switches below only to show or hide items here."
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_1",
      "label": "Show item 1",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_2",
      "label": "Show item 2",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_3",
      "label": "Show item 3",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_4",
      "label": "Show item 4",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_5",
      "label": "Show item 5",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_6",
      "label": "Show item 6",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Brisa kit bottom CTA"
    }
  ]
}
{% endschema %}
