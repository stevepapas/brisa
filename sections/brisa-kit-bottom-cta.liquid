{{ 'brisa-kit-purchase.css' | asset_url | stylesheet_tag }}

<section class="bkp-bottom" data-bkp-bottom {{ section.shopify_attributes }}>
  <div class="bkp-bottom__inner">
    <button type="button" class="bkp__atc" data-bkp-sync-atc>
      <span data-bkp-sync-atc-label>ADD TO CART</span>
    </button>

    {%- comment -%}
      Trust badges are cloned from Brisa kit purchase → Trust row.
      Edit icons/labels only in that section.
    {%- endcomment -%}
    <div class="bkp-bottom__trust" data-bkp-mirror-trust></div>
  </div>
</section>

<script>
  (() => {
    const fillTrust = () => {
      const source = document.querySelector(
        'brisa-kit-purchase [data-bkp-trust-source], brisa-kit-purchase .bkp__trust'
      );
      if (!source) return false;

      document.querySelectorAll('[data-bkp-mirror-trust]').forEach((host) => {
        if (host.childElementCount) return;
        const clone = source.cloneNode(true);
        clone.removeAttribute('data-bkp-trust-source');
        host.replaceChildren(clone);
      });
      return true;
    };

    if (!fillTrust()) {
      document.addEventListener('DOMContentLoaded', fillTrust);
      window.addEventListener('load', fillTrust);
    }

    const kit = document.querySelector('brisa-kit-purchase');
    if (kit && typeof kit.mirrorTrustIcons === 'function') {
      kit.mirrorTrustIcons();
    }
  })();
</script>

{% schema %}
{
  "name": "Brisa kit bottom CTA",
  "tag": "section",
  "class": "shopify-section--brisa-kit-bottom-cta",
  "settings": [],
  "presets": [
    {
      "name": "Brisa kit bottom CTA"
    }
  ]
}
{% endschema %}
