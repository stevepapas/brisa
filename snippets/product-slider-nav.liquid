{% liquid
  assign swatch_style = ''
  assign swatch_label = ''
  assign nav_label = variant.title

  if option_value != blank
    assign nav_label = option_value.name | default: variant.title
  endif

  case section.settings.swatch_label_source
    when 'product_option'
      if option_value != blank
        assign swatch_label = option_value.name
      else
        assign swatch_label = nav_label
      endif
    when 'carousel_swatch_colour'
      assign swatch_label = variant.metafields.custom.carousel_swatch_colour.value | default: variant.metafields.custom.carousel_swatch_colour | default: slider_product.metafields.custom.carousel_swatch_colour.value | default: slider_product.metafields.custom.carousel_swatch_colour
    when 'variant_title'
      assign swatch_label = variant.title
    when 'product_title'
      assign swatch_label = slider_product.title
    when 'flavour'
      assign swatch_label = variant.metafields.custom.flavour.value | default: variant.metafields.custom.flavour | default: variant.title
    when 'vendor'
      assign swatch_label = slider_product.vendor
    when 'product_type'
      assign swatch_label = slider_product.type
    when 'custom_metafield'
      assign metafield_namespace = section.settings.swatch_label_metafield_namespace
      assign metafield_key = section.settings.swatch_label_metafield_key
      assign swatch_label = variant.metafields[metafield_namespace][metafield_key].value | default: variant.metafields[metafield_namespace][metafield_key] | default: slider_product.metafields[metafield_namespace][metafield_key].value | default: slider_product.metafields[metafield_namespace][metafield_key]
  endcase

  comment
    Admin option swatch image (Aroma → Image) — preferred when set, regardless of colour source.
  endcomment
  if option_value != blank and option_value.swatch.image != blank
    assign swatch_image_url = option_value.swatch.image | image_url: width: 96
    assign swatch_style = 'background-image: url(' | append: swatch_image_url | append: ')'
  endif

  if swatch_style == blank
  case section.settings.swatch_color_source
    when 'product_option'
      if option_value != blank
        capture swatch_style
          render 'color-swatch-style', swatch: option_value.swatch, color_swatch_config: color_swatch_config, value: option_value
        endcapture
        assign swatch_style = swatch_style | strip
      endif
    when 'carousel_swatch_colour'
      assign swatch_color = variant.metafields.custom.carousel_swatch_colour.value | default: variant.metafields.custom.carousel_swatch_colour | default: slider_product.metafields.custom.carousel_swatch_colour.value | default: slider_product.metafields.custom.carousel_swatch_colour
      if swatch_color == blank
        assign flavour_name = nav_label | downcase | strip
        case flavour_name
          when 'watermelon'
            assign swatch_color = '#e9534f'
          when 'mint ice'
            assign swatch_color = '#6ec9b0'
          when 'blackcurrant', 'black currant'
            assign swatch_color = '#7b5ea7'
          when 'cherry pomegranate', 'cherry'
            assign swatch_style = 'background: linear-gradient(135deg, #e11d48 0%, #f9a8d4 100%)'
          when 'raspberry lime', 'raspberry'
            assign swatch_style = 'background: linear-gradient(135deg, #dc2626 0%, #84cc16 100%)'
          when 'variety'
            assign variety_swatch_url = 'variety.png' | file_url
            assign swatch_style = 'background-image: url(' | append: variety_swatch_url | append: ')'
          else
            assign swatch_color = section.settings.dot_color
        endcase
      endif
      if swatch_style == blank and swatch_color != blank
        assign swatch_style = 'background-color: ' | append: swatch_color
      endif
    when 'carousel_background_colour'
      assign swatch_color = variant.metafields.custom.carousel_background_colour.value | default: variant.metafields.custom.carousel_background_colour | default: slider_product.metafields.custom.carousel_background_colour.value | default: slider_product.metafields.custom.carousel_background_colour | default: section.settings.dot_color
      assign swatch_style = 'background-color: ' | append: swatch_color
    when 'custom_metafield'
      assign swatch_color_namespace = section.settings.swatch_color_metafield_namespace
      assign swatch_color_key = section.settings.swatch_color_metafield_key
      assign swatch_color = variant.metafields[swatch_color_namespace][swatch_color_key].value | default: variant.metafields[swatch_color_namespace][swatch_color_key] | default: slider_product.metafields[swatch_color_namespace][swatch_color_key].value | default: slider_product.metafields[swatch_color_namespace][swatch_color_key] | default: section.settings.dot_color
      assign swatch_style = 'background-color: ' | append: swatch_color
    else
      assign swatch_style = 'background-color: ' | append: section.settings.dot_color
  endcase
  endif

  if swatch_style == blank
    assign swatch_style = 'background-color: ' | append: section.settings.dot_color
  endif
%}

{% liquid
  assign display_label = swatch_label
  assign label_down = swatch_label | downcase | strip
  if label_down contains 'cherry'
    assign display_label = 'Cherry'
  elsif label_down contains 'raspberry'
    assign display_label = 'Raspberry'
  elsif label_down contains 'mint'
    assign display_label = 'Mint Ice'
  elsif label_down contains 'variety'
    assign display_label = 'Variety'
  endif

  assign show_new_badge = false
  assign display_down = display_label | downcase
  assign new_badge_names = section.settings.new_badge_names | default: 'Cherry,Raspberry,Variety,Cherry Pomegranate,Raspberry Lime' | downcase | replace: ', ', ',' | split: ','
  for badge_name in new_badge_names
    assign badge_trim = badge_name | strip
    if badge_trim != blank
      if label_down == badge_trim or display_down == badge_trim or label_down contains badge_trim
        assign show_new_badge = true
        break
      endif
    endif
  endfor

  comment
    Variety has no independent stock — gate on the three single-flavour packs
    (same source of truth as Monthly Better Box / Flow BOM).
  endcomment
  assign nav_available = variant.available
  assign is_variety = false
  assign variety_check = nav_label | append: ' ' | append: variant.title | downcase
  if variety_check contains 'variety'
    assign is_variety = true
    assign variety_mint_ok = false
    assign variety_raspberry_ok = false
    assign variety_cherry_ok = false
    for core_variant in slider_product.variants
      assign core_title = core_variant.title | downcase
      unless core_title contains 'variety'
        if core_variant.available
          if core_title contains 'mint'
            assign variety_mint_ok = true
          endif
          if core_title contains 'raspberry'
            assign variety_raspberry_ok = true
          endif
          if core_title contains 'cherry'
            assign variety_cherry_ok = true
          endif
        endif
      endunless
    endfor
    if variety_mint_ok and variety_raspberry_ok and variety_cherry_ok
      assign nav_available = true
    else
      assign nav_available = false
    endif
  endif
%}

{% unless variant == blank %}
<button
  class="product-slider__nav{% if nav_first %} is-active{% endif %}{% unless nav_available %} is-sold-out{% endunless %}"
  type="button"
  role="radio"
  data-product-slider-nav
  data-brisa-cores-swatch
  data-index="{{ nav_index }}"
  data-variant-id="{{ variant.id }}"
  data-available="{% if nav_available %}true{% else %}false{% endif %}"
  {% if is_variety %}data-variety="true" data-flavour-key="variety"{% endif %}
  aria-label="Select {{ nav_label | escape }}"
  aria-checked="{% if nav_first %}true{% else %}false{% endif %}"
  {% unless nav_available %}disabled aria-disabled="true" title="Sold out"{% endunless %}
  {% if nav_first %}aria-current="true"{% endif %}
>
  {% if section.settings.use_swatch_nav %}
    <span class="product-slider__swatch-wrap">
      <span class="product-slider__swatch" style="{{ swatch_style }}"></span>
      {% if show_new_badge %}
        <span class="product-slider__new-badge">NEW</span>
      {% endif %}
    </span>
    {% if display_label != blank %}
      <span class="product-slider__swatch-label">{{ display_label | escape }}</span>
    {% endif %}
  {% else %}
    <span class="product-slider__dot"></span>
  {% endif %}
</button>
{% endunless %}
