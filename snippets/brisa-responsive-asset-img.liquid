{%- comment -%}
  Render a responsive theme asset image.

  Required:
    filename: Theme asset filename.
    widths: Comma-separated numeric widths.

  Optional:
    sizes, alt, class, loading, fetchpriority, width, height, draggable, decoding, quality.
{%- endcomment -%}
{%- liquid
  assign asset_filename = filename | default: '' | strip
  assign responsive_widths = widths | default: '' | split: ','
  assign image_quality = quality | default: 70
  assign largest_width = ''

  for candidate in responsive_widths
    assign candidate_width = candidate | strip
    if candidate_width != blank
      assign largest_width = candidate_width
    endif
  endfor

  if largest_width == blank and width != blank
    assign largest_width = width
  endif

  assign source_size = largest_width | append: 'x'
  assign source_url = asset_filename | asset_img_url: source_size
  assign source_url = source_url | append: '&quality=' | append: image_quality
-%}
{%- if asset_filename != blank and largest_width != blank -%}
  {%- capture responsive_srcset -%}
    {%- for candidate in responsive_widths -%}
      {%- assign candidate_width = candidate | strip -%}
      {%- if candidate_width != blank -%}
        {%- assign named_size = candidate_width | append: 'x' -%}
        {%- assign candidate_url = asset_filename | asset_img_url: named_size -%}
        {{- candidate_url }}&quality={{ image_quality }} {{ candidate_width }}w{%- unless forloop.last -%}, {% endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  <img
    src="{{ source_url | escape }}"
    srcset="{{ responsive_srcset | strip | escape }}"
    alt="{{ alt | default: '' | escape }}"
    {%- if class != blank %} class="{{ class | escape }}"{% endif %}
    {%- if sizes != blank %} sizes="{{ sizes | escape }}"{% endif %}
    {%- if loading != blank %} loading="{{ loading | escape }}"{% endif %}
    {%- if fetchpriority != blank %} fetchpriority="{{ fetchpriority | escape }}"{% endif %}
    width="{{ width | default: largest_width }}"
    height="{{ height | default: largest_width }}"
    {%- if draggable != blank %} draggable="{{ draggable | escape }}"{% endif %}
    {%- if decoding != blank %} decoding="{{ decoding | escape }}"{% endif %}
  >
{%- endif -%}
