{%- comment -%}
  Custom HOW MUCH? pack cards. Syncs quantity on the product form.
  Each cores variant is a 3-pack ($15); qty 3/6/9 ≈ 9/18/27 cores.
  pack_X_label is split on first space: leading number (large) + rest (e.g. Core packs).
  pack_X_meta supports "Aroma line|ritual line" (split on |).
{%- endcomment -%}
<div class="bcp-packs" data-brisa-cores-packs>
  <button
    type="button"
    class="bcp-pack"
    data-brisa-cores-pack
    data-pack-qty="{{ section.settings.pack_1_qty | default: 3 }}"
    data-pack-cores="{{ section.settings.pack_1_cores | default: 9 }}"
    aria-pressed="false"
  >
    <span class="bcp-pack__flag bcp-pack__flag--sold-out" data-bcp-pack-sold-out hidden>Sold out</span>
    {%- assign pack_1_label = section.settings.pack_1_label | default: '3 Core packs' -%}
    {%- assign pack_1_label_parts = pack_1_label | split: ' ' -%}
    <span class="bcp-pack__cores">
      {%- if pack_1_label_parts.size > 1 -%}
        <span class="bcp-pack__cores-num">{{ pack_1_label_parts.first | escape }}</span>
        <span class="bcp-pack__cores-label">{{ pack_1_label | remove_first: pack_1_label_parts.first | strip | escape }}</span>
      {%- else -%}
        {{ pack_1_label | escape }}
      {%- endif -%}
    </span>
    {% if section.settings.pack_1_meta != blank %}
      {%- assign pack_1_meta_parts = section.settings.pack_1_meta | split: '|' -%}
      {% if pack_1_meta_parts.size > 1 %}
        <span class="bcp-pack__sublines">
          <span class="bcp-pack__aroma">{{ pack_1_meta_parts[0] | strip | escape }}</span>
          <span class="bcp-pack__meta">{{ pack_1_meta_parts[1] | strip | escape }}</span>
        </span>
      {% else %}
        <span class="bcp-pack__meta">{{ section.settings.pack_1_meta | escape }}</span>
      {% endif %}
    {% endif %}
    <span class="bcp-pack__price">{{ section.settings.pack_1_price | default: '$45' | escape }}</span>
    {% if section.settings.pack_1_unit != blank %}
      <span class="bcp-pack__unit">{{ section.settings.pack_1_unit | escape }}</span>
    {% endif %}
  </button>

  <button
    type="button"
    class="bcp-pack bcp-pack--popular is-selected"
    data-brisa-cores-pack
    data-pack-qty="{{ section.settings.pack_2_qty | default: 6 }}"
    data-pack-cores="{{ section.settings.pack_2_cores | default: 18 }}"
    aria-pressed="true"
  >
    <span class="bcp-pack__flag bcp-pack__flag--sold-out" data-bcp-pack-sold-out hidden>Sold out</span>
    {% if section.settings.pack_2_flag != blank %}
      <span class="bcp-pack__flag">{{ section.settings.pack_2_flag | escape }}</span>
    {% endif %}
    {%- assign pack_2_label = section.settings.pack_2_label | default: '6 Core packs' -%}
    {%- assign pack_2_label_parts = pack_2_label | split: ' ' -%}
    <span class="bcp-pack__cores">
      {%- if pack_2_label_parts.size > 1 -%}
        <span class="bcp-pack__cores-num">{{ pack_2_label_parts.first | escape }}</span>
        <span class="bcp-pack__cores-label">{{ pack_2_label | remove_first: pack_2_label_parts.first | strip | escape }}</span>
      {%- else -%}
        {{ pack_2_label | escape }}
      {%- endif -%}
    </span>
    {% if section.settings.pack_2_meta != blank %}
      {%- assign pack_2_meta_parts = section.settings.pack_2_meta | split: '|' -%}
      {% if pack_2_meta_parts.size > 1 %}
        <span class="bcp-pack__sublines">
          <span class="bcp-pack__aroma">{{ pack_2_meta_parts[0] | strip | escape }}</span>
          <span class="bcp-pack__meta">{{ pack_2_meta_parts[1] | strip | escape }}</span>
        </span>
      {% else %}
        <span class="bcp-pack__meta">{{ section.settings.pack_2_meta | escape }}</span>
      {% endif %}
    {% endif %}
    <span class="bcp-pack__price-row">
      <span class="bcp-pack__price">{{ section.settings.pack_2_price | default: '$75' | escape }}</span>
      {% if section.settings.pack_2_compare != blank %}
        <span class="bcp-pack__compare">{{ section.settings.pack_2_compare | escape }}</span>
      {% endif %}
    </span>
    {% if section.settings.pack_2_unit != blank %}
      <span class="bcp-pack__unit">{{ section.settings.pack_2_unit | escape }}</span>
    {% endif %}
    {% if section.settings.pack_2_save != blank %}
      <span class="bcp-pack__save">{{ section.settings.pack_2_save | escape }}</span>
    {% endif %}
  </button>

  <button
    type="button"
    class="bcp-pack bcp-pack--value"
    data-brisa-cores-pack
    data-pack-qty="{{ section.settings.pack_3_qty | default: 9 }}"
    data-pack-cores="{{ section.settings.pack_3_cores | default: 27 }}"
    aria-pressed="false"
  >
    <span class="bcp-pack__flag bcp-pack__flag--sold-out" data-bcp-pack-sold-out hidden>Sold out</span>
    {% if section.settings.pack_3_flag != blank %}
      <span class="bcp-pack__flag bcp-pack__flag--value">{{ section.settings.pack_3_flag | escape }}</span>
    {% endif %}
    {%- assign pack_3_label = section.settings.pack_3_label | default: '9 Core packs' -%}
    {%- assign pack_3_label_parts = pack_3_label | split: ' ' -%}
    <span class="bcp-pack__cores">
      {%- if pack_3_label_parts.size > 1 -%}
        <span class="bcp-pack__cores-num">{{ pack_3_label_parts.first | escape }}</span>
        <span class="bcp-pack__cores-label">{{ pack_3_label | remove_first: pack_3_label_parts.first | strip | escape }}</span>
      {%- else -%}
        {{ pack_3_label | escape }}
      {%- endif -%}
    </span>
    {% if section.settings.pack_3_meta != blank %}
      {%- assign pack_3_meta_parts = section.settings.pack_3_meta | split: '|' -%}
      {% if pack_3_meta_parts.size > 1 %}
        <span class="bcp-pack__sublines">
          <span class="bcp-pack__aroma">{{ pack_3_meta_parts[0] | strip | escape }}</span>
          <span class="bcp-pack__meta">{{ pack_3_meta_parts[1] | strip | escape }}</span>
        </span>
      {% else %}
        <span class="bcp-pack__meta">{{ section.settings.pack_3_meta | escape }}</span>
      {% endif %}
    {% endif %}
    <span class="bcp-pack__price-row">
      <span class="bcp-pack__price">{{ section.settings.pack_3_price | default: '$90' | escape }}</span>
      {% if section.settings.pack_3_compare != blank %}
        <span class="bcp-pack__compare">{{ section.settings.pack_3_compare | escape }}</span>
      {% endif %}
    </span>
    {% if section.settings.pack_3_unit != blank %}
      <span class="bcp-pack__unit">{{ section.settings.pack_3_unit | escape }}</span>
    {% endif %}
    {% if section.settings.pack_3_save != blank %}
      <span class="bcp-pack__save bcp-pack__save--value">{{ section.settings.pack_3_save | escape }}</span>
    {% endif %}
  </button>
</div>
