{% liquid
  assign slide_href = variant.url
  if slide_label != blank and slide_href contains '?'
    assign slide_colour_param = slide_label | url_encode
    assign slide_href = slide_href | append: '&colour=' | append: slide_colour_param
  endif

  assign desktop_image_size = section.settings.max_width | minus: 40 | times: section.settings.image_width | divided_by: 100
  assign sprout_mobile_size = section.settings.sprout_size | times: 0.72 | round
  assign sprout_sizes = '(max-width: 749px) ' | append: sprout_mobile_size | append: 'px, ' | append: section.settings.sprout_size | append: 'px'
%}

<div
  class="product-slider__card"
  data-product-slider-card
  data-product-title="{{ slide_label | escape }}"
  style="border-radius: {{ section.settings.slider_border_radius }}px;"
>
  <a class="product-slider__link" href="{{ slide_href }}">
    <div class="product-slider__image-wrapper">
      {% if section.settings.show_slide_product_name %}
        <div class="product-slider__flavour">{{ slide_label | escape }}</div>
      {% endif %}

      <div class="product-slider__sprouts">
        {% for i in (1..4) %}
          {% liquid
            assign sprout_key = 'sprout_image_' | append: i
            assign sprout_image = variant.metafields.custom[sprout_key].value | default: slider_product.metafields.custom[sprout_key].value
            if sprout_image != blank
              assign sprout_image_width = sprout_image.width | at_most: 280
            endif
          %}

          {% if sprout_image != blank %}
            <div class="product-slider__sprout">
              {%- capture sprout_image_markup -%}
                {{- sprout_image
                  | image_url: width: sprout_image_width
                  | image_tag:
                    alt: '',
                    loading: 'lazy',
                    sizes: sprout_sizes,
                    widths: '40,60,80,100,120,140,160,200,240,280',
                    width: sprout_image.width,
                    height: sprout_image.height
                -}}
              {%- endcapture -%}
              {{- sprout_image_markup
                | replace: '&amp;width=', '&amp;quality=70&amp;width='
                | replace: '?width=', '?quality=70&amp;width='
              -}}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% liquid
        assign card_image = blank

        case section.settings.slide_image_source
          when 'variant_metafield'
            assign ns = section.settings.slide_image_metafield_namespace
            assign key = section.settings.slide_image_metafield_key
            assign card_image = variant.metafields[ns][key].value | default: variant.metafields[ns][key]
          when 'variant_image'
            assign card_image = variant.image
          when 'carousel_product_image'
            assign card_image = variant.metafields.custom.carousel_product_image.value | default: variant.metafields.custom.carousel_product_image | default: slider_product.metafields.custom.carousel_product_image.value | default: slider_product.metafields.custom.carousel_product_image
          else
            assign card_image = variant.metafields.custom.carousel_product_image.value | default: variant.metafields.custom.carousel_product_image | default: slider_product.metafields.custom.carousel_product_image.value | default: slider_product.metafields.custom.carousel_product_image | default: variant.image
        endcase

        assign image_loading = 'lazy'
        if eager_load and section.index <= 2
          assign image_loading = 'eager'
        endif

        assign image_fetchpriority = 'auto'
        if eager_load and section.index <= 2
          assign image_fetchpriority = 'high'
        endif

        if card_image != blank
          assign card_image_width = card_image.width | at_most: 1600
          assign card_image_ratio = card_image.aspect_ratio | default: 1
          assign mobile_render_width = section.settings.mobile_image_max_height | times: card_image_ratio | ceil | at_least: 40
          assign desktop_render_width = section.settings.image_max_height | times: card_image_ratio | ceil | at_least: 40
          assign desktop_render_width = desktop_render_width | at_most: desktop_image_size
          assign card_image_sizes = '(max-width: 749px) min(' | append: section.settings.image_width | append: 'vw, ' | append: mobile_render_width | append: 'px), ' | append: desktop_render_width | append: 'px'
        endif
      %}

      {% if card_image != blank %}
        {%- capture card_image_markup -%}
          {{- card_image
            | image_url: width: card_image_width
            | image_tag:
              class: 'product-slider__image',
              alt: slide_label,
              loading: image_loading,
              fetchpriority: image_fetchpriority,
              sizes: card_image_sizes,
              widths: '40,60,80,100,120,160,180,240,320,360,480,600,800,1000,1200,1600',
              width: card_image.width,
              height: card_image.height
          -}}
        {%- endcapture -%}
        {{- card_image_markup
          | replace: '&amp;width=', '&amp;quality=70&amp;width='
          | replace: '?width=', '?quality=70&amp;width='
        -}}
      {% endif %}
    </div>
  </a>
</div>
