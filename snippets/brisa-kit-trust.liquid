{%- comment -%}
  Trust badge grid for Brisa kit purchase.
  Priority: Theme Editor image picker → theme asset filename → inline SVG.
  Edit labels/icons in Brisa kit purchase → Trust row.
  Pass: {% render 'brisa-kit-trust', settings: section.settings %}
{%- endcomment -%}
<ul class="bkp__trust" data-bkp-trust-source>
  {% for i in (1..6) %}
    {% liquid
      case i
        when 1
          assign t_label = settings.trust_1
          assign t_icon = settings.trust_icon_1
          assign t_asset = settings.trust_icon_asset_1 | default: 'brisa-trust-ship.svg'
        when 2
          assign t_label = settings.trust_2
          assign t_icon = settings.trust_icon_2
          assign t_asset = settings.trust_icon_asset_2 | default: 'brisa-trust-lock.svg'
        when 3
          assign t_label = settings.trust_3
          assign t_icon = settings.trust_icon_3
          assign t_asset = settings.trust_icon_asset_3 | default: 'brisa-trust-box.svg'
        when 4
          assign t_label = settings.trust_4
          assign t_icon = settings.trust_icon_4
          assign t_asset = settings.trust_icon_asset_4 | default: 'brisa-trust-aussie.svg'
        when 5
          assign t_label = settings.trust_5
          assign t_icon = settings.trust_icon_5
          assign t_asset = settings.trust_icon_asset_5 | default: 'brisa-trust-star.svg'
        else
          assign t_label = settings.trust_6
          assign t_icon = settings.trust_icon_6
          assign t_asset = settings.trust_icon_asset_6 | default: 'brisa-trust-shield.svg'
      endcase
    %}
    {% if t_label != blank %}
      <li class="bkp__trust-item">
        <span class="bkp__trust-icon bkp__trust-icon--custom" aria-hidden="true">
          {% if t_icon != blank %}
            {{ t_icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '28,56,96', alt: '' }}
          {% elsif t_asset != blank %}
            <img
              src="{{ t_asset | asset_url }}"
              alt=""
              width="28"
              height="28"
              loading="lazy"
            >
          {% endif %}
        </span>
        <span>{{ t_label | escape }}</span>
      </li>
    {% endif %}
  {% endfor %}
</ul>
