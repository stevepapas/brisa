<div
  class="brisa-cores-gallery__card"
  data-brisa-cores-card
  data-variant-id="{{ variant.id }}"
  data-slide-label="{{ slide_label | escape }}"
  style="border-radius: 0;"
>
  <div class="brisa-cores-gallery__image-wrapper">
    {% liquid
      assign card_image = blank
      case section.settings.slide_image_source
        when 'variant_metafield'
          assign ns = section.settings.slide_image_metafield_namespace
          assign key = section.settings.slide_image_metafield_key
          assign card_image = variant.metafields[ns][key].value | default: variant.metafields[ns][key]
          if card_image == blank
            assign card_image = variant.image
          endif
        when 'variant_image'
          assign card_image = variant.image
        when 'carousel_product_image'
          assign card_image = variant.metafields.custom.carousel_product_image.value | default: variant.metafields.custom.carousel_product_image | default: product.metafields.custom.carousel_product_image.value | default: product.metafields.custom.carousel_product_image | default: variant.image
        else
          assign card_image = variant.metafields.custom.slider_image.value | default: variant.metafields.custom.slider_image | default: variant.image
      endcase

      if card_image == blank and variant.featured_media != blank
        assign card_image = variant.featured_media.preview_image
      endif
      if card_image == blank and product.featured_media != blank
        assign card_image = product.featured_media.preview_image
      endif

      assign image_loading = 'lazy'
      if eager_load
        assign image_loading = 'eager'
      endif

      assign image_fetchpriority = 'auto'
      if eager_load and section.index == 1
        assign image_fetchpriority = 'high'
      endif

      if card_image != blank
        assign card_image_width = card_image.width | at_most: 1440
      endif
    %}

    {% if card_image != blank %}
      {{- card_image
        | image_url: width: card_image_width
        | image_tag:
          class: 'brisa-cores-gallery__image',
          alt: slide_label,
          loading: image_loading,
          fetchpriority: image_fetchpriority,
          sizes: '(max-width: 749px) calc(100vw - 40px), 720px',
          widths: '360,540,720,900,1080,1440',
          width: card_image.width,
          height: card_image.height
      -}}
    {% endif %}
  </div>
</div>
