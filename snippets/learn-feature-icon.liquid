{%- comment -%}
  Same Motion / learn feature icon from theme asset (title → handle.png).
  Usage: {% render 'learn-feature-icon', title: block.settings.title %}
{%- endcomment -%}
{%- liquid
  assign icon_asset = title | handle | append: '.png'
-%}
{%- if title != blank -%}
  <span class="learn-feature-icon-wrap learn-icon-circle">
    {% render 'brisa-responsive-asset-img',
      filename: icon_asset,
      widths: '44,88',
      sizes: '44px',
      alt: '',
      class: 'learn-feature-icon',
      loading: 'lazy',
      width: 44,
      height: 44
    %}
  </span>
{%- endif -%}
