{% liquid
  assign slider_option = blank
  assign slider_item_count = 0
  assign option_name_setting = section.settings.option_name | strip | downcase

  for option in product.options_with_values
    assign current_option_name = option.name | downcase
    if current_option_name == option_name_setting
      assign slider_option = option
      break
    endif
  endfor

  if slider_option == blank
    assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','
    for color_label in color_label_list
      if product.options_by_name[color_label] != blank
        assign slider_option = product.options_by_name[color_label]
        break
      endif
    endfor
  endif

  if slider_option != blank
    assign slider_item_count = slider_option.values.size
  else
    assign slider_item_count = product.variants.size
  endif
%}

{% if slider_item_count > 0 %}
  <div class="brisa-cores-gallery" data-brisa-cores-gallery>
    <div class="brisa-cores-gallery__swatches" data-brisa-cores-swatches role="radiogroup" aria-label="Choose aroma">
      {% if slider_option != blank %}
        {% for option_value in slider_option.values limit: section.settings.variant_limit %}
          {% render 'product-slider-nav',
            option_value: option_value,
            variant: option_value.variant,
            slider_product: product,
            section: section,
            color_swatch_config: color_swatch_config,
            nav_index: forloop.index0,
            nav_first: forloop.first
          %}
        {% endfor %}
      {% else %}
        {% for variant in product.variants limit: section.settings.variant_limit %}
          {% render 'product-slider-nav',
            option_value: blank,
            variant: variant,
            slider_product: product,
            section: section,
            color_swatch_config: color_swatch_config,
            nav_index: forloop.index0,
            nav_first: forloop.first
          %}
        {% endfor %}
      {% endif %}
    </div>

    {% if aroma_slot != blank %}
      <div class="brisa-cores-gallery__aroma-slot">
        {{ aroma_slot }}
      </div>
    {% endif %}

    <div class="brisa-cores-gallery__viewport" style="border-radius: 0;">
      <div class="brisa-cores-gallery__track" data-brisa-cores-track>
        {% if slider_option != blank %}
          {% for option_value in slider_option.values limit: section.settings.variant_limit %}
            {% liquid
              assign variant = option_value.variant
              assign slide_label = option_value.name | default: variant.title
            %}
            {% if variant == blank %}
              {% continue %}
            {% endif %}
            {% render 'brisa-cores-gallery-slide',
              variant: variant,
              slide_label: slide_label,
              product: product,
              section: section,
              eager_load: forloop.first
            %}
          {% endfor %}
        {% else %}
          {% for variant in product.variants limit: section.settings.variant_limit %}
            {% liquid
              assign slide_label = variant.metafields.custom.flavour.value | default: variant.metafields.custom.flavour | default: variant.title
            %}
            {% render 'brisa-cores-gallery-slide',
              variant: variant,
              slide_label: slide_label,
              product: product,
              section: section,
              eager_load: forloop.first
            %}
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div class="brisa-cores-gallery__captions" aria-live="polite">
      {% if slider_option != blank %}
        {% for option_value in slider_option.values limit: section.settings.variant_limit %}
          {% if option_value.variant == blank %}
            {% continue %}
          {% endif %}
          {% liquid
            assign caption_label = option_value.name
          %}
          <p class="brisa-cores-gallery__caption {% if forloop.first %}is-active{% endif %}" data-brisa-cores-caption data-variant-id="{{ option_value.variant.id }}">
            {%- render 'brisa-cores-aroma-copy', slide_label: caption_label, aroma_prefix: section.settings.aroma_prefix, part: 'caption' -%}
          </p>
        {% endfor %}
      {% else %}
        {% for variant in product.variants limit: section.settings.variant_limit %}
          {% liquid
            assign caption_label = variant.metafields.custom.flavour.value | default: variant.metafields.custom.flavour | default: variant.title
          %}
          <p class="brisa-cores-gallery__caption {% if forloop.first %}is-active{% endif %}" data-brisa-cores-caption data-variant-id="{{ variant.id }}">
            {%- render 'brisa-cores-aroma-copy', slide_label: caption_label, aroma_prefix: section.settings.aroma_prefix, part: 'caption' -%}
          </p>
        {% endfor %}
      {% endif %}
    </div>

    {%- liquid
      assign variety_mint_variant = blank
      assign variety_raspberry_variant = blank
      assign variety_cherry_variant = blank
      for v in product.variants
        assign vt = v.title | downcase | strip
        unless vt contains 'variety'
          if vt == 'mint ice' or vt contains 'mint ice'
            assign variety_mint_variant = v
          elsif vt == 'raspberry lime' or vt contains 'raspberry'
            assign variety_raspberry_variant = v
          elsif vt == 'cherry pomegranate' or vt contains 'cherry'
            assign variety_cherry_variant = v
          endif
        endunless
      endfor
    -%}

    <script type="application/json" data-brisa-cores-stock-map>
      {
        "variants": {
          {%- for variant in product.variants -%}
            "{{ variant.id }}": {
              "available": {{ variant.available | json }},
              "inventoryQuantity": {{ variant.inventory_quantity | json }},
              "inventoryManaged": {% if variant.inventory_management != blank %}true{% else %}false{% endif %}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        },
        "varietyComponents": {
          {%- if variety_mint_variant != blank -%}
          "mint": {
            "id": {{ variety_mint_variant.id | json }},
            "available": {{ variety_mint_variant.available | json }},
            "inventoryQuantity": {{ variety_mint_variant.inventory_quantity | json }},
            "inventoryManaged": {% if variety_mint_variant.inventory_management != blank %}true{% else %}false{% endif %}
          }{%- if variety_raspberry_variant != blank or variety_cherry_variant != blank -%},{%- endif -%}
          {%- endif -%}
          {%- if variety_raspberry_variant != blank -%}
          "raspberry": {
            "id": {{ variety_raspberry_variant.id | json }},
            "available": {{ variety_raspberry_variant.available | json }},
            "inventoryQuantity": {{ variety_raspberry_variant.inventory_quantity | json }},
            "inventoryManaged": {% if variety_raspberry_variant.inventory_management != blank %}true{% else %}false{% endif %}
          }{%- if variety_cherry_variant != blank -%},{%- endif -%}
          {%- endif -%}
          {%- if variety_cherry_variant != blank -%}
          "cherry": {
            "id": {{ variety_cherry_variant.id | json }},
            "available": {{ variety_cherry_variant.available | json }},
            "inventoryQuantity": {{ variety_cherry_variant.inventory_quantity | json }},
            "inventoryManaged": {% if variety_cherry_variant.inventory_management != blank %}true{% else %}false{% endif %}
          }
          {%- endif -%}
        }
      }
    </script>

    <script type="application/json" data-brisa-cores-aroma-map>
      [
        {% if slider_option != blank %}
          {% for option_value in slider_option.values limit: section.settings.variant_limit %}
            {% if option_value.variant == blank %}{% continue %}{% endif %}
            {% liquid
              assign map_label = option_value.name
              capture map_label_html
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'label'
              endcapture
              capture map_desc_html
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'desc'
              endcapture
              capture map_caption_html
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'caption'
              endcapture
              capture map_title_html
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'title'
              endcapture
              capture map_flavour_key
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'key'
              endcapture
            %}
            {
              "variantId": {{ option_value.variant.id | json }},
              "slideLabel": {{ map_label | json }},
              "flavourKey": {{ map_flavour_key | strip | json }},
              "titleHtml": {{ map_title_html | strip | json }},
              "labelHtml": {{ map_label_html | strip | json }},
              "descHtml": {{ map_desc_html | strip | json }},
              "captionHtml": {{ map_caption_html | strip | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        {% else %}
          {% for variant in product.variants limit: section.settings.variant_limit %}
            {% liquid
              assign map_label = variant.metafields.custom.flavour.value | default: variant.metafields.custom.flavour | default: variant.title
              capture map_label_html
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'label'
              endcapture
              capture map_desc_html
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'desc'
              endcapture
              capture map_caption_html
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'caption'
              endcapture
              capture map_title_html
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'title'
              endcapture
              capture map_flavour_key
                render 'brisa-cores-aroma-copy', slide_label: map_label, aroma_prefix: section.settings.aroma_prefix, part: 'key'
              endcapture
            %}
            {
              "variantId": {{ variant.id | json }},
              "slideLabel": {{ map_label | json }},
              "flavourKey": {{ map_flavour_key | strip | json }},
              "titleHtml": {{ map_title_html | strip | json }},
              "labelHtml": {{ map_label_html | strip | json }},
              "descHtml": {{ map_desc_html | strip | json }},
              "captionHtml": {{ map_caption_html | strip | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        {% endif %}
      ]
    </script>
  </div>
{% endif %}
