{% liquid
  assign slider_option = blank
  assign slider_item_count = 0
  assign option_name_setting = section.settings.option_name | strip | downcase

  for option in product.options_with_values
    assign current_option_name = option.name | downcase
    if current_option_name == option_name_setting
      assign slider_option = option
      break
    endif
  endfor

  if slider_option == blank
    assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','
    for color_label in color_label_list
      if product.options_by_name[color_label] != blank
        assign slider_option = product.options_by_name[color_label]
        break
      endif
    endfor
  endif

  if slider_option != blank
    assign slider_item_count = slider_option.values.size
  else
    assign slider_item_count = product.variants.size
  endif
%}

{% if slider_item_count > 0 %}
  <div class="brisa-cores-gallery" data-brisa-cores-gallery>
    <div class="brisa-cores-gallery__swatches" data-brisa-cores-swatches role="radiogroup" aria-label="Choose aroma">
      {% if slider_option != blank %}
        {% for option_value in slider_option.values limit: section.settings.variant_limit %}
          {% render 'product-slider-nav',
            option_value: option_value,
            variant: option_value.variant,
            slider_product: product,
            section: section,
            color_swatch_config: color_swatch_config,
            nav_index: forloop.index0,
            nav_first: forloop.first
          %}
        {% endfor %}
      {% else %}
        {% for variant in product.variants limit: section.settings.variant_limit %}
          {% render 'product-slider-nav',
            option_value: blank,
            variant: variant,
            slider_product: product,
            section: section,
            color_swatch_config: color_swatch_config,
            nav_index: forloop.index0,
            nav_first: forloop.first
          %}
        {% endfor %}
      {% endif %}
    </div>

    {% if aroma_slot != blank %}
      <div class="brisa-cores-gallery__aroma-slot">
        {{ aroma_slot }}
      </div>
    {% endif %}

    <div class="brisa-cores-gallery__viewport" style="border-radius: 0;">
      <div class="brisa-cores-gallery__track" data-brisa-cores-track>
        {% if slider_option != blank %}
          {% for option_value in slider_option.values limit: section.settings.variant_limit %}
            {% liquid
              assign variant = option_value.variant
              assign slide_label = option_value.name | default: variant.title
            %}
            {% if variant == blank %}
              {% continue %}
            {% endif %}
            {% render 'brisa-cores-gallery-slide',
              variant: variant,
              slide_label: slide_label,
              product: product,
              section: section,
              eager_load: forloop.first
            %}
          {% endfor %}
        {% else %}
          {% for variant in product.variants limit: section.settings.variant_limit %}
            {% liquid
              assign slide_label = variant.metafields.custom.flavour.value | default: variant.metafields.custom.flavour | default: variant.title
            %}
            {% render 'brisa-cores-gallery-slide',
              variant: variant,
              slide_label: slide_label,
              product: product,
              section: section,
              eager_load: forloop.first
            %}
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div class="brisa-cores-gallery__captions" aria-live="polite">
      {% if slider_option != blank %}
        {% for option_value in slider_option.values limit: section.settings.variant_limit %}
          {% if option_value.variant == blank %}
            {% continue %}
          {% endif %}
          {% liquid
            assign caption_label = option_value.name
            assign caption_downcase = caption_label | downcase
            assign popular_name = section.settings.popular_variant_name | downcase
            assign caption_text = caption_label | upcase
            if popular_name != blank and caption_downcase == popular_name and section.settings.popular_suffix != blank
              assign caption_text = caption_text | append: ' ' | append: section.settings.popular_suffix
            endif
          %}
          <p class="brisa-cores-gallery__caption {% if forloop.first %}is-active{% endif %}" data-brisa-cores-caption data-variant-id="{{ option_value.variant.id }}">
            {{ caption_text | escape }}
          </p>
        {% endfor %}
      {% else %}
        {% for variant in product.variants limit: section.settings.variant_limit %}
          {% liquid
            assign caption_label = variant.metafields.custom.flavour.value | default: variant.metafields.custom.flavour | default: variant.title
          %}
          {% liquid
            assign caption_downcase = caption_label | downcase
            assign popular_name = section.settings.popular_variant_name | downcase
            assign caption_text = caption_label | upcase
            if popular_name != blank and caption_downcase == popular_name and section.settings.popular_suffix != blank
              assign caption_text = caption_text | append: ' ' | append: section.settings.popular_suffix
            endif
          %}
          <p class="brisa-cores-gallery__caption {% if forloop.first %}is-active{% endif %}" data-brisa-cores-caption data-variant-id="{{ variant.id }}">
            {{ caption_text | escape }}
          </p>
        {% endfor %}
      {% endif %}
    </div>
  </div>
{% endif %}
