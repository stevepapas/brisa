{%- comment -%}
  Brisa PDP colour row: option swatches + variant device image (Slider Image metafield).
  Syncs with the hidden theme variant-picker via JS in brisa-product-buy-zone.

  Parameters:
  - product (required)
  - section (required) — brisa-product-buy-zone section object
{%- endcomment -%}

{%- liquid
  assign color_white_label = 'general.label.white' | t | downcase
  assign color_swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />'
  assign color_option = blank
  assign option_name_setting = section.settings.option_name | strip | downcase

  for option in product.options_with_values
    assign current_option_name = option.name | downcase
    if current_option_name == option_name_setting
      assign color_option = option
      break
    endif
  endfor

  if color_option == blank
    assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','
    for color_label in color_label_list
      if product.options_by_name[color_label] != blank
        assign color_option = product.options_by_name[color_label]
        break
      endif
    endfor
  endif

  assign ns = section.settings.image_metafield_namespace | default: 'custom'
  assign key = section.settings.image_metafield_key | default: 'slider_image'
  assign initial_variant = product.selected_or_first_available_variant
  assign initial_image = initial_variant.metafields[ns][key].value | default: initial_variant.metafields[ns][key] | default: initial_variant.image | default: product.featured_image
-%}

{%- if color_option != blank -%}
  <div
    class="brisa-colour-picker"
    data-brisa-colour-picker
    data-image-namespace="{{ ns | escape }}"
    data-image-key="{{ key | escape }}"
  >
    {%- if section.settings.show_heading -%}
      {%- capture colour_names -%}
        {%- for value in color_option.values -%}
          {{- value.name | default: value | upcase -}}{%- unless forloop.last -%} / {%- endunless -%}
        {%- endfor -%}
      {%- endcapture -%}
      <p class="brisa-colour-picker__heading">
        <span class="brisa-colour-picker__heading-label">{{ color_option.name | upcase | escape }}</span>
        <span class="brisa-colour-picker__heading-values">— {{ colour_names | strip }}</span>
      </p>
    {%- endif -%}

    <div class="brisa-colour-picker__row">
      <div class="brisa-colour-picker__swatches">
        {%- for value in color_option.values -%}
          {%- liquid
            assign value_name = value.name | default: value
            assign value_downcase = value_name | downcase
            assign variant_for_value = value.variant
            if variant_for_value == blank
              assign variant_for_value = product.variants | where: 'option1', value_name | first
            endif
            assign is_selected = false
            if value == color_option.selected_value
              assign is_selected = true
            endif
          -%}

          {%- if variant_for_value == blank -%}
            {%- continue -%}
          {%- endif -%}

          <button
            type="button"
            class="brisa-colour-picker__swatch{% if is_selected %} is-active{% endif %}"
            data-brisa-colour-swatch
            data-option-position="{{ color_option.position }}"
            data-option-value-id="{{ value.id }}"
            data-variant-id="{{ variant_for_value.id }}"
            aria-label="{{ value_name | escape }}"
            {% if is_selected %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}
          >
            <span
              class="brisa-colour-picker__swatch-dot{% if color_white_label == value_downcase %} brisa-colour-picker__swatch-dot--white{% endif %}"
              style="{% render 'color-swatch-style', swatch: value.swatch, color_swatch_config: color_swatch_config, value: value %}"
            ></span>
            <span class="brisa-colour-picker__swatch-label">{{ value_name | escape }}</span>
          </button>
        {%- endfor -%}
      </div>

      <div class="brisa-colour-picker__media">
        {%- if initial_image != blank -%}
          <img
            class="brisa-colour-picker__image"
            data-brisa-colour-image
            src="{{ initial_image | image_url: width: 700 }}"
            alt="{{ product.title | escape }}"
            loading="eager"
            width="{{ initial_image.width }}"
            height="{{ initial_image.height }}"
          >
        {%- else -%}
          <div class="brisa-colour-picker__image-placeholder" data-brisa-colour-image-placeholder></div>
        {%- endif -%}
      </div>
    </div>

    <script type="application/json" data-brisa-variant-images>
      {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {
            {%- assign variant_image = variant.metafields[ns][key].value | default: variant.metafields[ns][key] | default: variant.image -%}
            {%- if variant_image != blank -%}
              "src": {{ variant_image | image_url: width: 700 | json }},
              "width": {{ variant_image.width | default: 0 | json }},
              "height": {{ variant_image.height | default: 0 | json }}
            {%- else -%}
              "src": null
            {%- endif -%}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    </script>
  </div>
{%- endif -%}
