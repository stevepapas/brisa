{% doc %}
  @prompt
    Create a testimonials slider carousel for a custom liquid section. Repeat the following testimonial 4 times as placeholder slides: Name: Dante, Rating: 5 stars (★★★★★), Quote: "Good for those moments you'd normally go for a smoke without thinking.", Image: circular avatar photo (Dante.png). Design: spa-inspired earthy luxury aesthetic for a premium wellness brand, mobile-friendly with swipe support, each slide shows avatar, star rating, quote, and name, smooth transitions, dot navigation indicators, soft neutral tones, vanilla JS only.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-slider-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-testimonials-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-testimonials-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-testimonials-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
  }

  .ai-testimonials-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .ai-testimonials-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    padding: 0 10px;
    box-sizing: border-box;
  }

  .ai-testimonials-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.3s ease;
  }

  .ai-testimonials-card-{{ ai_gen_id }}:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-testimonials-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    margin: 0 auto 20px;
    overflow: hidden;
    background-color: {{ block.settings.avatar_placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonials-avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonials-avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
    color: {{ block.settings.avatar_placeholder_color }};
    font-weight: 600;
  }

  .ai-testimonials-rating-{{ ai_gen_id }} {
    margin-bottom: 20px;
    font-size: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
    letter-spacing: 4px;
  }

  .ai-testimonials-quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.7;
    margin: 0 0 24px;
    font-style: italic;
  }

  .ai-testimonials-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    color: {{ block.settings.name_color }};
    font-weight: 600;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-testimonials-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .ai-testimonials-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-testimonials-dot-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.dot_hover_color }};
    transform: scale(1.2);
  }

  .ai-testimonials-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.3);
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-slider-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-testimonials-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-testimonials-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-testimonials-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }

    .ai-testimonials-avatar-{{ ai_gen_id }} {
      width: {{ block.settings.avatar_size | times: 0.85 }}px;
      height: {{ block.settings.avatar_size | times: 0.85 }}px;
    }

    .ai-testimonials-quote-{{ ai_gen_id }} {
      font-size: {{ block.settings.quote_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<testimonials-slider-{{ ai_gen_id }}
  class="ai-testimonials-slider-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    {% if block.settings.show_title %}
      <div class="ai-testimonials-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-testimonials-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-testimonials-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-testimonials-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-testimonials-track-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          <div class="ai-testimonials-slide-{{ ai_gen_id }}">
            <div class="ai-testimonials-card-{{ ai_gen_id }}">
              <div class="ai-testimonials-avatar-{{ ai_gen_id }}">
                {% if block.settings.testimonial_image %}
                  <img
                    src="{{ block.settings.testimonial_image | image_url: width: 200 }}"
                    alt="Dante"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div class="ai-testimonials-avatar-placeholder-{{ ai_gen_id }}">D</div>
                {% endif %}
              </div>

              <div class="ai-testimonials-rating-{{ ai_gen_id }}" aria-label="5 star rating">
                ★★★★★
              </div>

              <blockquote class="ai-testimonials-quote-{{ ai_gen_id }}">
                "Good for those moments you'd normally go for a smoke without thinking."
              </blockquote>

              <p class="ai-testimonials-name-{{ ai_gen_id }}">Dante</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-testimonials-dots-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        <button
          class="ai-testimonials-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          aria-label="Go to slide {{ i }}"
          data-slide="{{ forloop.index0 }}"
        ></button>
      {% endfor %}
    </div>
  </div>
</testimonials-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 4;
        this.autoplayInterval = null;
        this.touchStartX = 0;
        this.touchEndX = 0;
        this.isDragging = false;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-testimonials-track-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-testimonials-dot-{{ ai_gen_id }}');
        this.wrapper = this.querySelector('.ai-testimonials-slider-wrapper-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;

        this.setupEventListeners();
        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideIndex = parseInt(e.target.dataset.slide);
            this.goToSlide(slideIndex);
            if (this.autoplay) {
              this.resetAutoplay();
            }
          });
        });

        this.wrapper.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
          this.isDragging = true;
          if (this.autoplay) {
            this.stopAutoplay();
          }
        });

        this.wrapper.addEventListener('touchmove', (e) => {
          if (!this.isDragging) return;
          this.touchEndX = e.changedTouches[0].screenX;
        });

        this.wrapper.addEventListener('touchend', () => {
          if (!this.isDragging) return;
          this.handleSwipe();
          this.isDragging = false;
          if (this.autoplay) {
            this.resetAutoplay();
          }
        });

        this.wrapper.addEventListener('mouseenter', () => {
          if (this.autoplay) {
            this.stopAutoplay();
          }
        });

        this.wrapper.addEventListener('mouseleave', () => {
          if (this.autoplay) {
            this.startAutoplay();
          }
        });
      }

      handleSwipe() {
        const swipeThreshold = 50;
        const diff = this.touchStartX - this.touchEndX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }
      }

      goToSlide(index) {
        this.currentSlide = index;
        const offset = -index * 100;
        this.track.style.transform = `translateX(${offset}%)`;
        this.updateDots();
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
        this.goToSlide(this.currentSlide);
      }

      prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.goToSlide(this.currentSlide);
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        this.stopAutoplay();
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('testimonials-slider-{{ ai_gen_id }}', TestimonialsSlider{{ ai_gen_id }});
  })();
</script>

